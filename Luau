    table.insert(ActiveConnections,UIS.InputEnded:Connect(function(i) if isTM(i) then sl=false end end))
    return {getValue=function() return val end,setValue=function(v) val=math.clamp(v,mn,mx);local fp=(val-mn)/(mx-mn);fl.Size=UDim2.new(fp,0,1,0);hd.Position=UDim2.new(fp,-hSz/2,0.5,-hSz/2);vL.Text=fmtN(val,inc) end}

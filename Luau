local function getNearestEnemy()
    local mr=character and character:FindFirstChild("HumanoidRootPart")
    if not mr then return nil,nil,math.huge end
    local bt,br,bd=nil,nil,math.huge
    for _,p in ipairs(Players:GetPlayers()) do
        if p==LP then continue end
        local ch=p.Character; if not ch then continue end
        local h=ch:FindFirstChildOfClass("Humanoid"); if not h or h.Health<=0 then continue end
        local r=ch:FindFirstChild("HumanoidRootPart"); if not r then continue end
        local d=(r.Position-mr.Position).Magnitude
        if d<bd then bd=d;bt=p;br=r end
    end
    return bt,br,bd
end

local function getAllNearbyEnemies(range)
    local mr=character and character:FindFirstChild("HumanoidRootPart")
    if not mr then return {} end
    local result={}
    for _,p in ipairs(Players:GetPlayers()) do
        if p==LP then continue end
        local ch=p.Character; if not ch then continue end
        local h=ch:FindFirstChildOfClass("Humanoid"); if not h or h.Health<=0 then continue end
        local r=ch:FindFirstChild("HumanoidRootPart"); if not r then continue end
        local d=(r.Position-mr.Position).Magnitude
        if d<range then table.insert(result,{root=r,dist=d}) end
    end
    return result
end

local function checkIncomingProjectiles()
    local mr=character and character:FindFirstChild("HumanoidRootPart")
    if not mr then return false end
    local myPos=mr.Position
    local ok,result=pcall(function()
        local params=OverlapParams.new()
        params.FilterType=Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances={character}
        local parts=workspace:GetPartBoundsInRadius(myPos,80,params)
        for _,part in ipairs(parts) do
            if not part:IsDescendantOf(character) then
                local vel=part.AssemblyLinearVelocity
                if vel.Magnitude>80 then
                    local toUs=(myPos-part.Position)
                    if toUs.Magnitude>1 and toUs.Unit:Dot(vel.Unit)>0.4 then return true end
                end
            end
        end
        return false
    end)
    return ok and result or false
end

local function getResolvedAimPos(targetRoot)
    if not targetRoot or not targetRoot.Parent then return nil end
    local head=targetRoot.Parent:FindFirstChild("Head")
    local part=head or targetRoot
    local vel=targetRoot.AssemblyLinearVelocity or Vector3.zero
    return part.Position + vel * 0.12
end

local function getAntiRiotFacingAngle()
    local mr=character and character:FindFirstChild("HumanoidRootPart")
    if not mr then return 0 end
    local enemies=getAllNearbyEnemies(50)
    if #enemies==0 then return 0 end
    local sumX,sumZ=0,0
    for _,e in ipairs(enemies) do
        local dir=(e.root.Position-mr.Position)*Vector3.new(1,0,1)
        if dir.Magnitude>0.1 then local u=dir.Unit; sumX=sumX+u.X; sumZ=sumZ+u.Z end
    end
    if math.abs(sumX)<0.001 and math.abs(sumZ)<0.001 then return 0 end
    return math.atan2(-sumX,-sumZ)
end


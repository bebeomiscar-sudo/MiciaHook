    end
    function Tab:Hide()
        tabFrame.Visible=false; indicator.Visible=false
        btn.TextColor3=T.TextDim; Tween(btn,{BackgroundColor3=T.Surface},0.12)
    end

    btn.MouseButton1Click:Connect(function() Tab:Show() end)
    if #AllTabs == 0 then task.defer(function() Tab:Show() end) end

    local function MakeGroupbox(gbName, col)
        local GB = {}
        local box = Make("Frame", {BackgroundColor3=T.Panel, Size=UDim2.new(1,0,0,36), ZIndex=13, Parent=col})
        Corner(box,8); Stroke(box,T.Border,1)


table.insert(ActiveConnections, RunService.Heartbeat:Connect(function(dt)
    local char = LP.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChild("Humanoid")
        if hrp then
            local nh = hum and hum.Health < hum.MaxHealth
            for obj in pairs(dropCache) do
                if not obj or not obj.Parent then dropCache[obj]=nil; continue end
                if (CFG.Collect.Health and obj:FindFirstChild("Health") and nh)
                or (CFG.Collect.Ammo   and obj:FindFirstChild("Ammo")) then
                    pcall(function() firetouchinterest(hrp,obj,0); firetouchinterest(hrp,obj,1) end)
                end
            end
        end
    end
end))


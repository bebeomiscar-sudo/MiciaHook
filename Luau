-- TRIGGERBOT
-- ═══════════════════════════════════════════
local TriggerState = { waiting = false, delayTimer = 0, cooldownTimer = 0 }

local function getTriggerTarget()
    local c = getScreenCenter()
    local origin = camera.CFrame.Position
    local direction = camera.CFrame.LookVector * 1000
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local filterList = { camera }
    if LP.Character then table.insert(filterList, LP.Character) end
    params.FilterDescendantsInstances = filterList

    local hit = workspace:Raycast(origin, direction, params)
    if not hit or not hit.Instance then return nil end

    local hitChar, inst = nil, hit.Instance
    while inst do
        if inst:FindFirstChildOfClass("Humanoid") then hitChar = inst; break end
        inst = inst.Parent
    end
    if not hitChar then return nil end

    local hum = hitChar:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return nil end

    local tp = Players:GetPlayerFromCharacter(hitChar)
    if tp == LP then return nil end

    if CFG.Trigger.TeamCheck and tp then
        local sameTeam = false
        pcall(function()
            sameTeam = tp.Team ~= nil and LP.Team ~= nil and tp.Team == LP.Team
        end)
        if not sameTeam then
            pcall(function()
                local tag = tp.Character and tp.Character:FindFirstChild("TeamTag")
                local myTag = LP.Character and LP.Character:FindFirstChild("TeamTag")
                if tag and myTag then sameTeam = tag.Value == myTag.Value end
            end)
        end
        if sameTeam then return nil end
    end

    local root = hitChar:FindFirstChild("HumanoidRootPart") or hitChar:FindFirstChild("Head")
    if root then
        local sp, on = camera:WorldToScreenPoint(root.Position)
        if on then
            if (Vector2.new(sp.X, sp.Y) - c).Magnitude > CFG.Trigger.FOV then return nil end
        end
    end
    return hitChar
end


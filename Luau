--// Create Mobile Button
local function CreateMobileButton(name, position, size, callback)
    if not IsMobile then return nil end
    
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "MobileButton_" .. name
    ScreenGui.Parent = gethui()
    protect_gui(ScreenGui)
    
    local Button = Instance.new("TextButton")
    Button.Name = name
    Button.Size = size or UDim2.new(0, 80, 0, 80)
    Button.Position = position or UDim2.new(0, 10, 0.5, -40)
    Button.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    Button.BackgroundTransparency = 0.3
    Button.BorderSizePixel = 0
    Button.Text = name
    Button.TextColor3 = Color3.new(1, 1, 1)
    Button.TextSize = 14
    Button.Font = Enum.Font.GothamBold
    Button.Parent = ScreenGui
    
    local UICorner = Instance.new("UICorner")
    UICorner.CornerRadius = UDim.new(0, 20)
    UICorner.Parent = Button
    
    local UIStroke = Instance.new("UIStroke")
    UIStroke.Color = Color3.fromRGB(100, 100, 100)
    UIStroke.Thickness = 2
    UIStroke.Parent = Button
    
    local active = false
    
    Button.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            active = true
            Button.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
            if callback then callback(true) end
        end
    end)
    
    Button.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            active = false
            Button.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
            if callback then callback(false) end
        end
    end)
    
    -- Make draggable
    local dragging = false
    local dragStart = nil
    local startPos = nil
    
    Button.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch and #Button:GetChildren() > 0 then
            local touchPos = input.Position
            if (touchPos - Button.AbsolutePosition - Vector2.new(Button.AbsoluteSize.X/2, Button.AbsoluteSize.Y/2)).Magnitude < 30 then
                dragging = true
                dragStart = input.Position
                startPos = Button.Position
            end
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - dragStart
            Button.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    
    State.mobileButtons[name] = {
        gui = ScreenGui,
        button = Button,
        active = function() return active end
    }
    
    return State.mobileButtons[name]
end

--// Utility Functions
local function GetCharacter(player)
    return player and player.Character
end

local function GetHumanoid(character)
    return character and character:FindFirstChildOfClass("Humanoid")
end

local function GetRootPart(character)
    return character and (character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso"))
end

local function IsPlayerAlive(player)
    local character = GetCharacter(player)
    local humanoid = GetHumanoid(character)
    return humanoid and humanoid.Health > 0
end

local function IsTeamMate(player)
    return player.Team == LocalPlayer.Team
end

local function WorldToViewport(position)
    local screenPos, onScreen = Camera:WorldToViewportPoint(position)
    return Vector2.new(screenPos.X, screenPos.Y), onScreen, screenPos.Z
end

local function GetDistance(position)
    return (Camera.CFrame.Position - position).Magnitude
end

local function GetClosestPlayer(fov, visibleOnly, teamCheck)
    local closest = nil
    local minDist = fov or math.huge
    local screenCenter = Camera.ViewportSize / 2
    
    for _, player in pairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if teamCheck and IsTeamMate(player) then continue end
        
        local character = GetCharacter(player)
        if not character then continue end
        
        local root = GetRootPart(character)
        if not root then continue end
        
        if not IsPlayerAlive(player) then continue end
        
        local screenPos, onScreen = WorldToViewport(root.Position)
        if not onScreen then continue end
        
        if visibleOnly then
            local ray = Workspace:Raycast(Camera.CFrame.Position, (root.Position - Camera.CFrame.Position).Unit * 1000, State.raycastParams)
            if ray and ray.Instance and not ray.Instance:IsDescendantOf(character) then
                continue
            end
        end
        
        local dist = (screenPos - screenCenter).Magnitude
        if dist < minDist then
            minDist = dist
            closest = {
                Player = player,
                Character = character,
                RootPart = root,
                Humanoid = GetHumanoid(character),
                ScreenPosition = screenPos,
                Distance = GetDistance(root.Position)
            }
        end
    end
    
    return closest
end

--// Metatable Hook Setup
local function SetupMetatableHooks()
    local success, err = pcall(function()
        local mt = getrawmetatable(game)
        if not mt then return end
        
        local oldNamecall = mt.__namecall
        local oldIndex = mt.__index
        
        setreadonly(mt, false)
        
        mt.__namecall = newcclosure(function(self, ...)
            local method = getnamecallmethod()
            local args = {...}
            
            if method == "FireServer" and self:IsDescendantOf(ReplicatedStorage) then
                -- No Spread
                if Toggles.exploits_no_spread and Toggles.exploits_no_spread.Value then
                    for _, arg in pairs(args) do
                        if type(arg) == "table" then
                            if arg.Spread then arg.Spread = Vector3.zero end
                            if arg.SpreadAngle then arg.SpreadAngle = 0 end
                            if arg._ProjectileEffect then
                                arg._ProjectileEffect.Spread = Vector3.zero
                                arg._ProjectileEffect.SpreadAngle = 0
                            end
                        end
                    end
                end
                
                -- Silent Aim Manipulation
                if Toggles.silent_manipulation and Toggles.silent_manipulation.Value and State.manipulation.targetPosition then
                    for _, arg in pairs(args) do
                        if type(arg) == "table" then
                            if arg.Direction then
                                arg.Direction = (State.manipulation.targetPosition - Camera.CFrame.Position).Unit
                            end
                            if arg.Origin then
                                arg.Origin = Camera.CFrame.Position
                            end
                        end
                    end
                end
            end
            
            return oldNamecall(self, ...)
        end)
        
        setreadonly(mt, true)
    end)
    
    if not success then
        warn("Metatable hook failed:", err)
    end
end

--// ESP System
local ESP = {}
ESP.__index = ESP

function ESP.new(player)
    local self = setmetatable({}, ESP)
    self.Player = player
    self.Character = nil
    self.RootPart = nil
    self.Humanoid = nil
    
    self.Drawings = {
        Box = CreateDrawing("Square", { Visible = false, Thickness = 1, Filled = false }),
        BoxOutline = CreateDrawing("Square", { Visible = false, Thickness = 3, Filled = false, Color = Color3.new(0, 0, 0) }),
        Name = CreateDrawing("Text", { Visible = false, Center = true, Outline = true, Size = 13 }),
        Distance = CreateDrawing("Text", { Visible = false, Center = true, Outline = true, Size = 12 }),
        Weapon = CreateDrawing("Text", { Visible = false, Center = true, Outline = true, Size = 12 }),
        HealthBar = CreateDrawing("Square", { Visible = false, Thickness = 1, Filled = true }),
        HealthBarOutline = CreateDrawing("Square", { Visible = false, Thickness = 1, Filled = false, Color = Color3.new(0, 0, 0) }),
        Skeleton = {}
    }
    
    -- Create skeleton lines
    local skeletonParts = {
        {"Head", "UpperTorso"},
        {"UpperTorso", "LowerTorso"},
        {"UpperTorso", "LeftUpperArm"},
        {"LeftUpperArm", "LeftLowerArm"},
        {"LeftLowerArm", "LeftHand"},
        {"UpperTorso", "RightUpperArm"},
        {"RightUpperArm", "RightLowerArm"},
        {"RightLowerArm", "RightHand"},
        {"LowerTorso", "LeftUpperLeg"},
        {"LeftUpperLeg", "LeftLowerLeg"},
        {"LeftLowerLeg", "LeftFoot"},
        {"LowerTorso", "RightUpperLeg"},
        {"RightUpperLeg", "RightLowerLeg"},
        {"RightLowerLeg", "RightFoot"}
    }
    
    for _, pair in pairs(skeletonParts) do
        table.insert(self.Drawings.Skeleton, {
            Line = CreateDrawing("Line", { Visible = false, Thickness = 1 }),
            Outline = CreateDrawing("Line", { Visible = false, Thickness = 3, Color = Color3.new(0, 0, 0) }),
            Part1 = pair[1],
            Part2 = pair[2]
        })
    end
    
    self.Connection = RunService.RenderStepped:Connect(function() self:Update() end)
    return self
end

function ESP:Update()
    if not Toggles.esp_enabled or not Toggles.esp_enabled.Value then
        self:SetVisible(false)
        return
    end
    
    if not self.Player or not self.Player.Parent then
        self:Destroy()
        return
    end
    
    local character = GetCharacter(self.Player)
    if not character then
        self:SetVisible(false)
        return
    end
    
    local humanoid = GetHumanoid(character)
    local rootPart = GetRootPart(character)
    
    if not humanoid or not rootPart or humanoid.Health <= 0 then
        self:SetVisible(false)
        return
    end
    
    if not Toggles.esp_show_team.Value and IsTeamMate(self.Player) then
        self:SetVisible(false)
        return
    end
    
    local screenPos, onScreen = WorldToViewport(rootPart.Position)
    if not onScreen then
        self:SetVisible(false)
        return
    end
    
    local distance = GetDistance(rootPart.Position)
    if distance > (Options.esp_max_distance and Options.esp_max_distance.Value or 1000) then
        self:SetVisible(false)
        return
    end
    
    -- Calculate box size
    local head = character:FindFirstChild("Head")
    local leg = character:FindFirstChild("LeftFoot") or character:FindFirstChild("LeftLowerLeg")
    
    local boxSize, boxPosition
    if head and leg then
        local headPos = WorldToViewport(head.Position)
        local legPos = WorldToViewport(leg.Position)
        local height = math.abs(headPos.Y - legPos.Y)
        boxSize = Vector2.new(height * 0.6, height)
        boxPosition = Vector2.new(screenPos.X - boxSize.X / 2, screenPos.Y - boxSize.Y / 2)
    else
        boxSize = Vector2.new(50, 80)
        boxPosition = Vector2.new(screenPos.X - 25, screenPos.Y - 40)
    end
    
    -- Update Box
    if Toggles.esp_box.Value then
        local color = Options.esp_box_color and Options.esp_box_color.Value or Color3.new(1, 1, 1)
        self.Drawings.Box.Size = boxSize
        self.Drawings.Box.Position = boxPosition
        self.Drawings.Box.Color = color
        self.Drawings.Box.Visible = true
        
        self.Drawings.BoxOutline.Size = boxSize
        self.Drawings.BoxOutline.Position = boxPosition
        self.Drawings.BoxOutline.Visible = true
    else
        self.Drawings.Box.Visible = false
        self.Drawings.BoxOutline.Visible = false
    end
    
    -- Update Fill
    if Toggles.esp_fill.Value then
        local fillColor = Options.esp_fill_color and Options.esp_fill_color.Value or Color3.new(1, 1, 1)
        local transparency = Options.esp_fill_transparency and Options.esp_fill_transparency.Value or 0.5
        self.Drawings.Box.Filled = true
        self.Drawings.Box.Transparency = transparency
        self.Drawings.Box.Color = fillColor
    else
        self.Drawings.Box.Filled = false
        self.Drawings.Box.Transparency = 1
    end
    
    -- Update Name
    if Toggles.esp_name.Value then
        local nameText = Options.esp_name_type and Options.esp_name_type.Value == "DisplayName" and self.Player.DisplayName or self.Player.Name
        self.Drawings.Name.Text = nameText
        self.Drawings.Name.Position = Vector2.new(screenPos.X, boxPosition.Y - 15)
        self.Drawings.Name.Color = Options.esp_name_color and Options.esp_name_color.Value or Color3.new(1, 1, 1)
        self.Drawings.Name.Visible = true
    else
        self.Drawings.Name.Visible = false
    end
    
    -- Update Distance
    if Toggles.esp_distance.Value then
        self.Drawings.Distance.Text = string.format("[%dm]", math.floor(distance))
        self.Drawings.Distance.Position = Vector2.new(screenPos.X, boxPosition.Y + boxSize.Y + 2)
        self.Drawings.Distance.Color = Options.esp_distance_color and Options.esp_distance_color.Value or Color3.new(1, 1, 1)
        self.Drawings.Distance.Visible = true
    else
        self.Drawings.Distance.Visible = false
    end
    
    -- Update Weapon
    if Toggles.esp_weapon.Value then
        local weaponText = "Unknown"
        -- Try to get weapon from backpack or character
        local tool = character:FindFirstChildOfClass("Tool")
        if tool then
            weaponText = tool.Name
        end
        self.Drawings.Weapon.Text = weaponText
        self.Drawings.Weapon.Position = Vector2.new(screenPos.X, boxPosition.Y + boxSize.Y + (Toggles.esp_distance.Value and 15 or 2))
        self.Drawings.Weapon.Color = Options.esp_weapon_color and Options.esp_weapon_color.Value or Color3.new(1, 1, 1)
        self.Drawings.Weapon.Visible = true
    else
        self.Drawings.Weapon.Visible = false
    end
    
    -- Update Health Bar
    if Toggles.esp_healthbar.Value then
        local healthPercent = humanoid.Health / humanoid.MaxHealth
        local barHeight = boxSize.Y * healthPercent
        local barWidth = 4
        
        self.Drawings.HealthBarOutline.Size = Vector2.new(barWidth + 2, boxSize.Y + 2)
        self.Drawings.HealthBarOutline.Position = Vector2.new(boxPosition.X - barWidth - 6, boxPosition.Y - 1)
        self.Drawings.HealthBarOutline.Visible = true
        
        self.Drawings.HealthBar.Size = Vector2.new(barWidth, barHeight)
        self.Drawings.HealthBar.Position = Vector2.new(boxPosition.X - barWidth - 5, boxPosition.Y + boxSize.Y - barHeight)
        self.Drawings.HealthBar.Color = Color3.new(1 - healthPercent, healthPercent, 0)
        self.Drawings.HealthBar.Visible = true
    else
        self.Drawings.HealthBar.Visible = false
        self.Drawings.HealthBarOutline.Visible = false
    end
    
    -- Update Skeleton
    if Toggles.esp_skeleton.Value then
        for _, lineData in pairs(self.Drawings.Skeleton) do
            local part1 = character:FindFirstChild(lineData.Part1)
            local part2 = character:FindFirstChild(lineData.Part2)
            
            if part1 and part2 then
                local pos1, onScreen1 = WorldToViewport(part1.Position)
                local pos2, onScreen2 = WorldToViewport(part2.Position)
                
                if onScreen1 and onScreen2 then
                    lineData.Line.From = pos1
                    lineData.Line.To = pos2
                    lineData.Line.Color = Options.esp_skeleton_color and Options.esp_skeleton_color.Value or Color3.new(1, 1, 1)
                    lineData.Line.Visible = true
                    
                    if Toggles.esp_skeleton_outline.Value then
                        lineData.Outline.From = pos1
                        lineData.Outline.To = pos2
                        lineData.Outline.Visible = true
                    else
                        lineData.Outline.Visible = false
                    end
                else
                    lineData.Line.Visible = false
                    lineData.Outline.Visible = false
                end
            else
                lineData.Line.Visible = false
                lineData.Outline.Visible = false
            end
        end
    else
        for _, lineData in pairs(self.Drawings.Skeleton) do
            lineData.Line.Visible = false
            lineData.Outline.Visible = false
        end
    end
end

function ESP:SetVisible(visible)
    for key, drawing in pairs(self.Drawings) do
        if key == "Skeleton" then
            for _, lineData in pairs(drawing) do
                lineData.Line.Visible = false
                lineData.Outline.Visible = false
            end
        elseif typeof(drawing) == "table" and drawing.Visible ~= nil then
            drawing.Visible = false
        end
    end
end

function ESP:Destroy()
    if self.Connection then
        self.Connection:Disconnect()
    end
    for _, drawing in pairs(self.Drawings) do
        if typeof(drawing) == "table" and drawing.Remove then
            drawing:Remove()
        end
    end
end

--// Initialize ESP
local function InitializeESP()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            State.visuals.espObjects[player] = ESP.new(player)
        end
    end
    
    Players.PlayerAdded:Connect(function(player)
        if player ~= LocalPlayer then
            State.visuals.espObjects[player] = ESP.new(player)
        end
    end)
    
    Players.PlayerRemoving:Connect(function(player)
        if State.visuals.espObjects[player] then
            State.visuals.espObjects[player]:Destroy()
            State.visuals.espObjects[player] = nil
        end
    end)
end

--// Crosshair System
local function CreateCrosshair()
    local crosshair = {
        Top = CreateDrawing("Line", { Visible = false, Thickness = 2, Color = Color3.new(1, 1, 1) }),
        Bottom = CreateDrawing("Line", { Visible = false, Thickness = 2, Color = Color3.new(1, 1, 1) }),
        Left = CreateDrawing("Line", { Visible = false, Thickness = 2, Color = Color3.new(1, 1, 1) }),
        Right = CreateDrawing("Line", { Visible = false, Thickness = 2, Color = Color3.new(1, 1, 1) }),
        Center = CreateDrawing("Circle", { Visible = false, Radius = 2, Filled = true, Color = Color3.new(1, 1, 1) })
    }
    return crosshair
end

local crosshair = CreateCrosshair()

local function UpdateCrosshair()
    if not Toggles.crosshair_enabled or not Toggles.crosshair_enabled.Value then
        for _, line in pairs(crosshair) do
            line.Visible = false
        end
        return
    end
    
    local center = Camera.ViewportSize / 2
    local size = Options.crosshair_size and Options.crosshair_size.Value or 12
    local gap = Options.crosshair_gap and Options.crosshair_gap.Value or 4
    local color = Options.crosshair_color and Options.crosshair_color.Value or Color3.new(1, 1, 1)
    
    -- Top
    crosshair.Top.From = Vector2.new(center.X, center.Y - gap - size)
    crosshair.Top.To = Vector2.new(center.X, center.Y - gap)
    crosshair.Top.Color = color
    crosshair.Top.Visible = true
    
    -- Bottom
    crosshair.Bottom.From = Vector2.new(center.X, center.Y + gap)
    crosshair.Bottom.To = Vector2.new(center.X, center.Y + gap + size)
    crosshair.Bottom.Color = color
    crosshair.Bottom.Visible = true
    
    -- Left
    crosshair.Left.From = Vector2.new(center.X - gap - size, center.Y)
    crosshair.Left.To = Vector2.new(center.X - gap, center.Y)
    crosshair.Left.Color = color
    crosshair.Left.Visible = true
    
    -- Right
    crosshair.Right.From = Vector2.new(center.X + gap, center.Y)
    crosshair.Right.To = Vector2.new(center.X + gap + size, center.Y)
    crosshair.Right.Color = color
    crosshair.Right.Visible = true
    
    -- Center dot
    if Toggles.crosshair_dot and Toggles.crosshair_dot.Value then
        crosshair.Center.Position = center
        crosshair.Center.Color = color
        crosshair.Center.Visible = true
    else
        crosshair.Center.Visible = false
    end
end

--// World Visuals
local BloomEffect = Instance.new("BloomEffect")
BloomEffect.Parent = Lighting
BloomEffect.Enabled = false

local ColorCorrection = Instance.new("ColorCorrectionEffect")
ColorCorrection.Parent = Lighting
ColorCorrection.Enabled = false

local Atmosphere = Instance.new("Atmosphere")
Atmosphere.Parent = Lighting

local SunRays = Instance.new("SunRaysEffect")
SunRays.Parent = Lighting
SunRays.Enabled = false

local function UpdateWorldVisuals()
    -- Bloom
    if Toggles.bloom_enabled and Toggles.bloom_enabled.Value then
        BloomEffect.Enabled = true
        BloomEffect.Size = Options.bloom_size and Options.bloom_size.Value or 24
        BloomEffect.Intensity = Options.bloom_intensity and Options.bloom_intensity.Value or 0.4
        BloomEffect.Threshold = Options.bloom_threshold and Options.bloom_threshold.Value or 0.95
    else
        BloomEffect.Enabled = false
    end
    
    -- Color Correction
    if Toggles.color_correction_enabled and Toggles.color_correction_enabled.Value then
        ColorCorrection.Enabled = true
        ColorCorrection.TintColor = Options.color_correction_tint and Options.color_correction_tint.Value or Color3.new(1, 1, 1)
        ColorCorrection.Saturation = Options.color_correction_saturation and Options.color_correction_saturation.Value or 0
        ColorCorrection.Contrast = Options.color_correction_contrast and Options.color_correction_contrast.Value or 0
        ColorCorrection.Brightness = Options.color_correction_brightness and Options.color_correction_brightness.Value or 0
    else
        ColorCorrection.Enabled = false
    end
    
    -- Atmosphere
    if Toggles.atmosphere_enabled and Toggles.atmosphere_enabled.Value then
        Atmosphere.Color = Options.atmosphere_color and Options.atmosphere_color.Value or Color3.fromRGB(199, 170, 107)
        Atmosphere.Decay = Options.atmosphere_decay and Options.atmosphere_decay.Value or 0
        Atmosphere.Glare = Options.atmosphere_glare and Options.atmosphere_glare.Value or 0
        Atmosphere.Haze = Options.atmosphere_haze and Options.atmosphere_haze.Value or 0
        Atmosphere.Density = Options.atmosphere_density and Options.atmosphere_density.Value or 0.3
        Atmosphere.Offset = Options.atmosphere_offset and Options.atmosphere_offset.Value or 0
    else
        Atmosphere.Density = 0
    end
    
    -- Sun Rays
    if Toggles.sunrays_enabled and Toggles.sunrays_enabled.Value then
        SunRays.Enabled = true
        SunRays.Spread = Options.sunrays_spread and Options.sunrays_spread.Value or 0.5
        SunRays.Intensity = Options.sunrays_intensity and Options.sunrays_intensity.Value or 0.25
    else
        SunRays.Enabled = false
    end
    
    -- Lighting Technology

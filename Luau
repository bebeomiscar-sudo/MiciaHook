-- EMOTES
-- ═══════════════════════════════════════════
local EmoteState = { currentTrack = nil, animObject = nil, playing = false }

local function stopEmote()
    EmoteState.playing = false
    if EmoteState.currentTrack then
        pcall(function()
            EmoteState.currentTrack:Stop()
            EmoteState.currentTrack:Destroy()
        end)
        EmoteState.currentTrack = nil
    end
    if EmoteState.animObject then
        pcall(function() EmoteState.animObject:Destroy() end)
        EmoteState.animObject = nil
    end
end

local function playEmote(animId, speed)
    stopEmote()
    if not animId or animId == "" then return end
    local char = LP.Character
    if not char then return end
    local hum = char:FindFirstChildWhichIsA("Humanoid")
    if not hum then return end

    local cleanId = tostring(animId):gsub("%s+", "")
    if not cleanId:find("rbxassetid://") then cleanId = "rbxassetid://" .. cleanId end

    local animation = Instance.new("Animation")
    animation.AnimationId = cleanId
    EmoteState.animObject = animation

    -- Use Animator instead of deprecated Humanoid:LoadAnimation
    local animator = hum:FindFirstChildOfClass("Animator")
    if not animator then
        animator = Instance.new("Animator", hum)
    end

    for _, track in next, animator:GetPlayingAnimationTracks() do
        track:Stop()
    end

    local success, track = pcall(function()
        return animator:LoadAnimation(animation)
    end)
    if success and track then
        track.Priority = Enum.AnimationPriority.Action4
        track:Play()
        track:AdjustSpeed(speed or 1)
        EmoteState.currentTrack = track
        EmoteState.playing = true
        track.Stopped:Connect(function()
            if CFG.Emote.On and CFG.Emote.Loop and EmoteState.playing then
                task.wait(0.05)
                if CFG.Emote.On then playEmote(CFG.Emote.AnimID, CFG.Emote.Speed) end
            end
        end)
    end
end

-- ═══════════════════════════════════════════
-- PROJECTILE CHECK
-- ═══════════════════════════════════════════
local function checkProjectiles()
    if not CFG.Void.ProjectileMimic or not Desync.realCFrame then return false end
    local myPos = Desync.realCFrame.Position
    local range = CFG.Void.DetectionRange
    local params = OverlapParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { character }

    local ok, parts = pcall(function()
        return workspace:GetPartBoundsInRadius(myPos, range, params)
    end)
    if not ok or not parts then return false end

    for _, part in ipairs(parts) do
        if not part:IsDescendantOf(character) then
            local vel = part.AssemblyLinearVelocity
            if vel.Magnitude > 80 then
                local toUs = myPos - part.Position
                if toUs.Magnitude > 1 and toUs.Unit:Dot(vel.Unit) > 0.4 then
                    return true
                end
            end
        end
    end
    return false
end


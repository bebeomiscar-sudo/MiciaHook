-- ★★★ CORE: ANTI-UE VOIDSPAM ENGINE ★★★
--━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

--[[
 ┌─────────────────────────────────────────────────────────────────┐
 │                UNNAMED ENHANCEMENTS RAGEBOT                     │
 │                                                                 │
 │  FEATURE           │  WHAT IT DOES           │  OUR COUNTER     │
 │ ───────────────────┼─────────────────────────┼──────────────────│
 │ Voidspam           │ They TP away & back     │ We cycle 2x     │
 │ (their own)        │ to dodge our shots       │ faster than      │
 │                    │                          │ them + ghosts    │
 │ ───────────────────┼─────────────────────────┼──────────────────│
 │ Hide: 0.01s-1s     │ How long they stay       │ Our pulse =      │
 │                    │ in void position         │ 0.003s-0.04s     │
 │                    │                          │ ALWAYS faster    │
 │ ───────────────────┼─────────────────────────┼──────────────────│
 │ Attack: 0.01s-1s   │ How long they come       │ Timing Desync    │
 │                    │ back to shoot            │ randomizes WHEN  │
 │                    │                          │ we're "home"     │
 │ ───────────────────┼─────────────────────────┼──────────────────│
 │ Projectile Mimic   │ Predicts trajectory      │ Velocity Spoof   │
 │                    │ of our hitbox movement   │ + zero-correl    │
 │                    │ to aim projectiles       │ random positions │
 │ ───────────────────┼─────────────────────────┼──────────────────│
 │ Shoot Attn Range   │ Lock-on range (1 or 2)   │ Ghost positions  │
 │ 1 to 2             │ How far they can target  │ at Range Escape  │
 │                    │                          │ distance + home  │
 │                    │                          │ shuffle           │
 └─────────────────────────────────────────────────────────────────┘
]]

-- ── INTENSITY PRESETS ──

local IntensityScales = {
    [1] = { ghostMul = 0.5, jitMul = 0.7, spiralMul = 0.8 },
    [2] = { ghostMul = 0.8, jitMul = 1.0, spiralMul = 1.0 },
    [3] = { ghostMul = 1.0, jitMul = 1.3, spiralMul = 1.2 },
    [4] = { ghostMul = 1.3, jitMul = 1.7, spiralMul = 1.5 },
    [5] = { ghostMul = 1.6, jitMul = 2.2, spiralMul = 2.0 },
}

local function getIntensity()
    return IntensityScales[CFG.Void.DesyncIntensity] or IntensityScales[3]
end

-- ── MODE MULTIPLIERS ──

local function getModeM()
    local m = CFG.Void.Mode
    if m == "Aggressive" then     return 2.2, 2.8, 1.5
    elseif m == "Erratic" then    return 1.8, 2.0, 0.3
    elseif m == "Spiral" then     return 0.8, 1.0, 2.5
    else                          return 1.4, 1.6, 1.2  end -- Adaptive
end

-- ── ANTI-PROJECTILE: VELOCITY DECORRELATOR ──
-- Creates a fake velocity vector that has ZERO correlation to actual movement
-- Projectile Mimic uses velocity to lead shots — spoofed velocity = missed shots

local function spoofVelocity(root)
    if not CFG.Void.VelocitySpoof then return end
    if not root then return end

    -- Generate completely random velocity direction
    local fakeVel = Vector3.new(
        (rng() - 0.5) * 200,
        (rng() - 0.5) * 100,
        (rng() - 0.5) * 200
    )
    VoidState.spoofedVel = fakeVel

    -- Apply to the root's AssemblyLinearVelocity
    -- This makes any velocity-reading resolver get garbage data
    pcall(function()
        root.AssemblyLinearVelocity = fakeVel
    end)
end

-- ── GHOST POSITION GENERATOR ──
-- Creates N decoy positions spread around to confuse Attention Range targeting

local function generateGhostPositions(origin, t, count)
    local positions = {}
    local iScale = getIntensity()
    local escRange = CFG.Void.RangeEscape * iScale.ghostMul

    for i = 1, count do
        -- Each ghost at a unique angle (golden angle spacing)
        local angle = i * 2.399 + t * (0.5 + i * 0.13)

        -- Varying distances — some within range, some outside
        -- This forces their Attention Range to flip between ghosts
        local dist
        if i % 3 == 0 then
            -- Inside range (bait ghost)
            dist = rng(1, escRange * 0.4)
        else
            -- Outside range (escape ghost)
            dist = escRange + rng(0, escRange * 0.5)
        end

        -- Y: unique incommensurate frequency per ghost
        local yOff = math.sin(t * (5.3 + i * 4.1)) * CFG.Void.YJitter * 0.5
                   + (rng() - 0.5) * CFG.Void.YJitter * 0.4

        local pos = Vector3.new(
            origin.X + math.cos(angle) * dist + (rng() - 0.5) * 4,
            origin.Y + yOff,
            origin.Z + math.sin(angle) * dist + (rng() - 0.5) * 4
        )
        table.insert(positions, pos)
    end

    return positions
end

-- ── AWAY POSITION CALCULATOR (enhanced for anti-UE) ──

local function calcAwayPos(origin, t, phaseIdx)
    local dist    = CFG.Void.TPDistance
    local yJit    = CFG.Void.YJitter
    local xzJit   = CFG.Void.XZJitter
    local spiralR = CFG.Void.SpiralRad
    local spiralS = CFG.Void.SpiralSpd

    local yM, xzM, spM = getModeM()
    local iScale = getIntensity()

    local effY   = yJit  * yM  * iScale.jitMul
    local effXZ  = xzJit * xzM * iScale.jitMul
    local effSpR = spiralR * spM * iScale.spiralMul
    local effSpS = spiralS * spM

    -- Direction: golden angle + time rotation
    local baseAngle = phaseIdx * 2.399 + t * 0.37 + rng() * 0.3

    local farX = origin.X + math.cos(baseAngle) * dist
    local farZ = origin.Z + math.sin(baseAngle) * dist

    -- Y: 5 incommensurate frequencies
    local yOff = math.sin(t * 7.3) * effY * 0.25
              + math.sin(t * 13.7) * effY * 0.25
              + math.sin(t * 23.1) * effY * 0.15
              + math.sin(t * 37.9) * effY * 0.15
              + math.sin(t * 53.3) * effY * 0.1
              + (rng() - 0.5) * effY * 0.8

    -- Anti-projectile: NO velocity correlation
    -- Position offset is random PER FRAME, not based on previous position
    if CFG.Void.AntiProjectile then
        yOff = yOff + (rng() - 0.5) * effY * 1.5
        farX = farX + (rng() - 0.5) * effXZ * 3
        farZ = farZ + (rng() - 0.5) * effXZ * 3
    end

    -- Spiral at destination
    local spiral = t * effSpS + phaseIdx * 1.047
    local sX = math.cos(spiral) * effSpR
    local sZ = math.sin(spiral) * effSpR

    -- Random jitter
    local jX = (rng() - 0.5) * effXZ * 2
    local jZ = (rng() - 0.5) * effXZ * 2

    -- Mode-specific
    local mode = CFG.Void.Mode
    if mode == "Aggressive" then
        jX = jX * 2.5; jZ = jZ * 2.5
        yOff = yOff + (rng() > 0.5 and effY or -effY)
    elseif mode == "Erratic" then
        local rA = rng() * math.pi * 2
        local rD = rng() * effXZ * 3
        sX = math.cos(rA) * rD; sZ = math.sin(rA) * rD
        yOff = (rng() - 0.5) * effY * 4
    elseif mode == "Spiral" then
        sX = sX + math.cos(t * effSpS * 1.7) * effSpR * 0.6
        sZ = sZ + math.sin(t * effSpS * 1.7) * effSpR * 0.6
    end

    -- Micro
    local mX = (rng() - 0.5) * 3.5
    local mY = (rng() - 0.5) * 2.8
    local mZ = (rng() - 0.5) * 3.5

    return Vector3.new(farX + sX + jX + mX, origin.Y + yOff + mY, farZ + sZ + jZ + mZ)
end

-- ── SCATTER POSITION (varying distance) ──

local function calcScatterPos(origin, t, phaseIdx, distMul)
    local baseDist = CFG.Void.TPDistance * distMul
    local yJit  = CFG.Void.YJitter
    local xzJit = CFG.Void.XZJitter
    local yM, xzM, spM = getModeM()
    local iScale = getIntensity()

    local angle = phaseIdx * 2.399 + rng() * 0.8 + t * 0.2
    local posX = origin.X + math.cos(angle) * baseDist
    local posZ = origin.Z + math.sin(angle) * baseDist

    local yOff = math.sin(t * 7.3 + phaseIdx) * yJit * yM * iScale.jitMul * 0.4
              + math.sin(t * 17.1 + phaseIdx * 2) * yJit * yM * iScale.jitMul * 0.3
              + (rng() - 0.5) * yJit * yM * iScale.jitMul

    if CFG.Void.AntiProjectile then
        yOff = yOff + (rng() - 0.5) * yJit * 1.5
        posX = posX + (rng() - 0.5) * xzJit * 3
        posZ = posZ + (rng() - 0.5) * xzJit * 3
    end

    local jX = (rng() - 0.5) * xzJit * xzM * iScale.jitMul * 2
    local jZ = (rng() - 0.5) * xzJit * xzM * iScale.jitMul * 2

    return Vector3.new(posX + jX + (rng()-0.5)*3, origin.Y + yOff + (rng()-0.5)*2, posZ + jZ + (rng()-0.5)*3)
end

-- ── HOME POSITION WITH SHUFFLE ──

local function getHomePosition(savedCFrame)
    if not CFG.Void.HomeShuffle then
        return savedCFrame
    end

    local range = CFG.Void.HomeShuffleRange

    -- Rotate shuffle position each cycle
    VoidState.homeShuffleAngle = VoidState.homeShuffleAngle + 0.7 + rng() * 0.5
    local angle = VoidState.homeShuffleAngle
    local dist  = rng(0.5, range)

    local offset = Vector3.new(
        math.cos(angle) * dist,
        (rng() - 0.5) * range * 0.4,
        math.sin(angle) * dist
    )

    return savedCFrame + offset
end

-- ── TPS CALCULATOR ──

local function calcTPS()
    local now = tick()
    table.insert(VoidState.tpsTracker, now)
    while #VoidState.tpsTracker > 0 and (now - VoidState.tpsTracker[1]) > 1 do
        table.remove(VoidState.tpsTracker, 1)
    end
    return #VoidState.tpsTracker
end

-- ══════════════════════════════════════════════
-- MAIN HEARTBEAT — THE ENGINE
-- ══════════════════════════════════════════════

local monitorTick = 0

table.insert(ActiveConnections, RunService.Heartbeat:Connect(function(dt)
    if not CFG.Void.On then
        if VoidState.active and VoidState.savedCFrame then
            local mr = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            if mr then mr.CFrame = VoidState.savedCFrame end
        end
        VoidState.active = false
        VoidState.phase = 0
        VoidState.accumulator = 0
        return
    end

    local myChar = LP.Character
    if not myChar then return end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    local myHum = myChar:FindFirstChildOfClass("Humanoid")
    if myHum and myHum.Health <= 0 then
        if VoidState.savedCFrame then myRoot.CFrame = VoidState.savedCFrame end
        return
    end

    VoidState.active = true
    VoidState.clock = VoidState.clock + dt
    VoidState.accumulator = VoidState.accumulator + dt

    if VoidState.accumulator < CFG.Void.PulseRate then return end
    VoidState.accumulator = 0

    local t = tick()
    local origin = myRoot.Position

    -- ─── VELOCITY SPOOF (every pulse) ───
    if CFG.Void.VelocitySpoof then
        spoofVelocity(myRoot)
    end

    -- ═══════════════════════
    -- METHOD 1: 2K TP
    -- ═══════════════════════
    if CFG.Void.Method == "2KTP" then
        local p = VoidState.phase % 6

        if p == 0 then
            -- ── SAVE HOME ──
            VoidState.savedCFrame = myRoot.CFrame
            VoidState.homeBase = myRoot.CFrame.Position
            VoidState.cycleID = VoidState.cycleID + 1

        elseif p == 1 or p == 3 or p == 5 then
            -- ── AWAY PHASES (with ghost stacking) ──
            local awayIdx = (p == 1 and 0) or (p == 3 and 1) or 2
            local awayPos = calcAwayPos(VoidState.homeBase or origin, t, awayIdx)

            -- Ghost stacking: set multiple CFrames before final
            if CFG.Void.GhostStack then
                local ghosts = generateGhostPositions(
                    VoidState.homeBase or origin, t, CFG.Void.GhostCount
                )
                VoidState.ghostsThisFrame = #ghosts
                for _, gPos in ipairs(ghosts) do
                    myRoot.CFrame = CFrame.new(gPos)
                end
            end

            -- Final position (this is what renders)
            myRoot.CFrame = CFrame.new(awayPos)
            VoidState.tpCount = VoidState.tpCount + 1
            calcTPS()

        elseif p == 2 or p == 4 then
            -- ── HOME PHASES ──

            -- Timing Desync: randomly SKIP going home
            if CFG.Void.TimingDesync then
                local roll = rngInt(1, 100)
                if roll <= CFG.Void.SkipChance then
                    -- SKIP: don't go home, go to another away position instead
                    VoidState.skippedFrames = VoidState.skippedFrames + 1
                    local extraAway = calcAwayPos(VoidState.homeBase or origin, t, rngInt(3, 8))

                    if CFG.Void.GhostStack then
                        local ghosts = generateGhostPositions(
                            VoidState.homeBase or origin, t, math.max(2, CFG.Void.GhostCount - 1)
                        )
                        for _, gPos in ipairs(ghosts) do
                            myRoot.CFrame = CFrame.new(gPos)
                        end
                    end

                    myRoot.CFrame = CFrame.new(extraAway)
                    VoidState.tpCount = VoidState.tpCount + 1
                    calcTPS()

                    VoidState.phase = VoidState.phase + 1
                    return -- Skip home entirely
                end
            end

            -- Normal home return (with shuffle)
            if VoidState.savedCFrame then
                -- Ghost stack at random positions before going home
                if CFG.Void.GhostStack then
                    local ghosts = generateGhostPositions(
                        VoidState.homeBase or origin, t, math.max(2, CFG.Void.GhostCount - 1)
                    )
                    for _, gPos in ipairs(ghosts) do
                        myRoot.CFrame = CFrame.new(gPos)
                    end
                end

                local homeCF = getHomePosition(VoidState.savedCFrame)
                myRoot.CFrame = homeCF
            end
        end

        VoidState.phase = VoidState.phase + 1

    -- ═══════════════════════
    -- METHOD 2: SCATTER
    -- ═══════════════════════
    elseif CFG.Void.Method == "Scatter" then
        local p = VoidState.phase % 10

        if p == 0 then
            -- SAVE
            VoidState.savedCFrame = myRoot.CFrame
            VoidState.homeBase = myRoot.CFrame.Position
            VoidState.cycleID = VoidState.cycleID + 1

        elseif p == 9 then
            -- HOME RETURN
            if CFG.Void.TimingDesync and rngInt(1, 100) <= CFG.Void.SkipChance then
                -- Skip home — extra scatter instead
                VoidState.skippedFrames = VoidState.skippedFrames + 1
                local pos = calcScatterPos(VoidState.homeBase or origin, t, rngInt(6, 12), rng(0.4, 1.0))
                if CFG.Void.GhostStack then
                    local ghosts = generateGhostPositions(VoidState.homeBase or origin, t, CFG.Void.GhostCount)
                    for _, gPos in ipairs(ghosts) do myRoot.CFrame = CFrame.new(gPos) end
                end
                myRoot.CFrame = CFrame.new(pos)
                calcTPS()
                VoidState.phase = VoidState.phase + 1
                return
            end

            if CFG.Void.GhostStack then
                local ghosts = generateGhostPositions(VoidState.homeBase or origin, t, CFG.Void.GhostCount)
                for _, gPos in ipairs(ghosts) do myRoot.CFrame = CFrame.new(gPos) end
            end
            local homeCF = getHomePosition(VoidState.savedCFrame)
            myRoot.CFrame = homeCF

        else
            -- SCATTER PHASES (1-8)
            local distMuls = {1.0, 0.6, 0.3, 1.0, 0.5, 0.8, 0.4, 0.9}
            local dm = distMuls[p] or rng(0.3, 1.0)
            local pos = calcScatterPos(VoidState.homeBase or origin, t, p, dm)

            if CFG.Void.GhostStack then
                local ghosts = generateGhostPositions(VoidState.homeBase or origin, t, CFG.Void.GhostCount)
                VoidState.ghostsThisFrame = #ghosts
                for _, gPos in ipairs(ghosts) do myRoot.CFrame = CFrame.new(gPos) end
            end

            myRoot.CFrame = CFrame.new(pos)
            VoidState.tpCount = VoidState.tpCount + 1
            calcTPS()
        end

        VoidState.phase = VoidState.phase + 1
    end

    -- ── UPDATE MONITOR (every 25 cycles) ──
    monitorTick = monitorTick + 1
    if monitorTick % 25 == 0 then
        local method = CFG.Void.Method
        monMethodV.Text = method == "2KTP" and "2K TELEPORT" or "SCATTER"
        monMethodV.TextColor3 = method == "2KTP" and C.cyan or C.orange

        local tps = #VoidState.tpsTracker
        monTPSV.Text = tostring(tps) .. "/s"
        monTPSV.TextColor3 = tps > 30 and C.green or tps > 15 and C.orange or C.red

        monGhostsV.Text = CFG.Void.GhostStack and (tostring(CFG.Void.GhostCount) .. "/frame") or "OFF"
        monGhostsV.TextColor3 = CFG.Void.GhostStack and C.purple or C.dim

        monSkipsV.Text = tostring(VoidState.skippedFrames)
        monSkipsV.TextColor3 = CFG.Void.TimingDesync and C.orange or C.dim

        -- Counter status indicators
        local pulseMs = CFG.Void.PulseRate * 1000
        monAntiHideV.Text = string.format("● ANTI-HIDE/ATTACK: %.1fms pulse (< their 10ms)", pulseMs)
        monAntiHideV.TextColor3 = pulseMs < 10 and C.green or C.orange

        monAntiProjV.Text = "● ANTI-PROJ MIMIC: " .. (CFG.Void.AntiProjectile and "ACTIVE" or "OFF")
            .. (CFG.Void.VelocitySpoof and " + VEL SPOOF" or "")
        monAntiProjV.TextColor3 = CFG.Void.AntiProjectile and C.green or C.dim

        monAntiRangeV.Text = "● ANTI-ATTN RANGE: " .. (CFG.Void.GhostStack and (CFG.Void.GhostCount .. " ghosts") or "OFF")
            .. " + " .. CFG.Void.RangeEscape .. "s escape"
        monAntiRangeV.TextColor3 = CFG.Void.GhostStack and C.green or C.dim

        monAntiVoidV.Text = "● ANTI-THEIR VOID: " .. tps .. " TPS"
            .. (CFG.Void.TimingDesync and " + timing desync" or "")
        monAntiVoidV.TextColor3 = tps > 20 and C.green or C.orange
    end
end))


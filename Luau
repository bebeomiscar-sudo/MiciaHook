-- GUN MODS (from ItemLibrary)
-- ═══════════════════════════════════════════
local gunSaved = {}
local SKIP_GUNS = {Sniper=true, Crossbow=true, Bow=true, RPG=true}

local function patchGuns()
    if not mItemLib then return end
    local ok, items = pcall(function() return mItemLib.Items end)
    if not ok or not items then return end
    for name, data in pairs(items) do
        if type(data)~="table" or SKIP_GUNS[name] then continue end
        if not gunSaved[name] then
            gunSaved[name] = {
                ShootSpread   = data.ShootSpread,
                ShootAccuracy = data.ShootAccuracy,
                ShootRecoil   = data.ShootRecoil,
                ShootCooldown = data.ShootCooldown,
            }
        end
        local s = gunSaved[name]
        if data.ShootSpread   then data.ShootSpread   = GN.noSpread  and 0    or s.ShootSpread   end
        if data.ShootAccuracy then data.ShootAccuracy = GN.noSpread  and 0    or s.ShootAccuracy end
        if data.ShootRecoil   then data.ShootRecoil   = GN.noRecoil  and 0    or s.ShootRecoil   end
        if data.ShootCooldown then data.ShootCooldown = GN.fast       and 0.05 or s.ShootCooldown end
    end

local SA_PEEK_OFFSETS_RB = {
    Vector3.new(0,12,0),Vector3.new(0,16,0),Vector3.new(0,20,0),Vector3.new(0,24,0),
    Vector3.new(0,28,0),Vector3.new(0,32,0),Vector3.new(0,36,0),Vector3.new(0,40,0),
}
local ray_params_sa = RaycastParams.new()

local function sa_getClosest()
    if not LP.Character or not LP.Character:FindFirstChild("HumanoidRootPart") then return nil,nil end
    local target,tchar,dist = nil,nil,RageCFG.MaxDist
    for _,v in next,players:GetPlayers() do
        if v==LP then continue end
        if RageCFG.TeamCheck and isSameTeamRivals(v) then continue end
        if not v.Character or not v.Character:FindFirstChild("Head") then continue end
        local hum=v.Character:FindFirstChildOfClass("Humanoid"); if not hum or hum.Health<=0 then continue end
        local mag=(LP.Character.HumanoidRootPart.Position-v.Character.Head.Position).Magnitude
        if mag<dist then dist=mag; target=v.Character.Head; tchar=v.Character end
    end
    return target,tchar
end

local function sa_calcPoint(origin, target_pos, target_char)
    ray_params_sa.FilterDescendantsInstances={LP.Character,target_char}; ray_params_sa.FilterType=Enum.RaycastFilterType.Exclude
    if not RageCFG.VisibleCheck then return origin,nil end
    if not ws:Raycast(origin, target_pos-origin, ray_params_sa) then return origin,nil end
    for _,offset in next,SA_PEEK_OFFSETS_RB do
        local sp=origin+offset
        if not ws:Raycast(sp, target_pos-sp, ray_params_sa) then return sp,offset.Y end
    end
    return nil,nil
end


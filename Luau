local function hookPlayerHealth(player)
    if player == LP then return end
    local function connectChar(char)
        local hum  = char:FindFirstChild("Humanoid"); if not hum then return end
        local head = char:FindFirstChild("Head"); if not head then return end
        local lastHP = hum.Health
        if hmConns[player] then xpcall(function() hmConns[player]:Disconnect() end, function(err) end) end
        hmConns[player] = hum.HealthChanged:Connect(function(newHP)
            local dmg = lastHP - newHP
            if dmg > 0.5 then
                if S.Misc.HitMarker.Enabled then task.spawn(spawnMarker, head, dmg) end
                if S.Misc.HitSound.Enabled  then task.spawn(playSound, S.Misc.HitSound.Sound) end
                if S.Misc.HitNotify.Enabled and Library then
                    Library:Notify(
                        S.Misc.HitNotify.Text
                            :gsub("{name}", player.DisplayName)
                            :gsub("{dmg}",  math.floor(dmg))
                            :gsub("{hp}",   math.floor(hum.Health))
                            :gsub("{maxhp}",math.floor(hum.MaxHealth)),
                        S.Misc.HitNotify.Duration
                    )
                end
                if newHP <= 0 then
                    if S.Misc.KillNotify.Enabled and Library then
                        Library:Notify(
                            S.Misc.KillNotify.Text:gsub("{name}", player.DisplayName),
                            S.Misc.KillNotify.Duration
                        )
                    end
                    if S.Misc.KillSay.Enabled then
                        task.delay(S.Misc.KillSay.Delay, function()
                            local msg = S.Misc.KillSay.Text:gsub("{name}", player.DisplayName)
                            xpcall(function()
                                game:GetService("TextChatService").TextChannels.RBXGeneral:SendAsync(msg)
                            end, function(err)
                                xpcall(function()
                                    local ce = game:GetService("ReplicatedStorage"):FindFirstChild("DefaultChatSystemChatEvents", true)
                                    if ce then
                                        local sm = ce:FindFirstChild("SayMessageRequest")
                                        if sm then sm:FireServer(msg, "All") end
                                    end
                                end, function(err2) end)
                            end)
                        end)
                    end
                end
            end
            lastHP = newHP
        end)
    end
    if player.Character then
        task.spawn(function() task.wait(0.3); connectChar(player.Character) end)
    end
    player.CharacterAdded:Connect(function(c)
        task.wait(0.3); connectChar(c)
    end)
end

for _, p in pairs(Players:GetPlayers()) do hookPlayerHealth(p) end
Players.PlayerAdded:Connect(hookPlayerHealth)

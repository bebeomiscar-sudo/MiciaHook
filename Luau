-- AIMBOT
-- ═══════════════════════════════════════════
local function getAimbotTarget()
    local c=getScreenCenter(); local bp,bd=nil,CFG.Aimbot.FOV
    for _,p in ipairs(Players:GetPlayers()) do if p==LP then continue end
        if CFG.Aimbot.TeamCheck and isSameTeam(p) then continue end
        local ch=p.Character; if not ch then continue end
        local h=ch:FindFirstChildOfClass("Humanoid"); if not h or h.Health<=0 then continue end
        local part=ch:FindFirstChild(CFG.Aimbot.AimHead and "Head" or "HumanoidRootPart")
        if not part then continue end
        if CFG.Aimbot.VisibleCheck and not isVisible(part) then continue end
        local sp,on=camera:WorldToScreenPoint(part.Position); if not on then continue end
        local d=(Vector2.new(sp.X,sp.Y)-c).Magnitude; if d<bd then bd=d; bp=part end
    end; return bp
end


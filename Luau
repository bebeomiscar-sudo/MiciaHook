            [utf8.char(2)]=tp,[utf8.char(3)]=util_mod:EncodeCFrame(tp.CFrame:ToObjectSpace(CFrame.new(tp.Position))),
        }
        pcall(function() rs.Remotes.Replication.Fighter.UseItem:FireServer(item:Get("ObjectID"),enums_mod:ToEnum("StartShooting"),cd,nil) end)
    end)
end


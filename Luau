local lastAST,tMC,autoSaveClock=0,0,0

RunService:BindToRenderStep("RivalsDesync",Enum.RenderPriority.Camera.Value-1,function()
    if not Desync.active or not Desync.realCFrame or not humanoidRootPart or not humanoidRootPart.Parent then return end
    humanoidRootPart.CFrame=Desync.realCFrame
end)

table.insert(ActiveConnections,RunService.RenderStepped:Connect(function(dt)
    camera=workspace.CurrentCamera;local center=getScreenCenter()
    if aimbotFOVCircle then pcall(function() aimbotFOVCircle.Position=center;aimbotFOVCircle.Radius=CFG.Aimbot.FOV;aimbotFOVCircle.Visible=CFG.Aimbot.ShowFOV and CFG.Aimbot.On end) end
    if silentFOVCircle then pcall(function() silentFOVCircle.Position=center;silentFOVCircle.Radius=silentGetEffectiveFOV();silentFOVCircle.Visible=CFG.Silent.ShowFOV and CFG.Silent.On end) end

    -- Aimbot
    if CFG.Aimbot.On and CameraController and isKeyActive("Aimbot",CFG.Aimbot.Key,CFG.Aimbot.KeyMode) then
        local tp=getAimbotTarget();if tp then pcall(function() local cp=camera.CFrame.Position;local ap=CFG.Aimbot.ClosestPos and getClosestPointOnPart(tp) or tp.Position;local du=(ap-cp).Unit;local tP=math.asin(du.Y);local tY=math.atan2(-du.X,-du.Z);local ba=CFG.Aimbot.Smoothness/100;local ya=ba*(CFG.Aimbot.XSmooth/100);local pa=ba*(CFG.Aimbot.YSmooth/100);if isAirborne(tp.Parent) then local jf=CFG.Aimbot.JumpSmooth/100;ya=ya*jf;pa=pa*jf end;ya=math.clamp(ya,0,1);pa=math.clamp(pa,0,1);local cur=CameraController.Rotation;CameraController:SetRotation(Vector2.new(cur.X+(tP-cur.X)*pa,cur.Y+angleDiff(cur.Y,tY)*ya)) end) end
    end

    -- Silent auto-shoot
    if CFG.Silent.On and CFG.Silent.AutoShoot and isKeyActive("Silent",CFG.Silent.Key,CFG.Silent.KeyMode) then local now=tick();if now-lastAST>=0.1 then if silentFindTarget() then lastAST=now;pcall(function() mouse1click() end) end end end

    -- Triggerbot
    tMC=tMC+dt
    if CFG.Trigger.On and isKeyActive("Trigger",CFG.Trigger.Key,CFG.Trigger.KeyMode) then
        local tgt=getTriggerTarget();if tgt then if not TriggerState.waiting then TriggerState.waiting=true;TriggerState.delayTimer=CFG.Trigger.Delay/1000 end;TriggerState.delayTimer=TriggerState.delayTimer-dt;if TriggerState.delayTimer<=0 then TriggerState.cooldownTimer=TriggerState.cooldownTimer-dt;if TriggerState.cooldownTimer<=0 then simClick();TriggerState.cooldownTimer=CFG.Trigger.BurstMs/1000 end end;if tMC>=0.1 then trigStatusV.Text=TriggerState.delayTimer>0 and "STATUS: WAITING" or "STATUS: FIRING";trigStatusV.TextColor3=TriggerState.delayTimer>0 and C.orange or C.green;trigDelayV.Text=string.format("DELAY: %.0fms",math.max(0,TriggerState.delayTimer*1000)) end
        else TriggerState.waiting=false;TriggerState.delayTimer=0;TriggerState.cooldownTimer=0;if tMC>=0.1 then trigStatusV.Text="SCANNING";trigStatusV.TextColor3=C.dim end end
    else TriggerState.waiting=false;if tMC>=0.1 then trigStatusV.Text=CFG.Trigger.On and "KEY INACTIVE" or "IDLE";trigStatusV.TextColor3=C.dim;trigDelayV.Text="--" end end
    if tMC>=0.1 then tMC=0 end

    -- ESP update
    updateESP()

    -- Ragebot status update
    if RagebotState.active then
        rageStatusDot.BackgroundColor3=C.red
        local elapsed=math.floor(tick()-RagebotState.actionTime)
        rageStatusLabel.Text="Killing: "..RagebotState.targetName.." ("..elapsed.."s)"
    end

    -- Auto-save
    autoSaveClock=autoSaveClock+dt
    if CFG.Config.AutoSave and autoSaveClock>=30 then
        autoSaveClock=0
        local n=configInput.getText();if n~="" then saveConfig(n) end
    end
end))


-- ANTI-CHEAT BYPASS
-- ═══════════════════════════════════════════
local acList = {
    "anticheat","ac_","_ac","anticheats","fairplay",
    "detection","integrity","security","validator",
}

local function applyBypass()
    coroutine.wrap(function()
        pcall(function()
            local function blockScript(obj)
                if obj:IsA("LocalScript") or obj:IsA("ModuleScript") then
                    local n = obj.Name:lower()
                    for _, ac in pairs(acList) do
                        if n:find(ac) then
                            pcall(function() obj.Disabled = true end)
                            break
                        end
                    end
                end
            end
            for _, obj in pairs(game:GetDescendants()) do blockScript(obj) end
            game.DescendantAdded:Connect(blockScript)
        end)
        pcall(function()
            local networkClient = game:GetService("NetworkClient")
            if networkClient then
                networkClient.ChildAdded:Connect(function(child)
                    local n = child.Name:lower()
                    if n:find("monitor") or n:find("reporter") or n:find("logger") then
                        pcall(function() child:Destroy() end)
                    end
                end)
            end
        end)
    end)()
end

applyBypass()


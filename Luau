-- LEGACY AIMBOT (PC ADS - kept for fans)
-- ═══════════════════════════════════════════
local legacyLockTimer    = 0
local legacyLockedTarget = nil
local legacyReactionTimer = 0
local legacyInReaction    = false

local function legacyResolveAimPart(char, dist)
    if AimbotCFG.AimPart == "Head" then
        return char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
    end
    if AimbotCFG.AimPart == "Body" then
        return char:FindFirstChild("UpperTorso") or char:FindFirstChild("HumanoidRootPart")
    end
    if AimbotCFG.AimPart == "Changing" then
        local mult  = math.max(AimbotCFG.ChangingHeadMult, 0.0001)
        local ratio = dist / AimbotCFG.DistanceDivider / mult
        if ratio > 1 then
            return char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
        else
            return char:FindFirstChild("UpperTorso") or char:FindFirstChild("HumanoidRootPart")
        end
    end
    return char:FindFirstChild("HumanoidRootPart")
end

local function legacyIsTargetValid(part)
    if not part or not part.Parent then return false end
    local hum = part.Parent:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    if AimbotCFG.VisibleCheck and not isVisible(part) then return false end
    if AimbotCFG.TeamCheck then
        local p = Players:GetPlayerFromCharacter(part.Parent)
        if p and isSameTeam(p) then return false end
    end
    return true
end

local function legacyScorePlayer(p, camPos)
    local ch  = p.Character; if not ch then return nil, -math.huge end
    local h   = ch:FindFirstChildOfClass("Humanoid")
    if not h or h.Health <= 0 then return nil, -math.huge end
    local hrp = ch:FindFirstChild("HumanoidRootPart"); if not hrp then return nil, -math.huge end
    if AimbotCFG.TeamCheck and isSameTeam(p) then return nil, -math.huge end
    if isPlayerImmune(p) then return nil, -math.huge end
    local dist   = (camPos - hrp.Position).Magnitude
    local sp, on = camera:WorldToScreenPoint(hrp.Position)
    if not on then return nil, -math.huge end
    local screenDist = (Vector2.new(sp.X, sp.Y) - getScreenCenter()).Magnitude
    if screenDist > AimbotCFG.MaxFOV then return nil, -math.huge end
    if AimbotCFG.VisibleCheck and not isVisible(hrp) then return nil, -math.huge end
    local score
    if     AimbotCFG.TargetPriority == "Closest"   then score = -dist
    elseif AimbotCFG.TargetPriority == "Furthest"  then score = dist
    elseif AimbotCFG.TargetPriority == "Lowest HP" then score = -(h.Health / h.MaxHealth) * 1000
    end
    return hrp, score
end

local function legacyFindTarget()
    local camPos   = camera.CFrame.Position
    local bestPart, bestScore = nil, -math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LP then continue end
        local part, score = legacyScorePlayer(p, camPos)
        if part and score > bestScore then
            bestScore = score
            local dist = (camPos - part.Position).Magnitude
            bestPart   = legacyResolveAimPart(p.Character, dist) or part
        end
    end
    return bestPart
end

local function legacyApplyMove(dt, targetPart)
    if not CameraController then return end
    local center = getScreenCenter()
    local sp, on = camera:WorldToViewportPoint(targetPart.Position)
    if not on or sp.Z < 0 then return end
    local screenTarget = Vector2.new(sp.X, sp.Y)
    local delta        = screenTarget - center
    local ppr          = camera.ViewportSize.Y / (2 * math.tan(math.rad(camera.FieldOfView / 2)))
    local sensScale    = SensitivityCFG.Sensitivity / 100
    local adsScale     = isADS and (SensitivityCFG.ADSMultiplier / 100) or 1
    local effectiveSens = sensScale * adsScale
    local movePixels
    if AimbotCFG.MouseType == "Percentage" then
        movePixels = delta * (AimbotCFG.Strength / 100)
    else
        local mag = delta.Magnitude
        if mag < 0.5 then return end
        movePixels = delta.Unit * math.min(mag, AimbotCFG.Strength)
    end
    local radiansX = (movePixels.X / ppr) / effectiveSens
    local radiansY = (movePixels.Y / ppr) / effectiveSens
    local cur      = CameraController.Rotation
    pcall(function()
        CameraController:SetRotation(Vector2.new(
            cur.X - radiansY,
            cur.Y - radiansX
        ))
    end)
end


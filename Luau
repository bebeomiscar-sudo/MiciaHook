-- ═══════════════════════════════════════════
local flConn = nil
local function startFakeLag()
    if flConn then flConn:Disconnect() end
    local lastFlip = tick(); local frozen = false
    flConn = RunService.Heartbeat:Connect(function()
        if not S.FakeLag.Enabled then
            flConn:Disconnect(); flConn = nil
            xpcall(function()
                local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                if hrp then hrp.Anchored = false end
            end, function(err) end)
            return
        end
        local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local now = tick()
        if now - lastFlip >= S.FakeLag.Interval then
            lastFlip = now; frozen = not frozen
            xpcall(function() hrp.Anchored = frozen end, function(err) end)
            if frozen and S.FakeLag.Desync then
                local orig = hrp.CFrame
                task.delay(0.016, function()
                    xpcall(function()
                        hrp.CFrame = orig * CFrame.new(
                            (math.random()-0.5)*S.FakeLag.DesyncStr,
                            0,
                            (math.random()-0.5)*S.FakeLag.DesyncStr
                        )
                    end, function(err) end)
                    task.delay(0.016, function()
                        xpcall(function() hrp.CFrame = orig end, function(err) end)
                    end)
                end)
            end
        end
    end)
end

local function stopFakeLag()
    S.FakeLag.Enabled = false
    if flConn then flConn:Disconnect(); flConn = nil end
    xpcall(function()
        local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        if hrp then hrp.Anchored = false end
    end, function(err) end)
end


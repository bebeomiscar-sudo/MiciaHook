local abTgt, abLockT, abReactT, abDoReact = nil, 0, 0, false

local function abEffFov()
    local f=AB.fov
    if AB.dynFov then f=f*(cam.FieldOfView/70) end
    return f
end

local function abTgtValid(pt)
    if not pt or not pt.Parent then return false end
    local h=pt.Parent:FindFirstChildOfClass("Humanoid")
    if not h or h.Health<=0 then return false end
    if not inFov(pt,abEffFov()) then return false end
    if AB.vis and not isVis(cam.CFrame.Position,pt) then return false end
    if AB.team then
        local p=plr:GetPlayerFromCharacter(pt.Parent)
        if p and sameTm(p) then return false end
    end
    return true
end

local function abFind()
    local c=scr(); local fv=abEffFov()
    local best,bd=nil,fv
    for _,p in ipairs(plr:GetPlayers()) do
        if p==lp then continue end
        if AB.team and sameTm(p) then continue end
        local chr=p.Character
        if not chr then continue end
        local hm=chr:FindFirstChildOfClass("Humanoid")
        if not hm or hm.Health<=0 then continue end
        local pt=bPart(chr,AB.part)
        if not pt then continue end
        local sp,on=cam:WorldToViewportPoint(pt.Position)
        if not on then continue end
        local d=(Vector2.new(sp.X,sp.Y)-c).Magnitude
        if d<bd then
            if AB.vis and not isVis(cam.CFrame.Position,pt) then continue end
            bd=d; best=pt
        end
    end
    return best
end

-- ═══════════════════════════════════════════
-- SILENT AIM — CORRECT METHOD
-- Hooks Utility.Raycast (the wrapper the game
-- uses for ALL gun shots) instead of ws:Raycast
--
-- From the code you found:
--   local orig = util.Raycast
--   util.Raycast = function(self, origin, dir, dist, ...)
--       local target = getTarget(origin)
--       if target then
--           return orig(self, origin, target.Position, dist, ...)
--       end
--       return orig(self, origin, dir, dist, ...)
--   end
--
-- We do the same but with our target system
-- ═══════════════════════════════════════════
local saApplied = false
local saTgt     = nil

-- Find best SA target (same logic as the code you found)
local function saGetTarget(origin)
    if not SA.on then return nil end
    local center = cam.ViewportSize / 2
    local best, bd = nil, math.huge

    for _, p in ipairs(plr:GetPlayers()) do
        if p == lp then continue end
        if SA.team and sameTm(p) then continue end
        local chr = p.Character
        if not chr then continue end
        local hm = chr:FindFirstChildOfClass("Humanoid")
        if not hm or hm.Health <= 0 then continue end

        -- Environment check (Rivals specific)
        local me = lp:GetAttribute("EnvironmentID")
        local th = p:GetAttribute("EnvironmentID")
        if me ~= nil and th ~= nil and me ~= th then continue end

        local pt = bPart(chr, SA.part)
        if not pt then continue end

        -- Distance from origin (gun barrel position)
        if (origin - pt.Position).Magnitude > SA.maxDist then continue end

        local sp, on = cam:WorldToViewportPoint(pt.Position)
        if not on then continue end

        local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
        if d > SA.fov then continue end

        if SA.vis and not isVis(origin, pt) then continue end

        if SA.mode == "Closest" and d < bd then
            bd=d; best=pt
        elseif SA.mode == "Furthest" and d > bd then
            bd=d; best=pt
        elseif SA.mode == "Random" then
            if not best or math.random() < 0.3 then best=pt end
        end
    end

    saTgt = best
    return best
end

-- Hook Utility.Raycast — the RIGHT way for Rivals
local function applySA()
    if saApplied then return end
    if not mUtil then
        Lib:Notify("SA: Utility module not loaded yet", 3)
        return
    end

    local origRaycast = mUtil.Raycast

    -- Direct function replacement (no hookmetamethod needed)
    -- This is safer and more targeted than ws:Raycast hook
    mUtil.Raycast = function(self, origin, direction, distance, ...)
        if SA.on then
            local target = saGetTarget(origin)
            if target then
                -- Redirect the ray toward the target
                -- Same as: return orig(self, origin, target.Position, distance, ...)
                return origRaycast(self, origin, target.Position, distance, ...)
            end
        end
        return origRaycast(self, origin, direction, distance, ...)
    end

    saApplied = true
    Lib:Notify("Silent Aim: Utility.Raycast hooked", 3)
end


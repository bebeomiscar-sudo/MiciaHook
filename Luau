local vp  = RaycastParams.new()
vp.FilterType = Enum.RaycastFilterType.Exclude

local function screenCenter()
    return Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)
end

local function sameTeam(p)
    local r = false
    pcall(function()
        local a = lp:GetAttribute("TeamID")
        local b = p:GetAttribute("TeamID")
        if a ~= nil and b ~= nil then r = (a==b) end
    end)
    return r
end

local function visible(orig, part)
    if not part then return false end
    local ok, res = pcall(function()
        vp.FilterDescendantsInstances = {lp.Character, part.Parent}
        local d = part.Position - orig
        local h = ws:Raycast(orig, d, vp)
        return h == nil or h.Instance:IsDescendantOf(part.Parent)
    end)
    return ok and res or false
end

local function inFOV(part, fovSize)
    if not part then return false end
    local sp, on = cam:WorldToViewportPoint(part.Position)
    if not on then return false end
    return (Vector2.new(sp.X,sp.Y) - screenCenter()).Magnitude <= fovSize
end

local function w2s(pos)
    local sp, on = cam:WorldToViewportPoint(pos)
    if not on or sp.Z <= 0 then return nil end
    return Vector2.new(sp.X, sp.Y)
end

local function angleDiff(f, t)
    local d = t - f
    return ((d + math.pi) % (math.pi*2)) - math.pi
end


local TrigState={waiting=false,timer=0,grace=0,cooldown=0,shooting=false}
local function getTrigDelay()
    if TrigCFG.RandomDelay then return math.random(TrigCFG.MinDelay,TrigCFG.MaxDelay)/1000 end; return TrigCFG.Delay/1000
end
local function getTriggerTarget()
    local origin=camera.CFrame.Position; local direction=camera.CFrame.LookVector*2000
    local params=RaycastParams.new(); params.FilterType=Enum.RaycastFilterType.Exclude; local fl={}
    if LP.Character then table.insert(fl,LP.Character) end; params.FilterDescendantsInstances=fl
    local hit=workspace:Raycast(origin,direction,params); if not hit or not hit.Instance then return nil end
    local hitChar,inst=nil,hit.Instance
    while inst do if inst:FindFirstChildOfClass("Humanoid") then hitChar=inst; break end; inst=inst.Parent end
    if not hitChar then return nil end
    local hum=hitChar:FindFirstChildOfClass("Humanoid"); if not hum or hum.Health<=0 then return nil end
    local tp=Players:GetPlayerFromCharacter(hitChar); if not tp or tp==LP then return nil end
    if TrigCFG.TeamCheck and isSameTeamRivals(tp) then return nil end
    local vn=TARGET_PARTS[TrigCFG.TargetPart] or {"Head","UpperTorso","LowerTorso"}
    local pm=false; for _,pn in ipairs(vn) do if hit.Instance.Name==pn then pm=true; break end end; if not pm then return nil end
    if TrigCFG.VisibleCheck then local cp=hitChar:FindFirstChild("Head") or hit.Instance; if not isAimbotVisible(cp) then return nil end end
    return hitChar
end

-- mobile triggerbot
local function getMobileTrigTarget()
    local center=getScreenCenter(); local bChar,bDist=nil,MobileTrigCFG.FOV
    for _,p in ipairs(Players:GetPlayers()) do
        if p==LP then continue end; if MobileTrigCFG.TeamCheck and isSameTeamRivals(p) then continue end
        local ch=p.Character; if not ch then continue end
        local hum=ch:FindFirstChildOfClass("Humanoid"); if not hum or hum.Health<=0 then continue end
        for _,pn in ipairs({"Head","UpperTorso","LowerTorso","HumanoidRootPart"}) do
            local part=ch:FindFirstChild(pn); if not part then continue end
            if MobileTrigCFG.VisCheck and not isAimbotVisible(part) then continue end
            local sp,on=camera:WorldToScreenPoint(part.Position); if not on then continue end
            local d=(Vector2.new(sp.X,sp.Y)-center).Magnitude; if d<bDist then bDist=d; bChar=ch end
        end
    end
    return bChar
end


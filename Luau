local function make(class, props)
    local obj = Instance.new(class)
    for k,v in pairs(props) do if k~="Parent" then obj[k]=v end end
    if props.Parent then obj.Parent = props.Parent end
    return obj
end

local function tw(obj,dur,goals)
    TweenService:Create(obj,TweenInfo.new(dur,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),goals):Play()
end

local function fmtN(val,inc)
    if inc>=1 then return tostring(math.floor(val)) end
    if inc>=0.1 then return string.format("%.1f",val) end
    return string.format("%.3f",val)
end

local function isTM(i)
    return i.UserInputType==Enum.UserInputType.MouseButton1
        or i.UserInputType==Enum.UserInputType.Touch
end

local function isTMM(i)
    return i.UserInputType==Enum.UserInputType.MouseMovement
        or i.UserInputType==Enum.UserInputType.Touch
end

local function gIP(i) return Vector2.new(i.Position.X,i.Position.Y) end


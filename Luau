-- ═══════════════════════════════════════════
local spoofBusy, spoofLoopThread = false, nil
local function spoofDevice(wantedDevice)
    if not SetControlsRemote or spoofBusy then return false end
    spoofBusy = true
    local ok = pcall(function()
        SetControlsRemote:FireServer("MouseKeyboard")
        task.wait(0.3)
        SetControlsRemote:FireServer(wantedDevice)
    end)
    spoofBusy = false; return ok
end
local function startAutoSpoof()
    if spoofLoopThread then pcall(function() task.cancel(spoofLoopThread) end) end
    if CFG.Spoofer.AutoSpoof and CFG.Spoofer.Device ~= "None" then
        spoofLoopThread = task.spawn(function()
            while CFG.Spoofer.AutoSpoof and CFG.Spoofer.Device ~= "None" do
                spoofDevice(CFG.Spoofer.Device); task.wait(CFG.Spoofer.Interval)
            end
        end)
    end
end
local function stopAutoSpoof() CFG.Spoofer.AutoSpoof=false; if spoofLoopThread then pcall(function() task.cancel(spoofLoopThread) end); spoofLoopThread=nil end end


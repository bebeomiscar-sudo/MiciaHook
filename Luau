local function getScreenCenter() return Vector2.new(camera.ViewportSize.X/2, camera.ViewportSize.Y/2) end
local function isSameTeam(p) if not p or not LP then return false end; local ok,r=pcall(function() return p.Team and LP.Team and p.Team==LP.Team end); return ok and r or false end
local function isVisible(tp) if not tp then return false end; local ok,r=pcall(function() local o=camera.CFrame.Position; local d=(tp.Position-o); local p=RaycastParams.new(); p.FilterType=Enum.RaycastFilterType.Exclude; local fl={camera}; if LP.Character then table.insert(fl,LP.Character) end; p.FilterDescendantsInstances=fl; local h=workspace:Raycast(o,d,p); if h then return h.Instance:IsDescendantOf(tp.Parent) end; return true end); return ok and r or false end
local function angleDiff(f,t) local d=t-f; return ((d+math.pi)%(math.pi*2))-math.pi end
local function isAirborne(ch) if not ch then return false end; local ok,r=pcall(function() local h=ch:FindFirstChildOfClass("Humanoid"); if not h then return false end; local st=h:GetState(); return st==Enum.HumanoidStateType.Freefall or st==Enum.HumanoidStateType.Jumping end); return ok and r or false end

local BODY_PARTS = {"Head","HumanoidRootPart","UpperTorso","LowerTorso","LeftUpperArm","RightUpperArm","LeftLowerArm","RightLowerArm"}
local function getClosestPart(ch) local c=getScreenCenter(); local bp,bd=nil,math.huge; for _,pn in ipairs(BODY_PARTS) do local p=ch:FindFirstChild(pn); if not p or not p:IsA("BasePart") then continue end; local sp,on=camera:WorldToScreenPoint(p.Position); if not on then continue end; local d=(Vector2.new(sp.X,sp.Y)-c).Magnitude; if d<bd then bd=d; bp=p end end; return bp end

local function isVisible(from, targetPos)
    local rp = RaycastParams.new()
    rp.FilterDescendantsInstances = {LP.Character}
    rp.FilterType = Enum.RaycastFilterType.Exclude
    local res = workspace:Raycast(from, (targetPos - from), rp)
    return not res or (res.Instance and res.Instance:IsDescendantOf(workspace))
end
local function isAimbotVisible(part)
    if not part then return false end
    local ok, r = pcall(function()
        local origin = camera.CFrame.Position
        local dir    = part.Position - origin
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = {LP.Character, part.Parent, workspace:FindFirstChild("Debris")}
        local hit = workspace:Raycast(origin, dir, params)
        return hit == nil or hit.Instance:IsDescendantOf(part.Parent)
    end)
    return ok and r or false
end


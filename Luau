-- Health hooks for hit markers, sounds, notifications
local hmConns={}
local notifyFunc = nil -- assigned after library loads

local function hookPlayerHealth(player)
    if player==LP then return end
    local function connectChar(char)
        local hum=char:FindFirstChild("Humanoid"); if not hum then return end
        local head=char:FindFirstChild("Head"); if not head then return end
        local lastHP=hum.Health
        if hmConns[player] then pcall(function() hmConns[player]:Disconnect() end) end
        hmConns[player]=hum.HealthChanged:Connect(function(newHP)
            local dmg=lastHP-newHP
            if dmg>0.5 then
                task.spawn(spawnHitMarker,head,dmg)
                task.spawn(playHitSound)
                if HitFXCFG.HitNotifyOn and notifyFunc then
                    local txt=HitFXCFG.HitNotifyText
                        :gsub("{name}",player.DisplayName)
                        :gsub("{dmg}",math.floor(dmg))
                    notifyFunc("Hit", txt, 2)
                end
                if newHP<=0 and HitFXCFG.KillNotifyOn and notifyFunc then
                    local txt=HitFXCFG.KillNotifyText:gsub("{name}",player.DisplayName)
                    notifyFunc("Kill", txt, 3)
                end
            end
            lastHP=newHP
        end)
    end
    if player.Character then task.spawn(function() task.wait(0.3); connectChar(player.Character) end) end
    player.CharacterAdded:Connect(function(c) task.wait(0.3); connectChar(c) end)
end
for _,p in ipairs(Players:GetPlayers()) do hookPlayerHealth(p) end
Players.PlayerAdded:Connect(hookPlayerHealth)
Players.PlayerRemoving:Connect(function(p) if hmConns[p] then pcall(function() hmConns[p]:Disconnect() end); hmConns[p]=nil end end)

UIS.InputBegan:Connect(function(i,g) if not g and i.UserInputType==Enum.UserInputType.MouseButton1 then fireTracer() end end)


--[[
    ANTI-AIM BREAKER ARCHITECTURE:
    
    6-PHASE CYCLE (unpredictable to resolvers):
      0 = VOID_DEEP    → Far below map, scattered XZ
      1 = STRIKE_A     → Near target, spiral angle 0°
      2 = VOID_MID     → Mid depth, offset XZ
      3 = STRIKE_B     → Near target, spiral angle 120°
      4 = SCATTER       → Random position, random height
      5 = STRIKE_C     → Near target, spiral angle 240°
    
    EVERY SINGLE FRAME:
      • Y: sin(t*7.3) + sin(t*13.7) + sin(t*23.1) + random noise
        → incommensurate frequencies = never repeating pattern
      • X: cos(spiral) + random jitter + pitch-adaptive offset
      • Z: sin(spiral) + random jitter + yaw-adaptive offset
      • Micro-jitter on top of everything
    
    ADAPTIVE SYSTEM (when AutoAdapt=true):
      • Samples target Y position + yaw rotation every frame
      • Every 15 frames: analyzes variance, rotation speed
      • Classifies Pitch: None/Zero/Up/Down/Glitch/Random
      • Classifies Yaw: Static/AtTargets/Spin/GlitchSpin/StutterSpin
      • Adjusts Y/XZ/Spiral multipliers to counter detected config
    
    RESULT:
      No Pitch+Yaw+YawBase+YawAngle combo in Kiciahook V2
      can predict our position on any given frame.
]]

-- ── ANALYSIS FUNCTIONS ──

local function sampleTarget()
    if not CFG.Target then return end
    local tc = CFG.Target.Character
    if not tc then return end
    local tr = tc:FindFirstChild("HumanoidRootPart")
    if not tr then return end

    local yPos = tr.Position.Y
    local look = tr.CFrame.LookVector
    local yaw  = math.atan2(look.X, look.Z)

    table.insert(Analysis.yBuffer, yPos)
    table.insert(Analysis.rotBuffer, yaw)
    table.insert(Analysis.tBuffer, tick())

    while #Analysis.yBuffer > Analysis.maxSamples do
        table.remove(Analysis.yBuffer, 1)
        table.remove(Analysis.rotBuffer, 1)
        table.remove(Analysis.tBuffer, 1)
    end
end

local function analyzeTarget()
    local n = #Analysis.yBuffer
    if n < 8 then return end

    -- ── Y VARIANCE (pitch detection) ──
    local yMean = 0
    for _, y in ipairs(Analysis.yBuffer) do yMean = yMean + y end
    yMean = yMean / n

    local yVar = 0
    for _, y in ipairs(Analysis.yBuffer) do yVar = yVar + (y - yMean) ^ 2 end
    yVar = yVar / n
    Analysis.yVariance = yVar

    -- ── ROTATION SPEED (yaw detection) ──
    local rotSpeeds = {}
    for i = 2, n do
        local dt = Analysis.tBuffer[i] - Analysis.tBuffer[i - 1]
        if dt > 0.001 then
            local dRot = math.abs(Analysis.rotBuffer[i] - Analysis.rotBuffer[i - 1])
            if dRot > math.pi then dRot = 2 * math.pi - dRot end
            table.insert(rotSpeeds, dRot / dt)
        end
    end

    local avgRot = 0
    for _, rs in ipairs(rotSpeeds) do avgRot = avgRot + rs end
    if #rotSpeeds > 0 then avgRot = avgRot / #rotSpeeds end
    Analysis.rotSpeed = avgRot

    local rotVar = 0
    for _, rs in ipairs(rotSpeeds) do rotVar = rotVar + (rs - avgRot) ^ 2 end
    if #rotSpeeds > 0 then rotVar = rotVar / #rotSpeeds end
    Analysis.rotVariance = rotVar

    -- ── CHECK IF TARGET FACES US ──
    local facingUs = false
    if CFG.Target and CFG.Target.Character and LP.Character then
        local tr = CFG.Target.Character:FindFirstChild("HumanoidRootPart")
        local mr = LP.Character:FindFirstChild("HumanoidRootPart")
        if tr and mr then
            local toMe = (mr.Position - tr.Position).Unit
            local look = tr.CFrame.LookVector
            facingUs = (toMe.X * look.X + toMe.Z * look.Z) > 0.6
        end
    end

    -- ── CLASSIFY PITCH ──
    if yVar > 80 then
        Analysis.detectedPitch = "Glitch"
    elseif yVar > 20 then
        Analysis.detectedPitch = "Random"
    else
        -- Check relative height to local player ground reference
        local myChar = LP.Character
        local myY = myChar and myChar:FindFirstChild("HumanoidRootPart")
            and myChar.HumanoidRootPart.Position.Y or yMean
        local diff = yMean - myY
        if diff > 4 then
            Analysis.detectedPitch = "Up"
        elseif diff < -4 then
            Analysis.detectedPitch = "Down"
        else
            Analysis.detectedPitch = "Zero"
        end
    end

    -- ── CLASSIFY YAW ──
    if avgRot > 6 then
        if rotVar > 15 then
            -- Erratic high speed rotation
            Analysis.detectedYaw = math.random() > 0.5 and "GlitchSpin" or "StutterSpin"
        else
            Analysis.detectedYaw = "Spin"
        end
    elseif avgRot > 2 then
        if facingUs then
            Analysis.detectedYaw = "AtTargets"
        else
            Analysis.detectedYaw = "Spin"
        end
    elseif facingUs then
        Analysis.detectedYaw = "AtTargets"
    else
        Analysis.detectedYaw = "Static"
    end

    -- ── COMPUTE ADAPTIVE MULTIPLIERS ──
    -- Pitch multipliers
    local pMult = ({
        Glitch = 2.5, Random = 2.0, Up = 1.6, Down = 1.8, Zero = 1.0, None = 1.0,
    })[Analysis.detectedPitch] or 1.0

    -- Yaw multipliers
    local xzM, spM = 1.0, 1.0
    if Analysis.detectedYaw == "Spin" then
        spM = 2.0; xzM = 1.5
    elseif Analysis.detectedYaw == "GlitchSpin" then
        xzM = 2.5; spM = 0.5
    elseif Analysis.detectedYaw == "StutterSpin" then
        xzM = 2.0; spM = 1.5
    elseif Analysis.detectedYaw == "AtTargets" then
        spM = 2.0; xzM = 1.5
    end

    Analysis.yMult = pMult
    Analysis.xzMult = xzM
    Analysis.spiralMult = spM
end

local function updateDetectionUI()
    -- Pitch label
    local pColor = C.dim
    local p = Analysis.detectedPitch
    if p == "Glitch" or p == "Random" then pColor = C.red
    elseif p == "Up" or p == "Down" then pColor = C.orange
    elseif p == "Zero" then pColor = C.green end
    pitchDetectLabel.Text = "PITCH: " .. p
    pitchDetectLabel.TextColor3 = pColor

    -- Yaw label
    local yColor = C.dim
    local y = Analysis.detectedYaw
    if y == "GlitchSpin" or y == "StutterSpin" then yColor = C.red
    elseif y == "Spin" then yColor = C.orange
    elseif y == "AtTargets" then yColor = C.cyan
    elseif y == "Static" then yColor = C.green end
    yawDetectLabel.Text = "YAW:   " .. y
    yawDetectLabel.TextColor3 = yColor
end

-- ── POSITION CALCULATORS ──

local PHASE_COUNT = 6
local voidPhase   = 0
local voidClock   = 0

local function calcVoidPos(targetPos, phaseType)
    local depth = CFG.Void.Depth
    local xzJ   = CFG.Void.XZJitter

    local yOff = 0
    if phaseType == 0 then
        -- VOID_DEEP: far below, random scatter
        yOff = depth + (math.random() - 0.5) * 60
    else
        -- VOID_MID: shallower, different position
        yOff = depth * 0.6 + (math.random() - 0.5) * 40
    end

    return Vector3.new(
        targetPos.X + (math.random() - 0.5) * xzJ * 2,
        targetPos.Y + yOff,
        targetPos.Z + (math.random() - 0.5) * xzJ * 2
    )
end

local function calcStrikePos(targetPos, angleOffset, t)
    local mode      = CFG.Void.Mode
    local yPhase    = CFG.Void.YPhaseDepth
    local yJit      = CFG.Void.YJitter
    local xzJit     = CFG.Void.XZJitter
    local spiralR   = CFG.Void.SpiralRad
    local spiralSpd = CFG.Void.SpiralSpd

    -- Apply adaptive multipliers
    local yM, xzM, spM = 1, 1, 1
    if CFG.Void.AutoAdapt and mode == "Adaptive" then
        yM  = Analysis.yMult
        xzM = Analysis.xzMult
        spM = Analysis.spiralMult
    elseif mode == "Aggressive" then
        yM = 2.0; xzM = 2.5; spM = 1.5
    elseif mode == "Erratic" then
        yM = 1.8; xzM = 2.0; spM = 0.3
    elseif mode == "Spiral" then
        yM = 1.0; xzM = 1.0; spM = 2.0
    end

    local effYPhase = yPhase * yM
    local effYJit   = yJit * yM
    local effXZJit  = xzJit * xzM
    local effSpR    = spiralR * spM
    local effSpSpd  = spiralSpd * spM

    -- ── Y-AXIS (anti-pitch) ──
    -- Three incommensurate frequencies → never-repeating pattern
    local yOsc = math.sin(t * 7.3) * effYPhase * 0.35
              + math.sin(t * 13.7) * effYJit * 0.4
              + math.sin(t * 23.1) * effYPhase * 0.15

    -- Pitch-specific modifiers
    local dp = Analysis.detectedPitch
    if CFG.Void.AutoAdapt and mode == "Adaptive" then
        if dp == "Glitch" then
            yOsc = yOsc + (math.random() - 0.5) * effYJit * 2.5
            yOsc = yOsc + math.sin(t * 31.3) * effYPhase * 0.3
        elseif dp == "Random" then
            yOsc = yOsc + (math.random() - 0.5) * effYPhase * 1.2
        elseif dp == "Up" then
            -- Alternate high and low to catch raised hitbox
            yOsc = yOsc + math.sin(t * 4.7) * effYPhase * 0.9
        elseif dp == "Down" then
            -- Bias downward to match floor hiding
            yOsc = yOsc - effYPhase * 0.5
            yOsc = yOsc + math.sin(t * 9.3) * effYJit * 0.8
        end
    end

    -- Always add random Y noise
    yOsc = yOsc + (math.random() - 0.5) * effYJit * 0.6

    -- ── XZ-AXIS (anti-yaw) ──
    local spiralAngle = t * effSpSpd + angleOffset
    local xOff = math.cos(spiralAngle) * effSpR
    local zOff = math.sin(spiralAngle) * effSpR

    -- Random jitter layer
    local jX = (math.random() - 0.5) * effXZJit * 2
    local jZ = (math.random() - 0.5) * effXZJit * 2

    -- Yaw-specific modifiers
    local dy = Analysis.detectedYaw
    if CFG.Void.AutoAdapt and mode == "Adaptive" then
        if dy == "Spin" then
            -- Counter-spin at different speed
            xOff = math.cos(-t * effSpSpd * 1.3 + angleOffset) * effSpR * 1.4
            zOff = math.sin(-t * effSpSpd * 1.3 + angleOffset) * effSpR * 1.4
            jX = jX * 1.5; jZ = jZ * 1.5
        elseif dy == "GlitchSpin" then
            -- Maximum random, abandon spiral
            xOff = (math.random() - 0.5) * effSpR * 3
            zOff = (math.random() - 0.5) * effSpR * 3
            jX = jX * 2.5; jZ = jZ * 2.5
        elseif dy == "StutterSpin" then
            -- Out of sync pulsing
            local flipX = math.sin(t * 17.3) > 0 and 1 or -1
            local flipZ = math.cos(t * 13.1) > 0 and 1 or -1
            xOff = math.cos(t * effSpSpd) * effSpR * flipX
            zOff = math.sin(t * effSpSpd * 1.7) * effSpR * flipZ
            jX = jX * 1.8; jZ = jZ * 1.8
        elseif dy == "AtTargets" then
            -- Strong spiral so our angle from target constantly changes
            xOff = math.cos(t * effSpSpd * 1.5 + angleOffset) * effSpR * 1.6
            zOff = math.sin(t * effSpSpd * 1.5 + angleOffset) * effSpR * 1.6
        end
    elseif mode == "Aggressive" then
        jX = (math.random() - 0.5) * effXZJit * 4
        jZ = (math.random() - 0.5) * effXZJit * 4
    elseif mode == "Erratic" then
        local rAngle = math.random() * math.pi * 2
        local rDist  = math.random() * effXZJit * 3
        xOff = math.cos(rAngle) * rDist
        zOff = math.sin(rAngle) * rDist
    end

    xOff = xOff + jX
    zOff = zOff + jZ

    return Vector3.new(
        targetPos.X + xOff,
        targetPos.Y + yOsc,
        targetPos.Z + zOff
    )
end

local function calcScatterPos(targetPos, t)
    local xzJit  = CFG.Void.XZJitter
    local yPhase = CFG.Void.YPhaseDepth
    local xzM = (CFG.Void.AutoAdapt and CFG.Void.Mode == "Adaptive") and Analysis.xzMult or 1.5

    local angle = math.random() * math.pi * 2
    local dist  = (xzJit * xzM) + math.random() * (xzJit * xzM)

    return Vector3.new(
        targetPos.X + math.cos(angle) * dist,
        targetPos.Y + (math.random() - 0.5) * yPhase * 0.6,
        targetPos.Z + math.sin(angle) * dist
    )
end

-- ── MAIN VOIDSPAM HEARTBEAT ──

local voidAccum = 0
local analysisDisplayTick = 0

table.insert(ActiveConnections, RunService.Heartbeat:Connect(function(dt)
    if not CFG.Void.On then
        voidAccum = 0
        voidPhase = 0
        voidClock = 0
        return
    end
    if not CFG.Target then return end

    local myChar = LP.Character
    if not myChar then return end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    local myHum = myChar:FindFirstChildOfClass("Humanoid")
    if myHum and myHum.Health <= 0 then return end

    local tc = CFG.Target.Character
    if not tc then return end
    local tr = tc:FindFirstChild("HumanoidRootPart")
    if not tr then return end

    local targetPos = tr.Position
    local t = tick()

    -- ── ANALYSIS (sample every frame, analyze every 15 frames) ──
    if CFG.Void.AutoAdapt then
        sampleTarget()
        Analysis.frameCount = Analysis.frameCount + 1
        if Analysis.frameCount % 15 == 0 then
            analyzeTarget()
        end
        -- Update UI every 30 frames (performance)
        analysisDisplayTick = analysisDisplayTick + 1
        if analysisDisplayTick % 30 == 0 then
            updateDetectionUI()
        end
    end

    -- ── PHASE ADVANCEMENT ──
    voidAccum = voidAccum + dt
    if voidAccum >= CFG.Void.PulseRate then
        voidAccum = 0
        voidPhase = (voidPhase + 1) % PHASE_COUNT
    end

    -- ── CALCULATE PHASE POSITION ──
    local pos

    if voidPhase == 0 then
        -- VOID_DEEP
        pos = calcVoidPos(targetPos, 0)
    elseif voidPhase == 1 then
        -- STRIKE_A (angle 0°)
        pos = calcStrikePos(targetPos, 0, t)
    elseif voidPhase == 2 then
        -- VOID_MID
        pos = calcVoidPos(targetPos, 1)
    elseif voidPhase == 3 then
        -- STRIKE_B (angle 120°)
        pos = calcStrikePos(targetPos, math.rad(120), t)
    elseif voidPhase == 4 then
        -- SCATTER
        pos = calcScatterPos(targetPos, t)
    elseif voidPhase == 5 then
        -- STRIKE_C (angle 240°)
        pos = calcStrikePos(targetPos, math.rad(240), t)
    end

    -- ── PER-FRAME MICRO-JITTER (on top of everything) ──
    -- Even within the same phase, no two frames are identical
    local micro = Vector3.new(
        (math.random() - 0.5) * 2.4,
        (math.random() - 0.5) * 1.8,
        (math.random() - 0.5) * 2.4
    )

    -- ── APPLY POSITION ──
    if pos then
        local finalPos = pos + micro

        -- During strike phases, face the target
        if voidPhase == 1 or voidPhase == 3 or voidPhase == 5 then
            myRoot.CFrame = CFrame.new(finalPos, targetPos)
        else
            myRoot.CFrame = CFrame.new(finalPos)
        end
    end
end))


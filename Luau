local DetectedPlatform = (UIS.TouchEnabled and not UIS.KeyboardEnabled) and "Mobile" or "PC"
local ActivePlatform   = DetectedPlatform

local InputCFG = {
    Platform      = ActivePlatform,
    PC_Smoothness = 10,
    PC_SensX      = 1.0,
    PC_SensY      = 1.0,
    PC_OffsetX    = 0,
    PC_OffsetY    = 0,
    MB_Smoothness = 8,
    MB_SensX      = 1.0,
    MB_SensY      = 1.0,
    MB_OffsetX    = 0,
    MB_OffsetY    = 0,
}

local function getMousePosition()
    -- NEVER Player:GetMouse() — that's what gets you banned
    local pos  = UIS:GetMouseLocation()
    local offX = InputCFG.Platform == "PC" and InputCFG.PC_OffsetX or InputCFG.MB_OffsetX
    local offY = InputCFG.Platform == "PC" and InputCFG.PC_OffsetY or InputCFG.MB_OffsetY
    return Vector2.new(pos.X + offX, pos.Y + offY)
end

local function getSmoothnessValue()
    return InputCFG.Platform == "PC" and InputCFG.PC_Smoothness or InputCFG.MB_Smoothness
end

local function getSensitivity()
    if InputCFG.Platform == "PC" then
        return InputCFG.PC_SensX, InputCFG.PC_SensY
    else
        return InputCFG.MB_SensX, InputCFG.MB_SensY
    end
end


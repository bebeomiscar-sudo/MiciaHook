local function getScreenCenter()
    return Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
end

local function isVisible(tp)
    if not tp then return false end
    local ok, r = pcall(function()
        local origin = camera.CFrame.Position
        local direction = tp.Position - origin
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        local filterList = { camera }
        if LP.Character then
            table.insert(filterList, LP.Character)
        end
        params.FilterDescendantsInstances = filterList
        local hit = workspace:Raycast(origin, direction, params)
        if hit then
            return hit.Instance:IsDescendantOf(tp.Parent)
        end
        return true
    end)
    return ok and r or false
end

local function angleDiff(f, t)
    local d = t - f
    return ((d + math.pi) % (math.pi * 2)) - math.pi
end

local function simClick()
    pcall(function()
        local vim = game:GetService("VirtualInputManager")
        local cx = camera.ViewportSize.X / 2
        local cy = camera.ViewportSize.Y / 2
        vim:SendMouseButtonEvent(cx, cy, 0, true, game, 1)
        task.defer(function()
            pcall(function()
                vim:SendMouseButtonEvent(cx, cy, 0, false, game, 1)
            end)
        end)
    end)
end


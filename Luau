-- HEALTH HOOKS (Hit Marker/Notify/Kill/Sound)
-- ═══════════════════════════════════════════
local Library = nil -- assigned after UI loads
local hmConns = {}

local function hookPlayer(player)
    if player == LP then return end
    local function connectChar(char)
        local hum  = char:FindFirstChild("Humanoid"); if not hum then return end
        local head = char:FindFirstChild("Head"); if not head then return end
        local lastHP = hum.Health
        if hmConns[player] then pcall(function() hmConns[player]:Disconnect() end) end
        hmConns[player] = hum.HealthChanged:Connect(function(newHP)
            local dmg = lastHP - newHP
            if dmg > 0.5 then
                if HitMarkerCFG.Enabled      then task.spawn(spawnMarker, head, dmg) end
                if MiscCFG.HitSound.Enabled  then task.spawn(playHitSound, MiscCFG.HitSound.Sound) end
                if MiscCFG.HitNotify.Enabled and Library then
                    Library:Notify(MiscCFG.HitNotify.Text:gsub("{name}",player.DisplayName):gsub("{dmg}",math.floor(dmg)):gsub("{hp}",math.floor(hum.Health)):gsub("{maxhp}",math.floor(hum.MaxHealth)), MiscCFG.HitNotify.Duration)
                end
                if newHP <= 0 then
                    if MiscCFG.KillNotify.Enabled and Library then
                        Library:Notify(MiscCFG.KillNotify.Text:gsub("{name}",player.DisplayName), MiscCFG.KillNotify.Duration)
                    end
                    if MiscCFG.KillSay.Enabled then
                        task.delay(MiscCFG.KillSay.Delay, function()
                            local msg = MiscCFG.KillSay.Text:gsub("{name}",player.DisplayName)
                            pcall(function() game:GetService("TextChatService").TextChannels.RBXGeneral:SendAsync(msg) end)
                        end)
                    end
                end
            end
            lastHP = newHP
        end)
    end
    if player.Character then task.spawn(function() task.wait(0.3); connectChar(player.Character) end) end
    player.CharacterAdded:Connect(function(c) task.wait(0.3); connectChar(c) end)
end
for _, p in pairs(Players:GetPlayers()) do hookPlayer(p) end
Players.PlayerAdded:Connect(hookPlayer)
Players.PlayerRemoving:Connect(function(p)
    if hmConns[p] then pcall(function() hmConns[p]:Disconnect() end); hmConns[p]=nil end
end)


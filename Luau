-- ═══════════════════════════════════════════
-- AIMBOT CORE
-- ─────────────────────────────────────────
-- Percentage: moves mouse (strength)% of distance to target each frame
-- Linear:     moves mouse (strength) pixels toward target each frame
-- Both are applied through CameraController.SetRotation
-- ═══════════════════════════════════════════
local lockTimer=0; local lockedTarget=nil; local reactionTimer=0; local isInReaction=false

-- Determine which part to aim at (handles "Changing" mode)
local function resolveAimPart(char, dist)
    if AimbotCFG.AimPart == "Head"  then return char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart") end
    if AimbotCFG.AimPart == "Body"  then return char:FindFirstChild("UpperTorso") or char:FindFirstChild("HumanoidRootPart") end
    if AimbotCFG.AimPart == "Changing" then
        local mult = math.max(AimbotCFG.ChangingHeadMult, 0.0001)
        local ratio = dist / AimbotCFG.DistanceDivider / mult
        -- ratio > 1 = aim head  |  ratio < 1 = aim body
        if ratio > 1 then
            return char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
        else
            return char:FindFirstChild("UpperTorso") or char:FindFirstChild("HumanoidRootPart")
        end
    end
    return char:FindFirstChild("HumanoidRootPart")
end

local function isTargetStillValid(part)
    if not part or not part.Parent then return false end
    local hum=part.Parent:FindFirstChildOfClass("Humanoid"); if not hum or hum.Health<=0 then return false end
    if AimbotCFG.VisibleCheck and not isVisible(part) then return false end
    if AimbotCFG.TeamCheck then local p=Players:GetPlayerFromCharacter(part.Parent); if p and isSameTeam(p) then return false end end
    return true
end

local function scorePlayer(p, camPos, camLook)
    local ch=p.Character; if not ch then return nil, -math.huge end
    local h=ch:FindFirstChildOfClass("Humanoid"); if not h or h.Health<=0 then return nil, -math.huge end
    local hrp=ch:FindFirstChild("HumanoidRootPart"); if not hrp then return nil, -math.huge end
    if AimbotCFG.TeamCheck and isSameTeam(p) then return nil, -math.huge end
    if isPlayerImmune(p) then return nil, -math.huge end
    local dist=(camPos-hrp.Position).Magnitude
    -- FOV gate for acquisition only
    local sp,on=camera:WorldToScreenPoint(hrp.Position)
    if not on then return nil, -math.huge end
    local screenDist=(Vector2.new(sp.X,sp.Y)-getScreenCenter()).Magnitude
    if screenDist>AimbotCFG.MaxFOV then return nil, -math.huge end
    if AimbotCFG.VisibleCheck and not isVisible(hrp) then return nil, -math.huge end
    -- Score by priority
    local score
    if AimbotCFG.TargetPriority=="Closest"    then score = -dist
    elseif AimbotCFG.TargetPriority=="Furthest"   then score = dist
    elseif AimbotCFG.TargetPriority=="Lowest HP"  then score = -(h.Health / h.MaxHealth) * 1000 end
    return hrp, score
end

local function findNewAimbotTarget()
    local camPos=camera.CFrame.Position; local camLook=camera.CFrame.LookVector
    local bestPart,bestScore=nil,-math.huge
    for _,p in ipairs(Players:GetPlayers()) do
        if p==LP then continue end
        local part, score = scorePlayer(p, camPos, camLook)
        if part and score > bestScore then
            bestScore=score
            -- find the actual aim part based on distance
            local dist=(camPos-part.Position).Magnitude
            bestPart = resolveAimPart(p.Character, dist) or part
        end
    end
    return bestPart
end

-- Compute screen-space delta and apply to camera
local function applyAimbotMove(dt, targetPart)
    if not CameraController then return end
    local center = getScreenCenter()
    local sp, on = camera:WorldToViewportPoint(targetPart.Position)
    if not on or sp.Z < 0 then return end

    local screenTarget = Vector2.new(sp.X, sp.Y)
    local delta = screenTarget - center
    local pixelsPerRadian = camera.ViewportSize.Y / (2 * math.tan(math.rad(camera.FieldOfView/2)))

    -- Convert sensitivity to a multiplier
    -- Rivals sensitivity: actual movement = input * (sens/100)
    local sensScale = (SensitivityCFG.Sensitivity / 100)
    local adsScale  = isADS and (SensitivityCFG.ADSMultiplier / 100) or 1
    local effectiveSens = sensScale * adsScale

    local movePixels
    if AimbotCFG.MouseType == "Percentage" then
        -- Move (strength)% of remaining distance per frame
        movePixels = delta * (AimbotCFG.Strength / 100)
    else
        -- Linear: move at most (strength) pixels per frame toward target
        local mag = delta.Magnitude
        if mag < 0.5 then return end
        movePixels = delta.Unit * math.min(mag, AimbotCFG.Strength)
    end

    -- Convert pixels to radians, account for sensitivity
    local radiansX = (movePixels.X / pixelsPerRadian) / effectiveSens
    local radiansY = (movePixels.Y / pixelsPerRadian) / effectiveSens

    local cur = CameraController.Rotation
    pcall(function()
        CameraController:SetRotation(Vector2.new(
            cur.X - radiansY,
            cur.Y - radiansX
        ))
    end)
end


-- ═══════════════════════════════════════════
local _infJumpConn    = nil
local _slideBoostConn = nil

local function startInfDoubleJump()
    if _infJumpConn then _infJumpConn:Disconnect() end
    _infJumpConn = RunService.Heartbeat:Connect(function()
        if not MechCFG.InfDoubleJump or not MechanicsCtrl then return end
        pcall(function() table.clear(MechanicsCtrl._double_jumps_used) end)
    end)
end

local function stopInfDoubleJump()
    MechCFG.InfDoubleJump = false
    if _infJumpConn then _infJumpConn:Disconnect(); _infJumpConn = nil end
end

local function setJumpPower(value)
    if not MechanicsCtrl then return end
    pcall(function() MechanicsCtrl._original_jump_power = value end)
end

local function startSlideBoost()
    if _slideBoostConn then _slideBoostConn:Disconnect() end
    _slideBoostConn = UIS.InputBegan:Connect(function(i, gpe)
        if gpe or not MechCFG.SlideBoost then return end
        if i.KeyCode == Enum.KeyCode.Space then
            if MechanicsCtrl and MechanicsCtrl.IsSliding then
                pcall(function() MechanicsCtrl:HighJump() end)
            end
        end
    end)
end

local function stopSlideBoost()
    MechCFG.SlideBoost = false
    if _slideBoostConn then _slideBoostConn:Disconnect(); _slideBoostConn = nil end
end

LP.CharacterAdded:Connect(function()
    task.wait(1)
    if MechCFG.InfDoubleJump then startInfDoubleJump() end
    if MechCFG.JumpPower ~= 1 then setJumpPower(MechCFG.JumpPower) end
end)


-- TRIGGERBOT
-- ═══════════════════════════════════════════
local TrigState = {waiting=false, timer=0, grace=0}

local function getTrigDelay()
    if TrigCFG.RandomDelay then
        return math.random(TrigCFG.MinDelay, TrigCFG.MaxDelay) / 1000
    end
    return TrigCFG.Delay / 1000
end

local function getTriggerTarget()
    local origin    = camera.CFrame.Position
    local direction = camera.CFrame.LookVector * 2000
    local params    = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = LP.Character and {LP.Character} or {}
    local hit = workspace:Raycast(origin, direction, params)
    if not hit or not hit.Instance then return nil end
    local hitChar, inst = nil, hit.Instance
    while inst do
        if inst:FindFirstChildOfClass("Humanoid") then hitChar = inst; break end
        inst = inst.Parent
    end
    if not hitChar then return nil end
    local hum = hitChar:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return nil end
    local tp = Players:GetPlayerFromCharacter(hitChar)
    if not tp or tp == LP then return nil end
    if TrigCFG.TeamCheck and isSameTeamRivals(tp) then return nil end
    local validNames = TARGET_PARTS[TrigCFG.TargetPart] or {"Head","UpperTorso","LowerTorso"}
    local partMatch  = false
    for _, pn in ipairs(validNames) do
        if hit.Instance.Name == pn then partMatch = true; break end
    end
    if not partMatch then return nil end
    return hitChar
end


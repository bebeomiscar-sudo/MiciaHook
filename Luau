local function getTracerOrigin()
    local vp=camera.ViewportSize; local o=BulletTracerCFG.Origin
    if o=="Top"    then return Vector2.new(vp.X/2, 0) end
    if o=="Middle" then return Vector2.new(vp.X/2, vp.Y/2) end
    return Vector2.new(vp.X/2, vp.Y)
end

local function fireTracer()
    if not BulletTracerCFG.Enabled then return end
    local char=LP.Character; if not char then return end
    local rp=RaycastParams.new(); rp.FilterDescendantsInstances={char}; rp.FilterType=Enum.RaycastFilterType.Exclude
    local res=workspace:Raycast(camera.CFrame.Position, camera.CFrame.LookVector*2000, rp)
    local hitPos=res and res.Position or (camera.CFrame.Position+camera.CFrame.LookVector*1000)
    local hsp,hon=camera:WorldToViewportPoint(hitPos); if not hon or hsp.Z<0 then return end
    local sFrom=getTracerOrigin(); local sTo=Vector2.new(hsp.X,hsp.Y); local delta=sTo-sFrom; local length=delta.Magnitude; if length<2 then return end
    local col=BulletTracerCFG.Rainbow and Color3.fromHSV(tracerHue,1,1) or BulletTracerCFG.Color
    if BulletTracerCFG.Rainbow then tracerHue=(tracerHue+0.05)%1 end
    local line=Instance.new("Frame"); line.BackgroundColor3=col; line.BorderSizePixel=0; line.AnchorPoint=Vector2.new(0,0.5); line.ZIndex=20
    line.Size=UDim2.new(0,length,0,BulletTracerCFG.Thickness); line.Position=UDim2.new(0,sFrom.X,0,sFrom.Y)
    line.Rotation=math.deg(math.atan2(delta.Y,delta.X)); line.Parent=TracerGui
    table.insert(activeTracers, {Line=line, Born=tick(), HitPos=hitPos})
end

RunService.RenderStepped:Connect(function()
    local now=tick(); local life=BulletTracerCFG.Duration; local keep={}
    for _, t in ipairs(activeTracers) do local age=now-t.Born
        if age<life and t.Line and t.Line.Parent then
            local sp,on=camera:WorldToViewportPoint(t.HitPos)
            if on and sp.Z>0 then
                local sFrom=getTracerOrigin(); local sTo=Vector2.new(sp.X,sp.Y); local delta=sTo-sFrom; local len=delta.Magnitude
                t.Line.Size=UDim2.new(0,len,0,BulletTracerCFG.Thickness); t.Line.Position=UDim2.new(0,sFrom.X,0,sFrom.Y); t.Line.Rotation=math.deg(math.atan2(delta.Y,delta.X))
                t.Line.BackgroundColor3=BulletTracerCFG.Rainbow and Color3.fromHSV((tracerHue+age*0.3)%1,1,1) or BulletTracerCFG.Color
                t.Line.BackgroundTransparency=BulletTracerCFG.Fade and math.clamp(age/life,0,0.95) or 0; t.Line.Visible=true
            else t.Line.Visible=false end
            table.insert(keep, t)
        else pcall(function() if t.Line then t.Line:Destroy() end end) end
    end
    activeTracers=keep
end)

UIS.InputBegan:Connect(function(i, g)
    if g then return end
    if i.UserInputType == Enum.UserInputType.MouseButton1 then fireTracer() end
end)


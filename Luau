local _hasFS = pcall(function() return writefile and readfile and isfile end)
local CONFIG_FOLDER = "RivalsToolPremium"
local CONFIG_EXT    = ".json"
local _refreshing   = false

local function ensureFolder()
    if not _hasFS then return end
    pcall(function() if not isfolder(CONFIG_FOLDER) then makefolder(CONFIG_FOLDER) end end)
end

local function getConfigPath(name)
    return CONFIG_FOLDER.."/".. (name or "default") ..CONFIG_EXT
end

local function saveConfig(name)
    if not _hasFS then return false end
    ensureFolder()
    local ok = pcall(function()
        writefile(getConfigPath(name), HttpService:JSONEncode(CFG))
    end)
    return ok
end

local function loadConfig(name)
    if not _hasFS then return false end
    local path = getConfigPath(name)
    local ok = pcall(function()
        if isfile(path) then
            local data = HttpService:JSONDecode(readfile(path))
            for k,v in pairs(data) do
                if type(v)=="table" and CFG[k] then
                    for k2,v2 in pairs(v) do CFG[k][k2]=v2 end
                end
            end
        end
    end)
    return ok
end

local function deleteConfig(name)
    if not _hasFS then return false end
    local ok = pcall(function()
        local p=getConfigPath(name); if isfile(p) then delfile(p) end
    end)
    return ok
end

local function listConfigs()
    if not _hasFS then return {} end
    local result={}
    pcall(function()
        ensureFolder()
        for _,f in ipairs(listfiles(CONFIG_FOLDER)) do
            local n=f:match("([^/\\]+)%"..CONFIG_EXT.."$")
            if n then table.insert(result,n) end
        end
    end)
    return result
end

local _autoSaveThread=nil
local function queueAutoSave()
    if _refreshing or not CFG.Config.AutoSave then return end
    if _autoSaveThread then pcall(task.cancel,_autoSaveThread) end
    _autoSaveThread=task.delay(1.5,function()
        saveConfig(CFG.Config.ConfigName)
        _autoSaveThread=nil
    end)
end


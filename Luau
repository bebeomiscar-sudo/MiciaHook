-- CORE RENDER STEP
local orbitAngle = 0

table.insert(ActiveConnections, RunService.RenderStepped:Connect(function(dt)
    camera = workspace.CurrentCamera
    local center = getScreenCenter()

    if CFG.Crosshair.On then
        crosshairImg.Position = UDim2.new(0.5, 0, 0.5, 0)
    end

    if fovCircle then
        fovCircle.Position = center
        fovCircle.Radius   = AimbotCFG.MaxFOV
        fovCircle.Visible  = AimbotCFG.DrawFOV and AimbotCFG.On
    end
    if saFovCircle then
        saFovCircle.Position = center
        saFovCircle.Radius   = SAHookCFG.IgnoreFOV and 0 or saGetEffectiveFOV()
        saFovCircle.Visible  = SAHookCFG.DrawFOV and SAHookCFG.On and not SAHookCFG.IgnoreFOV
    end

    -- Camera lean lock
    if MechCFG.LeanLock and MechanicsCtrl then
        pcall(function() MechanicsCtrl:SetCameraLean(MechCFG.LeanValue) end)
    end

    -- AIMBOT
    if AimbotCFG.On and CameraController then
        if isInReaction then
            reactionTimer = reactionTimer - dt
            if reactionTimer <= 0 then isInReaction = false end
        end
        if not isInReaction then
            if lockedTarget and not isTargetStillValid(lockedTarget) then
                lockedTarget = nil; lockTimer = 0
            end
            if not lockedTarget then
                local newT = findNewAimbotTarget()
                if newT then
                    lockedTarget  = newT
                    lockTimer     = 0
                    isInReaction  = true
                    reactionTimer = AimbotCFG.ReactionTime / 1000
                end
            end
            if lockedTarget then
                lockTimer = lockTimer + dt
                if lockTimer > AimbotCFG.MaxLockTime then
                    lockedTarget = nil; lockTimer = 0
                else
                    local isAtk = false
                    pcall(function()
                        if fighter_mod and fighter_mod.LocalFighter then
                            isAtk = fighter_mod.LocalFighter:Get("IsShooting") == true
                        end
                    end)
                    local speed = isAtk and AimbotCFG.SpeedInAttack or AimbotCFG.Speed
                    local sp2, on2 = camera:WorldToScreenPoint(lockedTarget.Position)
                    if on2 then
                        local sd = (Vector2.new(sp2.X, sp2.Y) - center).Magnitude
                        local fr = getEffectiveFOV()
                        if fr > 0 then
                            speed = speed * math.max(0.1, 1 - (sd / fr) * (AimbotCFG.SpeedScaleFOV / 100))
                        end
                    end
                    pcall(function()
                        local cp  = camera.CFrame.Position
                        local du  = (lockedTarget.Position - cp).Unit
                        local tP  = math.asin(du.Y)
                        local tY  = math.atan2(-du.X, -du.Z)
                        local sm  = math.clamp(speed / 5, 0, 1)
                        local cur = CameraController.Rotation
                        CameraController:SetRotation(Vector2.new(
                            cur.X + (tP - cur.X) * sm,
                            cur.Y + angleDiff(cur.Y, tY) * sm
                        ))
                    end)
                end
            end
        end
    end

    -- PC TRIGGERBOT
    if TrigCFG.On then
        local tgt = getTriggerTarget()
        if tgt then
            if not TrigState.waiting then
                TrigState.waiting = true
                TrigState.timer   = getTrigDelay()
                TrigState.grace   = TrigCFG.Grace / 1000
            end
            TrigState.timer = TrigState.timer - dt
            if TrigState.timer <= 0 then
                simClick()
                TrigState.waiting = false
                TrigState.timer   = 0
            end
        else
            if TrigState.waiting then
                TrigState.grace = TrigState.grace - dt
                if TrigState.grace <= 0 then
                    TrigState.waiting = false
                    TrigState.timer   = 0
                    TrigState.grace   = 0
                end
            end
        end
    else
        TrigState.waiting = false; TrigState.timer = 0; TrigState.grace = 0
    end

    -- MOBILE TRIGGERBOT
    if IsMobile and MobileTrigCFG.On then
        local sf = MobileTrigCFG.AutoFire or (MobileTrigCFG.HoldToShoot and MobileTrigState.touching)
        if sf then
            local tgt = getMobileTrigTarget()
            if tgt then
                if not MobileTrigState.waiting then
                    MobileTrigState.waiting  = true
                    MobileTrigState.timer    = MobileTrigCFG.Delay / 1000
                    MobileTrigState.cooldown = 0
                end
                MobileTrigState.timer = MobileTrigState.timer - dt
                if MobileTrigState.timer <= 0 then
                    MobileTrigState.cooldown = MobileTrigState.cooldown - dt
                    if MobileTrigState.cooldown <= 0 then
                        simClick()
                        MobileTrigState.cooldown = MobileTrigCFG.BurstMs / 1000
                    end
                end
            else
                if not MobileTrigState.touching then
                    MobileTrigState.waiting  = false
                    MobileTrigState.timer    = 0
                    MobileTrigState.cooldown = 0
                end
            end
        else
            MobileTrigState.waiting  = false
            MobileTrigState.timer    = 0
            MobileTrigState.cooldown = 0
        end
    end

    -- BULLET TRACERS UPDATE
    local now  = tick()
    local life = TracerCFG.Duration
    local keep = {}
    for _, t in ipairs(activeTracers) do
        if not t or not t.Line then continue end
        local age = now - t.Born
        if age < life and t.Line.Parent then
            local hsp, hon = camera:WorldToViewportPoint(t.HitPos)
            if hon and hsp.Z > 0 then
                local sFrom = getTracerOrigin()
                local sTo   = Vector2.new(hsp.X, hsp.Y)
                local delta = sTo - sFrom
                local len   = delta.Magnitude
                if len >= 2 then
                    t.Line.Size     = UDim2.new(0, len, 0, TracerCFG.Thickness)
                    t.Line.Position = UDim2.new(0, sFrom.X, 0, sFrom.Y)
                    t.Line.Rotation = math.deg(math.atan2(delta.Y, delta.X))
                end
                t.Line.BackgroundTransparency = TracerCFG.Fade and math.clamp(age / life, 0, 0.95) or 0
                t.Line.Visible = true
            else
                t.Line.Visible = false
            end
            table.insert(keep, t)
        else
            pcall(function() if t.Line then t.Line:Destroy() end end)
        end
    end
    activeTracers = keep
end))

-- CORE HEARTBEAT
table.insert(ActiveConnections, RunService.Heartbeat:Connect(function(dt)
    -- Auto Collect
    local char = LP.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChild("Humanoid")
        if hrp then
            local nh = hum and hum.Health < hum.MaxHealth
            for _, obj in workspace:GetChildren() do
                if obj.Name == "_drop" and obj:IsA("BasePart") then
                    if (CFG.Collect.Health and obj:FindFirstChild("Health") and nh)
                    or (CFG.Collect.Ammo  and obj:FindFirstChild("Ammo")) then
                        pcall(function()
                            firetouchinterest(hrp, obj, 0)
                            firetouchinterest(hrp, obj, 1)
                        end)
                    end
                end
            end
        end
    end

    -- Orbit
    if CFG.Orbit.On and not Desync.active and CFG.OrbitTarget then
        local mc = LP.Character
        if mc then
            local mr = mc:FindFirstChild("HumanoidRootPart")
            local tc = CFG.OrbitTarget.Character
            if mr and tc then
                local tr = tc:FindFirstChild("HumanoidRootPart")
                local mh = mc:FindFirstChildOfClass("Humanoid")
                if tr and mh and mh.Health > 0 then
                    orbitAngle = orbitAngle + (CFG.Orbit.Speed * dt)
                    if orbitAngle > math.pi * 2 then orbitAngle = orbitAngle - math.pi * 2 end
                    local tp = tr.Position
                    mr.CFrame = CFrame.new(
                        tp + Vector3.new(
                            math.cos(orbitAngle) * CFG.Orbit.Radius,
                            CFG.Orbit.Height,
                            math.sin(orbitAngle) * CFG.Orbit.Radius
                        ),
                        tp
                    )
                end
            end
        end
    end

    -- Voidspam
    if not Desync.active then return end
    if not humanoidRootPart or not humanoidRootPart.Parent then
        Desync.active = false; return
    end
    local hum2 = character:FindFirstChildOfClass("Humanoid")
    if not hum2 or hum2.Health <= 0 then
        if Desync.realCFrame then humanoidRootPart.CFrame = Desync.realCFrame end
        Desync.active = false; Desync.phase = "idle"; Desync.currentDepth = 0
        return
    end
    Desync.realCFrame  = humanoidRootPart.CFrame
    Desync.phaseTimer  = Desync.phaseTimer + dt

    if Desync.phase == "hide" then
        Desync.currentDepth = math.min(
            Desync.currentDepth + CFG.Void.StepSpeed * dt * 60,
            CFG.Void.VoidDepth
        )
        if Desync.phaseTimer >= CFG.Void.HideTime then
            Desync.phase = "attack"; Desync.phaseTimer = 0
            Desync.shotsFired = 0; Desync.shotCooldown = 0
        end
    elseif Desync.phase == "attack" then
        Desync.currentDepth = math.max(
            Desync.currentDepth - CFG.Void.StepSpeed * dt * 60 * 3,
            0
        )
        Desync.projCheckCD = Desync.projCheckCD + 1
        if Desync.projCheckCD >= 3 then
            Desync.projCheckCD = 0
            if checkProjectiles() then
                Desync.phase = "hide"; Desync.phaseTimer = 0
                Desync.totalCycles = Desync.totalCycles + 1
            end
        end
        if Desync.phase == "attack" and Desync.currentDepth <= 2 and CFG.Void.AutoFire then
            Desync.shotCooldown = Desync.shotCooldown - dt
            if Desync.shotsFired < CFG.Void.ShootAttempt and Desync.shotCooldown <= 0 then
                simClick(); Desync.shotsFired = Desync.shotsFired + 1; Desync.shotCooldown = 0.05
            end
        end
        if Desync.phase == "attack" and Desync.phaseTimer >= CFG.Void.AttackTime then
            Desync.phase = "hide"; Desync.phaseTimer = 0; Desync.totalCycles = Desync.totalCycles + 1
        end
    end

    if Desync.currentDepth > 0 then
        local rp  = Desync.realCFrame.Position
        local rot = Desync.realCFrame - rp
        humanoidRootPart.CFrame = CFrame.new(
            Vector3.new(rp.X, rp.Y - Desync.currentDepth, rp.Z)
        ) * rot
    end
end))


-- SILENT AIM — Utility.Raycast override
-- ═══════════════════════════════════════════
local SA = {
    on=false, vis=false, team=true,
    fov=600, drawFov=true, part="Head",
    mode="Closest", maxDist=500
}

local saApplied = false
local saTgt     = nil

local saCirc = Drawing.new("Circle")
saCirc.NumSides=64; saCirc.Filled=false
saCirc.Color=Color3.fromRGB(0,200,255)
saCirc.Thickness=1.5; saCirc.Transparency=0.7; saCirc.Visible=false

local function saGetTarget(origin)
    if not SA.on then return nil end
    local center=cam.ViewportSize/2
    local best,bd=nil,math.huge

    for _,p in ipairs(plr:GetPlayers()) do
        if p==lp then continue end
        if SA.team and sameTm(p) then continue end
        local chr=p.Character
        if not chr then continue end
        local hm=chr:FindFirstChildOfClass("Humanoid")
        if not hm or hm.Health<=0 then continue end
        local me=lp:GetAttribute("EnvironmentID")
        local th=p:GetAttribute("EnvironmentID")
        if me~=nil and th~=nil and me~=th then continue end
        local pt=bPart(chr,SA.part)
        if not pt then continue end
        if (origin-pt.Position).Magnitude>SA.maxDist then continue end
        local sp,on=cam:WorldToViewportPoint(pt.Position)
        if not on then continue end
        local d=(Vector2.new(sp.X,sp.Y)-center).Magnitude
        if d>SA.fov then continue end
        if SA.vis and not isVis(origin,pt) then continue end
        if SA.mode=="Closest" and d<bd then
            bd=d; best=pt
        elseif SA.mode=="Furthest" and d>bd then
            bd=d; best=pt
        elseif SA.mode=="Random" then
            if not best or math.random()<0.3 then best=pt end
        end
    end

    saTgt=best
    return best
end

local function applySA()
    if saApplied then return end
    if not mUtil then Lib:Notify("SA: Utility not loaded",3); return end
    local origRC=mUtil.Raycast
    mUtil.Raycast=function(self,origin,direction,distance,...)
        if SA.on then
            local target=saGetTarget(origin)
            if target then
                return origRC(self,origin,target.Position,distance,...)
            end
        end
        return origRC(self,origin,direction,distance,...)
    end
    saApplied=true
    Lib:Notify("SA: Utility.Raycast hooked",3)
end


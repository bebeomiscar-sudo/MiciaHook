-- RAGEBOT
-- ═══════════════════════════════════════════
local rageConn      = nil
local rageReloadCD  = 0

local rageRayParams = RaycastParams.new()
rageRayParams.FilterType = Enum.RaycastFilterType.Exclude

local RAGE_PEEK_OFFSETS = {
    Vector3.new(0, 0, 0), Vector3.new(0, 12, 0), Vector3.new(0, 20, 0),
    Vector3.new(0, 30, 0), Vector3.new(3, 0, 0), Vector3.new(-3, 0, 0),
}

local function rageGetClosest()
    local myHRP = character and character:FindFirstChild("HumanoidRootPart")
    if not myHRP then return nil, nil end
    local best, bchar, bd = nil, nil, RageCFG.MaxDist
    for _, v in ipairs(Players:GetPlayers()) do
        if v == LP then continue end
        if RageCFG.TeamCheck and isSameTeam(v) then continue end
        local ch   = v.Character
        if not ch then continue end
        local head = ch:FindFirstChild("Head")
        local hum  = ch:FindFirstChildOfClass("Humanoid")
        if not head or not hum or hum.Health <= 0 then continue end
        local mag = (myHRP.Position - head.Position).Magnitude
        if mag < bd then bd = mag; best = head; bchar = ch end
    end
    return best, bchar
end

local function ragePeek(origin, targetPos, targetChar)
    rageRayParams.FilterDescendantsInstances = {LP.Character, targetChar}
    if not RageCFG.VisibleCheck then return origin, 0 end
    if not Workspace:Raycast(origin, targetPos - origin, rageRayParams) then return origin, 0 end
    for _, offset in ipairs(RAGE_PEEK_OFFSETS) do
        local sp = origin + offset
        if not Workspace:Raycast(sp, targetPos - sp, rageRayParams) then
            return sp, offset.Y
        end
    end
    return nil, nil
end

local function startRagebot()
    if rageConn then rageConn:Disconnect() end
    rageConn = RunService.Heartbeat:Connect(function(dt)
        if not RageCFG.On or not LP.Character then return end
        if not LP.Character:FindFirstChild("HumanoidRootPart") then return end
        if not fighter_mod or not fighter_mod.LocalFighter then return end
        if not util_mod or not enums_mod then return end
        local item = fighter_mod.LocalFighter.EquippedItem
        if not item then return end
        rageReloadCD = rageReloadCD - dt
        local ammo = nil
        pcall(function() ammo = item:Get("CurrentAmmo") end)
        if ammo ~= nil and ammo <= 0 and rageReloadCD <= 0 then
            pcall(function()
                rs.Remotes.Replication.Fighter.UseItem:FireServer(
                    item:Get("ObjectID"), enums_mod:ToEnum("Reload"), {}, nil
                )
            end)
            rageReloadCD = 2.0
            return
        end
        local tp, tc = rageGetClosest()
        if not tp or not tc then return end
        local cam       = camera.CFrame
        local manip, height = ragePeek(cam.Position, tp.Position, tc)
        if not manip then return end
        local sp   = Vector3.new(manip.X, manip.Y + (height or 0), manip.Z)
        local look = CFrame.lookAt(sp, tp.Position)
        local p, y = look:ToOrientation()
        local cd   = {}
        cd[utf8.char(1)] = {
            [utf8.char(0)] = util_mod:EncodeCFrame(CFrame.new(sp) * CFrame.Angles(p, y, 0)),
            [utf8.char(1)] = util_mod:EncodeCFrame(CFrame.new(tp.Position) * CFrame.Angles(p, y, 0)),
            [utf8.char(2)] = tp,
            [utf8.char(3)] = util_mod:EncodeCFrame(tp.CFrame:ToObjectSpace(CFrame.new(tp.Position))),
        }
        pcall(function()
            rs.Remotes.Replication.Fighter.UseItem:FireServer(
                item:Get("ObjectID"), enums_mod:ToEnum("StartShooting"), cd, nil
            )
        end)
    end)
end

local function stopRagebot()
    RageCFG.On = false
    if rageConn then rageConn:Disconnect(); rageConn = nil end
end


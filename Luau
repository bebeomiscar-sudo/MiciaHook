-- CORE: VOIDSPAM LOGIC
--━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

task.spawn(function()
    local phase = false
    while true do
        if CFG.Void.On and CFG.Target then
            local myChar     = LP.Character
            local targetChar = CFG.Target.Character

            if myChar and targetChar then
                local myRoot     = myChar:FindFirstChild("HumanoidRootPart")
                local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
                local myHum      = myChar:FindFirstChildOfClass("Humanoid")

                if myRoot and targetRoot and myHum and myHum.Health > 0 then
                    phase = not phase
                    if phase then
                        myRoot.CFrame = targetRoot.CFrame + Vector3.new(0, CFG.Void.Depth, 0)
                    else
                        myRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 1)
                    end
                end
            end
        end
        task.wait(CFG.Void.On and CFG.Void.Rate or 0.5)
    end
end)


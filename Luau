local function isSameTeamRivals(p)
    local same = false
    pcall(function()
        local myID    = LP:GetAttribute("TeamID")
        local theirID = p:GetAttribute("TeamID")
        if myID and theirID then
            same = string.byte(myID or "\0") == string.byte(theirID or "\0")
        end
    end)
    if not same then
        pcall(function()
            same = p.Team ~= nil and LP.Team ~= nil and p.Team == LP.Team
        end)
    end
    return same
end

local function isAimbotVisible(part)
    if not part then return false end
    local ok, r = pcall(function()
        local origin = camera.CFrame.Position
        local dir    = part.Position - origin
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = {
            LP.Character, part.Parent, workspace:FindFirstChild("Debris"),
        }
        local hit = workspace:Raycast(origin, dir, params)
        return hit == nil or hit.Instance:IsDescendantOf(part.Parent)
    end)
    return ok and r or false
end


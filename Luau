-- PC TRIGGERBOT LOGIC
-- ═══════════════════════════════════════════
local TrigState = { waiting = false, timer = 0, grace = 0 }

local function getTrigDelay()
    if TrigCFG.RandomDelay then
        return math.random(TrigCFG.MinDelay, TrigCFG.MaxDelay) / 1000
    end
    return TrigCFG.Delay / 1000
end

local function getTriggerTarget()
    local origin    = camera.CFrame.Position
    local direction = camera.CFrame.LookVector * 2000
    local params    = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local fl = {}
    if LP.Character then table.insert(fl, LP.Character) end
    params.FilterDescendantsInstances = fl
    local hit = workspace:Raycast(origin, direction, params)
    if not hit or not hit.Instance then return nil end
    local hitChar, inst = nil, hit.Instance
    while inst do
        if inst:FindFirstChildOfClass("Humanoid") then hitChar = inst; break end
        inst = inst.Parent
    end
    if not hitChar then return nil end
    local hum = hitChar:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return nil end
    local tp = Players:GetPlayerFromCharacter(hitChar)
    if not tp or tp == LP then return nil end
    if TrigCFG.TeamCheck and isSameTeamRivals(tp) then return nil end
    local validNames = TARGET_PARTS[TrigCFG.TargetPart] or {"Head","UpperTorso","LowerTorso"}
    local partMatch  = false
    for _, pn in ipairs(validNames) do
        if hit.Instance.Name == pn then partMatch = true; break end
    end
    if not partMatch then return nil end
    if TrigCFG.VisibleCheck then
        local checkPart = hitChar:FindFirstChild("Head") or hit.Instance
        if not isAimbotVisible(checkPart) then return nil end
    end
    return hitChar
end

-- ═══════════════════════════════════════════
-- MOBILE TRIGGERBOT LOGIC
-- ═══════════════════════════════════════════
local function getMobileTrigTarget()
    local center = getScreenCenter()
    local bestChar, bestDist = nil, MobileTrigCFG.FOV
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LP then continue end
        if MobileTrigCFG.TeamCheck and isSameTeamRivals(p) then continue end
        local ch = p.Character; if not ch then continue end
        local hum = ch:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end
        for _, partName in ipairs({"Head","UpperTorso","LowerTorso","HumanoidRootPart"}) do
            local part = ch:FindFirstChild(partName)
            if not part then continue end
            if MobileTrigCFG.VisCheck and not isAimbotVisible(part) then continue end
            local sp, on = camera:WorldToScreenPoint(part.Position)
            if not on then continue end
            local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
            if d < bestDist then bestDist = d; bestChar = ch end
        end
    end
    return bestChar
end

-- ═══════════════════════════════════════════
-- IMMUNITY DETECTION SYSTEM
-- ═══════════════════════════════════════════
local function isPlayerImmune(p)
    if not ImmunityCFG.Enabled then return false end
    local data = playerImmunity[p]
    if data and data.forceShield then return true end
    local char = p.Character
    if char then
        if char:FindFirstChildOfClass("ForceField") then return true end
        for _, obj in ipairs(char:GetDescendants()) do
            local n = obj.Name:lower()
            if n == "shield" or n:find("immune") or n:find("shield") or n:find("protect") then
                if obj:IsA("BasePart") or obj:IsA("SelectionBox")
                or obj:IsA("ParticleEmitter") or obj:IsA("SpecialMesh")
                or obj:IsA("BillboardGui") then
                    return true
                end
            end
        end
    end
    if data then
        local elapsed = tick() - data.spawnTime
        if elapsed < ImmunityCFG.SpawnProtectionTime then return true end
    end
    return false
end

local function hookPlayerImmunity(p)
    if p == LP then return end
    local function onCharAdded(char)
        playerImmunity[p] = {
            spawnTime     = tick(),
            forceShield   = false,
            lastMaxHealth = 0,
        }
        if char:FindFirstChildOfClass("ForceField") then
            playerImmunity[p].forceShield = true
        end
        char.ChildAdded:Connect(function(child)
            if child:IsA("ForceField") then
                if playerImmunity[p] then playerImmunity[p].forceShield = true end
            end
        end)
        char.ChildRemoved:Connect(function(child)
            if child:IsA("ForceField") then
                if playerImmunity[p] then playerImmunity[p].forceShield = false end
            end
        end)
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            playerImmunity[p].lastMaxHealth = hum.MaxHealth
            hum:GetPropertyChangedSignal("MaxHealth"):Connect(function()
                if not playerImmunity[p] then return end
                local prev = playerImmunity[p].lastMaxHealth
                local curr = hum.MaxHealth
                if curr > 10000 and prev > 0 and curr > prev * 5 then
                    playerImmunity[p].forceShield = true
                end
                playerImmunity[p].lastMaxHealth = curr
            end)
        end
    end
    if p.Character then
        task.spawn(function() task.wait(0.1); onCharAdded(p.Character) end)
    end
    p.CharacterAdded:Connect(function(char)
        task.wait(0.1); onCharAdded(char)
    end)
end

for _, p in ipairs(Players:GetPlayers()) do hookPlayerImmunity(p) end
Players.PlayerAdded:Connect(hookPlayerImmunity)
Players.PlayerRemoving:Connect(function(p) playerImmunity[p] = nil end)


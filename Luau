TracerGui.IgnoreGuiInset=true; TracerGui.ZIndexBehavior=Enum.ZIndexBehavior.Sibling
TracerGui.DisplayOrder=25
pcall(function() TracerGui.Parent=LP:WaitForChild("PlayerGui") end)

local activeTracers    = {}
local tracerRainbowHue = 0

local function getTracerOrigin()
    local vp = camera.ViewportSize
    if TracerCFG.Origin=="Top"    then return Vector2.new(vp.X/2,0) end
    if TracerCFG.Origin=="Middle" then return Vector2.new(vp.X/2,vp.Y/2) end
    return Vector2.new(vp.X/2,vp.Y)
end

local function fireTracer()
    if not TracerCFG.On then return end
    pcall(function()
        local char = LP.Character; if not char then return end
        local rp   = RaycastParams.new()
        rp.FilterType=Enum.RaycastFilterType.Exclude
        rp.FilterDescendantsInstances={char}
        local res    = workspace:Raycast(camera.CFrame.Position, camera.CFrame.LookVector*2500, rp)
        local hitPos = res and res.Position or (camera.CFrame.Position+camera.CFrame.LookVector*1500)
        local hsp, hon = camera:WorldToViewportPoint(hitPos)
        if not hon or hsp.Z<0 then return end
        local sFrom = getTracerOrigin()
        local sTo   = Vector2.new(hsp.X,hsp.Y)
        local delta = sTo-sFrom
        local len   = delta.Magnitude
        if len<2 then return end
        local col = TracerCFG.Rainbow and Color3.fromHSV(tracerRainbowHue,1,1) or TracerCFG.Color
        if TracerCFG.Rainbow then tracerRainbowHue=(tracerRainbowHue+0.07)%1 end
        local line = Instance.new("Frame")
        line.BackgroundColor3=col; line.BorderSizePixel=0
        line.AnchorPoint=Vector2.new(0,0.5); line.ZIndex=26
        line.Size=UDim2.new(0,len,0,TracerCFG.Thickness)
        line.Position=UDim2.new(0,sFrom.X,0,sFrom.Y)
        line.Rotation=math.deg(math.atan2(delta.Y,delta.X))
        line.Parent=TracerGui
        table.insert(activeTracers,{Line=line,Born=tick(),HitPos=hitPos})
    end)
end


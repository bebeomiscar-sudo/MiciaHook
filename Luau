abFovCircle.Visible=false

local function abGetEffFOV()
    local f = AB.fov
    if AB.dynFov then f = f * (cam.FieldOfView/70) end
    return f
end

local function abTargetValid(part)
    if not part or not part.Parent then return false end
    local h = part.Parent:FindFirstChildOfClass("Humanoid")
    if not h or h.Health <= 0 then return false end
    if not inFOV(part, abGetEffFOV()) then return false end
    if AB.vis and not visible(cam.CFrame.Position, part) then return false end
    if AB.team then
        local p = plr:GetPlayerFromCharacter(part.Parent)
        if p and sameTeam(p) then return false end
    end
    return true
end

local function abFindTarget()
    local c   = screenCenter()
    local fov = abGetEffFOV()
    local best, bd = nil, fov
    for _, p in ipairs(plr:GetPlayers()) do
        if p == lp then continue end
        if AB.team and sameTeam(p) then continue end
        local chr = p.Character
        if not chr then continue end
        local hm = chr:FindFirstChildOfClass("Humanoid")
        if not hm or hm.Health <= 0 then continue end
        local pt = bestPart(chr, AB.part)
        if not pt then continue end
        local sp, on = cam:WorldToViewportPoint(pt.Position)
        if not on then continue end
        local d = (Vector2.new(sp.X,sp.Y) - c).Magnitude
        if d < bd then
            if AB.vis and not visible(cam.CFrame.Position, pt) then continue end
            bd=d; best=pt
        end
    end
    return best
end

-- ═══════════════════════════════════════════
-- SILENT AIM (Workspace:Raycast hook)
-- Uses Utility.SphereLineIntersection for better detection
-- ═══════════════════════════════════════════
local saTarget   = nil
local saHooked   = false
local saFovCirc  = Drawing.new("Circle")
saFovCirc.NumSides=64; saFovCirc.Filled=false
saFovCirc.Color=Color3.fromRGB(0,200,255)
saFovCirc.Thickness=1.5; saFovCirc.Transparency=0.7
saFovCirc.Visible=false

local saRp = RaycastParams.new()
saRp.FilterType = Enum.RaycastFilterType.Exclude

local function saEffFOV()
    if true then return SA.fov end -- always use FOV for now
end

local function saFindTarget()
    if not SA.on then saTarget=nil; return end
    local cpos  = cam.CFrame.Position
    local ctr   = cam.ViewportSize/2
    local best, bd, bChar = nil, math.huge, nil

    for _, p in ipairs(plr:GetPlayers()) do
        if p == lp then continue end
        if SA.team and sameTeam(p) then continue end
        local chr = p.Character
        if not chr then continue end
        local hm = chr:FindFirstChildOfClass("Humanoid")
        if not hm or hm.Health <= 0 then continue end
        -- environment check
        local me = lp:GetAttribute("EnvironmentID")
        local th = p:GetAttribute("EnvironmentID")
        if me ~= nil and th ~= nil and me ~= th then continue end
        local pt = bestPart(chr, SA.part)
        if not pt then continue end
        local sp, on = cam:WorldToViewportPoint(pt.Position)
        if not on then continue end
        local d = (Vector2.new(sp.X,sp.Y) - ctr).Magnitude
        if d > SA.fov then continue end
        if SA.vis then
            saRp.FilterDescendantsInstances = {lp.Character, chr}
            local dir = pt.Position - cpos
            local h = ws:Raycast(cpos, dir, saRp)
            if h and not h.Instance:IsDescendantOf(chr) then continue end
        end
        -- Use Utility.SphereLineIntersection if available
        local hitRadius = 2.5 -- stud radius for hitbox
        local useUtil = false
        if mUtil then
            pcall(function()
                local rayOrig = cpos
                local rayEnd  = cpos + cam.CFrame.LookVector * 1000
                useUtil = mUtil:SphereLineIntersection(
                    pt.Position, hitRadius, rayOrig, rayEnd
                )
            end)
        end
        if SA.mode == "Closest" then
            if d < bd then bd=d; best=pt; bChar=chr end
        elseif SA.mode == "Furthest" then
            if d > bd then bd=d; best=pt; bChar=chr end
        else
            if not best or math.random() < 0.3 then best=pt; bChar=chr end
        end
    end
    saTarget = best
end

local function applySAHook()
    if saHooked then return end
    if not hookmetamethod then notify("SA: hookmetamethod unavailable",4); return end
    local orig
    orig = hookmetamethod(game, "__namecall", newcclosure(function(self,...)
        local m = getnamecallmethod()
        if m=="Raycast" and (self==ws or self==workspace) then
            if SA.on and saTarget then
                if math.random(1,100) <= SA.hit then
                    if not checkcaller() then
                        local a = {...}
                        local origin = a[1]; local dir = a[2]
                        if origin and dir and typeof(origin)=="Vector3" and typeof(dir)=="Vector3" then
                            if dir.Magnitude > 50 then
                                local dfc = (origin - cam.CFrame.Position).Magnitude
                                if dfc < 20 then
                                    local nd = (saTarget.Position - origin).Unit * dir.Magnitude
                                    return orig(self, origin, nd, a[3])
                                end
                            end
                        end
                    end
                end
            end
        end
        return orig(self,...)
    end))
    saHooked = true
end


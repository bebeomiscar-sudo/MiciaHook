local function getBestPart(char, setting)
    local preset = TARGET_PART_PRESETS[setting] or {"Head"}
    if preset[1] == "Random" then
        local available = {}
        for _, pn in ipairs(ALL_TARGET_PARTS) do
            local p = char:FindFirstChild(pn)
            if p then table.insert(available, p) end
        end
        return #available > 0 and available[math.random(1,#available)] or nil
    end
    for _, pn in ipairs(preset) do
        local p = char:FindFirstChild(pn); if p then return p end
    end
    for _, pn in ipairs(ALL_TARGET_PARTS) do
        local p = char:FindFirstChild(pn); if p then return p end
    end
    return nil
end

-- ═══════════════════════════════════════════
-- ENEMY SORTING
-- ═══════════════════════════════════════════
local function GetEnemiesSorted(cfg)
    cfg = cfg or ProjectileTPCFG
    local list   = {}
    local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LP then continue end
        if not IsAlive(player) then continue end
        if cfg.TeamCheck and isSameTeamRivals(player) then continue end
        local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if root and myRoot then
            local dist = (myRoot.Position - root.Position).Magnitude
            if dist <= cfg.MaxDistance then
                if cfg.VisCheck and not isVisible(myRoot.Position, root) then continue end
                table.insert(list, {player=player, dist=dist})
            end
        end
    end
    local priority = cfg.Priority or "Closest"
    if priority == "Closest" then
        table.sort(list, function(a,b) return a.dist < b.dist end)
    elseif priority == "Furthest" then
        table.sort(list, function(a,b) return a.dist > b.dist end)
    elseif priority == "Random" then
        for i = #list, 2, -1 do
            local j = math.random(i); list[i], list[j] = list[j], list[i]
        end
    elseif priority == "Lowest HP" then
        table.sort(list, function(a,b)
            local ha = a.player.Character:FindFirstChildOfClass("Humanoid")
            local hb = b.player.Character:FindFirstChildOfClass("Humanoid")
            return (ha and ha.Health or 0) < (hb and hb.Health or 0)
        end)
    elseif priority == "Highest HP" then
        table.sort(list, function(a,b)
            local ha = a.player.Character:FindFirstChildOfClass("Humanoid")
            local hb = b.player.Character:FindFirstChildOfClass("Humanoid")
            return (ha and ha.Health or 0) > (hb and hb.Health or 0)
        end)
    end
    local result = {}
    for _, e in ipairs(list) do table.insert(result, e.player) end
    return result
end

local function GetClosestEnemy()
    return GetEnemiesSorted(ProjectileTPCFG)[1]
end

local function CacheEnemies()
    EnemyCache = GetEnemiesSorted(ProjectileTPCFG)
end


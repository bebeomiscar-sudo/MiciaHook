-- ═══════════════════════════════════════════
local AC_KEYWORDS = {
    "anticheat", "ac_", "detection", "exploit_check",
    "securitycheck", "clientcheck", "remotespy"
}

local function applyBypass()
    coroutine.wrap(function()
        -- Fix 1: xpcall now has proper error handler as second argument
        -- Fix 2: AC_KEYWORDS replaces undefined slur variable
        xpcall(function()
            local function blockScript(obj)
                if obj:IsA("LocalScript") or obj:IsA("ModuleScript") then
                    local n = obj.Name:lower()
                    for _, keyword in pairs(AC_KEYWORDS) do
                        if n:find(keyword) then
                            -- Fix 3: xpcall with proper error handler
                            xpcall(
                                function() obj.Disabled = true end,
                                function(err) end -- silent error handler
                            )
                            break
                        end
                    end
                end
            end
            for _, obj in pairs(game:GetDescendants()) do
                blockScript(obj)
            end
            game.DescendantAdded:Connect(blockScript)
        end, function(err) end) -- Fix: added error handler

        xpcall(function()
            local networkClient = game:GetService("NetworkClient")
            if networkClient then
                networkClient.ChildAdded:Connect(function(child)
                    local n = child.Name:lower()
                    -- Fix: replaced slur variable names with descriptive ones
                    local suspiciousNames = {"internalcheck", "secmonitor", "detectcore"}
                    for _, keyword in ipairs(suspiciousNames) do
                        if n:find(keyword) then
                            xpcall(
                                function() child:Destroy() end,
                                function(err) end
                            )
                            break
                        end
                    end
                end)
            end
        end, function(err) end) -- Fix: added error handler
    end)()
end

applyBypass()


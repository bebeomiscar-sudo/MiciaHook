-- SKIN CHANGER — ANIMATION HOOK
-- ═══════════════════════════════════════════
local originalAnimInfo  = {}
local currentAnimWeapon = nil
local currentAnimSkin   = nil
local animHookActive    = false

local function hasCustomAnims(weaponPrefix, skinPrefix)
    if not animLib or not animLib.Info then return false end
    local base = weaponPrefix .. "_" .. skinPrefix .. "_"
    for k in pairs(animLib.Info) do
        if string.sub(k, 1, #base) == base then return true end
    end
    return false
end

local function hookAnimations(weaponName, skinName)
    if not animLib or not animLib.Info then return false end
    local weaponPrefix = WEAPON_TO_ANIM_PREFIX[weaponName]
    if not weaponPrefix then return false end
    local skinPrefix = SKIN_TO_ANIM_PREFIX[skinName]
    if not skinPrefix then return false end
    if not hasCustomAnims(weaponPrefix, skinPrefix) then return false end

    local overridePrefix    = weaponPrefix .. "_" .. skinPrefix .. "_"
    local overridePrefixLen = #overridePrefix

    for animKey, animData in pairs(animLib.Info) do
        if string.sub(animKey, 1, overridePrefixLen) == overridePrefix then
            local action  = string.sub(animKey, overridePrefixLen + 1)
            local baseKey = weaponPrefix .. "_" .. action
            if animLib.Info[baseKey] and not originalAnimInfo[baseKey] then
                originalAnimInfo[baseKey] = animLib.Info[baseKey]
            end
            animLib.Info[baseKey] = animData
        end
    end

    currentAnimWeapon = weaponName
    currentAnimSkin   = skinName
    animHookActive    = true
    return true
end

local function unhookAnimations()
    if not animLib or not animLib.Info then return end
    for baseKey, originalData in pairs(originalAnimInfo) do
        animLib.Info[baseKey] = originalData
    end
    originalAnimInfo  = {}
    currentAnimWeapon = nil
    currentAnimSkin   = nil
    animHookActive    = false
end


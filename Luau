local TriggerState = { waiting=false, delayTimer=0, cooldownTimer=0 }
local function getTriggerTarget()
    local c=getScreenCenter(); local o=camera.CFrame.Position; local d=(camera.CFrame.LookVector)*1000
    local p=RaycastParams.new(); p.FilterType=Enum.RaycastFilterType.Exclude; local fl={camera}; if LP.Character then table.insert(fl,LP.Character) end; p.FilterDescendantsInstances=fl
    local h=workspace:Raycast(o,d,p); if not h or not h.Instance then return nil end
    local hc,inst=nil,h.Instance; while inst do if inst:FindFirstChildOfClass("Humanoid") then hc=inst; break end; inst=inst.Parent end
    if not hc then return nil end; local hum=hc:FindFirstChildOfClass("Humanoid"); if not hum or hum.Health<=0 then return nil end
    local tp=Players:GetPlayerFromCharacter(hc); if tp==LP then return nil end
    if CFG.Trigger.TeamCheck and tp and isSameTeam(tp) then return nil end
    local root=hc:FindFirstChild("HumanoidRootPart") or hc:FindFirstChild("Head")
    if root then local sp,on=camera:WorldToScreenPoint(root.Position); if on then if (Vector2.new(sp.X,sp.Y)-c).Magnitude>CFG.Trigger.FOV then return nil end end end
    return hc
end


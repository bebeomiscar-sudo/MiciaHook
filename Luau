-- PART SYSTEM
-- ══════════════════════════════════════════════════
local PARTS = {
    "Head","UpperTorso","LowerTorso","HumanoidRootPart",
    "Body","Head, Body","Body, Head","Random"
}
local PMAP = {
    ["Head"]             = {"Head"},
    ["HumanoidRootPart"] = {"HumanoidRootPart"},
    ["UpperTorso"]       = {"UpperTorso","Torso","HumanoidRootPart"},
    ["LowerTorso"]       = {"LowerTorso","Torso","HumanoidRootPart"},
    ["Body"]             = {"UpperTorso","LowerTorso","Torso","HumanoidRootPart"},
    ["Head, Body"]       = {"Head","UpperTorso","LowerTorso","HumanoidRootPart"},
    ["Body, Head"]       = {"UpperTorso","LowerTorso","HumanoidRootPart","Head"},
    ["Random"]           = {"_random"},
}

local function getPart(char, setting)
    local preset = PMAP[setting] or {"Head"}
    if preset[1] == "_random" then
        local pool = {}
        for _, n in ipairs({"Head","UpperTorso","LowerTorso","HumanoidRootPart"}) do
            local p = char:FindFirstChild(n)
            if p then table.insert(pool, p) end
        end
        return #pool > 0 and pool[math.random(1, #pool)] or nil
    end
    for _, n in ipairs(preset) do
        local p = char:FindFirstChild(n)
        if p then return p end
    end
    return nil
end


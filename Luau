local function makeDrawing(dtype, props)
    local d = Drawing.new(dtype)
    for k, v in pairs(props) do d[k] = v end
    return d
end

local function clearESPFor(p)
    local obj = espObjects[p]
    if not obj then return end
    for _, v in pairs(obj) do
        if type(v) == "table" then
            for _, line in pairs(v) do if line.Remove then line:Remove() end end
        elseif v and v.Remove then
            v:Remove()
        end
    end
    espObjects[p] = nil
end

local function clearAllESP()
    for p in pairs(espObjects) do clearESPFor(p) end
end

local function getViewModels()
    local vm = Workspace:FindFirstChild("ViewModels")
    return vm
end

local function getEnemyWeaponName(p)
    local vm = getViewModels()
    if not vm then return nil end
    for _, m in ipairs(vm:GetChildren()) do
        if m:IsA("Model") then
            local parts = string.split(m.Name, " - ")
            if parts[1] == p.Name then
                return parts[3] or parts[2] or m.Name
            end
        end
    end
    return nil
end

local function getCharBounds(ch)
    local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
    local anyOnScreen = false
    for _, part in ipairs(ch:GetDescendants()) do
        if part:IsA("BasePart") then
            local sp, on = camera:WorldToViewportPoint(part.Position)
            if on then
                anyOnScreen = true
                if sp.X < minX then minX = sp.X end
                if sp.Y < minY then minY = sp.Y end
                if sp.X > maxX then maxX = sp.X end
                if sp.Y > maxY then maxY = sp.Y end
            end
        end
    end
    if not anyOnScreen then return nil end
    return minX, minY, maxX, maxY
end

local function updateESP()
    if not ESPConfig.Enabled then clearAllESP(); return end
    camera = Workspace.CurrentCamera

    local activePlayers = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LP then continue end
        if ESPConfig.TeamCheck and isSameTeam(p) then continue end
        local ch  = p.Character
        local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
        local hum = ch and ch:FindFirstChildOfClass("Humanoid")
        if not ch or not hrp or not hum then
            clearESPFor(p); continue
        end
        if hum.Health <= 0 then clearESPFor(p); continue end

        local sp, onScreen = camera:WorldToViewportPoint(hrp.Position)
        if not onScreen then
            -- hide but keep
            local obj = espObjects[p]
            if obj then
                if obj.name    then obj.name.Visible    = false end
                if obj.dist    then obj.dist.Visible    = false end
                if obj.weapon  then obj.weapon.Visible  = false end
                if obj.health  then obj.health.Visible  = false end
                if obj.box     then obj.box.Visible     = false end
                if obj.tracer  then obj.tracer.Visible  = false end
                if obj.charm   then obj.charm.Visible   = false end
                if obj.lines   then for _, l in pairs(obj.lines) do l.Visible = false end end
            end
            continue
        end
        activePlayers[p] = true

        if not espObjects[p] then
            espObjects[p] = {
                lines  = {},
                name   = makeDrawing("Text",      {Visible=false,Center=true,Outline=true,Size=14,Font=2}),
                dist   = makeDrawing("Text",      {Visible=false,Center=true,Outline=true,Size=12,Font=2}),
                weapon = makeDrawing("Text",      {Visible=false,Center=true,Outline=true,Size=12,Font=2}),
                health = makeDrawing("Text",      {Visible=false,Center=true,Outline=true,Size=12,Font=2}),
                box    = makeDrawing("Square",    {Visible=false,Filled=false,Thickness=1.5}),
                tracer = makeDrawing("Line",      {Visible=false,Thickness=1.5}),
                charm  = makeDrawing("Square",    {Visible=false,Filled=false,Thickness=1}),
            }
            for i = 1, #SKELETON_CONNECTIONS do
                espObjects[p].lines[i] = makeDrawing("Line", {Visible=false,Thickness=1})
            end
        end

        local obj  = espObjects[p]
        local dist = (camera.CFrame.Position - hrp.Position).Magnitude
        local screenPos = Vector2.new(sp.X, sp.Y)

        -- Box
        if ESPConfig.Boxes then
            local x1, y1, x2, y2 = getCharBounds(ch)
            if x1 then
                obj.box.Position  = Vector2.new(x1, y1)
                obj.box.Size      = Vector2.new(x2 - x1, y2 - y1)
                obj.box.Color     = ESPConfig.BoxColor
                obj.box.Visible   = true
            else
                obj.box.Visible = false
            end
        else
            obj.box.Visible = false
        end

        -- Name
        if ESPConfig.Names then
            obj.name.Position = screenPos - Vector2.new(0, 30)
            obj.name.Text     = p.DisplayName
            obj.name.Color    = ESPConfig.NameColor
            obj.name.Visible  = true
        else obj.name.Visible = false end

        -- Distance
        if ESPConfig.Distance then
            obj.dist.Position = screenPos - Vector2.new(0, 44)
            obj.dist.Text     = string.format("%.0f studs", dist)
            obj.dist.Color    = ESPConfig.DistColor
            obj.dist.Visible  = true
        else obj.dist.Visible = false end

        -- Weapon
        if ESPConfig.Weapon then
            local wep = getEnemyWeaponName(p) or "Unknown"
            obj.weapon.Position = screenPos + Vector2.new(0, 20)
            obj.weapon.Text     = wep
            obj.weapon.Color    = ESPConfig.WeaponColor
            obj.weapon.Visible  = true
        else obj.weapon.Visible = false end

        -- Health
        if ESPConfig.Health then
            local hp  = math.floor(hum.Health + 0.5)
            local mhp = math.floor(hum.MaxHealth + 0.5)
            obj.health.Position = screenPos + Vector2.new(0, 34)
            obj.health.Text     = hp .. " / " .. mhp
            obj.health.Color    = ESPConfig.HealthColor
            obj.health.Visible  = true
        else obj.health.Visible = false end

        -- Charms (small box around charm slot – Head area)
        local head = ch:FindFirstChild("Head")
        if ESPConfig.Charms and head then
            local hsp, hon = camera:WorldToViewportPoint(head.Position)
            if hon then
                local sz = math.clamp(300 / dist, 4, 20)
                obj.charm.Position  = Vector2.new(hsp.X - sz/2, hsp.Y - sz/2)
                obj.charm.Size      = Vector2.new(sz, sz)
                obj.charm.Color     = ESPConfig.CharmColor
                obj.charm.Filled    = ESPConfig.CharmsFilled
                obj.charm.Visible   = true
            else obj.charm.Visible = false end
        else obj.charm.Visible = false end

        -- Tracer
        if ESPConfig.Tracers then
            obj.tracer.From    = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
            obj.tracer.To      = screenPos
            obj.tracer.Color   = ESPConfig.TracerColor
            obj.tracer.Visible = true
        else obj.tracer.Visible = false end

        -- Skeleton
        if ESPConfig.Skeleton then
            for i, conn in ipairs(SKELETON_CONNECTIONS) do
                local pA = ch:FindFirstChild(conn[1])
                local pB = ch:FindFirstChild(conn[2])
                local line = obj.lines[i]
                if pA and pB then
                    local sA, oA = camera:WorldToViewportPoint(pA.Position)
                    local sB, oB = camera:WorldToViewportPoint(pB.Position)
                    if oA and oB then
                        line.From    = Vector2.new(sA.X, sA.Y)
                        line.To      = Vector2.new(sB.X, sB.Y)
                        line.Color   = ESPConfig.SkeletonColor
                        line.Visible = true
                    else line.Visible = false end
                else line.Visible = false end
            end
        else
            for _, line in pairs(obj.lines) do line.Visible = false end
        end
    end

    -- Cleanup disconnected
    for p in pairs(espObjects) do
        if not activePlayers[p] and not (p.Character and p.Character.Parent) then
            clearESPFor(p)
        end
    end
end


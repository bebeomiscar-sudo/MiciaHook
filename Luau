-- ENHANCED RAGEBOT - All Weapons Support
-- ═══════════════════════════════════════════
local ragebotConn = nil
local rageReloadCooldown = 0

local function detectWeaponType(item)
    if not item then return "Gun" end
    
    local name = ""
    pcall(function() name = item:Get("Name") or item.Name or "" end)
    
    if name:find("Bow") or name:find("Crossbow") then return "Bow" end
    if name:find("Dagger") or name:find("Knife") or name:find("Fist") then return "Dagger" end
    if name:find("Slingshot") or name:find("Sling") then return "Slingshot" end
    
    return "Gun"
end

local function rageGetTarget(weaponType)
    if not LP.Character or not LP.Character:FindFirstChild("HumanoidRootPart") then 
        return nil, nil 
    end
    
    local maxDist = RageCFG.MaxDist
    if weaponType == "Dagger" then
        maxDist = math.min(maxDist, RageCFG.DaggerRange)
    elseif weaponType == "Bow" then
        maxDist = math.min(maxDist, 300)
    elseif weaponType == "Slingshot" then
        maxDist = math.min(maxDist, 200)
    end
    
    local target, tchar, dist = nil, nil, maxDist
    
    for _, v in next, players:GetPlayers() do
        if v == LP then continue end
        if RageCFG.TeamCheck and isSameTeamRivals(v) then continue end
        if not v.Character then continue end
        
        local hum = v.Character:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end
        
        local head = v.Character:FindFirstChild("Head")
        if not head then continue end
        
        local mag = (LP.Character.HumanoidRootPart.Position - head.Position).Magnitude
        if mag < dist then 
            dist = mag
            target = head
            tchar = v.Character 
        end
    end
    
    return target, tchar
end

local function fireRageWeapon(item, target, tchar, weaponType)
    if not item or not target then return end
    
    pcall(function()
        local objectId = item:Get("ObjectID")
        local targetPos = target.Position
        
        if weaponType == "Bow" and RageCFG.SupportBow then
            local aimOffset = Vector3.new(0, 0.5, 0)
            targetPos = targetPos + aimOffset
            
            pcall(function() item:StartCharging() end)
            task.wait(RageCFG.BowChargeTime)
            
            local cd = {}
            cd[utf8.char(1)] = {
                [utf8.char(0)] = util_mod:EncodeCFrame(CFrame.new(Workspace.CurrentCamera.CFrame.Position)),
                [utf8.char(1)] = util_mod:EncodeCFrame(CFrame.new(targetPos)),
                [utf8.char(2)] = target,
                [utf8.char(3)] = util_mod:EncodeCFrame(target.CFrame:ToObjectSpace(CFrame.new(targetPos))),
            }
            
            rs.Remotes.Replication.Fighter.UseItem:FireServer(
                objectId,
                enums_mod:ToEnum("ReleaseCharge"),
                cd,
                nil
            )
            
        elseif weaponType == "Dagger" and RageCFG.SupportDagger then
            for i = 1, 3 do
                local slashDir = (targetPos - LP.Character.HumanoidRootPart.Position).Unit
                
                rs.Remotes.Replication.Fighter.UseItem:FireServer(
                    objectId,
                    enums_mod:ToEnum("Slash"),
                    {slashDir},
                    nil
                )
                task.wait(0.08)
            end
            
        elseif weaponType == "Slingshot" and RageCFG.SupportSlingshot then
            local velocity = target.AssemblyLinearVelocity or Vector3.new(0, 0, 0)
            local timeToHit = (targetPos - LP.Character.HumanoidRootPart.Position).Magnitude / RageCFG.SlingshotSpeed
            targetPos = targetPos + (velocity * timeToHit) + Vector3.new(0, 0.3, 0)
            
            local cd = {}
            cd[utf8.char(1)] = {
                [utf8.char(0)] = util_mod:EncodeCFrame(CFrame.new(LP.Character.HumanoidRootPart.Position)),
                [utf8.char(1)] = util_mod:EncodeCFrame(CFrame.new(targetPos)),
                [utf8.char(2)] = target,
            }
            
            rs.Remotes.Replication.Fighter.UseItem:FireServer(
                objectId,
                enums_mod:ToEnum("Shoot"),
                cd,
                nil
            )
            
        elseif RageCFG.SupportGuns then
            local ray_params_sa = RaycastParams.new()
            ray_params_sa.FilterDescendantsInstances = {LP.Character, tchar}
            ray_params_sa.FilterType = Enum.RaycastFilterType.Exclude
            
            local SA_PEEK_OFFSETS_RB = {
                Vector3.new(0, 12, 0), Vector3.new(0, 16, 0), Vector3.new(0, 20, 0),
                Vector3.new(0, 24, 0), Vector3.new(0, 28, 0), Vector3.new(0, 32, 0),
                Vector3.new(0, 36, 0), Vector3.new(0, 40, 0),
            }
            
            local cam = Workspace.CurrentCamera.CFrame
            local manip, height
            
            if not RageCFG.VisibleCheck then 
                manip = cam.Position
            elseif not Workspace:Raycast(cam.Position, targetPos - cam.Position, ray_params_sa) then 
                manip = cam.Position
            else
                for _, offset in next, SA_PEEK_OFFSETS_RB do
                    local sp = cam.Position + offset
                    if not Workspace:Raycast(sp, targetPos - sp, ray_params_sa) then 
                        manip = sp
                        height = offset.Y
                        break
                    end
                end
            end
            
            if not manip then return end
            
            local sp   = (height == nil and manip) or cam.Position
            local cd   = {}
            cd[utf8.char(1)] = {
                [utf8.char(0)] = util_mod:EncodeCFrame(
                    CFrame.new(sp.X, sp.Y + (height or 0), sp.Z)
                    * CFrame.Angles(CFrame.lookAt(sp, targetPos):ToOrientation())
                ),
                [utf8.char(1)] = height and
                    util_mod:EncodeCFrame(
                        CFrame.new(targetPos)
                        * CFrame.Angles(CFrame.lookAt(sp, targetPos):ToOrientation())
                    ) or
                    util_mod:EncodeCFrame(
                        CFrame.new(sp.X, sp.Y + (height or 0), sp.Z)
                        * CFrame.Angles(CFrame.lookAt(sp, targetPos):ToOrientation())
                    ),
                [utf8.char(2)] = target,
                [utf8.char(3)] = util_mod:EncodeCFrame(target.CFrame:ToObjectSpace(CFrame.new(targetPos))),
            }
            
            rs.Remotes.Replication.Fighter.UseItem:FireServer(
                objectId,
                enums_mod:ToEnum("StartShooting"),
                cd,
                nil
            )
        end
    end)
end

local function tryRageReload(item)
    if not item then return end
    pcall(function()
        rs.Remotes.Replication.Fighter.UseItem:FireServer(
            item:Get("ObjectID"), 
            enums_mod:ToEnum("Reload"), 
            {}, 
            nil
        )
        rs.Remotes.Replication.Fighter.UseItem:FireServer(
            item:Get("ObjectID"), 
            enums_mod:ToEnum("StartReloading"), 
            {}, 
            nil
        )
    end)
end

local function startEnhancedRagebot()
    if ragebotConn then 
        ragebotConn:Disconnect() 
    end
    
    ragebotConn = RunService.Heartbeat:Connect(function(dt)
        if not RageCFG.On or not LP.Character then return end
        if not LP.Character:FindFirstChild("HumanoidRootPart") then return end
        if not fighter_mod or not fighter_mod.LocalFighter then return end
        
        local item = fighter_mod.LocalFighter.EquippedItem
        if not item then return end
        
        local weaponType = detectWeaponType(item)
        
        if weaponType == "Bow" and not RageCFG.SupportBow then return end
        if weaponType == "Dagger" and not RageCFG.SupportDagger then return end
        if weaponType == "Slingshot" and not RageCFG.SupportSlingshot then return end
        if weaponType == "Gun" and not RageCFG.SupportGuns then return end
        
        if weaponType == "Gun" then
            rageReloadCooldown = rageReloadCooldown - dt
            local ammo = nil
            pcall(function() 
                ammo = item:Get("CurrentAmmo") 
            end)
            
            if ammo ~= nil and ammo <= 0 and rageReloadCooldown <= 0 then
                tryRageReload(item)
                rageReloadCooldown = 2.0
                return
            end
        end
        
        local tp, tc = rageGetTarget(weaponType)
        if not tp or not tc then return end
        
        fireRageWeapon(item, tp, tc, weaponType)
    end)
end

local function stopEnhancedRagebot()
    if ragebotConn then 
        ragebotConn:Disconnect()
        ragebotConn = nil 
    end
end


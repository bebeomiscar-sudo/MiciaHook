-- MAIN LOOPS
-- ═══════════════════════════════════════════

RunService.RenderStepped:Connect(function()
    local dt = RunService.Heartbeat:Wait()
    
    -- Update FOV Circles
    local center = getScreenCenter()
    
    fovCircle.Position = center
    fovCircle.Radius = getEffectiveFOV()
    applyFOVStyle(fovCircle, AimbotCFG.FOVStyle)
    
    saFovCircle.Position = center
    saFovCircle.Radius = saGetEffectiveFOV()
    if SAHookCFG.DrawFOV and SAHookCFG.On and not SAHookCFG.IgnoreFOV then
        saFovCircle.Visible = true
    else
        saFovCircle.Visible = false
    end
    
    -- Aimbot Logic
    if AimbotCFG.On then
        if not lockedTarget or not isTargetStillValid(lockedTarget) then
            lockTimer = lockTimer + dt
            if lockTimer >= (AimbotCFG.ForgotTime / 10) then
                lockedTarget = findNewAimbotTarget()
                lockTimer = 0
                reactionTimer = 0
                isInReaction = true
                resetDelayedPos()
            end
        else
            lockTimer = 0
        end
        
        if lockedTarget and lockedTarget.Parent then
            if isInReaction then
                reactionTimer = reactionTimer + (dt * 1000)
                if reactionTimer >= AimbotCFG.ReactionTime then
                    isInReaction = false
                end
            else
                local delayedPos = getDelayedPos(lockedTarget, dt)
                if delayedPos and CameraController then
                    local targetCFrame = CFrame.new(camera.CFrame.Position, delayedPos)
                    local smoothFactor = math.clamp(AimbotCFG.Smoothness / 100, 0.01, 1)
                    local newRotation = camera.CFrame:Lerp(targetCFrame, smoothFactor)
                    CameraController:SetRotation(newRotation.Rotation)
                end
            end
        end
    else
        lockedTarget = nil
        lockTimer = 0
        reactionTimer = 0
        isInReaction = false
        resetDelayedPos()
    end
end)


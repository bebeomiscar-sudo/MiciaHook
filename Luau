-- TOGGLE (big touch targets)
local function makeToggle(parent, label, default, order, callback)
    local state = default or false

    local frame = make("Frame", {
        Size = UDim2.new(1, 0, 0, TOGGLE_H),
        BackgroundColor3 = C.elem,
        BorderSizePixel = 0,
        LayoutOrder = order or 0,
        Parent = parent,
    })
    make("UICorner", { CornerRadius = UDim.new(0, s(3)), Parent = frame })

    make("TextLabel", {
        Size = UDim2.new(1, -s(60), 1, 0),
        Position = UDim2.new(0, s(12), 0, 0),
        BackgroundTransparency = 1,
        Text = label,
        TextColor3 = C.text,
        Font = Enum.Font.Gotham,
        TextSize = FONT_MAIN,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Parent = frame,
    })

    local trackW = s(40)
    local trackH = s(20)
    local knobS  = s(16)

    local track = make("Frame", {
        Size = UDim2.new(0, trackW, 0, trackH),
        Position = UDim2.new(1, -trackW - s(10), 0.5, -trackH/2),
        BackgroundColor3 = state and C.accent or C.off,
        BorderSizePixel = 0,
        Parent = frame,
    })
    make("UICorner", { CornerRadius = UDim.new(0, trackH/2), Parent = track })

    local knob = make("Frame", {
        Size = UDim2.new(0, knobS, 0, knobS),
        Position = state
            and UDim2.new(1, -knobS - s(2), 0.5, -knobS/2)
            or  UDim2.new(0, s(2), 0.5, -knobS/2),
        BackgroundColor3 = C.text,
        BorderSizePixel = 0,
        Parent = track,
    })
    make("UICorner", { CornerRadius = UDim.new(1, 0), Parent = knob })

    local btn = make("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "",
        Parent = frame,
    })

    local function toggle()
        state = not state
        tw(track, 0.18, { BackgroundColor3 = state and C.accent or C.off })
        tw(knob, 0.18, {
            Position = state
                and UDim2.new(1, -knobS - s(2), 0.5, -knobS/2)
                or  UDim2.new(0, s(2), 0.5, -knobS/2)
        })
        if callback then callback(state) end
    end

    btn.MouseButton1Click:Connect(toggle)
    btn.TouchTap:Connect(function() -- extra mobile safety
    end)

    return {
        getState = function() return state end,
        setState = function(v)
            state = v
            track.BackgroundColor3 = v and C.accent or C.off
            knob.Position = v
                and UDim2.new(1, -knobS - s(2), 0.5, -knobS/2)
                or  UDim2.new(0, s(2), 0.5, -knobS/2)
        end,
    }
end

-- SLIDER (touch + mouse)
local function makeSlider(parent, label, min, max, default, increment, order, callback)
    local value = default

    local frame = make("Frame", {
        Size = UDim2.new(1, 0, 0, SLIDER_H),
        BackgroundColor3 = C.elem,
        BorderSizePixel = 0,
        LayoutOrder = order or 0,
        Parent = parent,
    })
    make("UICorner", { CornerRadius = UDim.new(0, s(3)), Parent = frame })

    make("TextLabel", {
        Size = UDim2.new(0.6, 0, 0, s(22)),
        Position = UDim2.new(0, s(12), 0, s(2)),
        BackgroundTransparency = 1,
        Text = label,
        TextColor3 = C.text,
        Font = Enum.Font.Gotham,
        TextSize = s(12),
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Parent = frame,
    })

    local valLabel = make("TextLabel", {
        Size = UDim2.new(0.35, 0, 0, s(22)),
        Position = UDim2.new(0.62, 0, 0, s(2)),
        BackgroundTransparency = 1,
        Text = fmtN(value, increment),
        TextColor3 = C.dim,
        Font = Enum.Font.GothamSemibold,
        TextSize = s(12),
        TextXAlignment = Enum.TextXAlignment.Right,
        Parent = frame,
    })

    local barH = s(8)
    local trackBG = make("Frame", {
        Size = UDim2.new(1, -s(24), 0, barH),
        Position = UDim2.new(0, s(12), 0, SLIDER_H - barH - s(10)),
        BackgroundColor3 = C.border,
        BorderSizePixel = 0,
        Parent = frame,
    })
    make("UICorner", { CornerRadius = UDim.new(0, s(3)), Parent = trackBG })

    local pct = math.clamp((default - min) / (max - min), 0, 1)

    local fill = make("Frame", {
        Size = UDim2.new(pct, 0, 1, 0),
        BackgroundColor3 = C.accent,
        BorderSizePixel = 0,
        Parent = trackBG,
    })
    make("UICorner", { CornerRadius = UDim.new(0, s(3)), Parent = fill })

    local handleS = s(18)
    local handle = make("Frame", {
        Size = UDim2.new(0, handleS, 0, handleS),
        Position = UDim2.new(pct, -handleS/2, 0.5, -handleS/2),
        BackgroundColor3 = C.text,
        BorderSizePixel = 0,
        ZIndex = 3,
        Parent = trackBG,
    })
    make("UICorner", { CornerRadius = UDim.new(1, 0), Parent = handle })

    -- Invisible bigger touch area over the slider track
    local touchZone = make("TextButton", {
        Size = UDim2.new(1, s(20), 0, s(30)),
        Position = UDim2.new(0, -s(10), 0.5, -s(15)),
        BackgroundTransparency = 1,
        Text = "",
        ZIndex = 4,
        Parent = trackBG,
    })

    local sliding = false

    local function updateSlider(inputX)
        local absX = trackBG.AbsolutePosition.X
        local absW = trackBG.AbsoluteSize.X
        local rel = math.clamp((inputX - absX) / absW, 0, 1)
        local raw = min + (max - min) * rel
        value = math.floor(raw / increment + 0.5) * increment
        value = math.clamp(value, min, max)
        local finalPct = (value - min) / (max - min)
        fill.Size = UDim2.new(finalPct, 0, 1, 0)
        handle.Position = UDim2.new(finalPct, -handleS/2, 0.5, -handleS/2)
        valLabel.Text = fmtN(value, increment)
        if callback then callback(value) end
    end

    touchZone.InputBegan:Connect(function(input)
        if isTouchOrMouse(input) then
            sliding = true
            updateSlider(input.Position.X)
        end
    end)

    handle.InputBegan:Connect(function(input)
        if isTouchOrMouse(input) then
            sliding = true
        end
    end)

    table.insert(ActiveConnections, UIS.InputChanged:Connect(function(input)
        if sliding and isTouchOrMouseMove(input) then
            updateSlider(input.Position.X)
        end
    end))

    table.insert(ActiveConnections, UIS.InputEnded:Connect(function(input)
        if isTouchOrMouse(input) then
            sliding = false
        end
    end))

    return {
        getValue = function() return value end,
        setValue = function(v)
            value = v
            local p = (v - min) / (max - min)
            fill.Size = UDim2.new(p, 0, 1, 0)
            handle.Position = UDim2.new(p, -handleS/2, 0.5, -handleS/2)
            valLabel.Text = fmtN(v, increment)
        end,
    }
end


local POSES = {Spider=POSE_SPIDER, UpsideDown=POSE_UPSIDEDOWN, Kneel=POSE_KNEEL}

local function activatePose(name)
    activePoseName = name
    S.Player.Spider=false; S.Player.UpsideDown=false; S.Player.Kneel=false
    if spiderConn then spiderConn:Disconnect(); spiderConn=nil end
    local char = LP.Character
    if char then
        for _, m in pairs(char:GetDescendants()) do
            if m:IsA("Motor6D") and spiderOrigC0[m] then
                xpcall(function() m.C0 = spiderOrigC0[m] end, function(err) end)
            end
        end
    end
    spiderOrigC0 = {}
    if not name then return end
    S.Player[name] = true
    local char2 = LP.Character; if not char2 then return end
    for _, m in pairs(char2:GetDescendants()) do
        if m:IsA("Motor6D") then spiderOrigC0[m] = m.C0 end

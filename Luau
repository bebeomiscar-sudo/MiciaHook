--━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
local function anim2track(asset_id)
    local success, objs = pcall(function()
        return game:GetObjects(asset_id)
    end)
    if success and objs then
        for i = 1, #objs do
            if objs[i]:IsA("Animation") then
                return objs[i].AnimationId
            end
        end
    end
    return asset_id
end

local function stopEmote()
    EmoteState.playing = false
    if EmoteState.currentTrack then
        pcall(function()
            EmoteState.currentTrack:Stop()
            EmoteState.currentTrack:Destroy()
        end)
        EmoteState.currentTrack = nil
    end
    if EmoteState.animObject then
        pcall(function()
            EmoteState.animObject:Destroy()
        end)
        EmoteState.animObject = nil
    end
end

function playEmote(animId, speed)
    stopEmote()

    if not animId or animId == "" then return end
    local char = LP.Character
    if not char then return end
    local hum = char:FindFirstChildWhichIsA("Humanoid")
    if not hum then return end

    local cleanId = tostring(animId):gsub("%s+", "")
    if not cleanId:find("rbxassetid://") then
        cleanId = "rbxassetid://" .. cleanId
    end

    local resolvedId = anim2track(cleanId)

    local animation = Instance.new("Animation")
    animation.AnimationId = resolvedId
    EmoteState.animObject = animation

    for _, track in next, hum:GetPlayingAnimationTracks() do
        track:Stop()
    end

    local success, track = pcall(function()
        return hum:LoadAnimation(animation)
    end)

    if not success or not track then
        local animator = hum:FindFirstChildOfClass("Animator")
        if animator then
            success, track = pcall(function()
                return animator:LoadAnimation(animation)
            end)
        end
    end

    if success and track then
        track.Priority = Enum.AnimationPriority.Action4
        track:Play()
        track:AdjustSpeed(speed or 1)
        EmoteState.currentTrack = track
        EmoteState.playing = true

        track.Stopped:Connect(function()
            if CFG.Emote.On and CFG.Emote.Loop and EmoteState.playing then
                task.wait(0.05)
                if CFG.Emote.On and LP.Character and LP.Character:FindFirstChildWhichIsA("Humanoid") then
                    playEmote(CFG.Emote.AnimID, CFG.Emote.Speed)
                end
            end
        end)
    end
end


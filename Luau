    accent.BorderSizePixel  = 0
    local al = Instance.new("UICorner", accent)
    al.CornerRadius = UDim.new(0, 2)
    local nl = Instance.new("TextLabel", n)
    nl.Size             = UDim2.new(1, -12, 1, 0)

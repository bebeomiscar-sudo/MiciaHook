-- ═══════════════════════════════════════════
-- CORE RENDER STEP
-- ═══════════════════════════════════════════
RunService.RenderStepped:Connect(function(dt)
    camera = workspace.CurrentCamera
    local center = getScreenCenter()

    -- Crosshair
    if CFG.Crosshair.On then crosshairImg.Position=UDim2.new(0.5,0,0.5,0) end

    -- Stretched resolution
    if StretchCFG.On then
        camera.CFrame = camera.CFrame * CFrame.new(0,0,0,1,0,0,0,StretchCFG.Scale,0,0,0,1)
    end

    -- FOV circles
    if fovCircle then
        fovCircle.Position=center; fovCircle.Radius=AimbotCFG.MaxFOV
        fovCircle.Visible=AimbotCFG.DrawFOV and AimbotCFG.On
    end
    if saFovCircle then
        saFovCircle.Position=center; saFovCircle.Radius=SAHookCFG.IgnoreFOV and 0 or saGetEffectiveFOV()
        saFovCircle.Visible=SAHookCFG.DrawFOV and SAHookCFG.On and not SAHookCFG.IgnoreFOV
    end
    if trigFovCircle then
        trigFovCircle.Position=center; trigFovCircle.Radius=TrigCFG.FOVSize
        trigFovCircle.Visible=TrigCFG.DrawFOV and TrigCFG.On
    end

    -- ══ AIMBOT ══
    -- Fires when: (ADS or toggle active) AND aimbot enabled
    local shouldAim = AimbotCFG.On and (isADS or AimbotCFG.ToggleActive)
    if shouldAim and CameraController then
        -- Reaction timer
        if isInReaction then
            reactionTimer = reactionTimer - dt
            if reactionTimer <= 0 then isInReaction = false end
        end

        if not isInReaction then
            -- Validate current lock
            if lockedTarget and not isTargetStillValid(lockedTarget) then
                lockedTarget=nil; lockTimer=0
            end

            -- Acquire new target
            if not lockedTarget then
                local newT = findNewAimbotTarget()
                if newT then
                    lockedTarget = newT; lockTimer = 0
                    isInReaction = true; reactionTimer = 0  -- no reaction delay in this system
                end
            end

            -- Track locked target
            if lockedTarget then
                lockTimer = lockTimer + dt
                if lockTimer > AimbotCFG.MaxLockTime then
                    lockedTarget=nil; lockTimer=0
                else
                    applyAimbotMove(dt, lockedTarget)
                end
            end
        end
    else
        -- Reset when not aiming
        if not shouldAim then
            lockedTarget=nil; lockTimer=0; isInReaction=false
        end
    end

    -- ══ PC TRIGGERBOT ══
    if TrigCFG.On then
        local tgt = getTriggerTarget()
        if tgt then
            if not TrigState.waiting then TrigState.waiting=true; TrigState.timer=getTrigDelay(); TrigState.grace=TrigCFG.Grace/1000 end
            TrigState.timer = TrigState.timer - dt
            if TrigState.timer <= 0 then simClick(); TrigState.waiting=false; TrigState.timer=0 end
        else
            if TrigState.waiting then
                TrigState.grace = TrigState.grace - dt
                if TrigState.grace <= 0 then TrigState.waiting=false; TrigState.timer=0; TrigState.grace=0 end
            end
        end
    else TrigState.waiting=false; TrigState.timer=0; TrigState.grace=0 end

    -- ══ MOBILE TRIGGERBOT ══
    if IsMobile and MobileTrigCFG.On then
        local sf = MobileTrigCFG.AutoFire or (MobileTrigCFG.HoldToShoot and MobileTrigState.touching)
        if sf then
            local tgt = getMobileTrigTarget()
            if tgt then
                if not MobileTrigState.waiting then MobileTrigState.waiting=true; MobileTrigState.timer=MobileTrigCFG.Delay/1000; MobileTrigState.cooldown=0 end
                MobileTrigState.timer = MobileTrigState.timer - dt
                if MobileTrigState.timer <= 0 then
                    MobileTrigState.cooldown = MobileTrigState.cooldown - dt
                    if MobileTrigState.cooldown <= 0 then simClick(); MobileTrigState.cooldown=MobileTrigCFG.BurstMs/1000 end
                end
            else if not MobileTrigState.touching then MobileTrigState.waiting=false; MobileTrigState.timer=0; MobileTrigState.cooldown=0 end end
        else MobileTrigState.waiting=false; MobileTrigState.timer=0; MobileTrigState.cooldown=0 end
    end

    -- ══ TRACER UPDATE ══
    local now=tick(); local life=TracerCFG.Duration; local keep={}
    for _,t in ipairs(activeTracers) do
        local age=now-t.Born
        if age<life and t.Line and t.Line.Parent then
            local hsp,hon=camera:WorldToViewportPoint(t.HitPos)
            if hon and hsp.Z>0 then
                local sFrom=getTracerOrigin(); local sTo=Vector2.new(hsp.X,hsp.Y); local delta=sTo-sFrom; local len=delta.Magnitude
                if len>=2 then
                    t.Line.Size=UDim2.new(0,len,0,TracerCFG.Thickness)
                    t.Line.Position=UDim2.new(0,sFrom.X,0,sFrom.Y)
                    t.Line.Rotation=math.deg(math.atan2(delta.Y,delta.X))
                end
                t.Line.BackgroundTransparency=TracerCFG.Fade and math.clamp(age/life,0,0.95) or 0
                t.Line.Visible=true
            else t.Line.Visible=false end
            table.insert(keep,t)
        else pcall(function() if t.Line then t.Line:Destroy() end end) end
    end
    activeTracers=keep
end)

-- ═══════════════════════════════════════════
-- CORE HEARTBEAT
-- ═══════════════════════════════════════════
RunService.Heartbeat:Connect(function(dt)
    -- Auto Collect
    local char=LP.Character
    if char then
        local hrp=char:FindFirstChild("HumanoidRootPart"); local hum=char:FindFirstChild("Humanoid")
        if hrp then
            local nh=hum and hum.Health<hum.MaxHealth
            for _,obj in workspace:GetChildren() do
                if obj.Name=="_drop" and obj:IsA("BasePart") then
                    if (CFG.Collect.Health and obj:FindFirstChild("Health") and nh) or (CFG.Collect.Ammo and obj:FindFirstChild("Ammo")) then
                        pcall(function() firetouchinterest(hrp,obj,0); firetouchinterest(hrp,obj,1) end)
                    end
                end
            end
        end
    end

    -- Orbit
    if CFG.Orbit.On and CFG.OrbitTarget then
        local mc=LP.Character
        if mc then
            local mr=mc:FindFirstChild("HumanoidRootPart"); local tc=CFG.OrbitTarget.Character
            if mr and tc then
                local tr=tc:FindFirstChild("HumanoidRootPart"); local mh=mc:FindFirstChildOfClass("Humanoid")
                if tr and mh and mh.Health>0 then
                    orbitAngle=orbitAngle+(CFG.Orbit.Speed*dt); if orbitAngle>math.pi*2 then orbitAngle=orbitAngle-math.pi*2 end
                    local tp=tr.Position
                    mr.CFrame=CFrame.new(tp+Vector3.new(math.cos(orbitAngle)*CFG.Orbit.Radius,CFG.Orbit.Height,math.sin(orbitAngle)*CFG.Orbit.Radius),tp)
                end
            end
        end
    end

    -- Void Spam
    if VoidDesync.active and RagebotCFG.VoidSpam then
        if not humanoidRootPart or not humanoidRootPart.Parent then VoidDesync.active=false; return end
        local hum2=character and character:FindFirstChildOfClass("Humanoid")
        if not hum2 or hum2.Health<=0 then stopVoidSpam(); return end

        VoidDesync.realCFrame = humanoidRootPart.CFrame
        VoidDesync.phaseTimer = VoidDesync.phaseTimer + dt

        if VoidDesync.phase=="hide" then
            VoidDesync.depth = math.min(VoidDesync.depth+30, 200)
            if VoidDesync.phaseTimer >= RagebotCFG.HideTime then
                VoidDesync.phase="attack"; VoidDesync.phaseTimer=0; VoidDesync.shotsFired=0; VoidDesync.shotCooldown=0
            end
        elseif VoidDesync.phase=="attack" then
            VoidDesync.depth = math.max(VoidDesync.depth-90, 0)
            if VoidDesync.depth<=2 and RagebotCFG.On then
                VoidDesync.shotCooldown = VoidDesync.shotCooldown-dt
                if VoidDesync.shotsFired<RagebotCFG.ShootAttempts and VoidDesync.shotCooldown<=0 then
                    simClick(); VoidDesync.shotsFired=VoidDesync.shotsFired+1; VoidDesync.shotCooldown=0.05
                end
            end
            if VoidDesync.phaseTimer>=RagebotCFG.AttackTime then
                VoidDesync.phase="hide"; VoidDesync.phaseTimer=0
            end
        end

        if VoidDesync.depth>0 then

local wsApplied = false
local oldWSFunc = nil
local function applyWeaponStatus()
    if wsApplied then return end
    local hp = LP:FindFirstChild("PlayerScripts")
        and LP.PlayerScripts:FindFirstChild("Modules")
        and LP.PlayerScripts.Modules:FindFirstChild("WeaponStatusHandler")
    if not hp then return end
    local ok, WSH = pcall(require, hp); if not ok or not WSH then return end
    oldWSFunc = WSH.ApplyItemStatusToBackground
    WSH.ApplyItemStatusToBackground = function(self, bg, stroke, status)
        bg.BackgroundColor3 = Color3.fromRGB(100,0,200)
        if stroke then stroke.Color=Color3.fromRGB(170,0,255); stroke.Thickness=2 end
        local parent = bg.Parent
        if parent and parent:FindFirstChild("Icon") then
            parent.Icon.Picture.ImageTransparency = 0.1
        end
        return oldWSFunc(self, bg, stroke, "Banned")
    end
    wsApplied = true
end
local function removeWeaponStatus()
    if not wsApplied or not oldWSFunc then return end
    local hp = LP:FindFirstChild("PlayerScripts")
        and LP.PlayerScripts:FindFirstChild("Modules")
        and LP.PlayerScripts.Modules:FindFirstChild("WeaponStatusHandler")
    if not hp then return end
    local ok, WSH = pcall(require, hp)
    if ok and WSH then WSH.ApplyItemStatusToBackground = oldWSFunc end
    wsApplied = false
end


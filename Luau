-- Rivals TeamID attribute check (most reliable)
local function isSameTeamRivals(p)
    local same = false
    pcall(function()
        local myID    = LP:GetAttribute("TeamID")
        local theirID = p:GetAttribute("TeamID")
        if myID and theirID then
            same = string.byte(myID or "\0") == string.byte(theirID or "\0")
        end
    end)
    if not same then
        pcall(function()
            same = p.Team ~= nil and LP.Team ~= nil and p.Team == LP.Team
        end)
    end
    return same
end

-- Raycast visibility check
local function isAimbotVisible(part)
    if not part then return false end
    local ok, r = pcall(function()
        local origin = camera.CFrame.Position
        local dir    = part.Position - origin
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = {
            LP.Character, part.Parent, workspace:FindFirstChild("Debris")
        }
        local hit = workspace:Raycast(origin, dir, params)
        return hit == nil or hit.Instance:IsDescendantOf(part.Parent)
    end)
    return ok and r or false
end

-- Target part resolver
local TARGET_PARTS = {
    ["Head"]       = {"Head"},
    ["Body"]       = {"UpperTorso","LowerTorso","HumanoidRootPart"},
    ["Head, Body"] = {"Head","UpperTorso","LowerTorso","HumanoidRootPart"},
    ["Body, Head"] = {"UpperTorso","LowerTorso","Head"},
}

local function getBestPart(char, setting)
    local names = TARGET_PARTS[setting] or {"Head"}
    for _, n in ipairs(names) do
        local p = char:FindFirstChild(n)
        if p then return p end
    end
    return nil
end

local function getEffectiveFOV()
    local fov = AimbotCFG.MaxFOV
    if AimbotCFG.DynamicFOV then fov = fov * (camera.FieldOfView / 70) end
    return fov
end


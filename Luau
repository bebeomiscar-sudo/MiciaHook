-- ═══════════════════════════════════════════
-- IMMUNITY DETECTION
-- ═══════════════════════════════════════════
local function isPlayerImmune(p)
    if not ImmunityCFG.Enabled then return false end
    local data = playerImmunity[p]
    if data and data.forceShield then return true end
    local char = p.Character
    if char then
        if char:FindFirstChildOfClass("ForceField") then return true end
        for _, obj in ipairs(char:GetDescendants()) do
            local n = obj.Name:lower()
            if n == "shield" or n:find("immune") or n:find("protect") then
                if obj:IsA("BasePart") or obj:IsA("SelectionBox") or obj:IsA("ParticleEmitter") then
                    return true
                end
            end
        end
    end
    if data and (tick() - data.spawnTime) < ImmunityCFG.SpawnProtectionTime then
        return true
    end
    return false
end

local function hookPlayerImmunity(p)
    if p == LP then return end
    local function onCharAdded(char)
        playerImmunity[p] = { spawnTime = tick(), forceShield = false, lastMaxHealth = 0 }
        if char:FindFirstChildOfClass("ForceField") then
            playerImmunity[p].forceShield = true
        end
        char.ChildAdded:Connect(function(child)
            if child:IsA("ForceField") and playerImmunity[p] then
                playerImmunity[p].forceShield = true
            end
        end)
        char.ChildRemoved:Connect(function(child)
            if child:IsA("ForceField") and playerImmunity[p] then
                playerImmunity[p].forceShield = false
            end
        end)
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            playerImmunity[p].lastMaxHealth = hum.MaxHealth
            hum:GetPropertyChangedSignal("MaxHealth"):Connect(function()
                if not playerImmunity[p] then return end
                local prev = playerImmunity[p].lastMaxHealth
                local curr = hum.MaxHealth
                if curr > 10000 and prev > 0 and curr > prev * 5 then
                    playerImmunity[p].forceShield = true
                end
                playerImmunity[p].lastMaxHealth = curr
            end)
        end
    end
    if p.Character then
        task.spawn(function() task.wait(0.1); onCharAdded(p.Character) end)
    end
    p.CharacterAdded:Connect(function(char)
        task.wait(0.1); onCharAdded(char)
    end)
end

for _, p in ipairs(Players:GetPlayers()) do hookPlayerImmunity(p) end
Players.PlayerAdded:Connect(hookPlayerImmunity)
Players.PlayerRemoving:Connect(function(p) playerImmunity[p] = nil end)

-- ═══════════════════════════════════════════
-- ═══════════════════════════════════════════
-- KICIA HOOK AIMBOT
-- Works on mobile + PC with no keybind
-- Uses CFrame manipulation via hookmetamethod
-- Speed: controls smoothing (0=instant, 5=very smooth/slow)
-- SpeedInAttack: overrides Speed when target is being shot
-- SpeedScaleFOV: scales speed based on angular distance from center
-- MaxLockTime: auto-releases lock after N seconds
-- ReactionTime: ms delay before aimbot starts moving on new target
-- ═══════════════════════════════════════════
-- ═══════════════════════════════════════════

local kiciaHookActive = false
local kiciaHookRef    = nil
local kiciaTargetCF   = nil   -- the CFrame we want the camera to face

-- The hook intercepts camera CFrame reads so the game
-- sees a corrected CFrame pointing at our target
local function startKiciaHook()
    if kiciaHookActive then return end
    local ok = pcall(function()
        kiciaHookRef = hookmetamethod(game, "__index", newcclosure(function(self, key, ...)
            local orig = kiciaHookRef(self, key, ...)
            if not checkcaller() and key == "CFrame" and self == workspace.CurrentCamera then
                if kiciaTargetCF and KiciaCFG.On and not KiciaState.inReaction then
                    return kiciaTargetCF
                end
            end
            return orig
        end))
    end)
    if ok then kiciaHookActive = true end
end

local function stopKiciaHook()
    kiciaHookActive = false
    kiciaTargetCF   = nil
    -- We cannot unhook hookmetamethod cleanly without executor support
    -- so we just stop writing kiciaTargetCF (hook returns orig)
end

local function kiciaGetAimPart(char)
    local partName = KiciaCFG.AimPart
    if partName == "Head" then
        return char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
    elseif partName == "Body" then
        return char:FindFirstChild("UpperTorso") or char:FindFirstChild("HumanoidRootPart")
    end
    return char:FindFirstChild("HumanoidRootPart")
end

local function kiciaIsValid(part)
    if not part or not part.Parent then return false end
    local hum = part.Parent:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    if KiciaCFG.VisibleCheck and not isVisible(part) then return false end
    if KiciaCFG.TeamCheck then
        local p = Players:GetPlayerFromCharacter(part.Parent)
        if p and isSameTeam(p) then return false end
    end
    return true
end

local function kiciaScorePlayer(p, camPos, center)
    local ch  = p.Character; if not ch then return nil, -math.huge end
    local h   = ch:FindFirstChildOfClass("Humanoid")
    if not h or h.Health <= 0 then return nil, -math.huge end
    local hrp = ch:FindFirstChild("HumanoidRootPart"); if not hrp then return nil, -math.huge end
    if KiciaCFG.TeamCheck and isSameTeam(p) then return nil, -math.huge end
    if isPlayerImmune(p) then return nil, -math.huge end
    local dist   = (camPos - hrp.Position).Magnitude
    local sp, on = camera:WorldToScreenPoint(hrp.Position)
    if not on then return nil, -math.huge end
    local screenDist = (Vector2.new(sp.X, sp.Y) - center).Magnitude
    if screenDist > KiciaCFG.MaxFOV then return nil, -math.huge end
    if KiciaCFG.VisibleCheck and not isVisible(hrp) then return nil, -math.huge end
    local score
    if     KiciaCFG.TargetPriority == "Closest"   then score = -dist
    elseif KiciaCFG.TargetPriority == "Furthest"  then score = dist
    elseif KiciaCFG.TargetPriority == "Lowest HP" then score = -(h.Health / h.MaxHealth) * 1000
    end
    local aimPart = kiciaGetAimPart(ch) or hrp
    return aimPart, score
end

local function kiciaFindTarget()
    local camPos  = camera.CFrame.Position
    local center  = getScreenCenter()
    local best, bestScore = nil, -math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LP then continue end
        local part, score = kiciaScorePlayer(p, camPos, center)
        if part and score > bestScore then
            bestScore = score
            best      = part
        end
    end
    return best
end

-- Compute the smoothed speed factor
-- Speed 0 = instant lock (alpha = 1), Speed 5 = very slow (alpha small)
-- SpeedScaleFOV scales the alpha based on how far the target is from center
local function kiciaComputeAlpha(dt, part, speed, center)
    -- Base alpha: 0 speed → 1.0 (instant), 5 speed → ~0.05 (very smooth)
    -- We invert: alpha = 1 - (speed/5)*0.95, then multiply by 60*dt for frame independence
    local baseAlpha  = (1 - (speed / 5) * 0.95) * 60 * dt
    baseAlpha        = math.clamp(baseAlpha, 0.01, 1)

    -- FOV scale: target near center = full speed, far = scale down
    local sp, on     = camera:WorldToScreenPoint(part.Position)
    if not on then return baseAlpha end
    local screenDist = (Vector2.new(sp.X, sp.Y) - center).Magnitude
    local fovScale   = math.clamp(1 - (screenDist / math.max(KiciaCFG.SpeedScaleFOV, 1)) * 0.5, 0.1, 1)

    return baseAlpha * fovScale
end

-- Main Kicia update called every RenderStepped
local function kiciaUpdate(dt)
    if not KiciaCFG.On then
        kiciaTargetCF = nil
        KiciaState.lockedTarget = nil
        KiciaState.lockTimer    = 0
        KiciaState.inReaction   = true
        KiciaState.reactionTimer = 0
        return
    end

    -- Validate existing lock
    if KiciaState.lockedTarget and not kiciaIsValid(KiciaState.lockedTarget) then
        KiciaState.lockedTarget  = nil
        KiciaState.lockTimer     = 0
        KiciaState.inReaction    = true
        KiciaState.reactionTimer = 0
        kiciaTargetCF            = nil
    end

    -- Find new target if needed
    if not KiciaState.lockedTarget then
        local newT = kiciaFindTarget()
        if newT then
            KiciaState.lockedTarget  = newT
            KiciaState.lockTimer     = 0
            KiciaState.inReaction    = true
            KiciaState.reactionTimer = KiciaCFG.ReactionTime / 1000
            kiciaTargetCF            = nil
        else
            kiciaTargetCF = nil
            return
        end
    end

    -- Reaction time countdown
    if KiciaState.inReaction then
        KiciaState.reactionTimer = KiciaState.reactionTimer - dt
        if KiciaState.reactionTimer <= 0 then
            KiciaState.inReaction    = false
            KiciaState.reactionTimer = 0
        else
            -- Still in reaction delay, dont move
            kiciaTargetCF = nil
            return
        end
    end

    -- Max lock time
    KiciaState.lockTimer = KiciaState.lockTimer + dt
    if KiciaState.lockTimer > KiciaCFG.MaxLockTime and KiciaCFG.MaxLockTime > 0 then
        KiciaState.lockedTarget  = nil
        KiciaState.lockTimer     = 0
        KiciaState.inReaction    = true
        KiciaState.reactionTimer = 0
        kiciaTargetCF            = nil
        return
    end

    local part   = KiciaState.lockedTarget
    local center = getScreenCenter()

    -- Detect if we are "attacking" (shooting at target = target is close to crosshair)
    local sp, on = camera:WorldToScreenPoint(part.Position)
    local screenDist = on and (Vector2.new(sp.X, sp.Y) - center).Magnitude or math.huge
    local wasAttacking = KiciaState.isAttacking
    KiciaState.isAttacking = screenDist < 40  -- within 40px = attacking

    if KiciaState.isAttacking and not wasAttacking then
        KiciaState.attackTimer = 0.3  -- sustain attack speed for 0.3s
    elseif KiciaState.attackTimer > 0 then
        KiciaState.attackTimer = KiciaState.attackTimer - dt
        if KiciaState.attackTimer <= 0 then
            KiciaState.isAttacking = false
            KiciaState.attackTimer = 0
        end
    end

    -- Choose speed
    local useSpeed = KiciaState.isAttacking and KiciaCFG.SpeedInAttack or KiciaCFG.Speed
    local alpha    = kiciaComputeAlpha(dt, part, useSpeed, center)

    -- Build target CFrame: camera position looking at target
    local camPos   = camera.CFrame.Position
    local targetPos = part.Position

    -- Predict target position using velocity smoothing
    if KiciaState.prevTargetPos then
        local rawVel   = (targetPos - KiciaState.prevTargetPos) / dt
        -- Smooth the velocity estimate
        KiciaState.velocitySmooth = KiciaState.velocitySmooth:Lerp(rawVel, math.min(alpha * 2, 1))
        -- Predict 1 frame ahead
        targetPos = targetPos + KiciaState.velocitySmooth * dt
    end
    KiciaState.prevTargetPos = part.Position

    -- Build desired CFrame
    local desiredCF = CFrame.lookAt(camPos, targetPos)

    -- Lerp from current camera CFrame toward desired
    local currentCF   = camera.CFrame
    local smoothedCF  = currentCF:Lerp(desiredCF, math.clamp(alpha, 0, 1))

    kiciaTargetCF = smoothedCF
end

-- Start hook immediately (hook is always live, only writes kiciaTargetCF when On)
startKiciaHook()


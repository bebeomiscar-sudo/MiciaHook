-- Basic ESP (highlight boxes)
local espEnabled    = false
local espBoxes      = {}

local function clearESP()
    for _, h in pairs(espBoxes) do
        if h and h.Parent then h:Destroy() end
    end
    espBoxes = {}
end

local function updateESP()
    if not espEnabled then clearESP(); return end
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LP then continue end
        local ch = p.Character
        if not ch then continue end
        local hrp = ch:FindFirstChild("HumanoidRootPart")
        local hum = ch:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum or hum.Health <= 0 then continue end

        if not espBoxes[p] then
            local h = Instance.new("SelectionBox")
            h.Color3       = Color3.fromRGB(255, 50, 50)
            h.LineThickness = 0.05
            h.SurfaceTransparency = 1
            h.Adornee      = ch
            h.Parent        = Workspace
            espBoxes[p]    = h
        end
    end
    -- Cleanup dead entries
    for p, h in pairs(espBoxes) do
        if not p.Character or not p.Character.Parent then
            h:Destroy()
            espBoxes[p] = nil
        end
    end
end

V_ESP:AddToggle("ESPOn", {
    Text     = "Enable ESP",
    Default  = false,
    Callback = function(v)
        espEnabled = v
        if not v then clearESP() end
    end
})


local monitorTick = 0

table.insert(ActiveConnections, RunService.Heartbeat:Connect(function(dt)
    if not CFG.Void.On then
        -- If was active, snap back to saved position
        if VoidState.active and VoidState.savedCFrame then
            local mr = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            if mr then mr.CFrame = VoidState.savedCFrame end
        end
        VoidState.active = false
        VoidState.atHome = true
        VoidState.phase = 0
        VoidState.accumulator = 0
        return
    end

    local myChar = LP.Character
    if not myChar then return end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    local myHum = myChar:FindFirstChildOfClass("Humanoid")
    if myHum and myHum.Health <= 0 then
        -- Auto stop on death, snap home
        if VoidState.savedCFrame then
            myRoot.CFrame = VoidState.savedCFrame
        end
        return
    end

    VoidState.active = true
    VoidState.clock = VoidState.clock + dt
    VoidState.accumulator = VoidState.accumulator + dt

    -- Only advance phase at pulse rate
    if VoidState.accumulator < CFG.Void.PulseRate then return end
    VoidState.accumulator = 0

    local t = tick()
    local origin = myRoot.Position

    -- ═══════════════════════════════════
    -- METHOD 1: 2K TP (6-phase cycle)
    -- ═══════════════════════════════════
    if CFG.Void.Method == "2KTP" then
        local p = VoidState.phase % 6

        if p == 0 then
            -- HOME: save current position
            VoidState.savedCFrame = myRoot.CFrame

        elseif p == 1 then
            -- AWAY: TP 2K studs, direction A (golden angle 0)
            local awayPos = calcAwayPosition(VoidState.savedCFrame.Position, t, 0)
            myRoot.CFrame = CFrame.new(awayPos)
            VoidState.tpCount = VoidState.tpCount + 1
            calcTPS()

        elseif p == 2 then
            -- HOME: restore
            if VoidState.savedCFrame then
                myRoot.CFrame = VoidState.savedCFrame
            end

        elseif p == 3 then
            -- AWAY: TP 2K studs, direction B (golden angle 1)
            local awayPos = calcAwayPosition(VoidState.savedCFrame.Position, t, 1)
            myRoot.CFrame = CFrame.new(awayPos)
            VoidState.tpCount = VoidState.tpCount + 1
            calcTPS()

        elseif p == 4 then
            -- HOME: restore
            if VoidState.savedCFrame then
                myRoot.CFrame = VoidState.savedCFrame
            end

        elseif p == 5 then
            -- AWAY: TP 2K studs, direction C (golden angle 2)
            local awayPos = calcAwayPosition(VoidState.savedCFrame.Position, t, 2)
            myRoot.CFrame = CFrame.new(awayPos)
            VoidState.tpCount = VoidState.tpCount + 1
            calcTPS()
        end

        VoidState.phase = VoidState.phase + 1

    -- ═══════════════════════════════════
    -- METHOD 2: SCATTER (8-phase cycle)
    -- ═══════════════════════════════════
    elseif CFG.Void.Method == "Scatter" then
        local p = VoidState.phase % 8

        if p == 0 then
            -- HOME: save
            VoidState.savedCFrame = myRoot.CFrame

        elseif p == 1 then
            -- FAR A: full distance, direction 0
            local pos = calcScatterPosition(VoidState.savedCFrame.Position, t, 0, 1.0)
            myRoot.CFrame = CFrame.new(pos)
            VoidState.tpCount = VoidState.tpCount + 1
            calcTPS()

        elseif p == 2 then
            -- MID B: 60% distance, direction 1
            local pos = calcScatterPosition(VoidState.savedCFrame.Position, t, 1, 0.6)
            myRoot.CFrame = CFrame.new(pos)
            VoidState.tpCount = VoidState.tpCount + 1
            calcTPS()

        elseif p == 3 then
            -- FAR C: full distance, direction 2
            local pos = calcScatterPosition(VoidState.savedCFrame.Position, t, 2, 1.0)
            myRoot.CFrame = CFrame.new(pos)
            VoidState.tpCount = VoidState.tpCount + 1
            calcTPS()

        elseif p == 4 then
            -- CLOSE D: 30% distance, random direction
            local pos = calcScatterPosition(VoidState.savedCFrame.Position, t, 3, 0.3)
            myRoot.CFrame = CFrame.new(pos)
            VoidState.tpCount = VoidState.tpCount + 1
            calcTPS()

        elseif p == 5 then
            -- MID E: 50% distance, direction 4
            local pos = calcScatterPosition(VoidState.savedCFrame.Position, t, 4, 0.5)
            myRoot.CFrame = CFrame.new(pos)
            VoidState.tpCount = VoidState.tpCount + 1
            calcTPS()

        elseif p == 6 then
            -- FAR F: 80% distance, direction 5
            local pos = calcScatterPosition(VoidState.savedCFrame.Position, t, 5, 0.8)
            myRoot.CFrame = CFrame.new(pos)
            VoidState.tpCount = VoidState.tpCount + 1
            calcTPS()

        elseif p == 7 then
            -- HOME: restore
            if VoidState.savedCFrame then
                myRoot.CFrame = VoidState.savedCFrame
            end
        end

        VoidState.phase = VoidState.phase + 1
    end

    -- ── UPDATE MONITOR UI (every 20 phases for performance) ──
    monitorTick = monitorTick + 1
    if monitorTick % 20 == 0 then
        local method = CFG.Void.Method
        monMethodLabel.Text = "METHOD: " .. (method == "2KTP" and "OPT 1 — 2K TP" or "OPT 2 — SCATTER")
        monMethodLabel.TextColor3 = method == "2KTP" and C.cyan or C.orange

        local phaseName

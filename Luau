-- SILENT AIM — util.Raycast hook
-- ═══════════════════════════════════════════
local SACFG = {
    On      = false,
    FOV     = 150,
    MaxDist = 200,
    TeamCheck = true,
    VisCheck  = false,
}

local saCircle = Drawing.new("Circle")
saCircle.Thickness = 1.5
saCircle.Filled    = false
saCircle.NumSides  = 64
saCircle.Visible   = false
saCircle.Color     = Color3.fromRGB(0, 200, 255)

local saHooked = false

local function saGetTarget(origin)
    local center = getScreenCenter()
    local best, bestDist = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LP then continue end
        if SACFG.TeamCheck and isSameTeam(p) then continue end
        local ch = p.Character
        if not ch then continue end
        local head = ch:FindFirstChild("Head")
        local hum  = ch:FindFirstChildOfClass("Humanoid")
        if not head or not hum or hum.Health <= 0 then continue end
        if (origin - head.Position).Magnitude > SACFG.MaxDist then continue end
        local sp, vis = camera:WorldToViewportPoint(head.Position)
        if not vis then continue end
        local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
        if d < SACFG.FOV and d < bestDist then
            bestDist = d
            best = head
        end
    end
    return best
end

local function applySAHook()
    if saHooked or not util_mod then return end
    saHooked = true

    local origRaycast = util_mod.Raycast
    util_mod.Raycast = function(self, origin, direction, distance, ...)
        if SACFG.On then
            local target = saGetTarget(origin)
            if target then
                return origRaycast(self, origin, target.Position, distance, ...)
            end
        end
        return origRaycast(self, origin, direction, distance, ...)
    end

    -- Block flash/smoke particles
    local origParticles = util_mod.PlayParticles
    if origParticles then
        util_mod.PlayParticles = function(self, obj)
            if typeof(obj) == "Instance" then
                local n = obj.Name:lower()
                if n:find("flash") or n:find("smoke") or n:find("blind") then return end
            end
            return origParticles(self, obj)
        end
    end
end


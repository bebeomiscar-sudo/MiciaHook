-- MAIN RENDER LOOP
-- ══════════════════════════════════════════════════
sRun.RenderStepped:Connect(function(dt)
    Cam = sWorkspace.CurrentCamera
    local vc = viewportCenter()

    -- FOV indicators
    abCirc.Position = vc
    abCirc.Radius   = effFov()
    abCirc.Visible  = AB.drawFov and AB.on

    saCirc.Position = vc
    saCirc.Radius   = SA.fov
    saCirc.Visible  = SA.drawFov and SA.on

    updateTracers()
    updateESP()

    -- ── AIMBOT ──────────────────────────────────
    if AB.on and mCam then
        -- Reaction delay
        if abInReact then
            abReactTimer = abReactTimer - dt
            if abReactTimer <= 0 then abInReact = false end
        end

        if not abInReact then
            -- Validate current target
            if abTarget and not abTargetValid(abTarget) then
                abTarget=nil; abLockTimer=0
                abPrevPos=nil; abCurveStart=nil; abCurveProgress=0
            end

            -- Find new target
            if not abTarget then
                abTarget = abFindTarget()
                if abTarget then
                    abLockTimer=0; abInReact=true
                    abReactTimer=AB.react/1000
                    abPrevPos=nil; abCurveStart=nil; abCurveProgress=0
                end
            end

            -- Apply aimbot
            if abTarget then
                abLockTimer = abLockTimer + dt
                if abLockTimer > AB.lockTime then
                    abTarget=nil; abLockTimer=0
                    abPrevPos=nil; abCurveStart=nil; abCurveProgress=0
                elseif onScreen(abTarget, effFov(), false) then
                    pcall(function()
                        local aimPos = predictPos(abTarget)
                        local cp     = Cam.CFrame.Position
                        local du     = (aimPos - cp).Unit
                        local tp     = math.asin(math.clamp(du.Y, -1, 1))
                        local ty     = math.atan2(-du.X, -du.Z)
                        local tRot   = Vector2.new(tp, ty)
                        local cur    = mCam.Rotation

                        local newRot
                        if AB.lockMode == "Soft" then
                            newRot = softLock(tRot, cur, dt)
                        elseif AB.lockMode == "Magnet" then
                            newRot = magnetLock(tRot, cur, dt)
                        else
                            newRot = curveLock(tRot, cur, dt)
                        end

                        -- Apply AI legit modifications
                        newRot = applyAILegit(newRot, cur, dt)

                        -- Apply via game's own method (AC safe)
                        mCam:ApplyRotationDelta(Vector2.new(
                            newRot.X - cur.X,
                            yawDiff(cur.Y, newRot.Y)
                        ))
                    end)
                else
                    abTarget=nil; abLockTimer=0
                    abPrevPos=nil; abCurveStart=nil; abCurveProgress=0
                end
            end
        end
    end
end)


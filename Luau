-- MAIN LOOP
-- ═══════════════════════════════════════════
RunService.RenderStepped:Connect(function(dt)
    camera = Workspace.CurrentCamera
    local center = getScreenCenter()

    -- SA FOV circle (always shows when SA enabled)
    saCircle.Position = center
    saCircle.Radius   = SACFG.FOV
    saCircle.Visible  = SACFG.On

    -- Aimbot FOV circle with pulse + lock color
    if AimbotCFG.DrawFOV and AimbotCFG.On then
        fovCircle.Visible  = true
        fovCircle.Filled   = AimbotCFG.FOVFilled
        fovCircle.Position = center

        if AimbotCFG.Pulse and lockedTarget then
            -- Pulse: oscillate radius ±10% around FOV size
            fovPulseT  = fovPulseT + dt * 6
            local pulse = math.sin(fovPulseT) * 0.1
            fovCircle.Radius = getEffectiveAimbotFOV() * (1 + pulse)
            -- Change color to red on lock
            fovCircle.Color = Color3.fromRGB(255, 50, 50)
        else
            fovPulseT       = 0
            fovCircle.Radius = getEffectiveAimbotFOV()
            fovCircle.Color  = AimbotCFG.FOVColor
        end
    else
        fovCircle.Visible = false
        fovPulseT = 0
    end

    -- ESP
    updateESP()

    -- Aimbot logic
    if AimbotCFG.On and CameraController then
        if isInReaction then
            reactionTimer = reactionTimer - dt
            if reactionTimer <= 0 then isInReaction = false end
        end
        if not isInReaction then
            if lockedTarget and not isTargetValid(lockedTarget) then
                lockedTarget = nil; lockTimer = 0; resetDelayedPos()
            end
            if not lockedTarget then
                local newT = findAimbotTarget()
                if newT then
                    lockedTarget = newT; lockTimer = 0
                    isInReaction = true; reactionTimer = AimbotCFG.ReactionTime / 1000
                    resetDelayedPos()
                end
            end
            if lockedTarget then
                lockTimer = lockTimer + dt
                if lockTimer > AimbotCFG.ForgotTime then
                    lockedTarget = nil; lockTimer = 0; resetDelayedPos()
                elseif isInFOV(lockedTarget) then
                    local aimPos = getDelayedPos(lockedTarget, dt)
                    if aimPos then
                        local sm = math.clamp(1 / math.max(AimbotCFG.Smoothness, 0.1), 0.01, 1)
                        pcall(function()
                            local cp  = camera.CFrame.Position
                            local du  = (aimPos - cp).Unit
                            local tP  = math.asin(math.clamp(du.Y, -1, 1))
                            local tY  = math.atan2(-du.X, -du.Z)
                            local cur = CameraController.Rotation
                            CameraController:SetRotation(Vector2.new(
                                cur.X + (tP - cur.X) * sm,
                                cur.Y + angleDiff(tY - cur.Y) * sm
                            ))
                        end)
                    end
                else
                    lockedTarget = nil; lockTimer = 0; resetDelayedPos()
                end
            end
        end
    end
end)


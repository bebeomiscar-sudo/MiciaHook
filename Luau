                b.LineThickness=0.05
                b.SurfaceTransparency=1
                b.Adornee=chr; b.Parent=ws
                espBoxes[p]=b
            end
        else
            if espBoxes[p] then espBoxes[p]:Destroy(); espBoxes[p]=nil end
        end
    end
end

-- ═══════════════════════════════════════════
-- BULLET TRACERS
-- ═══════════════════════════════════════════
local tracers={}

local function spawnTracer(o3, t3)
    if not VIS.tracers then return end
    local l=Drawing.new("Line")
    l.Thickness=VIS.tracerThick
    l.Color=Color3.fromRGB(255,50,50)
    l.Transparency=0; l.Visible=false
    table.insert(tracers,{line=l,born=tick(),o=o3,t=t3})
end

local function updateTracers()
    local now=tick(); local alive={}
    for _,t in ipairs(tracers) do
        local age=now-t.born
        local life=math.max(VIS.tracerDur,0.05)
        if age>=life then
            pcall(function() t.line:Remove() end)
        else
            local a=1-(age/life)
            local from=Vector2.new(cam.ViewportSize.X/2,cam.ViewportSize.Y)
            local to=w2s(t.t)
            if to then
                t.line.From=from; t.line.To=to
                t.line.Transparency=1-a; t.line.Visible=true
            else
                t.line.Visible=false
            end
            table.insert(alive,t)
        end
    end
    tracers=alive
end

-- Wrap fireShot for tracers
local _fso=fireShot
fireShot=function(item,hitPart,origin)
    if VIS.tracers and hitPart and hitPart.Parent then
        spawnTracer(origin or cam.CFrame.Position, hitPart.Position)
    end
    _fso(item,hitPart,origin)
end


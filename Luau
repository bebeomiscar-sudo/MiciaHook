--[[
    HOW IT WORKS:
    
    Your hitbox is NEVER where your screen shows you.
    
    OPTION 1 — 2K TP:
    ┌──────────────────────────────────────────────┐
    │ Frame 1: SAVE your CFrame                    │
    │ Frame 2: TP 2000 studs away (jittered pos)   │
    │ Frame 3: TP back to saved CFrame             │
    │ Frame 4: TP 2000 studs (different direction) │
    │ Frame 5: TP back                             │
    │ ... repeat forever                           │
    │                                              │
    │ Server sees you flickering between HOME      │
    │ and 2000 studs away — hitbox is NOWHERE      │
    │ Enemy ragebot resolver CANNOT lock on        │
    └──────────────────────────────────────────────┘
    
    OPTION 2 — SCATTER (fallback if OPT 1 triggers OOB):
    ┌──────────────────────────────────────────────┐
    │ Frame 1: SAVE CFrame                         │
    │ Frame 2: TP to position A (far, direction 1) │
    │ Frame 3: TP to position B (mid, direction 2) │
    │ Frame 4: TP to position C (far, direction 3) │
    │ Frame 5: TP to position D (close, random)    │
    │ Frame 6: TP back to saved CFrame             │
    │ ... cycle through                            │
    │                                              │
    │ Multiple ghost positions = even more desync  │
    │ Varying distances = OOB can't detect pattern │
    └──────────────────────────────────────────────┘
    
    ANTI-AA JITTER (applied at TP destination):
    Y axis:  3 incommensurate sines + random noise
    XZ axis: spiral + random jitter + mode modifiers
    Result:  TP destination is NEVER predictable
]]

-- ── MODE MULTIPLIERS ──

local function getModeMultipliers()
    local mode = CFG.Void.Mode
    if mode == "Aggressive" then
        return 2.2, 2.8, 1.5  -- yM, xzM, spM
    elseif mode == "Erratic" then
        return 1.8, 2.0, 0.3
    elseif mode == "Spiral" then
        return 0.8, 1.0, 2.5
    else -- Adaptive
        return 1.4, 1.6, 1.2
    end
end

-- ── POSITION CALCULATORS ──

local function calcAwayPosition(origin, t, phaseIdx)
    local dist    = CFG.Void.TPDistance
    local yJit    = CFG.Void.YJitter
    local xzJit   = CFG.Void.XZJitter
    local spiralR = CFG.Void.SpiralRad
    local spiralS = CFG.Void.SpiralSpd

    local yM, xzM, spM = getModeMultipliers()

    local effYJit  = yJit * yM
    local effXZJit = xzJit * xzM
    local effSpR   = spiralR * spM
    local effSpS   = spiralS * spM

    -- ── BASE DIRECTION: rotates per phase, never same angle ──
    -- Golden angle spacing (137.5°) = maximally spread directions
    local baseAngle = phaseIdx * 2.399 + t * 0.37
    local dirX = math.cos(baseAngle)
    local dirZ = math.sin(baseAngle)

    -- Base far position at TPDistance
    local farX = origin.X + dirX * dist
    local farZ = origin.Z + dirZ * dist

    -- ── Y AXIS: incommensurate frequencies → never repeating ──
    local yOff = math.sin(t * 7.3) * effYJit * 0.35
              + math.sin(t * 13.7) * effYJit * 0.4
              + math.sin(t * 23.1) * effYJit * 0.15
              + math.sin(t * 37.9) * effYJit * 0.2
              + (math.random() - 0.5) * effYJit * 0.8

    -- Mode-specific Y modifiers
    local mode = CFG.Void.Mode
    if mode == "Aggressive" then
        -- Violent Y snapping
        yOff = yOff + (math.random() > 0.5 and effYJit or -effYJit) * 1.5
    elseif mode == "Erratic" then
        -- Pure random Y
        yOff = (math.random() - 0.5) * effYJit * 4
    elseif mode == "Spiral" then
        -- Smooth sin Y
        yOff = math.sin(t * effSpS * 0.7) * effYJit * 1.2
    end

    -- ── XZ AXIS: spiral + jitter at destination ──
    local spiralAngle = t * effSpS + phaseIdx * 1.047
    local sX = math.cos(spiralAngle) * effSpR
    local sZ = math.sin(spiralAngle) * effSpR

    -- Random jitter layer
    local jX = (math.random() - 0.5) * effXZJit * 2
    local jZ = (math.random() - 0.5) * effXZJit * 2

    -- Mode-specific XZ modifiers
    if mode == "Aggressive" then
        jX = jX * 2.5; jZ = jZ * 2.5
    elseif mode == "Erratic" then
        -- Completely random direction at destination
        local rAngle = math.random() * math.pi * 2
        local rDist = math.random() * effXZJit * 3
        sX = math.cos(rAngle) * rDist
        sZ = math.sin(rAngle) * rDist
    elseif mode == "Spiral" then
        -- Double spiral layer
        sX = sX + math.cos(t * effSpS * 1.7) * effSpR * 0.6
        sZ = sZ + math.sin(t * effSpS * 1.7) * effSpR * 0.6
    end

    -- ── MICRO JITTER (unique per frame) ──
    local mX = (math.random() - 0.5) * 3.2
    local mY = (math.random() - 0.5) * 2.4
    local mZ = (math.random() - 0.5) * 3.2

    return Vector3.new(
        farX + sX + jX + mX,
        origin.Y + yOff + mY,
        farZ + sZ + jZ + mZ
    )
end

-- For Scatter method: varying distances
local function calcScatterPosition(origin, t, phaseIdx, distMultiplier)
    local baseDist = CFG.Void.TPDistance * distMultiplier
    local yJit    = CFG.Void.YJitter
    local xzJit   = CFG.Void.XZJitter
    local spiralR = CFG.Void.SpiralRad
    local spiralS = CFG.Void.SpiralSpd

    local yM, xzM, spM = getModeMultipliers()

    -- Random direction per scatter point
    local angle = phaseIdx * 2.399 + math.random() * 0.8 + t * 0.2
    local dirX = math.cos(angle)
    local dirZ = math.sin(angle)

    -- Position at varying distance
    local posX = origin.X + dirX * baseDist
    local posZ = origin.Z + dirZ * baseDist

    -- Y: same multi-frequency approach
    local yOff = math.sin(t * 7.3 + phaseIdx) * yJit * yM * 0.4
              + math.sin(t * 17.1 + phaseIdx * 2) * yJit * yM * 0.3
              + (math.random() - 0.5) * yJit * yM * 1.0

    -- XZ scatter
    local spiral = t * spiralS * spM + phaseIdx
    local sX = math.cos(spiral) * spiralR * spM
    local sZ = math.sin(spiral) * spiralR * spM
    local jX = (math.random() - 0.5) * xzJit * xzM * 2
    local jZ = (math.random() - 0.5) * xzJit * xzM * 2

    -- Micro
    local mX = (math.random() - 0.5) * 2.8
    local mY = (math.random() - 0.5) * 2.0
    local mZ = (math.random() - 0.5) * 2.8

    return Vector3.new(
        posX + sX + jX + mX,
        origin.Y + yOff + mY,
        posZ + sZ + jZ + mZ
    )
end

-- ── TPS CALCULATOR ──

local function calcTPS()
    local now = tick()
    -- Add current TP timestamp
    table.insert(VoidState.tpsTracker, now)
    -- Remove entries older than 1 second
    while #VoidState.tpsTracker > 0 and (now - VoidState.tpsTracker[1]) > 1 do
        table.remove(VoidState.tpsTracker, 1)
    end
    return #VoidState.tpsTracker
end


local TARGET_PARTS = {
    ["Head"]       = {"Head"},
    ["Body"]       = {"UpperTorso","LowerTorso","HumanoidRootPart"},
    ["Head, Body"] = {"Head","UpperTorso","LowerTorso","HumanoidRootPart"},
    ["Body, Head"] = {"UpperTorso","LowerTorso","Head"},
}

local function getBestPart(char, setting)
    local names = TARGET_PARTS[setting] or {"Head"}
    for _, n in ipairs(names) do
        local p = char:FindFirstChild(n)
        if p then return p end
    end
    return nil
end

local function getClosestPlayer(opts)
    opts = opts or {}
    local teamCheck = opts.teamCheck or false
    local visCheck  = opts.visCheck  or false
    local maxDist   = opts.maxDist   or math.huge
    local myHRP     = getHRP(LP)
    if not myHRP then return nil end
    local best, bestD = nil, maxDist
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LP then continue end
        if teamCheck and isSameTeamRivals(p) then continue end
        local hrp = getHRP(p); if not hrp then continue end
        local hum = getHum(p); if not hum or hum.Health <= 0 then continue end
        local d = (hrp.Position - myHRP.Position).Magnitude
        if d < bestD then
            if visCheck and not isVisible(camera.CFrame.Position, hrp.Position) then continue end
            bestD = d; best = p
        end
    end
    return best
end


-- ═══════════════════════════════════════════
local aaConn=nil; local aaSpinT=0

local function startAntiAim()
    if aaConn then aaConn:Disconnect() end; aaSpinT=0
    aaConn=RunService.RenderStepped:Connect(function(dt)
        if not AntiAimCFG.On then
            aaConn:Disconnect(); aaConn=nil
            pcall(function()
                local char=LP.Character; if not char then return end
                local hrp=char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
                local rj=hrp:FindFirstChild("RootJoint")
                if rj and aaOrigC0 then rj.C0=aaOrigC0 end
            end)
            aaOrigC0=nil; return
        end
        aaSpinT=(aaSpinT+dt)%(math.pi*2)
        local char=LP.Character; if not char then return end
        local hrp=char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
        local rj=hrp:FindFirstChild("RootJoint"); if not rj then return end
        if not aaOrigC0 then aaOrigC0=rj.C0 end
        local yaw,pitch=0,0
        local typ=AntiAimCFG.Type
        if     typ=="Backwards"  then yaw=math.rad(180)
        elseif typ=="Spin"       then yaw=aaSpinT*10
        elseif typ=="HideHead"   then pitch=math.rad(89)
        elseif typ=="BelowFloor" then pitch=math.rad(180)
        elseif typ=="Custom"     then
            yaw=math.rad(AntiAimCFG.YawAngle)
            pitch=math.rad(AntiAimCFG.PitchAngle)
        end
        pcall(function() rj.C0=aaOrigC0*CFrame.Angles(pitch,yaw,0) end)
    end)

local function applyReloadPatch()
    pcall(function()
        local ItemLibrary = require(ReplicatedStorage.Modules.ItemLibrary)
        local Items       = rawget(ItemLibrary, "Items"); if not Items then return end
        for _, Item in Items do
            local Name = Item.Name
            if not table.find(WeaponsCFG.Whitelist, Name) then continue end
            if not Item["ReloadLength"] then continue end
            if not reloadPatchedOrig[Name] then reloadPatchedOrig[Name] = Item.ReloadLength end
            if WeaponsCFG.ReloadSpeedEnabled then
                rawset(Item, "ReloadLength",
                    Name == "Daggers" and math.max(WeaponsCFG.ReloadLength, 0.09) or WeaponsCFG.ReloadLength
                )
            else
                rawset(Item, "ReloadLength", reloadPatchedOrig[Name])
            end
        end
    end)
end


-- AIMBOT STATE
-- ═══════════════════════════════════════════
local abTgt           = nil
local abLockT         = 0
local abReactT        = 0
local abDoReact       = false
local abPrevPos       = nil
local abPrevTick      = 0
local abCurveProgress = 0
local abCurveStart    = nil
local abCurveEnd      = nil

local abCirc = Drawing.new("Circle")
abCirc.NumSides=64; abCirc.Filled=false; abCirc.Color=Color3.fromRGB(255,255,255)
abCirc.Thickness=1.5; abCirc.Transparency=0.7; abCirc.Visible=false

local function abEffFov()
    local f = AB.fov
    if AB.dynFov then f = f * (cam.FieldOfView/70) end
    return f
end

local function abTgtValid(pt)
    if not pt or not pt.Parent then return false end
    local h = pt.Parent:FindFirstChildOfClass("Humanoid")
    if not h or h.Health <= 0 then return false end
    if not inFov(pt, abEffFov()) then return false end
    if AB.vis and not isVis(cam.CFrame.Position, pt) then return false end
    if AB.team then
        local p = plr:GetPlayerFromCharacter(pt.Parent)
        if p and sameTm(p) then return false end
    end
    return true
end

local function abFind()
    local c = scr(); local fv = abEffFov()
    local best = nil; local bd = fv
    for _, p in ipairs(plr:GetPlayers()) do
        if p == lp then continue end
        if AB.team and sameTm(p) then continue end
        local chr = p.Character; if not chr then continue end
        local hm = chr:FindFirstChildOfClass("Humanoid")
        if not hm or hm.Health <= 0 then continue end
        local pt = bPart(chr, AB.part); if not pt then continue end
        local sp, on = cam:WorldToViewportPoint(pt.Position); if not on then continue end
        local d = (Vector2.new(sp.X, sp.Y) - c).Magnitude
        if d < bd then
            if AB.vis and not isVis(cam.CFrame.Position, pt) then continue end
            bd = d; best = pt
        end
    end
    return best
end

-- ── OVERHAUL: velocity prediction built into speed system
local function getPredictedPos(pt)
    local now = tick(); local pos = pt.Position
    if abPrevPos and (now - abPrevTick) > 0 then
        local el = now - abPrevTick
        local vel = (pos - abPrevPos) / el
        -- prediction magnitude scales with speedAttack
        pos = pos + vel * (0.08 * AB.speedAttack)
    end
    abPrevPos = pt.Position; abPrevTick = now
    return pos
end

-- ── OVERHAUL: unified smooth-lock that uses speed + speedAttack + speedScaleFov
local function applySmartLock(tRot, cur, dt, screenDist, fovRadius)
    -- speedScaleFov: 0=ignore distance, 100=fully scale speed by how far from center
    local distFactor = 1.0
    if fovRadius > 0 then
        local normalized = math.clamp(screenDist / fovRadius, 0, 1)
        -- when close to target → use speedAttack, when far → use speed
        distFactor = 1.0 + (AB.speedScaleFov / 100) * (1 - normalized) * (AB.speedAttack - AB.speed)
    end

    -- effective speed this frame
    local eff = math.clamp(AB.speed * distFactor, 0.01, 5)
    -- convert to lerp factor
    local factor = math.clamp(eff * dt * 6, 0, 1)

    if AB.lockMode == "Soft" or AB.lockMode == "Magnet" then
        return Vector2.new(
            cur.X + (tRot.X - cur.X) * factor,
            cur.Y + angDiff(cur.Y, tRot.Y) * factor
        )
    else
        -- Curve
        local distP = math.abs(tRot.X - cur.X)
        local distY = math.abs(angDiff(cur.Y, tRot.Y))
        local dist  = math.sqrt(distP^2 + distY^2)
        if abCurveStart == nil or dist > 0.5 then
            abCurveStart = cur; abCurveProgress = 0
        end
        abCurveEnd = tRot
        local speed2 = (AB.curvePct / 100) * 3 * eff
        abCurveProgress = math.clamp(abCurveProgress + speed2 * dt, 0, 1)
        local t = abCurveProgress
        local curved = t * t * (3 - 2*t)
        local nP = abCurveStart.X + (abCurveEnd.X - abCurveStart.X) * curved
        local nY = abCurveStart.Y + angDiff(abCurveStart.Y, abCurveEnd.Y) * curved
        if abCurveProgress >= 1 then abCurveStart = nil; abCurveProgress = 0 end
        return Vector2.new(nP, nY)
    end
end

-- ═══════════════════════════════════════════
-- AI LEGIT
-- ═══════════════════════════════════════════
local AI = {
    on          = false,
    jitter      = 0.002,
    overshoot   = 0.12,
    breakChance = 0.008,
    breakDur    = 0.25,
    varySmooth  = true,
}
local aiBreakTimer = 0
local aiInBreak    = false
local aiJitterX    = 0
local aiJitterY    = 0

local function aiLegitProcess(newRot, cur, dt)
    if not AI.on then return newRot end
    if aiInBreak then
        aiBreakTimer = aiBreakTimer - dt
        if aiBreakTimer <= 0 then aiInBreak = false end
        return cur
    end
    if math.random() < AI.breakChance * dt * 60 then
        aiInBreak = true; aiBreakTimer = AI.breakDur + (math.random()-0.5)*0.1
        return cur
    end
    local jRaw = AI.jitter * 2
    aiJitterX = aiJitterX*0.75 + (math.random()-0.5)*jRaw*0.25
    aiJitterY = aiJitterY*0.75 + (math.random()-0.5)*jRaw*0.25
    local smoothMult = AI.varySmooth and (0.82 + math.random()*0.36) or 1.0
    local blended = Vector2.new(
        cur.X + (newRot.X - cur.X) * smoothMult,
        cur.Y + angDiff(cur.Y, newRot.Y) * smoothMult
    )
    if math.random() < AI.overshoot * 0.015 then
        blended = Vector2.new(
            blended.X + (math.random()-0.5)*0.035,
            blended.Y + (math.random()-0.5)*0.035
        )
    end
    return Vector2.new(blended.X + aiJitterX, blended.Y + aiJitterY)
end

-- ═══════════════════════════════════════════
-- SILENT AIM
-- ═══════════════════════════════════════════
local SA = {
    on=false, vis=false, team=true, fov=600,
    drawFov=true, part="Head", mode="Closest", maxDist=500,
}
local saApplied = false
local saTgt     = nil

local saCirc = Drawing.new("Circle")
saCirc.NumSides=64; saCirc.Filled=false; saCirc.Color=Color3.fromRGB(0,200,255)
saCirc.Thickness=1.5; saCirc.Transparency=0.7; saCirc.Visible=false

local function saGetTarget(origin)
    if not SA.on then return nil end
    local center = cam.ViewportSize/2; local best = nil; local bd = math.huge
    for _, p in ipairs(plr:GetPlayers()) do
        if p == lp then continue end
        if SA.team and sameTm(p) then continue end
        local chr = p.Character; if not chr then continue end
        local hm = chr:FindFirstChildOfClass("Humanoid")
        if not hm or hm.Health <= 0 then continue end
        local me = lp:GetAttribute("EnvironmentID"); local th = p:GetAttribute("EnvironmentID")
        if me ~= nil and th ~= nil and me ~= th then continue end
        local pt = bPart(chr, SA.part); if not pt then continue end
        if (origin - pt.Position).Magnitude > SA.maxDist then continue end
        local sp, on = cam:WorldToViewportPoint(pt.Position); if not on then continue end
        local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
        if d > SA.fov then continue end
        if SA.vis and not isVis(origin, pt) then continue end
        if SA.mode == "Closest" and d < bd then bd=d; best=pt
        elseif SA.mode == "Furthest" and d > bd then bd=d; best=pt
        elseif SA.mode == "Random" then if not best or math.random()<0.3 then best=pt end end
    end
    saTgt = best; return best
end

local function applySA()
    if saApplied then return end
    if not mUtil then Lib:Notify("SA: Utility not loaded yet",3); return end
    local origRC = mUtil.Raycast
    mUtil.Raycast = function(self, origin, direction, distance, ...)
        if SA.on then
            local target = saGetTarget(origin)
            if target then return origRC(self, origin, target.Position, distance, ...) end
        end
        return origRC(self, origin, direction, distance, ...)
    end
    saApplied = true; Lib:Notify("SA: Utility.Raycast hooked",3)
end

-- ═══════════════════════════════════════════
-- TRIGGERBOT
-- ═══════════════════════════════════════════
local TB = {
    on=false, delay=0, grace=0, rand=false, minD=50, maxD=150,
    vis=false, team=true, fov=250, dist=500,
}
local tbConn=nil; local tbLastSeen=0; local tbLastFire=0

local function tbDelay()
    if TB.rand then return math.random(math.min(TB.minD,TB.maxD), math.max(TB.minD,TB.maxD)) end
    return TB.delay
end

local function fireShot(item, hitPart, origin)
    if not item or not hitPart then return end
    if not mUtil or not mEnum or not rUseItem then return end
    local oid = nil; pcall(function() oid = item:Get("ObjectID") end)
    if not oid then return end
    local org = origin or cam.CFrame.Position
    local aimCF = CFrame.lookAt(org, hitPart.Position)
    local sd = {}
    pcall(function()
        sd[utf8.char(1)] = {
            [utf8.char(0)] = mUtil:EncodeCFrame(aimCF),
            [utf8.char(1)] = mUtil:EncodeCFrame(hitPart.CFrame),
            [utf8.char(2)] = hitPart,
            [utf8.char(3)] = mUtil:EncodeCFrame(hitPart.CFrame:ToObjectSpace(CFrame.new(hitPart.Position))),
        }
    end)
    pcall(function() rUseItem:FireServer(oid, mEnum:ToEnum("StartShooting"), sd, nil) end)
    task.delay(0.07, function()
        pcall(function() rUseItem:FireServer(oid, mEnum:ToEnum("StopShooting"), {}, nil) end)
    end)
end

local function startTB()
    if tbConn then tbConn:Disconnect() end
    tbLastSeen=0; tbLastFire=0
    tbConn = rs.Heartbeat:Connect(function()
        if not TB.on or not lp.Character then return end
        local lf=nil; pcall(function() if mFig then lf=mFig.LocalFighter end end)
        if not lf then return end
        local item=lf.EquippedItem; if not item then return end
        local ammo=nil; pcall(function() ammo=item:Get("CurrentAmmo") end)
        if ammo ~= nil and ammo <= 0 then return end
        local now=tick(); local c=scr(); local found=false; local fp=nil
        for _, p in ipairs(plr:GetPlayers()) do
            if p==lp then continue end
            if TB.team and sameTm(p) then continue end
            local chr=p.Character; if not chr then continue end
            local hm=chr:FindFirstChildOfClass("Humanoid")
            if not hm or hm.Health<=0 then continue end
            for _, n in ipairs({"Head","UpperTorso","LowerTorso","HumanoidRootPart"}) do
                local pt=chr:FindFirstChild(n); if not pt then continue end
                local dist=(cam.CFrame.Position-pt.Position).Magnitude
                if dist>TB.dist then continue end
                if TB.vis and not isVis(cam.CFrame.Position, pt) then continue end
                local sp, on=cam:WorldToViewportPoint(pt.Position)
                if not on or sp.Z<=0 then continue end
                local sd2=(Vector2.new(sp.X,sp.Y)-c).Magnitude
                if sd2<=TB.fov then found=true; fp=pt; tbLastSeen=now; break end
            end
            if found then break end
        end
        local grace=(now-tbLastSeen)*1000<=TB.grace
        if not found and not grace then return end
        if (now-tbLastFire)*1000<tbDelay() then return end
        tbLastFire=now; if fp then fireShot(item,fp) end
    end)
end

-- ═══════════════════════════════════════════
-- RAGEBOT — Priority + FFA
-- ═══════════════════════════════════════════
local RG = {
    on=false, dist=999, team=false, vis=false, part="Head",
    voidSpam=false, hideTime=0.25, atkTime=0.1, attempts=1,
    priority="Closest", ffa=false,
}
local rgConn=nil; local rgCD=0; local rgRunning=false
local rgOrbitC=nil; local rgEnemy=nil; local rgOrbitA=0
local rgRp=RaycastParams.new(); rgRp.FilterType=Enum.RaycastFilterType.Exclude

local function rgValid(p)
    if p==lp then return false end
    if not RG.ffa and RG.team and sameTm(p) then return false end
    local chr=p.Character; if not chr then return false end
    local hm=chr:FindFirstChildOfClass("Humanoid")
    return hm and hm.Health>0

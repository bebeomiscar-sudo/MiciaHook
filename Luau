-- ★★★ DEVICE SPOOFER ENGINE (2-STEP METHOD) ★★★
-- Step 1: Fire "MouseKeyboard" to reset
-- Step 2: Wait 0.3s
-- Step 3: Fire target device
-- This is required — directly switching doesn't give aim assist
--━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
local spoofBusy = false

local function spoofDevice(wantedDevice)
    if not SetControlsRemote then return false end
    if spoofBusy then return false end
    spoofBusy = true

    local ok = pcall(function()
        -- Step 1: Reset to MouseKeyboard first
        SetControlsRemote:FireServer("MouseKeyboard")
        -- Step 2: Wait for server to process the reset
        task.wait(0.3)
        -- Step 3: Now send the actual desired device
        SetControlsRemote:FireServer(wantedDevice)
    end)

    spoofBusy = false
    return ok
end

local spoofLoopThread = nil

local function startAutoSpoof()
    if spoofLoopThread then pcall(function() task.cancel(spoofLoopThread) end) end
    if CFG.Spoofer.AutoSpoof and CFG.Spoofer.Device ~= "None" then
        spoofLoopThread = task.spawn(function()
            while CFG.Spoofer.AutoSpoof and CFG.Spoofer.Device ~= "None" do
                spoofDevice(CFG.Spoofer.Device)
                task.wait(CFG.Spoofer.Interval)
            end
        end)
    end
end

local function stopAutoSpoof()
    CFG.Spoofer.AutoSpoof = false
    if spoofLoopThread then pcall(function() task.cancel(spoofLoopThread) end);spoofLoopThread=nil end
end


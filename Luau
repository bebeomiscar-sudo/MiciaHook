        local contLayout = List(cont, Enum.FillDirection.Vertical, 5)

        local function resize()
            local h = contLayout.AbsoluteContentSize.Y + 18
            cont.Size = UDim2.new(1,0,0,h); box.Size = UDim2.new(1,0,0,24+h)
        end
        contLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(resize)
        task.defer(resize)

        GB._cont=cont; GB._resize=resize

        function GB:AddLabel(text)

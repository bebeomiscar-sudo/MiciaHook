RunService.RenderStepped:Connect(function()
    local parts = {"Rivals Tool v9.8"}
    if WatermarkCFG.ShowTime then table.insert(parts, os.date("%H:%M:%S")) end
    if WatermarkCFG.ShowActive then
        local active = {}
        if AimbotCFG.On             then table.insert(active, "AIM")    end
        if SilentAimCFG.Enabled     then table.insert(active, "SA")     end
        if SAHookCFG.On             then table.insert(active, "HOOK")   end
        if silentActive             then table.insert(active, "RAGE")   end
        if TrigCFG.On               then table.insert(active, "TRIG")   end
        if CFG.Void.On              then table.insert(active, "VOID")   end
        if CFG.Orbit.On             then table.insert(active, "ORBIT")  end
        if AntiAimCFG.Enabled       then table.insert(active, "AA")     end
        if FakeLagCFG.Enabled       then table.insert(active, "FL")     end
        if ESPCFG.Enabled           then table.insert(active, "ESP")    end
        if GunCFG.NoRecoil or GunCFG.NoSpread or GunCFG.FastShoot or GunCFG.RapidFire then table.insert(active, "GUN") end
        if #active > 0 then table.insert(parts, "["..table.concat(active," ").."]") end
    end
    watermark:SetText(table.concat(parts, " | "))
end)


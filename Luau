-- ═══════════════════════════════════════════
-- TARGET SELECTION (World-distance based)
-- ═══════════════════════════════════════════
local function getClosest(opts)
    opts = opts or {}
    local teamCheck = opts.teamCheck or false
    local visCheck  = opts.visCheck  or false
    local radius    = opts.radius    or math.huge
    local closest, closestD = nil, math.huge
    local localHRP = getHRP(LP)
    if not localHRP then return nil end
    for _, p in pairs(Players:GetPlayers()) do
        if p == LP then continue end
        if teamCheck and isSameTeam(p) then continue end
        local hrp = getHRP(p); if not hrp then continue end
        local hum = getHum(p); if not hum or hum.Health <= 0 then continue end
        local d = (hrp.Position - localHRP.Position).Magnitude
        if d > radius then continue end
        if visCheck and not isVisible(camera.CFrame.Position, hrp.Position) then continue end
        if d < closestD then closestD = d; closest = p end
    end
    return closest
end

local function getEffectiveFOV()
    local fov = AimbotCFG.MaxFOV
    if AimbotCFG.DynamicFOV then fov = fov * (camera.FieldOfView / 70) end
    return fov
end

-- ═══════════════════════════════════════════
-- SILENT AIM (Memory Hook)
-- ═══════════════════════════════════════════
local currentSATarget = nil
local saStarted = false

local function applyMemorySA()
    if not _util or not _origRaycast then return end
    _util.Raycast = function(...)
        local args = {...}
        if katanaActive and #args > 0 then
            args[3] = Vector3.new(
                args[3].X + math.random(10,30),
                args[3].Y + math.random(10,30),
                args[3].Z + math.random(10,30)
            )
            return _origRaycast(table.unpack(args))
        end
        if not SilentAimCFG.Enabled then return _origRaycast(table.unpack(args)) end
        local roll = math.random(1, 100)
        if roll <= SilentAimCFG.HitChance then
            local t = getClosest({teamCheck=SilentAimCFG.TeamCheck, visCheck=SilentAimCFG.VisibleOnly})
            if t and t.Character then
                local part = t.Character:FindFirstChild(SilentAimCFG.HitPart)
                    or t.Character:FindFirstChild("UpperTorso")
                    or t.Character:FindFirstChild("HumanoidRootPart")
                if part and args[3] then
                    currentSATarget = t
                    args[3] = part.Position
                    if MiscCFG.HitSound.Enabled then task.spawn(playHitSound, MiscCFG.HitSound.Sound) end
                end
            end
        end
        return _origRaycast(table.unpack(args))
    end
end

local function removeMemorySA()
    if _util and _origRaycast then _util.Raycast = _origRaycast; currentSATarget = nil end
end

local function startSilentAim()
    if saStarted then return end; saStarted = true
    applyMemorySA()
    -- Mouse mode
    RunService.RenderStepped:Connect(function()
        if not SilentAimCFG.Enabled or SilentAimCFG.Mode ~= "Mouse" then return end
        if not isShooting then return end
        local t = getClosest({teamCheck=SilentAimCFG.TeamCheck, visCheck=SilentAimCFG.VisibleOnly})
        if not t or not t.Character then return end
        local part = t.Character:FindFirstChild(SilentAimCFG.HitPart)
            or t.Character:FindFirstChild("HumanoidRootPart")
        if not part then return end
        local sp, on = camera:WorldToViewportPoint(part.Position)
        if on and sp.Z > 0 then pcall(function() mousemoveabs(sp.X, sp.Y) end) end
    end)
    -- Camera mode
    RunService.RenderStepped:Connect(function()
        if not SilentAimCFG.Enabled or SilentAimCFG.Mode ~= "Camera" then return end
        if not isShooting then return end
        local t = getClosest({teamCheck=SilentAimCFG.TeamCheck, visCheck=SilentAimCFG.VisibleOnly})
        if not t or not t.Character then return end
        local part = t.Character:FindFirstChild(SilentAimCFG.HitPart)
            or t.Character:FindFirstChild("HumanoidRootPart")
        if not part then return end
        local dir = (part.Position - camera.CFrame.Position).Unit
        camera.CFrame = CFrame.new(camera.CFrame.Position, camera.CFrame.Position + dir)
    end)
end
local function stopSilentAim()
    SilentAimCFG.Enabled = false; removeMemorySA()
end

-- ═══════════════════════════════════════════
-- KICIAHOOK SILENT AIM (ViewportSize Hook)
-- ═══════════════════════════════════════════
local saHookTarget  = nil
local saHookConn    = nil
local saHookApplied = false
local saHookIdx     = nil

local SA_PART_MAP = {
    ["Head"]       = {"Head"},
    ["Body"]       = {"UpperTorso","LowerTorso","HumanoidRootPart"},
    ["Head, Body"] = {"Head","UpperTorso","LowerTorso","HumanoidRootPart"},
    ["Body, Head"] = {"UpperTorso","LowerTorso","Head"},
}
local function saGetEffectiveFOV()
    if SAHookCFG.IgnoreFOV then return math.huge end
    local fov = SAHookCFG.FOVSize
    if SAHookCFG.DynamicFOV then fov = fov * (camera.FieldOfView / 70) end
    return fov
end
local function saGetTargetPart(char)
    local names = SA_PART_MAP[SAHookCFG.TargetParts] or {"Head"}
    if SAHookCFG.PreferRandom then
        local valid = {}
        for _, n in ipairs(names) do
            local p = char:FindFirstChild(n)
            if p then table.insert(valid, p) end
        end
        if #valid > 0 then return valid[math.random(1, #valid)] end
        return nil
    end
    for _, n in ipairs(names) do
        local p = char:FindFirstChild(n); if p then return p end
    end
    return nil
end
local function startSAHook()
    if not saHookApplied then
        local ok = pcall(function()
            saHookIdx = hookmetamethod(game, "__index", newcclosure(function(self, idx, ...)
                if saHookTarget and not checkcaller()
                    and idx == "ViewportSize"
                    and self == workspace.CurrentCamera
                then
                    if math.random(1, 100) <= SAHookCFG.HitChance then
                        local pos, on = workspace.CurrentCamera:WorldToViewportPoint(saHookTarget)
                        if on then return Vector2.new(pos.X * 2, pos.Y * 2) end
                    end
                end
                return saHookIdx(self, idx, ...)
            end))
        end)
        if ok then saHookApplied = true end
    end
    if saHookConn then saHookConn:Disconnect() end
    saHookConn = RunService.Heartbeat:Connect(function()
        if not SAHookCFG.On then saHookTarget = nil; return end
        local cam    = workspace.CurrentCamera
        local camPos = cam.CFrame.Position
        local center = cam.ViewportSize / 2
        local best, bd = nil, math.huge
        for _, plr in Players:GetPlayers() do
            if plr == LP then continue end
            local char = plr.Character; if not char then continue end
            local hum  = char:FindFirstChildOfClass("Humanoid")
            if not (hum and hum.Health > 0) then continue end
            if SAHookCFG.TeamCheck and isSameTeam(plr) then continue end
            local head = char:FindFirstChild("Head"); if not head then continue end
            if (head.Position - camPos).Magnitude > SAHookCFG.Distance then continue end
            local targetPart = saGetTargetPart(char); if not targetPart then continue end
            local sp, on = cam:WorldToViewportPoint(targetPart.Position)
            if on then
                local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                if not SAHookCFG.IgnoreFOV and d > saGetEffectiveFOV() then continue end
                if SAHookCFG.Targeting == "Closest" then
                    if d < bd then bd = d; best = targetPart end
                elseif SAHookCFG.Targeting == "Furthest" then
                    if d > bd or bd == math.huge then bd = d; best = targetPart end
                else
                    if best == nil or math.random() < 0.5 then best = targetPart end
                end
            end
        end
        saHookTarget = best and best.Position or nil
    end)
end
local function stopSAHook()
    SAHookCFG.On = false; saHookTarget = nil
    if saHookConn then saHookConn:Disconnect(); saHookConn = nil end
end


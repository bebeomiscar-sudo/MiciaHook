    local l=Drawing.new("Line")
    l.From=s2; l.To=e2
    l.Thickness=math.max(TR.width*10, 1)
    l.Color=trColor()
    l.Transparency=0; l.Visible=true
    table.insert(trPool,{born=tick(), objs={l},
        startPos=startPos, endPos=endPos, style="Line"})
end

-- ── SPAWN BEAM TRACER ──
local function spawnBeamTracer(startPos, endPos)
    local folder=Instance.new("Folder"); folder.Name="TracerBeam"; folder.Parent=ws
    local a0=Instance.new("Attachment"); a0.WorldPosition=startPos; a0.Parent=ws.Terrain
    local a1=Instance.new("Attachment"); a1.WorldPosition=endPos;   a1.Parent=ws.Terrain
    local beam=Instance.new("Beam")
    beam.Attachment0=a0; beam.Attachment1=a1
    local c=trColor()
    if TR.gradMode then
        beam.Color=ColorSequence.new({
            ColorSequenceKeypoint.new(0, TR.gradStart),
            ColorSequenceKeypoint.new(1, TR.gradEnd),
        })
    else
        beam.Color=ColorSequence.new(c)
    end
    beam.Width0=TR.width; beam.Width1=TR.width*0.5
    beam.LightEmission=TR.lightEm; beam.FaceCamera=true
    beam.Transparency=NumberSequence.new(0.3)
    beam.Segments=4; beam.CurveSize0=0; beam.CurveSize1=0
    beam.Parent=ws.Terrain
    table.insert(trPool,{born=tick(), objs={beam,a0,a1,folder}, style="Beam"})
end

-- ── SPAWN PART TRACER ──
local function spawnPartTracer(startPos, endPos)
    local dist=(endPos-startPos).Magnitude
    if dist<0.1 then return end
    local mid=startPos:Lerp(endPos,0.5)
    local p=Instance.new("Part")
    p.Anchored=true; p.CanCollide=false; p.CastShadow=false
    p.Material=Enum.Material.Neon
    p.Color=trColor()
    p.Size=Vector3.new(TR.width,TR.width,dist)
    p.CFrame=CFrame.lookAt(mid,(endPos-startPos).Unit+mid)
    p.Transparency=0.2
    p.Parent=ws
    table.insert(trPool,{born=tick(), objs={p}, style="Part"})
end

-- ── SPAWN LIGHTNING TRACER ──
local function spawnLightningTracer(startPos, endPos)
    local segs=math.clamp(TR.segments,3,20)
    local lines={}
    local pts={startPos}
    for i=1,segs-1 do
        local t=i/segs
        local base=startPos:Lerp(endPos,t)
        local off=Vector3.new(
            (math.random()-0.5)*TR.offset*2,
            (math.random()-0.5)*TR.offset*2,
            (math.random()-0.5)*TR.offset*2
        )
        table.insert(pts,base+off)
    end
    table.insert(pts,endPos)
    local c=trColor()
    for i=1,#pts-1 do
        local s2=w2s(pts[i]); local e2=w2s(pts[i+1])
        if s2 and e2 then
            local l=Drawing.new("Line")
            l.From=s2; l.To=e2
            l.Thickness=math.max(TR.width*8,1)
            l.Color=c; l.Transparency=0; l.Visible=true
            table.insert(lines,l)
        end
    end
    table.insert(trPool,{born=tick(), objs=lines, style="Lightning",
        pts=pts, startPos=startPos, endPos=endPos})
end

-- ── MASTER SPAWN ──
local function spawnTracer(startPos, endPos)
    if not TR.enabled then return end
    if not startPos or not endPos then return end
    -- enforce max
    while #trPool >= TR.maxCount do
        local oldest=table.remove(trPool,1)
        for _, obj in ipairs(oldest.objs or {}) do
            pcall(function()
                if typeof(obj)=="Instance" then obj:Destroy() else obj:Remove() end
            end)
        end
    end
    if TR.style=="Beam" then spawnBeamTracer(startPos, endPos)
    elseif TR.style=="Part" then spawnPartTracer(startPos, endPos)
    elseif TR.style=="Lightning" then spawnLightningTracer(startPos, endPos)
    else spawnLineTracer(startPos, endPos) end
end

-- Update Line/Lightning tracer 2D positions each frame
local function updateTracerPositions()
    for _, t in ipairs(trPool) do
        if t.style=="Line" then
            local s2=w2s(t.startPos); local e2=w2s(t.endPos)
            pcall(function()
                if s2 and e2 then
                    t.objs[1].From=s2; t.objs[1].To=e2; t.objs[1].Visible=true
                else t.objs[1].Visible=false end
            end)
        elseif t.style=="Lightning" then
            -- re-render lightning each frame (flicker)
            local c=TR.rainbow and getRainbow() or TR.color
            local objIdx=1
            for i=1,#t.pts-1 do
                local s2=w2s(t.pts[i]); local e2=w2s(t.pts[i+1])
                local obj=t.objs[objIdx]; objIdx=objIdx+1
                if obj then
                    pcall(function()
                        if s2 and e2 then
                            obj.From=s2; obj.To=e2
                            obj.Color=c; obj.Visible=true
                        else obj.Visible=false end
                    end)
                end
            end
        end
    end
end


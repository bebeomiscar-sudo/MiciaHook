    ["Legs"]              = {"LeftUpperLeg", "RightUpperLeg", "LeftLowerLeg", "RightLowerLeg", "LeftFoot", "RightFoot"},
    ["Head, Body"]        = {"Head", "UpperTorso", "LowerTorso", "Torso", "HumanoidRootPart"},
    ["Body, Head"]        = {"UpperTorso", "LowerTorso", "Torso", "HumanoidRootPart", "Head"},
    ["Head, Arms"]        = {"Head", "LeftUpperArm", "RightUpperArm", "LeftLowerArm", "RightLowerArm"},

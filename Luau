-- UTILITY FUNCTIONS
-- ══════════════════════════════════════════════════
local VisRp = RaycastParams.new()
VisRp.FilterType = Enum.RaycastFilterType.Exclude

-- Screen center (NO Player:GetMouse())
local function screenCenter()
    return sUIS:GetMouseLocation()
    -- Note: for aimbot FOV we compare against screen center
    -- For actual mouse pos we use GetMouseLocation
end

local function viewportCenter()
    return Vector2.new(Cam.ViewportSize.X/2, Cam.ViewportSize.Y/2)
end

local function sameTeam(p)
    local r = false
    pcall(function()
        local a = LP:GetAttribute("TeamID")
        local b = p:GetAttribute("TeamID")
        if a ~= nil and b ~= nil then r = (a == b) end
    end)
    return r
end

local function canSee(origin, part)
    if not part then return false end
    local ok, res = pcall(function()
        VisRp.FilterDescendantsInstances = {LP.Character, part.Parent}
        local dir = part.Position - origin
        local hit = sWorkspace:Raycast(origin, dir, VisRp)
        return hit == nil or hit.Instance:IsDescendantOf(part.Parent)
    end)
    return ok and res
end

local function onScreen(part, fovSize, useCrosshair)
    if not part then return false end
    local sp, on = Cam:WorldToViewportPoint(part.Position)
    if not on then return false end
    local center = useCrosshair and screenCenter() or viewportCenter()
    return (Vector2.new(sp.X, sp.Y) - center).Magnitude <= fovSize
end

local function worldToScreen(pos)
    local sp, on = Cam:WorldToViewportPoint(pos)
    if not on or sp.Z <= 0 then return nil end
    return Vector2.new(sp.X, sp.Y)
end

local function angleLerp(a, b, t)
    local d = ((b - a + math.pi) % (math.pi*2)) - math.pi
    return a + d * t
end

local function yawDiff(from, to)
    local d = to - from
    return ((d + math.pi) % (math.pi*2)) - math.pi
end


    if autoJoinConn then autoJoinConn:Disconnect() end
    autoJoinConn=RunService.Heartbeat:Connect(function()
        if not MechCFG.AutoJoinArcade or not ArcadeCtrl then return end
        pcall(function() if ArcadeCtrl:CanJoin() then ArcadeCtrl:Join() end end)
    end)
end
local function stopAutoJoinArcade()
    MechCFG.AutoJoinArcade=false; if autoJoinConn then autoJoinConn:Disconnect(); autoJoinConn=nil end
end
local rangeESPEnabled=false; local rangeESPLabels={}; local rangeESPConn=nil
local function clearRangeESP() for _,lbl in pairs(rangeESPLabels) do pcall(function() lbl:Destroy() end) end; rangeESPLabels={} end
local function startRangeESP()
    if rangeESPConn then rangeESPConn:Disconnect() end
    rangeESPConn=RunService.RenderStepped:Connect(function()
        clearRangeESP(); if not rangeESPEnabled or not EntityCtrl then return end
        if not MechanicsCtrl or not MechanicsCtrl.LocalFighter then return end
        local ok,points=pcall(function() return EntityCtrl:GetScreenPoints(MechanicsCtrl.LocalFighter,false) end)
        if not ok or not points then return end
        local pg=LP:FindFirstChild("PlayerGui"); if not pg then return end
        for entity,sp in pairs(points) do
            pcall(function()
                local lbl=Instance.new("TextLabel"); lbl.BackgroundColor3=Color3.fromRGB(20,20,20); lbl.BackgroundTransparency=0.4; lbl.BorderSizePixel=0
                lbl.Text=entity.Name or "Entity"; lbl.TextColor3=Color3.fromRGB(255,80,80); lbl.Font=Enum.Font.GothamBold; lbl.TextSize=13
                lbl.Size=UDim2.new(0,80,0,20); lbl.AnchorPoint=Vector2.new(0.5,0.5); lbl.Position=UDim2.new(0,sp.X,0,sp.Y-24); lbl.ZIndex=10; lbl.Parent=pg
                table.insert(rangeESPLabels,lbl)
            end)
        end
    end)
end
local function stopRangeESP() rangeESPEnabled=false; clearRangeESP(); if rangeESPConn then rangeESPConn:Disconnect(); rangeESPConn=nil end end


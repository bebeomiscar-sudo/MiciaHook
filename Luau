-- ═══════════════════════════════════════════
-- CORE RENDER STEP
-- ═══════════════════════════════════════════
local watermark = library:Hud()

table.insert(ActiveConnections, RunService.RenderStepped:Connect(function(dt)
    camera = workspace.CurrentCamera
    local center = getScreenCenter()

    if CFG.Crosshair.On then crosshairImg.Position = UDim2.new(0.5,0,0.5,0) end

    if fovCircle then
        fovCircle.Position = center
        fovCircle.Radius   = AimbotCFG.MaxFOV
        fovCircle.Visible  = AimbotCFG.DrawFOV and AimbotCFG.On
    end
    if saFovCircle then
        saFovCircle.Position = center
        saFovCircle.Radius   = SAHookCFG.IgnoreFOV and 0 or saGetEffectiveFOV()
        saFovCircle.Visible  = SAHookCFG.DrawFOV and SAHookCFG.On and not SAHookCFG.IgnoreFOV
    end

    -- AIMBOT
    if AimbotCFG.On and CameraController then
        if isInReaction then
            reactionTimer = reactionTimer - dt
            if reactionTimer <= 0 then isInReaction = false end
        end
        if not isInReaction then
            if lockedTarget and not isTargetStillValid(lockedTarget) then
                lockedTarget=nil; lockTimer=0
            end
            if not lockedTarget then
                local newT = findNewAimbotTarget()
                if newT then
                    lockedTarget=newT; lockTimer=0
                    isInReaction=true; reactionTimer=AimbotCFG.ReactionTime/1000
                end
            end
            if lockedTarget then
                lockTimer = lockTimer + dt
                if lockTimer > AimbotCFG.MaxLockTime then
                    lockedTarget=nil; lockTimer=0
                else
                    local isAtk = false
                    pcall(function()
                        if fighter_mod and fighter_mod.LocalFighter then
                            isAtk = fighter_mod.LocalFighter:Get("IsShooting") == true
                        end
                    end)
                    local speed = isAtk and AimbotCFG.SpeedInAttack or AimbotCFG.Speed
                    local sp2, on2 = camera:WorldToScreenPoint(lockedTarget.Position)
                    if on2 then
                        local sd = (Vector2.new(sp2.X, sp2.Y) - center).Magnitude
                        local fr = getEffectiveFOV()
                        if fr > 0 then
                            speed = speed * math.max(0.1, 1 - (sd/fr) * (AimbotCFG.SpeedScaleFOV/100))
                        end
                    end
                    pcall(function()
                        local cp  = camera.CFrame.Position
                        local du  = (lockedTarget.Position - cp).Unit
                        local tP  = math.asin(du.Y)
                        local tY  = math.atan2(-du.X, -du.Z)
                        local sm  = math.clamp(speed/5, 0, 1)
                        local cur = CameraController.Rotation
                        CameraController:SetRotation(Vector2.new(
                            cur.X + (tP - cur.X) * sm,
                            cur.Y + angleDiff(cur.Y, tY) * sm
                        ))
                    end)
                end
            end
        end
    end

    -- PC TRIGGERBOT
    if TrigCFG.On then
        local tgt = getTriggerTarget()
        if tgt then
            if not TrigState.waiting then
                TrigState.waiting=true; TrigState.timer=getTrigDelay(); TrigState.grace=TrigCFG.Grace/1000
            end
            TrigState.timer = TrigState.timer - dt
            if TrigState.timer <= 0 then
                simClick(); TrigState.waiting=false; TrigState.timer=0
            end
        else
            if TrigState.waiting then
                TrigState.grace = TrigState.grace - dt
                if TrigState.grace <= 0 then
                    TrigState.waiting=false; TrigState.timer=0; TrigState.grace=0
                end
            end
        end
    else
        TrigState.waiting=false; TrigState.timer=0; TrigState.grace=0
    end

    -- MOBILE TRIGGERBOT
    if IsMobile and MobileTrigCFG.On then
        local sf = MobileTrigCFG.AutoFire or (MobileTrigCFG.HoldToShoot and MobileTrigState.touching)
        if sf then
            local tgt = getMobileTrigTarget()
            if tgt then
                if not MobileTrigState.waiting then
                    MobileTrigState.waiting=true
                    MobileTrigState.timer=MobileTrigCFG.Delay/1000
                    MobileTrigState.cooldown=0
                end
                MobileTrigState.timer = MobileTrigState.timer - dt
                if MobileTrigState.timer <= 0 then
                    MobileTrigState.cooldown = MobileTrigState.cooldown - dt
                    if MobileTrigState.cooldown <= 0 then
                        simClick(); MobileTrigState.cooldown = MobileTrigCFG.BurstMs/1000
                    end
                end
            else
                if not MobileTrigState.touching then
                    MobileTrigState.waiting=false; MobileTrigState.timer=0; MobileTrigState.cooldown=0
                end
            end
        else
            MobileTrigState.waiting=false; MobileTrigState.timer=0; MobileTrigState.cooldown=0
        end
    end

    -- BULLET TRACER UPDATE
    local now  = tick()
    local life = TracerCFG.Duration
    local keep = {}
    for _, t in ipairs(activeTracers) do
        local age = now - t.Born
        if age < life and t.Line and t.Line.Parent then
            local hsp, hon = camera:WorldToViewportPoint(t.HitPos)
            if hon and hsp.Z > 0 then
                local sFrom = getTracerOrigin()
                local sTo   = Vector2.new(hsp.X, hsp.Y)
                local delta = sTo - sFrom
                local len   = delta.Magnitude
                if len >= 2 then
                    t.Line.Size     = UDim2.new(0, len, 0, TracerCFG.Thickness)
                    t.Line.Position = UDim2.new(0, sFrom.X, 0, sFrom.Y)
                    t.Line.Rotation = math.deg(math.atan2(delta.Y, delta.X))
                end
                t.Line.BackgroundTransparency = TracerCFG.Fade
                    and math.clamp(age/life, 0, 0.95) or 0
                t.Line.Visible = true
            else
                t.Line.Visible = false
            end
            table.insert(keep, t)
        else
            pcall(function() if t.Line then t.Line:Destroy() end end)
        end
    end
    activeTracers = keep

    -- WATERMARK
    local parts = {"Rivals Tool v9.8"}
    if WatermarkCFG.ShowTime then table.insert(parts, os.date("%H:%M:%S")) end
    if WatermarkCFG.ShowActive then
        local a = {}
        if AimbotCFG.On    then table.insert(a,"AIM")   end
        if SAHookCFG.On    then table.insert(a,"HOOK")  end
        if silentActive    then table.insert(a,"RAGE")  end
        if TrigCFG.On      then table.insert(a,"TRIG")  end
        if IsMobile and MobileTrigCFG.On then table.insert(a,"MTRIG") end
        if CFG.Void.On     then table.insert(a,"VOID")  end
        if CFG.Orbit.On    then table.insert(a,"ORBIT") end
        if GunCFG.NoRecoil or GunCFG.NoSpread or GunCFG.FastShoot then table.insert(a,"GUN") end
        if AntiAimCFG.On   then table.insert(a,"AA")    end
        if TracerCFG.On    then table.insert(a,"TRACE") end
        if #a > 0 then table.insert(parts, "["..table.concat(a," ").."]") end
    end
    watermark:SetText(table.concat(parts, " | "))
end))


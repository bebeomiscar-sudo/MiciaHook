-- SKINS SYSTEM
-- ═══════════════════════════════════════════
local skinEnabled = false
local skinColor1  = Color3.fromRGB(255, 50, 50)
local skinColor2  = Color3.fromRGB(50, 50, 255)

local function applySkinToChar(char, enabled, c1, c2)
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
            if enabled then
                part.Color = c1
            end
        end
        if part:IsA("SpecialMesh") or part:IsA("UnionOperation") then
            if enabled then
                part.Color3 = c2
            end
        end
    end
end

local function refreshSkins()
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then
            applySkinToChar(p.Character, skinEnabled, skinColor1, skinColor2)
        end
    end
end


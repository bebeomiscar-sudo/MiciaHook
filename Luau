-- ADVANCED BULLET TRACERS
-- Style: "Line" (Drawing), "Beam", "Part", "Lightning"
-- ═══════════════════════════════════════════
local TR = {
    enabled   = false,
    style     = "Line",     -- "Line" | "Beam" | "Part" | "Lightning"
    color     = Color3.fromRGB(255,255,0),
    width     = 0.2,
    duration  = 0.15,
    fadeOut   = true,
    rainbow   = false,
    maxCount  = 10,
    gradMode  = false,
    gradStart = Color3.fromRGB(255,255,0),
    gradEnd   = Color3.fromRGB(255,0,0),
    lightEm   = 1.0,
    -- Lightning specific
    segments  = 8,
    offset    = 1.0,
}

-- Tracer pool
local trPool = {}

-- Rainbow helper
local rainbowHue = 0
local function getRainbow()
    rainbowHue = (rainbowHue + 0.005) % 1
    return Color3.fromHSV(rainbowHue, 1, 1)
end

-- Gradient helper (0-1 t)
local function getGradColor(t)
    return TR.gradStart:Lerp(TR.gradEnd, t)
end

-- Effective color
local function trColor()
    if TR.rainbow then return getRainbow() end
    return TR.color
end

-- ── CLEAN old tracers ──
local function cleanTracers()
    local now=tick(); local alive={}
    for _, t in ipairs(trPool) do
        local age=now-t.born
        local life=math.max(TR.duration,0.05)
        if age>=life then
            -- destroy all objects in t.objs
            for _, obj in ipairs(t.objs or {}) do
                pcall(function()
                    if typeof(obj)=="Instance" then obj:Destroy()
                    else obj:Remove() end
                end)
            end
        else
            -- fade
            local alpha=1-(age/life)
            if TR.fadeOut then
                for _, obj in ipairs(t.objs or {}) do
                    pcall(function()
                        if typeof(obj)=="Instance" then
                            if obj:IsA("BasePart") then obj.Transparency=1-alpha
                            elseif obj:IsA("Beam") then
                                obj.Transparency=NumberSequence.new({
                                    NumberSequenceKeypoint.new(0,1-alpha),
                                    NumberSequenceKeypoint.new(1,1),
                                })
                            end
                        else
                            -- Drawing line
                            obj.Transparency = 1-alpha
                        end
                    end)
                end
            end
            table.insert(alive,t)
        end
    end
    trPool=alive
end

-- ── SPAWN LINE TRACER (Drawing API, always works) ──
local function spawnLineTracer(startPos, endPos)
    local s2=w2s(startPos); local e2=w2s(endPos)

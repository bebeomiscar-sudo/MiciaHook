            for _,p in ipairs(v:GetChildren()) do
                if p.ClassName~="Highlight" then table.insert(targets,p) end
            end
        end
    end
    return targets
end

local function silentGetAimPos(char)
    local h=char:FindFirstChild("Head"); local root=char:FindFirstChild("HumanoidRootPart")
    if not h then return nil end
    local velMult = CFG.Silent.ImproveAccuracy and CFG.Silent.AccuracyFactor or 0
    local pos = h.Position + (root and root.Velocity*velMult or Vector3.zero)
    if CFG.Silent.RandomAimpoint then
        pos = pos + Vector3.new((math.random()-0.5)*0.7,(math.random()-0.5)*0.4,(math.random()-0.5)*0.7)
    end
    return pos
end

local function silentGetEffectiveFOV()
    if CFG.Silent.IgnoreFOV then return math.huge end
    local fov = CFG.Silent.FOV
    if CFG.Silent.DynamicFOV then fov = fov*(camera.FieldOfView/70) end
    return fov
end

local function silentFindTarget()
    local cam=workspace.CurrentCamera; local center=Vector2.new(cam.ViewportSize.X/2,cam.ViewportSize.Y/2)
    local localChar=LP.Character; if not localChar then return nil end
    local fovLimit=silentGetEffectiveFOV(); local bestTarget,bestDist=nil,math.huge
    for _,char in ipairs(silentGetTargets()) do
        if char==localChar then continue end
        local hum=char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health<=0 then continue end
        local tp=Players:GetPlayerFromCharacter(char)
        if tp and CFG.Aimbot.TeamCheck and isSameTeam(tp) then continue end
        local root=char:FindFirstChild("HumanoidRootPart"); if not root then continue end
        if CFG.Silent.AntiKatana then
            local lr=localChar:FindFirstChild("HumanoidRootPart")
            if lr and (root.Position-lr.Position).Magnitude<15 then continue end
        end
        if CFG.Silent.VisibleCheck then
            local head=char:FindFirstChild("Head")
            if head and not isVisible(head) then continue end
        end
        local aimPos=silentGetAimPos(char); if not aimPos then continue end
        local sp,on=cam:WorldToViewportPoint(aimPos); if not on then continue end
        local d=(center-Vector2.new(sp.X,sp.Y)).Magnitude
        if d<fovLimit and d<bestDist then bestTarget=char; bestDist=d end
    end
    return bestTarget
end

local function applySilentHook()
    if silentHookApplied then return true end
    if not UtilityModule or not UtilityModule.Raycast then return false end
    local ok = pcall(function()
        silentOriginalRaycast = UtilityModule.Raycast
        UtilityModule.Raycast = function(...)
            local args={...}
            if args[4]==999 and CFG.Silent.On and isKeyHeld(CFG.Silent.Key) then
                if math.random(1,100)<=CFG.Silent.Hitchance then
                    local target=silentFindTarget()
                    if target then
                        local pos=silentGetAimPos(target)
                        if pos then args[3]=pos end
                    end
                end
            end
            return silentOriginalRaycast(unpack(args))
        end
    end)
    if ok then silentHookApplied=true end
    return ok
end

applySilentHook()


-- ═══════════════════════════════════════════
local function isPlayerImmune(p)
    if not ImmunityCFG.Enabled then return false end
    local data=playerImmunity[p]
    if data and data.forceShield then return true end
    local char=p.Character
    if char then
        if char:FindFirstChildOfClass("ForceField") then return true end
        for _,obj in ipairs(char:GetDescendants()) do
            local n=obj.Name:lower()
            if n=="shield" or n:find("immune") or n:find("protect") then
                if obj:IsA("BasePart") or obj:IsA("SelectionBox") or obj:IsA("ParticleEmitter") then return true end
            end
        end
    end
    if data and (tick()-data.spawnTime)<ImmunityCFG.SpawnProtectionTime then return true end
    return false
end
local function hookPlayerImmunity(p)
    if p==LP then return end
    local function onCharAdded(char)
        playerImmunity[p]={spawnTime=tick(),forceShield=false,lastMaxHealth=0}
        if char:FindFirstChildOfClass("ForceField") then playerImmunity[p].forceShield=true end
        char.ChildAdded:Connect(function(child)
            if child:IsA("ForceField") and playerImmunity[p] then playerImmunity[p].forceShield=true end
        end)
        char.ChildRemoved:Connect(function(child)
            if child:IsA("ForceField") and playerImmunity[p] then playerImmunity[p].forceShield=false end
        end)
        local hum=char:FindFirstChildOfClass("Humanoid")
        if hum then
            playerImmunity[p].lastMaxHealth=hum.MaxHealth
            hum:GetPropertyChangedSignal("MaxHealth"):Connect(function()
                if not playerImmunity[p] then return end
                local prev=playerImmunity[p].lastMaxHealth; local curr=hum.MaxHealth
                if curr>10000 and prev>0 and curr>prev*5 then playerImmunity[p].forceShield=true end
                playerImmunity[p].lastMaxHealth=curr
            end)
        end
    end
    if p.Character then task.spawn(function() task.wait(0.1); onCharAdded(p.Character) end) end
    p.CharacterAdded:Connect(function(char) task.wait(0.1); onCharAdded(char) end)
end

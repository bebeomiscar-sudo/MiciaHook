-- ANTI-AIM ENGINE
--━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
local function getAntiAimCFrame(realCF)
    local cf=realCF
    local pitchRad=0
    local yawRad=0
    local t=tick()

    -- PITCH
    local pm=CFG.AntiAim.PitchMode
    local pa=math.rad(CFG.AntiAim.PitchAngle)
    if pm=="Up" then pitchRad=pa
    elseif pm=="Down" then pitchRad=-pa
    elseif pm=="Glitch" then pitchRad=(t%0.08<0.04) and pa or -pa
    elseif pm=="Random" then pitchRad=math.rad((math.random()-0.5)*2*CFG.AntiAim.PitchAngle) end

    -- YAW BASE
    if CFG.AntiAim.YawBase=="At Targets" then
        local _,tr=getNearestEnemy()
        if tr then
            local dir=(tr.Position-cf.Position)*Vector3.new(1,0,1)
            if dir.Magnitude>0.1 then
                cf=CFrame.new(cf.Position,cf.Position+dir.Unit)
            end
        end
    end

    -- YAW MODE
    local ym=CFG.AntiAim.YawMode
    local sp=CFG.AntiAim.SpinSpeed
    if ym=="Spin" then
        yawRad=(t*sp)%(math.pi*2)
    elseif ym=="Glitch Spin" then
        yawRad=math.rad(math.random(-180,180))
    elseif ym=="Stutter Spin" then
        local fr=math.floor(t*sp*10)
        yawRad=(fr%2==0) and math.rad(CFG.AntiAim.YawAngle) or math.rad(-CFG.AntiAim.YawAngle)
    end

    -- APPLY ROTATIONS
    cf=cf*CFrame.Angles(pitchRad,yawRad,0)

    -- HIDE IN FLOOR
    if CFG.AntiAim.HideInFloor then
        cf=cf-Vector3.new(0,CFG.AntiAim.FloorDepth,0)
    end

    -- ANTI HEADSHOT
    if CFG.AntiAim.AntiHeadshot then
        local ho=CFG.AntiAim.HeadshotOffset
        cf=cf+Vector3.new((math.random()-0.5)*ho,(math.random()-0.5)*ho*0.5,(math.random()-0.5)*ho)
    end

    return cf
end


-- Lighting FX
local lightConn = nil
local lightHue  = 0
local function startLightingFX()
    if lightConn then lightConn:Disconnect() end
    lightConn = RunService.Heartbeat:Connect(function(dt)
        if not S.Visuals.Lighting.Enabled then
            lightConn:Disconnect(); lightConn = nil
            xpcall(function()
                Lighting.Brightness = origLight.Brightness
                Lighting.Ambient    = origLight.Ambient
            end, function(err) end)
            return
        end
        local mode = S.Visuals.Lighting.Mode
        local t    = tick() * S.Visuals.Lighting.Speed
        if mode == "Neon" then
            lightHue = (lightHue + dt * 0.3 * S.Visuals.Lighting.Speed) % 1
            local c  = Color3.fromHSV(lightHue, 1, 1)
            Lighting.Ambient = c; Lighting.OutdoorAmbient = c
            Lighting.Brightness = 2 + math.sin(t) * 0.5
        elseif mode == "Strobe" then
            local on = math.floor(t * 10) % 2 == 0
            Lighting.Brightness = on and 5 or 0.1
            Lighting.Ambient    = on and S.Visuals.Lighting.Color or Color3.new(0,0,0)
        elseif mode == "Pulse" then
            local a = (math.sin(t * 2) + 1) / 2
            local c = S.Visuals.Lighting.Color
            Lighting.Ambient    = Color3.new(c.R*a, c.G*a, c.B*a)
            Lighting.Brightness = 1 + a * 3
        elseif mode == "Disco" then
            Lighting.Ambient = Color3.new(
                (math.sin(t*1.7)+1)/2,
                (math.sin(t*2.3)+1)/2,
                (math.sin(t*3.1)+1)/2
            )
            Lighting.Brightness = 2
        elseif mode == "Static" then
            Lighting.Ambient    = S.Visuals.Lighting.Color
            Lighting.Brightness = 3
        end
    end)
end


local function isAimbotVisible(part)
    if not part then return false end
    local ok, r = pcall(function()
        local origin = camera.CFrame.Position
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = {LP.Character, part.Parent}
        local hit = workspace:Raycast(origin, part.Position - origin, params)
        return hit == nil or hit.Instance:IsDescendantOf(part.Parent)
    end)
    return ok and r or false
end

local function isTargetStillValid(part)
    if not part or not part.Parent then return false end
    local hum = part.Parent:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    if AimbotCFG.VisibleCheck and not isAimbotVisible(part) then return false end
    if AimbotCFG.TeamCheck then
        local p = Players:GetPlayerFromCharacter(part.Parent)
        if p and isSameTeamRivals(p) then return false end
    end
    return true
end

local function getEffectiveFOV()
    local fov = AimbotCFG.MaxFOV
    if AimbotCFG.DynamicFOV then fov = fov * (camera.FieldOfView / 70) end
    return fov
end

local function findNewAimbotTarget()
    local c  = getScreenCenter()
    local bp, bd = nil, getEffectiveFOV()
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LP then continue end
        if AimbotCFG.TeamCheck and isSameTeamRivals(p) then continue end
        local ch = p.Character; if not ch then continue end
        local h  = ch:FindFirstChildOfClass("Humanoid")
        if not h or h.Health <= 0 then continue end
        local part = getBestPart(ch, AimbotCFG.TargetPart)
        if not part then continue end
        if AimbotCFG.VisibleCheck and not isAimbotVisible(part) then continue end
        local sp, on = camera:WorldToScreenPoint(part.Position)
        if not on then continue end
        local d = (Vector2.new(sp.X, sp.Y) - c).Magnitude
        if d < bd then bd = d; bp = part end
    end
    return bp
end


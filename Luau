-- CORE HEARTBEAT (Anti-Aim desync + Orbit engine)
--━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
local monClock=0

table.insert(ActiveConnections,RunService.Heartbeat:Connect(function(dt)
    if not humanoidRootPart or not humanoidRootPart.Parent then return end
    if not character or not character:FindFirstChildOfClass("Humanoid") then return end
    local hum=character:FindFirstChildOfClass("Humanoid")
    if hum.Health<=0 then
        if AntiAimState.realCFrame then pcall(function() humanoidRootPart.CFrame=AntiAimState.realCFrame end) end
        AntiAimState.realCFrame=nil; return
    end

    ----------------------------------------------------------------
    -- ORBIT AURA
    ----------------------------------------------------------------
    if CFG.Orbit.On then
        local tp,tr,td=getNearestEnemy()

        if tr then
            OrbitState.tpTimer=OrbitState.tpTimer+dt
            OrbitState.shotTimer=OrbitState.shotTimer+dt

            -- Advance orbit angle
            OrbitState.angle=OrbitState.angle+(CFG.Orbit.Speed*dt)
            if OrbitState.angle>math.pi*2 then OrbitState.angle=OrbitState.angle-math.pi*2;OrbitState.totalCycles=OrbitState.totalCycles+1 end

            -- Anti-Projectile: dodge jump
            if CFG.Orbit.AntiProjectile then
                local incoming=checkIncomingProjectiles()
                if incoming then OrbitState.angle=OrbitState.angle+math.pi*0.7 end
            end

            -- Strike on Melee: snap attack
            local strikeTarget=nil
            if CFG.Orbit.StrikeOnMelee then
                local enemies=getAllNearbyEnemies(CFG.Orbit.MeleeRange)
                if #enemies>0 then strikeTarget=enemies[1].root end
            end

            -- Teleport at TP interval
            if OrbitState.tpTimer>=CFG.Orbit.TPDelay then
                OrbitState.tpTimer=0
                local tPos=tr.Position

                -- Anti-Riot: face average enemy direction
                local facingAngle=OrbitState.angle
                if CFG.Orbit.AntiRiot then
                    local riotAngle=getAntiRiotFacingAngle()
                    if riotAngle~=0 then
                        -- Offset orbit to keep enemies in our front arc
                        facingAngle=riotAngle+math.pi+OrbitState.angle
                    end
                end

                local orbX=tPos.X+math.cos(facingAngle)*CFG.Orbit.Radius
                local orbZ=tPos.Z+math.sin(facingAngle)*CFG.Orbit.Radius
                local orbY=tPos.Y+CFG.Orbit.Height

                local orbitCF=CFrame.new(Vector3.new(orbX,orbY,orbZ),tPos)

                -- If strike on melee is active and target is close, snap to strike pos
                if strikeTarget then
                    local sDir=(strikeTarget.Position-humanoidRootPart.Position)*Vector3.new(1,0,1)
                    if sDir.Magnitude>1 then
                        orbitCF=CFrame.new(strikeTarget.Position-sDir.Unit*5+Vector3.new(0,CFG.Orbit.Height,0),strikeTarget.Position)
                    end
                    simClick()
                end

                -- Apply anti-aim rotations to orbit CFrame if both active
                if CFG.AntiAim.On then
                    local pitchRad,yawRad=0,0
                    local t=tick()
                    local pm=CFG.AntiAim.PitchMode;local pa=math.rad(CFG.AntiAim.PitchAngle)
                    if pm=="Up" then pitchRad=pa elseif pm=="Down" then pitchRad=-pa
                    elseif pm=="Glitch" then pitchRad=(t%0.08<0.04) and pa or -pa
                    elseif pm=="Random" then pitchRad=math.rad((math.random()-0.5)*2*CFG.AntiAim.PitchAngle) end

                    local ym=CFG.AntiAim.YawMode;local sp=CFG.AntiAim.SpinSpeed
                    if ym=="Spin" then yawRad=(t*sp)%(math.pi*2)
                    elseif ym=="Glitch Spin" then yawRad=math.rad(math.random(-180,180))
                    elseif ym=="Stutter Spin" then local fr=math.floor(t*sp*10);yawRad=(fr%2==0) and math.rad(CFG.AntiAim.YawAngle) or math.rad(-CFG.AntiAim.YawAngle) end

                    orbitCF=orbitCF*CFrame.Angles(pitchRad,yawRad,0)
                    if CFG.AntiAim.HideInFloor then orbitCF=orbitCF-Vector3.new(0,CFG.AntiAim.FloorDepth,0) end
                    if CFG.AntiAim.AntiHeadshot then local ho=CFG.AntiAim.HeadshotOffset;orbitCF=orbitCF+Vector3.new((math.random()-0.5)*ho,(math.random()-0.5)*ho*0.5,(math.random()-0.5)*ho) end
                end

                humanoidRootPart.CFrame=orbitCF
            end

            -- Auto-fire at shot interval
            if CFG.Orbit.AutoFire and OrbitState.shotTimer>=CFG.Orbit.ShotInterval then
                OrbitState.shotTimer=0
                -- Resolver: aim camera at predicted head
                if CFG.Orbit.Resolver then
                    local aimPos=getResolvedAimPos(tr)
                    if aimPos then
                        pcall(function()
                            local dir=(aimPos-camera.CFrame.Position).Unit
                            camera.CFrame=CFrame.new(camera.CFrame.Position,camera.CFrame.Position+dir)
                        end)
                    end
                end
                simClick()
            end
        end

    ----------------------------------------------------------------
    -- ANTI-AIM (standalone, no orbit)
    ----------------------------------------------------------------
    elseif CFG.AntiAim.On then
        AntiAimState.realCFrame=humanoidRootPart.CFrame
        local modifiedCF=getAntiAimCFrame(AntiAimState.realCFrame)
        humanoidRootPart.CFrame=modifiedCF
    end

    ----------------------------------------------------------------
    -- MONITOR UPDATE
    ----------------------------------------------------------------
    monClock=monClock+dt
    if monClock>=0.15 then
        monClock=0

        -- Anti-Aim Monitor
        if CFG.AntiAim.On then
            aaMonStatus.Text="STATUS: ACTIVE";aaMonStatus.TextColor3=C.purple
            aaMonPitch.Text="PITCH: "..CFG.AntiAim.PitchMode.." ("..CFG.AntiAim.PitchAngle.."°)"
            aaMonPitch.TextColor3=CFG.AntiAim.PitchMode~="Off" and C.green or C.dim
            local ymS=CFG.AntiAim.YawMode;if ymS~="Off" then ymS=ymS.." ["..CFG.AntiAim.YawBase.."]" end
            aaMonYaw.Text="YAW: "..ymS;aaMonYaw.TextColor3=CFG.AntiAim.YawMode~="Off" and C.cyan or C.dim
        else
            aaMonStatus.Text="STATUS: IDLE";aaMonStatus.TextColor3=C.dim
            aaMonPitch.Text="PITCH: --";aaMonPitch.TextColor3=C.dim
            aaMonYaw.Text="YAW: --";aaMonYaw.TextColor3=C.dim
        end

        -- Orbit Monitor
        if CFG.Orbit.On then
            orbMonStatus.Text="STATUS: ORBITING";orbMonStatus.TextColor3=C.green
            local _,tr=getNearestEnemy()
            local tName=tr and tr.Parent and tr.Parent.Name or "None"
            orbMonTarget.Text="TARGET: "..tName;orbMonTarget.TextColor3=tr and C.accentL or C.dim
            orbMonAngle.Text=string.format("ANGLE: %.0f°",math.deg(OrbitState.angle)%360)
            orbMonCycles.Text="CYCLES: "..OrbitState.totalCycles
        else
            orbMonStatus.Text="STATUS: IDLE";orbMonStatus.TextColor3=C.dim
            orbMonTarget.Text="TARGET: --";orbMonTarget.TextColor3=C.dim
            orbMonAngle.Text="ANGLE: --";orbMonCycles.Text="CYCLES: 0"
        end
    end
end))


-- MAIN LOOP
-- ═══════════════════════════════════════════
rs.RenderStepped:Connect(function(dt)
    cam=ws.CurrentCamera
    local c=scr()

    abCirc.Position=c; abCirc.Radius=abEffFov()
    abCirc.Visible=AB.drawFov and AB.on
    saCirc.Position=c; saCirc.Radius=SA.fov
    saCirc.Visible=SA.drawFov and SA.on

    updateTracers()
    updateESP()

    -- ── AIMBOT ──
    if AB.on and mCam then
        -- Reaction delay
        if abDoReact then
            abReactT=abReactT-dt
            if abReactT<=0 then abDoReact=false end
        end

        if not abDoReact then
            -- Validate current target
            if abTgt and not abTgtValid(abTgt) then
                abTgt=nil; abLockT=0
                abPrevPos=nil; abCurveStart=nil; abCurveProgress=0
            end

            -- Find new target
            if not abTgt then
                abTgt=abFind()
                if abTgt then
                    abLockT=0; abDoReact=true; abReactT=AB.react/1000
                    abPrevPos=nil; abCurveStart=nil; abCurveProgress=0
                end
            end

            -- Apply aimbot
            if abTgt then
                abLockT=abLockT+dt
                if abLockT>AB.lockTime then
                    abTgt=nil; abLockT=0
                    abPrevPos=nil; abCurveStart=nil; abCurveProgress=0
                elseif inFov(abTgt,abEffFov()) then
                    pcall(function()
                        -- Get predicted position
                        local aimPos = getPredictedPos(abTgt, dt)

                        -- Convert to rotation angles
                        local cp  = cam.CFrame.Position
                        local du  = (aimPos - cp).Unit
                        local tp  = math.asin(math.clamp(du.Y,-1,1))
                        local ty  = math.atan2(-du.X,-du.Z)
                        local tRot = Vector2.new(tp, ty)
                        local cur  = mCam.Rotation

                        local newRot

                        if AB.lockMode == "Soft" then
                            newRot = applySoftLock(tRot, cur, dt)
                        elseif AB.lockMode == "Magnet" then
                            newRot = applyMagnetLock(tRot, cur, dt)
                        elseif AB.lockMode == "Curve" then
                            newRot = applyCurveLock(tRot, cur, dt)
                        else
                            newRot = applySoftLock(tRot, cur, dt)
                        end

                        -- Apply via game's own method
                        local delta = Vector2.new(
                            newRot.X - cur.X,
                            angDiff(cur.Y, newRot.Y)
                        )
                        mCam:ApplyRotationDelta(delta)
                    end)
                else
                    abTgt=nil; abLockT=0
                    abPrevPos=nil; abCurveStart=nil; abCurveProgress=0
                end
            end
        end
    end
end)


local antiSubConn=nil

local function startAntiSubspace()
    if antiSubConn then pcall(function() antiSubConn:Disconnect() end) end
    antiSubConn=workspace.ChildAdded:Connect(function(child)
        if not CFG.Ragebot.AntiSubspace then return end
        if child.Name~="SubspaceTripmineHitbox" then return end
        local myChar=LP.Character;if not myChar then return end
        local myHRP=myChar:FindFirstChild("HumanoidRootPart");if not myHRP then return end

        -- Check range
        task.wait(0.05)
        local hitbox=child:FindFirstChild("Hitbox")
        if not hitbox then return end

        local dist=(myHRP.Position-hitbox.Position).Magnitude
        if dist<=CFG.Ragebot.SubspaceRange then
            pcall(function()
                firetouchinterest(myHRP,hitbox,1)
                firetouchinterest(myHRP,hitbox,0)
            end)
        end
    end)
    table.insert(ActiveConnections,antiSubConn)
end

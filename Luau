table.insert(ActiveConnections, RunService.RenderStepped:Connect(function(dt)
    camera = workspace.CurrentCamera

    -- Crosshair position update
    if CFG.Crosshair.On then
        crosshairImg.Position = UDim2.new(0.5, 0, 0.5, 0)
    end

    -- Aimbot
    if CFG.Aimbot.On and CameraController then
        local tp = getAimbotTarget()
        if tp then
            pcall(function()
                local cp = camera.CFrame.Position
                local ap = tp.Position
                local du = (ap - cp).Unit
                local tP = math.asin(du.Y)
                local tY = math.atan2(-du.X, -du.Z)
                local ba = CFG.Aimbot.Smoothness / 100
                ba = math.clamp(ba, 0, 1)
                local cur = CameraController.Rotation
                CameraController:SetRotation(Vector2.new(
                    cur.X + (tP - cur.X) * ba,
                    cur.Y + angleDiff(cur.Y, tY) * ba
                ))
            end)
        end
    end

    -- Triggerbot
    if CFG.Trigger.On then
        local tgt = getTriggerTarget()
        if tgt then
            if not TriggerState.waiting then
                TriggerState.waiting = true
                TriggerState.delayTimer = CFG.Trigger.Delay / 1000
            end
            TriggerState.delayTimer = TriggerState.delayTimer - dt
            if TriggerState.delayTimer <= 0 then
                TriggerState.cooldownTimer = TriggerState.cooldownTimer - dt
                if TriggerState.cooldownTimer <= 0 then
                    simClick()
                    TriggerState.cooldownTimer = CFG.Trigger.BurstMs / 1000
                end
            end
        else
            TriggerState.waiting = false
            TriggerState.delayTimer = 0
            TriggerState.cooldownTimer = 0
        end
    else
        TriggerState.waiting = false
        TriggerState.delayTimer = 0
        TriggerState.cooldownTimer = 0
    end
end))


end

-- ═══════════════════════════════════════════
-- SIXTH SENSE — Tripmine ESP
-- ═══════════════════════════════════════════
local sixthEnabled  = false
local sixthLabels   = {}
local sixthCount    = 0
local sixthRender   = nil
local sixthAdd      = nil
local sixthRemove   = nil
local sixthQueue    = nil
local sixthPending  = {}
local sixthPendSet  = {}
local MAX_SIXTH     = 50
local SIXTH_DIST    = 300
local SIXTH_DISPLAY = "Subspace Tripmine"

local function isTripmine(part)
    if not part or not part:IsA("BasePart") then return false end
    local vm = Workspace:FindFirstChild("ViewModels")
    if vm and part:IsDescendantOf(vm) then return false end
    local n = part.Name:lower()
    if n:find("tripmine") then return true end
    local anc = part:FindFirstAncestorOfClass("Model")
    if anc and anc.Name:lower():find("tripmine") then return true end
    return false
end

local function makeTripmineLabel(part)
    if sixthLabels[part] or sixthCount >= MAX_SIXTH then return end
    local t = Drawing.new("Text")
    t.Text    = SIXTH_DISPLAY
    t.Size    = 16
    t.Color   = Color3.fromRGB(255, 120, 120)
    t.Center  = true
    t.Outline = true
    t.Visible = false
    sixthLabels[part] = t
    sixthCount = sixthCount + 1
end

local function removeTripmineLabel(part)
    local d = sixthLabels[part]
    if not d then return end
    if d.Remove then d:Remove() end
    sixthLabels[part] = nil
    sixthCount = sixthCount - 1
end

local function enableSixth()
    if sixthRender then return end

    -- Scan existing
    task.spawn(function()
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if sixthCount >= MAX_SIXTH then break end
            if obj:IsA("BasePart") and isTripmine(obj) and not sixthLabels[obj] then
                makeTripmineLabel(obj)
            end
        end
    end)

    sixthAdd = Workspace.DescendantAdded:Connect(function(d)
        if d:IsA("BasePart") and isTripmine(d) and not sixthLabels[d] then
            makeTripmineLabel(d)
        end
    end)
    sixthRemove = Workspace.DescendantRemoving:Connect(function(d)
        if d:IsA("BasePart") then removeTripmineLabel(d) end
    end)

    sixthRender = RunService.RenderStepped:Connect(function()
        local cam    = Workspace.CurrentCamera
        if not cam then return end
        local camPos = cam.CFrame.Position
        for part, draw in pairs(sixthLabels) do
            if not part or not part.Parent then removeTripmineLabel(part); continue end
            local p, on = cam:WorldToViewportPoint(part.Position)
            local dist  = (part.Position - camPos).Magnitude
            if not on or p.Z <= 0 or dist > SIXTH_DIST then
                draw.Visible = false
            else
                local ratio = math.clamp(50 / math.max(dist, 1), 0.125, 1)
                draw.Size     = math.floor(math.clamp(32 * ratio, 12, 32))
                draw.Position = Vector2.new(p.X, p.Y)
                draw.Visible  = true
            end
        end
    end)
end

local function disableSixth()
    if sixthRender  then sixthRender:Disconnect();  sixthRender  = nil end
    if sixthAdd     then sixthAdd:Disconnect();     sixthAdd     = nil end
    if sixthRemove  then sixthRemove:Disconnect();  sixthRemove  = nil end
    for p in pairs(sixthLabels) do removeTripmineLabel(p) end
    sixthLabels = {}; sixthCount = 0
end

-- ═══════════════════════════════════════════
-- STICK TO TARGET
-- ═══════════════════════════════════════════
local StickCFG = {
    Enabled        = false,
    Smoothing      = false,
    SmoothIntensity = 20,
    MaxDist        = 300,
    BehindDist     = 6,
    TeamCheck      = true,
}

local stickTarget     = nil
local stickConn       = nil
local STICK_SELECT_CD = 0.25
local lastStickSelect = 0
local spinRot         = 0

local function stickIsValid(pl)
    if not pl or pl == LP then return false end
    if StickCFG.TeamCheck and isSameTeam(pl) then return false end
    if not pl.Character then return false end
    local pp  = pl.Character.PrimaryPart or pl.Character:FindFirstChild("HumanoidRootPart")
    if not pp or not pp.Parent then return false end
    local hum = pl.Character:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    return true
end

local function findStickTarget()
    local cam = Workspace.CurrentCamera
    if not cam then return nil end
    local look   = cam.CFrame.LookVector
    local origin = cam.CFrame.Position
    local best, bd = nil, math.huge
    for _, pl in ipairs(Players:GetPlayers()) do
        if not stickIsValid(pl) then continue end
        local pp = pl.Character.PrimaryPart or pl.Character:FindFirstChild("HumanoidRootPart")
        local toT = pp.Position - origin
        local dot = look:Dot(toT.Unit)
        if dot > 0.65 then
            local dist = toT.Magnitude
            if dist < StickCFG.MaxDist and dist < bd then bd = dist; best = pl end
        end
    end
    return best
end

local function startStick()
    if stickConn then stickConn:Disconnect() end
    spinRot = 0
    stickConn = RunService.Heartbeat:Connect(function(dt)
        if not StickCFG.Enabled then return end
        if not LP.Character then return end
        local lpRoot = LP.Character.PrimaryPart or LP.Character:FindFirstChild("HumanoidRootPart")
        if not lpRoot then return end

        local now = tick()
        if not stickTarget and now - lastStickSelect >= STICK_SELECT_CD then
            stickTarget = findStickTarget()
            lastStickSelect = now
        end

        if stickTarget and not stickIsValid(stickTarget) then
            stickTarget = nil; spinRot = 0; return
        end
        if not stickTarget then return end

        local tp = stickTarget.Character.PrimaryPart or stickTarget.Character:FindFirstChild("HumanoidRootPart")
        if not tp then return end

        local targetPos = tp.Position + Vector3.new(0, 6.4, 0)
        local backPos   = targetPos - (tp.CFrame.LookVector.Unit * StickCFG.BehindDist)
        local dest      = CFrame.new(backPos, tp.Position)

        if StickCFG.Smoothing then
            local alpha = math.clamp(StickCFG.SmoothIntensity / 100, 0, 1)
            local lerp  = math.clamp(alpha * (dt * 8), 0, 1)
            LP.Character:SetPrimaryPartCFrame(lpRoot.CFrame:Lerp(dest, lerp))
        else
            LP.Character:SetPrimaryPartCFrame(dest)
        end
    end)
end

local function stopStick()
    StickCFG.Enabled = false
    if stickConn then stickConn:Disconnect(); stickConn = nil end
    stickTarget = nil
end

-- ═══════════════════════════════════════════
-- FPS OVERLAY
-- ═══════════════════════════════════════════
local fpsGui     = nil
local fpsLabel   = nil
local fpsDragConn = nil
local fpsRender  = nil
local fpsFrames  = 0
local fpsLast    = 0
local fpsCurrent = 0
local FPS_INTERVAL = 0.5

local function buildFpsOverlay()
    if fpsGui then return end
    fpsGui = Instance.new("ScreenGui")
    fpsGui.Name           = "RivalsFPS"
    fpsGui.ResetOnSpawn   = false
    fpsGui.IgnoreGuiInset = true
    fpsGui.Parent         = LP:WaitForChild("PlayerGui")

    local frame = Instance.new("Frame", fpsGui)
    frame.Size            = UDim2.fromOffset(120, 40)
    frame.Position        = UDim2.new(0.5, -60, 0, 10)
    frame.AnchorPoint     = Vector2.new(0.5, 0)
    frame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    frame.BorderSizePixel = 0
    frame.Active          = true
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)

    local stroke = Instance.new("UIStroke", frame)
    stroke.Color = Color3.fromRGB(0, 180, 255); stroke.Thickness = 1.5

    fpsLabel = Instance.new("TextLabel", frame)
    fpsLabel.Size                = UDim2.new(1, 0, 1, 0)
    fpsLabel.BackgroundTransparency = 1
    fpsLabel.TextColor3          = Color3.fromRGB(0, 200, 255)
    fpsLabel.Font                = Enum.Font.GothamBold
    fpsLabel.TextSize            = 18
    fpsLabel.Text                = "FPS: 0"

    -- Draggable
    local dragging, dragStart, startPos
    frame.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = UIS:GetMouseLocation()
            startPos  = frame.Position
        end
    end)
    frame.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    fpsDragConn = UIS.InputChanged:Connect(function(inp)
        if dragging and inp.UserInputType == Enum.UserInputType.MouseMovement then
            local now   = UIS:GetMouseLocation()
            local delta = now - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)

    fpsFrames = 0; fpsLast = tick()
    fpsRender = RunService.RenderStepped:Connect(function()
        fpsFrames = fpsFrames + 1
        local now = tick()
        local el  = now - fpsLast
        if el >= FPS_INTERVAL then
            fpsCurrent = fpsFrames / el
            if fpsLabel then fpsLabel.Text = "FPS: " .. math.floor(fpsCurrent) end
            fpsFrames = 0; fpsLast = now
        end
    end)
end

local function destroyFpsOverlay()
    if fpsRender   then fpsRender:Disconnect();   fpsRender   = nil end
    if fpsDragConn then fpsDragConn:Disconnect(); fpsDragConn = nil end
    if fpsGui      then fpsGui:Destroy();          fpsGui      = nil; fpsLabel = nil end
end

-- ═══════════════════════════════════════════
-- LIGHTING INTENSITY
-- ═══════════════════════════════════════════
local savedLighting = nil

local function saveLighting()
    if savedLighting then return end
    savedLighting = {
        Brightness     = Lighting.Brightness,
        Ambient        = Lighting.Ambient,
        OutdoorAmbient = Lighting.OutdoorAmbient,
    }
end

local function applyLightingIntensity(v)
    saveLighting()
    local m = math.clamp(v / 100, 0.01, 5)
    Lighting.Brightness     = savedLighting.Brightness * m
    Lighting.Ambient        = Color3.new(
        math.clamp(savedLighting.Ambient.R * m, 0, 1),
        math.clamp(savedLighting.Ambient.G * m, 0, 1),
        math.clamp(savedLighting.Ambient.B * m, 0, 1)
    )
    Lighting.OutdoorAmbient = Color3.new(
        math.clamp(savedLighting.OutdoorAmbient.R * m, 0, 1),
        math.clamp(savedLighting.OutdoorAmbient.G * m, 0, 1),
        math.clamp(savedLighting.OutdoorAmbient.B * m, 0, 1)
    )
end

local function restoreLighting()
    if not savedLighting then return end
    Lighting.Brightness     = savedLighting.Brightness
    Lighting.Ambient        = savedLighting.Ambient
    Lighting.OutdoorAmbient = savedLighting.OutdoorAmbient
    savedLighting = nil
end


local function rgFindTarget()
    local myH=lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    if not myH then return nil,nil,nil end
    local candidates={}
    for _, p in ipairs(plr:GetPlayers()) do
        if not rgValid(p) then continue end
        local chr=p.Character; local pt=bPart(chr, RG.part); if not pt then continue end
        local dist=(myH.Position-pt.Position).Magnitude; if dist>RG.dist then continue end
        if RG.vis then
            rgRp.FilterDescendantsInstances={lp.Character,chr}
            local dir=pt.Position-cam.CFrame.Position
            local h=ws:Raycast(cam.CFrame.Position,dir,rgRp)
            if h and not h.Instance:IsDescendantOf(chr) then continue end
        end
        local hm=chr:FindFirstChildOfClass("Humanoid"); local hp=hm and hm.Health or 0
        table.insert(candidates,{player=p,char=chr,part=pt,dist=dist,hp=hp})
    end
    if #candidates==0 then return nil,nil,nil end
    if RG.priority=="LowHP" then table.sort(candidates,function(a,b) return a.hp<b.hp end)
    elseif RG.priority=="HighHP" then table.sort(candidates,function(a,b) return a.hp>b.hp end)
    elseif RG.priority=="Closest" then table.sort(candidates,function(a,b) return a.dist<b.dist end)
    elseif RG.priority=="Random" then
        for i=#candidates,2,-1 do local j=math.random(i); candidates[i],candidates[j]=candidates[j],candidates[i] end
    end
    local best=candidates[1]; return best.player,best.char,best.part
end

local function rgStopOrbit()
    if rgOrbitC then rgOrbitC:Disconnect(); rgOrbitC=nil end
    rgEnemy=nil; rgOrbitA=0
end
local function rgStartOrbit(eChar)
    rgStopOrbit(); rgEnemy=eChar; rgOrbitA=0
    rgOrbitC=rs.Heartbeat:Connect(function(dt)
        if not rgEnemy or not rgEnemy.Parent then rgStopOrbit(); return end
        local myH=lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
        if not myH then rgStopOrbit(); return end
        rgOrbitA=rgOrbitA+dt*6
        local pos=myH.Position+Vector3.new(math.cos(rgOrbitA),0,math.sin(rgOrbitA))
        pcall(function() rgEnemy:SetPrimaryPartCFrame(CFrame.lookAt(pos,myH.Position)) end)
    end)
end
local function rgFire(oid, bp)
    if not mUtil or not mEnum or not rUseItem then return end
    local myH=lp.Character and lp.Character:FindFirstChild("HumanoidRootPart"); if not myH then return end
    local org=myH.Position+Vector3.new(0,1.5,0)
    local aimCF=CFrame.lookAt(org,bp.Position); local sd={}
    pcall(function()
        sd[utf8.char(1)]={
            [utf8.char(0)]=mUtil:EncodeCFrame(aimCF),
            [utf8.char(1)]=mUtil:EncodeCFrame(bp.CFrame),
            [utf8.char(2)]=bp,
            [utf8.char(3)]=mUtil:EncodeCFrame(bp.CFrame:ToObjectSpace(CFrame.new(bp.Position))),
        }
    end)
    pcall(function() rUseItem:FireServer(oid,mEnum:ToEnum("StartShooting"),sd,nil) end)
    task.delay(0.07,function()
        pcall(function() rUseItem:FireServer(oid,mEnum:ToEnum("StopShooting"),{},nil) end)
    end)
end
local function startRG()
    if rgConn then rgConn:Disconnect() end; rgRunning=false
    rgConn=rs.Heartbeat:Connect(function(dt)
        if not RG.on or not lp.Character then return end
        if not mUtil or not mEnum or not rUseItem then return end
        if rgRunning then return end
        local lf=nil; pcall(function() if mFig then lf=mFig.LocalFighter end end)
        if not lf then return end
        local item=lf.EquippedItem; if not item then return end
        local oid=nil; pcall(function() oid=item:Get("ObjectID") end); if not oid then return end
        rgCD=rgCD-dt
        local ammo=nil; pcall(function() ammo=item:Get("CurrentAmmo") end)
        if ammo~=nil and ammo<=0 and rgCD<=0 then
            rgStopOrbit()
            pcall(function() rUseItem:FireServer(oid,mEnum:ToEnum("Reload"),{},nil) end)
            rgCD=2.0; return
        end
        local _,bc,bp=rgFindTarget()
        if not bc or not bp then rgStopOrbit(); return end
        if RG.voidSpam then
            rgRunning=true; rgStartOrbit(bc)
            task.delay(RG.hideTime,function()
                if not RG.on then rgStopOrbit(); rgRunning=false; return end
                for i=1,RG.attempts do
                    task.delay((i-1)*RG.atkTime,function()
                        if RG.on and bp and bp.Parent then rgFire(oid,bp) end
                    end)
                end
                task.delay(RG.attempts*RG.atkTime+0.15,function()
                    rgStopOrbit(); rgRunning=false
                end)
            end)
        else rgFire(oid,bp) end
    end)
end


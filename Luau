local function isSameTeamRivals(p)
    local same = false
    xpcall(function()
        local myID    = LP:GetAttribute("TeamID")
        local theirID = p:GetAttribute("TeamID")
        if myID and theirID then
            same = string.byte(myID or "\0") == string.byte(theirID or "\0")
        end
    end, function(err) end)
    if not same then
        xpcall(function()
            same = p.Team ~= nil and LP.Team ~= nil and p.Team == LP.Team
        end, function(err) end)
    end
    return same
end

local function isVisible(from, target)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {LP.Character}
    local dir = target - from
    local res  = workspace:Raycast(from, dir, params)
    return res == nil or res.Instance:IsDescendantOf(target.Parent)
end


-- ESP (using FighterController.GetEntities)
-- ═══════════════════════════════════════════
local espBoxes = {}

local function updateESP()
    if not VIS.esp then
        for _, b in pairs(espBoxes) do
            pcall(function() b:Destroy() end)
        end
        espBoxes = {}
        return
    end

    local entities = {}
    if mFig then
        pcall(function() entities = mFig:GetEntities() end)
    end

    -- Also use Players as fallback
    for _, p in ipairs(plr:GetPlayers()) do
        if p==lp then continue end
        local chr = p.Character
        if not chr then continue end
        local hrp2 = chr:FindFirstChild("HumanoidRootPart")
        local hm2  = chr:FindFirstChildOfClass("Humanoid")
        if not hrp2 or not hm2 or hm2.Health<=0 then
            if espBoxes[p] then espBoxes[p]:Destroy(); espBoxes[p]=nil end
            continue
        end
        if not espBoxes[p] then
            local b = Instance.new("SelectionBox")
            b.Color3              = Color3.fromRGB(255,50,50)
            b.LineThickness       = 0.05
            b.SurfaceTransparency = 1
            b.Adornee             = chr
            b.Parent              = ws
            espBoxes[p] = b
        end
    end
    for p, b in pairs(espBoxes) do
        if not p.Character or not p.Character.Parent then
            b:Destroy(); espBoxes[p]=nil
        end
    end
end

-- ═══════════════════════════════════════════
-- BULLET TRACERS
-- ═══════════════════════════════════════════
local tracers = {}

local function spawnTracer(orig3D, tgt3D)
    if not VIS.tracers then return end
    local l = Drawing.new("Line")
    l.Thickness=VIS.tracerThick; l.Color=VIS.tracerColor
    l.Transparency=0; l.Visible=false
    table.insert(tracers, {line=l, born=tick(), orig=orig3D, tgt=tgt3D})
end

local function updateTracers()
    local now=tick(); local alive={}
    for _, t in ipairs(tracers) do
        local age  = now-t.born
        local life = math.max(VIS.tracerDur, 0.05)
        if age>=life then
            pcall(function() t.line:Remove() end)
        else
            local alpha = 1-(age/life)
            local from2 = Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y)
            local to2   = w2s(t.tgt)
            if to2 then
                t.line.From=from2; t.line.To=to2
                t.line.Transparency=1-alpha
                t.line.Visible=true
            else
                t.line.Visible=false
            end
            table.insert(alive, t)
        end
    end
    tracers = alive
end

-- Wrap fireShot to also spawn tracers
local _fireOrig = fireShot
fireShot = function(item, hitPart, fromPos)
    if VIS.tracers and hitPart and hitPart.Parent then
        spawnTracer(fromPos or cam.CFrame.Position, hitPart.Position)
    end
    _fireOrig(item, hitPart, fromPos)
end


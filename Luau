-- IMMUNITY DETECTION
-- ═══════════════════════════════════════════
local function isPlayerImmune(p)
    if not ImmunityCFG.Enabled then return false end
    local data = playerImmunity[p]
    if data and data.forceShield then return true end
    local char = p.Character
    if char then
        if char:FindFirstChildOfClass("ForceField") then return true end
        for _, obj in ipairs(char:GetDescendants()) do
            local n = obj.Name:lower()
            if n == "shield" or n:find("immune") or n:find("protect") then
                if obj:IsA("BasePart") or obj:IsA("SelectionBox") or obj:IsA("ParticleEmitter") then
                    return true
                end
            end
        end
    end
    if data then
        local elapsed = tick() - data.spawnTime
        if elapsed < ImmunityCFG.SpawnProtectionTime then return true end
    end
    return false
end

local function hookPlayerImmunity(p)
    if p == LP then return end
    local function onCharAdded(char)
        playerImmunity[p] = { spawnTime=tick(), forceShield=false, lastMaxHealth=0 }
        if char:FindFirstChildOfClass("ForceField") then
            playerImmunity[p].forceShield = true
        end
        char.ChildAdded:Connect(function(child)
            if child:IsA("ForceField") and playerImmunity[p] then
                playerImmunity[p].forceShield = true
            end
        end)
        char.ChildRemoved:Connect(function(child)
            if child:IsA("ForceField") and playerImmunity[p] then
                playerImmunity[p].forceShield = false
            end
        end)
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            playerImmunity[p].lastMaxHealth = hum.MaxHealth
            hum:GetPropertyChangedSignal("MaxHealth"):Connect(function()
                if not playerImmunity[p] then return end
                local prev = playerImmunity[p].lastMaxHealth
                local curr = hum.MaxHealth
                if curr > 10000 and prev > 0 and curr > prev * 5 then
                    playerImmunity[p].forceShield = true
                end
                playerImmunity[p].lastMaxHealth = curr
            end)
        end
    end
    if p.Character then
        task.spawn(function() task.wait(0.1); onCharAdded(p.Character) end)
    end
    p.CharacterAdded:Connect(function(char)
        task.wait(0.1); onCharAdded(char)
    end)
end

for _, p in ipairs(Players:GetPlayers()) do hookPlayerImmunity(p) end
Players.PlayerAdded:Connect(function(p) hookPlayerImmunity(p) end)
Players.PlayerRemoving:Connect(function(p) playerImmunity[p] = nil end)

-- ═══════════════════════════════════════════
-- SILENT AIM HOOK
-- ═══════════════════════════════════════════
local saHookTarget  = nil
local saHookConn    = nil
local saHookApplied = false
local saHookIdx     = nil

local function saHookByte(a) return string.byte(a or "\0") end
local function saGetEffectiveFOV()
    if SAHookCFG.IgnoreFOV then return math.huge end
    local f = SAHookCFG.FOVSize
    if SAHookCFG.DynamicFOV then f = f * (camera.FieldOfView / 70) end
    return f
end

local SA_PART_MAP = {
    ["Head"]       = {"Head"},
    ["Body"]       = {"UpperTorso", "LowerTorso", "HumanoidRootPart"},
    ["Head, Body"] = {"Head", "UpperTorso", "LowerTorso", "HumanoidRootPart"},
    ["Body, Head"] = {"UpperTorso", "LowerTorso", "Head"},
}

local function saGetTargetPart(char)
    local names = SA_PART_MAP[SAHookCFG.TargetParts] or {"Head"}
    if SAHookCFG.PreferRandom then
        local v = {}
        for _, n in ipairs(names) do
            local p = char:FindFirstChild(n)
            if p then table.insert(v, p) end
        end
        if #v > 0 then return v[math.random(1, #v)] end
        return nil
    end
    for _, n in ipairs(names) do
        local p = char:FindFirstChild(n)
        if p then return p end
    end
    return nil
end

local function saHookVisible(part, camPos)
    if not SAHookCFG.VisCheck then return true end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {
        LP.Character, part.Parent, workspace:FindFirstChild("Debris")
    }
    local dir    = part.Position - camPos
    local result = workspace:Raycast(camPos, dir.Unit * SAHookCFG.Distance, params)
    return result == nil or result.Instance:IsDescendantOf(part.Parent)
end

local function saHookValid(plr, camPos, center)
    local char = plr.Character; if not char then return false end
    local hum  = char:FindFirstChildOfClass("Humanoid")
    if not (hum and hum.Health > 0) then return false end
    local myEnv    = LP:GetAttribute("EnvironmentID")
    local theirEnv = plr:GetAttribute("EnvironmentID")
    if myEnv and theirEnv and saHookByte(myEnv) ~= saHookByte(theirEnv) then return false end
    if SAHookCFG.TeamCheck then
        local mt2 = LP:GetAttribute("TeamID")
        local tt  = plr:GetAttribute("TeamID")
        if mt2 and tt and saHookByte(mt2) == saHookByte(tt) then return false end
    end
    local head = char:FindFirstChild("Head"); if not head then return false end
    if (head.Position - camPos).Magnitude > SAHookCFG.Distance then return false end
    if not SAHookCFG.IgnoreFOV then
        local sp, on = workspace.CurrentCamera:WorldToViewportPoint(head.Position)
        if not on then return false end
        if (Vector2.new(sp.X, sp.Y) - center).Magnitude > saGetEffectiveFOV() then return false end
    end
    local tp = saGetTargetPart(char); if not tp then return false end
    if not saHookVisible(tp, camPos) then return false end
    return true
end

local function startSAHook()
    if not saHookApplied then
        local ok = pcall(function()
            saHookIdx = hookmetamethod(game, "__index", newcclosure(function(self, idx, ...)
                if not SAHookCFG.On then return saHookIdx(self, idx, ...) end
                if saHookTarget and not checkcaller()
                and idx == "ViewportSize" and self == workspace.CurrentCamera then
                    if math.random(1, 100) <= SAHookCFG.HitChance then
                        local pos, on = workspace.CurrentCamera:WorldToViewportPoint(saHookTarget)
                        if on then return Vector2.new(pos.X * 2, pos.Y * 2) end
                    end
                end
                return saHookIdx(self, idx, ...)
            end))
        end)
        if ok then saHookApplied = true end
    end
    if saHookConn then saHookConn:Disconnect() end
    saHookConn = RunService.Heartbeat:Connect(function()
        if not SAHookCFG.On then saHookTarget = nil; return end
        local cam    = workspace.CurrentCamera
        local camPos = cam.CFrame.Position
        local center = cam.ViewportSize / 2
        local best, bd = nil, math.huge
        for _, plr in Players:GetPlayers() do
            if plr == LP then continue end
            if saHookValid(plr, camPos, center) then
                local char = plr.Character; if not char then continue end
                local tp   = saGetTargetPart(char); if not tp then continue end
                local sp, on = cam:WorldToViewportPoint(tp.Position)
                if on then
                    local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                    if SAHookCFG.Targeting == "Closest" and d < bd then
                        bd = d; best = tp
                    elseif SAHookCFG.Targeting == "Furthest" and (d > bd or bd == math.huge) then
                        bd = d; best = tp
                    elseif SAHookCFG.Targeting == "Random" and (best == nil or math.random() < 0.5) then
                        best = tp
                    end
                end
            end
        end
        saHookTarget = best and best.Position or nil
    end)
end

local function stopSAHook()
    SAHookCFG.On = false; saHookTarget = nil
    if saHookConn then saHookConn:Disconnect(); saHookConn = nil end
end

-- ═══════════════════════════════════════════
-- ANTI-AIM
-- ═══════════════════════════════════════════
local aaConn  = nil
local aaSpinT = 0

local function startAntiAim()
    if aaConn then aaConn:Disconnect() end
    aaSpinT = 0
    aaConn = RunService.RenderStepped:Connect(function(dt)
        if not AntiAimCFG.On then
            aaConn:Disconnect(); aaConn = nil
            pcall(function()
                local char = LP.Character; if not char then return end
                local hrp  = char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
                local rj   = hrp:FindFirstChild("RootJoint")
                if rj and aaOrigC0 then rj.C0 = aaOrigC0 end
            end)
            aaOrigC0 = nil; return
        end
        aaSpinT = aaSpinT + dt
        local char = LP.Character; if not char then return end
        local hrp  = char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
        local rj   = hrp:FindFirstChild("RootJoint"); if not rj then return end
        if not aaOrigC0 then aaOrigC0 = rj.C0 end
        local yaw, pitch = 0, 0
        local typ = AntiAimCFG.Type
        if     typ == "Backwards"  then yaw   = math.rad(180)
        elseif typ == "Spin"       then yaw   = aaSpinT * 10
        elseif typ == "HideHead"   then pitch = math.rad(89)
        elseif typ == "BelowFloor" then pitch = math.rad(180)
        elseif typ == "Custom"     then
            yaw   = math.rad(AntiAimCFG.YawAngle)
            pitch = math.rad(AntiAimCFG.PitchAngle)
        end
        pcall(function() rj.C0 = aaOrigC0 * CFrame.Angles(pitch, yaw, 0) end)
    end)
end


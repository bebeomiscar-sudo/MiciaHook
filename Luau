local triggerConn     = nil
local triggerLastFire = 0

local triggerRayParams = RaycastParams.new()
triggerRayParams.FilterType  = Enum.RaycastFilterType.Exclude
triggerRayParams.IgnoreWater = true

local function triggerIsValid(plr)
    if not plr or plr == LP then return false, nil end
    local ch = plr.Character
    if not ch then return false, nil end
    local hum = ch:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false, nil end
    if TriggerCFG.TeamCheck and isSameTeam(plr) then return false, nil end
    local part = getBestPart(ch, TriggerCFG.TargetPart)
    if not part then return false, nil end
    if TriggerCFG.VisCheck and not isVisible(camera.CFrame.Position, part) then return false, nil end
    local dist = (camera.CFrame.Position - part.Position).Magnitude
    if dist > TriggerCFG.MaxDist then return false, nil end
    return true, part
end

local function triggerDoFire(item)
    if not item then return end
    local objectId = nil
    pcall(function() objectId = item:Get("ObjectID") end)
    pcall(function() if item.Shoot then item:Shoot() end end)
    if objectId and enums_mod then
        pcall(function()
            rs.Remotes.Replication.Fighter.UseItem:FireServer(
                objectId, enums_mod:ToEnum("StartShooting"), {}, nil
            )
        end)
        task.delay(0.06, function()
            pcall(function()
                rs.Remotes.Replication.Fighter.UseItem:FireServer(
                    objectId, enums_mod:ToEnum("StopShooting"), {}, nil
                )
            end)
        end)
    end
end

local function startTriggerbot()
    if triggerConn then triggerConn:Disconnect() end

    triggerConn = RunService.Heartbeat:Connect(function()
        if not TriggerCFG.On then return end
        local myChar = LP.Character
        if not myChar then return end
        local myHum = myChar:FindFirstChildOfClass("Humanoid")
        if not myHum or myHum.Health <= 0 then return end

        if TriggerCFG.Mode == "Scoped Only" then
            local aiming = false
            pcall(function()
                if fighter_mod and fighter_mod.LocalFighter then
                    aiming = fighter_mod.LocalFighter.IsAiming or false
                end
            end)
            if not aiming then return end
        end

        if TriggerCFG.Mode == "On Aimbot Target" and not lockedTarget then return end

        local item = nil
        pcall(function()
            if fighter_mod and fighter_mod.LocalFighter then
                item = fighter_mod.LocalFighter.EquippedItem
            end
        end)
        if not item then return end

        triggerRayParams.FilterDescendantsInstances = {myChar}
        local origin  = camera.CFrame.Position
        local forward = camera.CFrame.LookVector
        local result  = Workspace:Raycast(origin, forward * TriggerCFG.MaxDist, triggerRayParams)
        if not result then return end

        local hitModel = result.Instance:FindFirstAncestorOfClass("Model")
        if not hitModel then return end
        local hitPlayer = Players:GetPlayerFromCharacter(hitModel)
        if not hitPlayer then return end

        local valid, hitPart = triggerIsValid(hitPlayer)
        if not valid then return end

        local sp, onScreen = camera:WorldToViewportPoint(hitPart.Position)
        if not onScreen then return end
        if (Vector2.new(sp.X, sp.Y) - getScreenCenter()).Magnitude > TriggerCFG.TriggerFOV then return end

        local now = tick()
        if (now - triggerLastFire) * 1000 < TriggerCFG.Delay then return end
        triggerLastFire = now

        for i = 1, TriggerCFG.BurstCount do
            triggerDoFire(item)
            if TriggerCFG.BurstCount > 1 then task.wait(0.07) end
        end
    end)
end

local function stopTriggerbot()
    TriggerCFG.On = false
    if triggerConn then triggerConn:Disconnect(); triggerConn = nil end
end


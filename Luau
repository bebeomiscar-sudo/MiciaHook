    })
    Corner(indicator, 2)

    local tabFrame = Make("Frame", {BackgroundTransparency=1, Size=UDim2.new(1,0,1,0), Visible=false, ZIndex=12, Parent=ContentArea})

    local function makeCol(xScale, xOffset, wScale, wOffset)
        local col = Make("ScrollingFrame", {
            BackgroundTransparency=1, Position=UDim2.new(xScale,xOffset,0,6),
            Size=UDim2.new(wScale,wOffset,1,-12), CanvasSize=UDim2.new(0,0,0,0),

local function makeTextInput(parent, placeholder, order, callback)
    local frame = make("Frame",{
        Size = UDim2.new(1, 0, 0, s(40)),
        BackgroundColor3 = C.elem,
        BorderSizePixel = 0,
        LayoutOrder = order,
        Parent = parent,
    })
    make("UICorner",{CornerRadius=UDim.new(0,s(3)),Parent=frame})

    local tb = make("TextBox",{
        Size = UDim2.new(1, -s(20), 1, -s(8)),
        Position = UDim2.new(0, s(10), 0, s(4)),
        BackgroundTransparency = 1,
        Text = "",
        PlaceholderText = placeholder,
        PlaceholderColor3 = Color3.fromRGB(70, 70, 80),
        TextColor3 = C.text,
        Font = Enum.Font.Gotham,
        TextSize = FONT_MAIN,
        TextXAlignment = Enum.TextXAlignment.Left,
        ClearTextOnFocus = false,
        Parent = frame,
    })

    tb.FocusLost:Connect(function(enterPressed)
        if callback then callback(tb.Text) end
    end)

    -- Highlight on focus
    tb.Focused:Connect(function()
        tw(frame, 0.12, {BackgroundColor3 = C.hover})
    end)
    tb.FocusLost:Connect(function()
        tw(frame, 0.12, {BackgroundColor3 = C.elem})
    end)

    return {
        getText = function() return tb.Text end,
        setText = function(t) tb.Text = t end,
        getTextBox = function() return tb end,
    }
end


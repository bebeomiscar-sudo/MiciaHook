-- ═══════════════════════════════════════════
local silentHookApplied, silentOriginalRaycast = false, nil
local function silentGetTargets() local t={}; for _,v in ipairs(workspace:GetChildren()) do if v:FindFirstChildOfClass("Humanoid") then table.insert(t,v) end end; return t end
local function silentGetAimPos(ch) local h=ch:FindFirstChild("Head"); local root=ch:FindFirstChild("HumanoidRootPart"); if not h then return nil end; local vm=CFG.Silent.ImproveAccuracy and CFG.Silent.AccuracyFactor or 0; local pos=h.Position+(root and root.Velocity*vm or Vector3.zero); if CFG.Silent.RandomAimpoint then pos=pos+Vector3.new((math.random()-0.5)*0.7,(math.random()-0.5)*0.4,(math.random()-0.5)*0.7) end; return pos end
local function silentGetEffectiveFOV() if CFG.Silent.IgnoreFOV then return math.huge end; local f=CFG.Silent.FOV; if CFG.Silent.DynamicFOV then f=f*(camera.FieldOfView/70) end; return f end
local function silentFindTarget() local cam=workspace.CurrentCamera; local center=Vector2.new(cam.ViewportSize.X/2,cam.ViewportSize.Y/2); local lc=LP.Character; if not lc then return nil end; local fl=silentGetEffectiveFOV(); local bt,bd=nil,math.huge; for _,ch in ipairs(silentGetTargets()) do if ch==lc then continue end; local hum=ch:FindFirstChildOfClass("Humanoid"); if not hum or hum.Health<=0 then continue end; if CFG.Silent.AntiKatana then local lr=lc:FindFirstChild("HumanoidRootPart"); local root=ch:FindFirstChild("HumanoidRootPart"); if lr and root and (root.Position-lr.Position).Magnitude<15 then continue end end; local ap=silentGetAimPos(ch); if not ap then continue end; local sp,on=cam:WorldToViewportPoint(ap); if not on then continue end; local d=(center-Vector2.new(sp.X,sp.Y)).Magnitude; if d<fl and d<bd then bt=ch; bd=d end end; return bt end

local function applySilentHook()
    if silentHookApplied then return end
    if not UtilityModule or not UtilityModule.Raycast then return end
    pcall(function()
        silentOriginalRaycast = UtilityModule.Raycast
        UtilityModule.Raycast = function(...) local args={...}
            if args[4]==999 and CFG.Silent.On then
                if math.random(1,100)<=CFG.Silent.Hitchance then local t=silentFindTarget(); if t then local p=silentGetAimPos(t); if p then args[3]=p end end end
            end; return silentOriginalRaycast(unpack(args))
        end
    end)
    silentHookApplied = true
end
applySilentHook()


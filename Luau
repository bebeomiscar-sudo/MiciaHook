rs.RenderStepped:Connect(function(dt)
    cam = ws.CurrentCamera
    local c = scr()

    -- FOV circles
    abCirc.Position = c
    abCirc.Radius   = abEffFov()
    abCirc.Visible  = AB.drawFov and AB.on

    saCirc.Position = c
    saCirc.Radius   = SA.fov
    saCirc.Visible  = SA.drawFov and SA.on

    -- Tracers + ESP
    updateTracers()
    updateESP()

    -- SA target update
    if SA.on then saFind() end

    -- LEGITBOT — uses CameraController.ApplyRotationDelta
    if AB.on and mCam then
        if abDoReact then
            abReactT=abReactT-dt
            if abReactT<=0 then abDoReact=false end
        end
        if not abDoReact then
            if abTgt and not abTgtValid(abTgt) then
                abTgt=nil; abLockT=0
            end
            if not abTgt then
                abTgt=abFind()
                if abTgt then
                    abLockT=0; abDoReact=true; abReactT=AB.react/1000
                end
            end
            if abTgt then
                abLockT=abLockT+dt
                if abLockT>AB.lockTime then
                    abTgt=nil; abLockT=0
                elseif inFov(abTgt,abEffFov()) then
                    pcall(function()
                        local cp  = cam.CFrame.Position
                        local du  = (abTgt.Position-cp).Unit
                        local tp  = math.asin(math.clamp(du.Y,-1,1))
                        local ty  = math.atan2(-du.X,-du.Z)
                        local cur = mCam.Rotation
                        local sm  = 1/math.max(AB.speed,0.1)
                        local dp  = (tp-cur.X)*sm
                        local dy  = angDiff(cur.Y,ty)*sm
                        -- Use game's own method — more compatible
                        mCam:ApplyRotationDelta(Vector2.new(dp,dy))
                    end)
                else
                    abTgt=nil; abLockT=0
                end
            end
        end
    end
end)


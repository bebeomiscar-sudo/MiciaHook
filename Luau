        tws:Create(lbl,TweenInfo.new(0.6),{TextTransparency=1}):Play()
        task.wait(0.6); lbl:Destroy()
    end)
end

local function hookHum(h)
    local last=h.Health
    h.HealthChanged:Connect(function(hp)
        local dmg=last-hp
        if dmg>0.1 then showHit(dmg) end
        last=hp
    end)
end

for _, p in ipairs(plr:GetPlayers()) do

-- ═══════════════════════════════════════════
-- AIMBOT STATE
-- ═══════════════════════════════════════════
local abTgt     = nil   -- locked target part
local abLockT   = 0     -- time locked onto target
local abReactT  = 0     -- reaction delay timer
local abDoReact = false -- waiting for reaction delay
local abPrevPos = nil   -- previous target position (for prediction)
local abPrevTick = 0    -- tick of previous position sample
local abCurveProgress = 0  -- curve lock progress (0→1)
local abCurveStart = nil   -- where curve started (camera rotation)
local abCurveEnd   = nil   -- where curve ends (target rotation)

local abCirc = Drawing.new("Circle")
abCirc.NumSides=64; abCirc.Filled=false
abCirc.Color=Color3.fromRGB(255,255,255)
abCirc.Thickness=1.5; abCirc.Transparency=0.7; abCirc.Visible=false

local function abEffFov()
    local f=AB.fov
    if AB.dynFov then f=f*(cam.FieldOfView/70) end
    return f
end

local function abTgtValid(pt)
    if not pt or not pt.Parent then return false end
    local h=pt.Parent:FindFirstChildOfClass("Humanoid")
    if not h or h.Health<=0 then return false end
    if not inFov(pt,abEffFov()) then return false end
    if AB.vis and not isVis(cam.CFrame.Position,pt) then return false end
    if AB.team then
        local p=plr:GetPlayerFromCharacter(pt.Parent)
        if p and sameTm(p) then return false end
    end
    return true
end

local function abFind()
    local c=scr(); local fv=abEffFov()
    local best,bd=nil,fv
    for _,p in ipairs(plr:GetPlayers()) do
        if p==lp then continue end
        if AB.team and sameTm(p) then continue end
        local chr=p.Character
        if not chr then continue end
        local hm=chr:FindFirstChildOfClass("Humanoid")
        if not hm or hm.Health<=0 then continue end
        local pt=bPart(chr,AB.part)
        if not pt then continue end
        local sp,on=cam:WorldToViewportPoint(pt.Position)
        if not on then continue end
        local d=(Vector2.new(sp.X,sp.Y)-c).Magnitude
        if d<bd then
            if AB.vis and not isVis(cam.CFrame.Position,pt) then continue end
            bd=d; best=pt
        end
    end
    return best
end

--[[
    PREDICTION:
    We sample the target's position each frame.
    velocity = (currentPos - prevPos) / deltaTime
    predictedPos = currentPos + velocity * prediction
    Higher prediction = leads the target more
]]
local function getPredictedPos(pt, dt)
    local now  = tick()
    local pos  = pt.Position

    if abPrevPos and (now - abPrevTick) > 0 then
        local elapsed  = now - abPrevTick
        local velocity = (pos - abPrevPos) / elapsed
        -- Scale by prediction factor
        pos = pos + velocity * AB.prediction
    end

    abPrevPos  = pt.Position  -- store REAL position, not predicted
    abPrevTick = now

    return pos
end

--[[
    LOCK MODES:

    SOFT LOCK:
    - Gentle lerp toward target
    - Easy to override with mouse movement
    - Smoothness controls speed
    - Best for: subtle assistance

    MAGNET LOCK:
    - Strong snap toward target
    - Harder to override
    - Low smoothness = very fast snap
    - Best for: strong pull

    CURVE LOCK:
    - Camera follows a smooth curved arc to target
    - Most natural looking movement
    - curvePct controls how strongly it curves
    - Best for: legit play, recorded footage
]]
local function applySoftLock(targetRot, currentRot, dt)
    -- Simple lerp — smoothness controls speed
    -- smoothness 0.02 = very fast, 5 = very slow
    local speed = 1 / math.max(AB.smoothness, 0.02)
    local factor = math.clamp(speed * dt, 0, 1)
    return Vector2.new(
        currentRot.X + (targetRot.X - currentRot.X) * factor,
        currentRot.Y + angDiff(currentRot.Y, targetRot.Y) * factor
    )
end

local function applyMagnetLock(targetRot, currentRot, dt)
    -- Stronger pull — reduced by distance for a "snap then slow" feel
    local distPitch = math.abs(targetRot.X - currentRot.X)
    local distYaw   = math.abs(angDiff(currentRot.Y, targetRot.Y))
    local dist      = math.sqrt(distPitch^2 + distYaw^2)

    -- Fast when far, slightly slower when close (still snappy)
    local speed  = math.max(1 / math.max(AB.smoothness * 0.3, 0.02), 1)
    local factor = math.clamp(speed * dt * (1 + dist * 2), 0, 1)

    return Vector2.new(
        currentRot.X + (targetRot.X - currentRot.X) * factor,
        currentRot.Y + angDiff(currentRot.Y, targetRot.Y) * factor
    )
end

local function applyCurveLock(targetRot, currentRot, dt)
    --[[
        Curve Lock explanation:
        - We track a "curve progress" from 0 to 1
        - Progress advances at a rate based on curvePct
        - We use a smooth ease-in-out curve (smoothstep)
        - This makes the aim start slow, speed up, then slow down at target
        - Looks very natural and human-like

        curvePct 0.01% = barely moves (almost no curve)
        curvePct 40%   = strong aggressive curve
    ]]

    -- Reset curve if target changed significantly
    local distPitch = math.abs(targetRot.X - currentRot.X)
    local distYaw   = math.abs(angDiff(currentRot.Y, targetRot.Y))
    local dist      = math.sqrt(distPitch^2 + distYaw^2)

    if abCurveStart == nil or dist > 0.5 then
        -- Start fresh curve from current position
        abCurveStart    = currentRot
        abCurveProgress = 0
    end

    -- Update the end point every frame (target moves)
    abCurveEnd = targetRot

    -- Advance progress based on curvePct
    -- curvePct/100 gives 0.01 to 0.40 as a fraction
    local speed = (AB.curvePct / 100) * 3  -- multiply for reasonable speed
    abCurveProgress = math.clamp(abCurveProgress + speed * dt, 0, 1)

    -- Smoothstep: s(t) = 3t² - 2t³
    -- Makes motion start/end smoothly — very legit looking
    local t = abCurveProgress
    local curved = t * t * (3 - 2 * t)

    -- Interpolate along the curve
    local newPitch = abCurveStart.X + (abCurveEnd.X - abCurveStart.X) * curved
    local newYaw   = abCurveStart.Y + angDiff(abCurveStart.Y, abCurveEnd.Y) * curved

    -- Reset when we arrive
    if abCurveProgress >= 1 then
        abCurveStart    = nil
        abCurveProgress = 0
    end

    return Vector2.new(newPitch, newYaw)
end


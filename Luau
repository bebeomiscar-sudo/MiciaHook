local function triggerExplosion(position, size, pitchVariance)
    if not ExplosionEffectFn then return end
    pcall(function()
        ExplosionEffectFn(
            position or Vector3.new(0,0,0),
            size or ExplosionCFG.Size,
            pitchVariance or (0.9 + ExplosionCFG.SpeedVariance * math.random())
        )
    end)
end

local function hookPlayerForExplosion(player)
    if player == LP then return end
    local function watchChar(char)
        local hum = char:WaitForChild("Humanoid", 5); if not hum then return end
        local conn = hum.Died:Connect(function()
            if not ExplosionCFG.Enabled or not ExplosionCFG.OnDeath then return end
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then triggerExplosion(root.Position, ExplosionCFG.Size) end
        end)
        table.insert(explosionDeathConns, conn)
    end
    if player.Character then task.spawn(watchChar, player.Character) end
    local conn = player.CharacterAdded:Connect(function(char) task.spawn(watchChar, char) end)
    table.insert(explosionDeathConns, conn)
end

for _, p in ipairs(Players:GetPlayers()) do hookPlayerForExplosion(p) end
Players.PlayerAdded:Connect(hookPlayerForExplosion)

local function startLoopExplosions()
    if loopExplosionTask then return end
    loopExplosionTask = task.spawn(function()
        while ExplosionCFG.Enabled and ExplosionCFG.LoopExp do
            pcall(function()
                local char = LP.Character; if not char then return end
                local root = char:FindFirstChild("HumanoidRootPart"); if not root then return end
                triggerExplosion(
                    root.Position + Vector3.new(math.random(-5,5),math.random(0,3),math.random(-5,5)),
                    ExplosionCFG.Size * 0.5
                )
            end)
            task.wait(ExplosionCFG.LoopInterval)
        end
        loopExplosionTask = nil
    end)
end

local function stopLoopExplosions()
    if loopExplosionTask then task.cancel(loopExplosionTask); loopExplosionTask = nil end
end


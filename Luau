        Make("Frame", {BackgroundColor3=T.Accent, Size=UDim2.new(1,0,0,4), Position=UDim2.new(0,0,1,-4), ZIndex=14, Parent=accentBar})

        Make("TextLabel", {
            BackgroundTransparency=1, Position=UDim2.new(0,10,0,5), Size=UDim2.new(1,-10,0,16),
            Font=T.Font, Text=gbName, TextColor3=T.TextAcc, TextSize=11,
            TextXAlignment=Enum.TextXAlignment.Left, ZIndex=16, Parent=box,
        })

        local cont = Make("Frame", {BackgroundTransparency=1, Position=UDim2.new(0,0,0,24), Size=UDim2.new(1,0,0,0), ZIndex=14, Parent=box})

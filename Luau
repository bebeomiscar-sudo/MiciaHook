-- RIVALS SILENT AIM (Remote Manipulation)
-- ═══════════════════════════════════════════
local rs_sa      = cloneref(game:GetService("ReplicatedStorage"))
local players_sa = cloneref(game:GetService("Players"))
local ws_sa      = cloneref(game:GetService("Workspace"))

local silentActive       = false
local silentVisibleCheck = false
local silentTeamCheck    = false
local silentFOV          = 999
local silentConn         = nil

local gun_mod, util_mod, enums_mod, fighter_mod
pcall(function()
    gun_mod     = require(LP.PlayerScripts.Modules.ItemTypes.Gun)
    util_mod    = require(rs_sa.Modules.Utility)
    enums_mod   = require(rs_sa.Modules.EnumLibrary)
    fighter_mod = require(LP.PlayerScripts.Controllers.FighterController)
end)

local ray_params_sa = RaycastParams.new()

local sa_offsets = {
    Vector3.new(0, 12, 0), Vector3.new(0, 16, 0), Vector3.new(0, 20, 0),
    Vector3.new(0, 24, 0), Vector3.new(0, 28, 0), Vector3.new(0, 32, 0),
    Vector3.new(0, 36, 0), Vector3.new(0, 40, 0),
}

local function sa_getClosest()
    if not LP.Character or not LP.Character:FindFirstChild("HumanoidRootPart") then
        return nil, nil
    end
    local target, tchar, dist = nil, nil, silentFOV
    for _, v in next, players_sa:GetPlayers() do
        if v == LP then continue end
        if silentTeamCheck then
            local sameTeam = false
            pcall(function()
                sameTeam = v.Team ~= nil and LP.Team ~= nil and v.Team == LP.Team
            end)
            if not sameTeam then
                pcall(function()
                    local tag = v.Character and v.Character:FindFirstChild("TeamTag")
                    local myTag = LP.Character and LP.Character:FindFirstChild("TeamTag")
                    if tag and myTag then
                        sameTeam = tag.Value == myTag.Value
                    end
                end)
            end
            if sameTeam then continue end
        end
        if not v.Character or not v.Character:FindFirstChild("Head") then continue end
        local hum = v.Character:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end
        local mag = (LP.Character.HumanoidRootPart.Position - v.Character.Head.Position).Magnitude
        if mag < dist then
            dist = mag
            target = v.Character.Head
            tchar = v.Character
        end
    end
    return target, tchar
end

local function sa_calcPoint(origin, target_pos, target_char)
    ray_params_sa.FilterDescendantsInstances = { LP.Character, target_char }
    ray_params_sa.FilterType = Enum.RaycastFilterType.Exclude

    if not silentVisibleCheck then
        return origin, nil
    end

    -- Check direct line of sight
    if not ws_sa:Raycast(origin, target_pos - origin, ray_params_sa) then
        return origin, nil
    end

    -- Try vertical offsets to find clear shot
    for _, offset in next, sa_offsets do
        local scan_pos = origin + offset
        if not ws_sa:Raycast(scan_pos, target_pos - scan_pos, ray_params_sa) then
            return scan_pos, offset.Y
        end
    end

    -- No clear shot found
    return nil, nil
end

local function startSilentAim()
    if silentConn then silentConn:Disconnect() end
    silentConn = RunService.Heartbeat:Connect(function()
        if not silentActive then return end
        if not LP.Character then return end
        local root = LP.Character:FindFirstChild("HumanoidRootPart")
        if not root then return end
        if not fighter_mod or not fighter_mod.LocalFighter then return end
        local item = fighter_mod.LocalFighter.EquippedItem
        if not item then return end

        local target_part, target_char = sa_getClosest()
        if not target_part or not target_char then return end

        local cam = ws_sa.CurrentCamera.CFrame
        local manip, height = sa_calcPoint(cam.Position, target_part.Position, target_char)
        if not manip then return end

        local shoot_pos = (height == nil and manip) or cam.Position

        local cameradata = {}
        cameradata[utf8.char(1)] = {
            [utf8.char(0)] = util_mod:EncodeCFrame(
                CFrame.new(shoot_pos.X, shoot_pos.Y + (height or 0), shoot_pos.Z)
                * CFrame.Angles(CFrame.lookAt(shoot_pos, target_part.Position):ToOrientation())
            ),
            [utf8.char(1)] = height and
                util_mod:EncodeCFrame(
                    CFrame.new(target_part.Position)
                    * CFrame.Angles(CFrame.lookAt(shoot_pos, target_part.Position):ToOrientation())
                )
                or util_mod:EncodeCFrame(
                    CFrame.new(shoot_pos.X, shoot_pos.Y + (height or 0), shoot_pos.Z)
                    * CFrame.Angles(CFrame.lookAt(shoot_pos, target_part.Position):ToOrientation())
                ),
            [utf8.char(2)] = target_part,
            [utf8.char(3)] = util_mod:EncodeCFrame(
                target_part.CFrame:ToObjectSpace(CFrame.new(target_part.Position))
            ),
        }

        pcall(function()
            rs_sa.Remotes.Replication.Fighter.UseItem:FireServer(
                item:Get("ObjectID"), enums_mod:ToEnum("StartShooting"), cameradata, nil
            )
        end)
    end)
end

local function stopSilentAim()
    if silentConn then silentConn:Disconnect(); silentConn = nil end
end


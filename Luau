TracerGui.IgnoreGuiInset=true; TracerGui.ZIndexBehavior=Enum.ZIndexBehavior.Sibling
TracerGui.Parent=LP.PlayerGui
local activeTracers = {}
local tracerHue     = 0

local function getTracerOrigin()
    local vp = camera.ViewportSize
    local o  = S.Misc.BulletTracer.Origin
    if o == "Top"    then return Vector2.new(vp.X/2, 0)       end
    if o == "Middle" then return Vector2.new(vp.X/2, vp.Y/2)  end
    return Vector2.new(vp.X/2, vp.Y)
end

local function fireTracer()
    if not S.Misc.BulletTracer.Enabled then return end
    local char = LP.Character; if not char then return end
    local rp   = RaycastParams.new()
    rp.FilterDescendantsInstances = {char}
    rp.FilterType = Enum.RaycastFilterType.Exclude
    local res    = workspace:Raycast(camera.CFrame.Position, camera.CFrame.LookVector*2000, rp)
    local hitPos = res and res.Position or (camera.CFrame.Position + camera.CFrame.LookVector*1000)
    local hsp, hon = camera:WorldToViewportPoint(hitPos)
    if not hon or hsp.Z < 0 then return end
    local sFrom  = getTracerOrigin()
    local sTo    = Vector2.new(hsp.X, hsp.Y)
    local delta  = sTo - sFrom
    local length = delta.Magnitude
    if length < 2 then return end
    local col = S.Misc.BulletTracer.Rainbow and Color3.fromHSV(tracerHue,1,1) or S.Misc.BulletTracer.Color
    if S.Misc.BulletTracer.Rainbow then tracerHue = (tracerHue + 0.05) % 1 end
    local line = Instance.new("Frame")
    line.BackgroundColor3 = col; line.BorderSizePixel = 0
    line.AnchorPoint = Vector2.new(0,0.5); line.ZIndex = 20
    line.Size = UDim2.new(0,length,0,S.Misc.BulletTracer.Thickness)
    line.Position = UDim2.new(0,sFrom.X,0,sFrom.Y)
    line.Rotation = math.deg(math.atan2(delta.Y,delta.X))
    line.Parent = TracerGui
    table.insert(activeTracers, {Line=line, Born=tick(), HitPos=hitPos})
end

UIS.InputBegan:Connect(function(i, g)
    if g then return end
    if i.UserInputType == Enum.UserInputType.MouseButton1 then fireTracer() end
end)


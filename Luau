-- ══════════════════════════════════════════════════
-- TARGET VALIDATION
-- ══════════════════════════════════════════════════
local function isValidTarget(p)
    if p == LP then return false end
    local chr = p.Character
    if not chr then return false end
    local hm = chr:FindFirstChildOfClass("Humanoid")
    if not hm or hm.Health <= 0 then return false end
    return true
end

local function abTargetValid(pt)
    if not pt or not pt.Parent then return false end
    if not isValidTarget(sPlayers:GetPlayerFromCharacter(pt.Parent)) then return false end
    if not onScreen(pt, effFov(), false) then return false end
    if AB.vis and not canSee(Cam.CFrame.Position, pt) then return false end
    if AB.team then
        local p = sPlayers:GetPlayerFromCharacter(pt.Parent)
        if p and sameTeam(p) then return false end
    end
    return true
end

-- ══════════════════════════════════════════════════
-- TARGET FINDER
-- ══════════════════════════════════════════════════
local function abFindTarget()
    local center = viewportCenter()
    local fov    = effFov()
    local best   = nil
    local bd     = fov

    for _, p in ipairs(sPlayers:GetPlayers()) do
        if not isValidTarget(p) then continue end
        if AB.team and sameTeam(p) then continue end
        local chr = p.Character
        local pt  = getPart(chr, AB.part)
        if not pt then continue end
        local sp, on = Cam:WorldToViewportPoint(pt.Position)
        if not on then continue end
        local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
        if d < fov and d < bd then
            if AB.vis and not canSee(Cam.CFrame.Position, pt) then continue end
            bd = d; best = pt
        end
    end
    return best
end

-- ══════════════════════════════════════════════════
-- PREDICTION  (velocity-based leading)
-- ══════════════════════════════════════════════════
local function predictPos(pt)
    local now = tick()
    local pos = pt.Position
    if abPrevPos and (now - abPrevTick) > 0 then
        local dt  = now - abPrevTick
        local vel = (pos - abPrevPos) / dt
        pos = pos + vel * AB.prediction
    end
    abPrevPos  = pt.Position
    abPrevTick = now
    return pos
end

-- ══════════════════════════════════════════════════
-- LOCK MODES
-- ══════════════════════════════════════════════════
local function softLock(tRot, cur, dt)
    local spd = 1 / math.max(AB.smoothness, 0.02)
    local f   = math.clamp(spd * dt, 0, 1)
    return Vector2.new(
        cur.X + (tRot.X - cur.X) * f,
        cur.Y + yawDiff(cur.Y, tRot.Y) * f
    )
end

local function magnetLock(tRot, cur, dt)
    local dp  = math.abs(tRot.X - cur.X)
    local dy  = math.abs(yawDiff(cur.Y, tRot.Y))
    local d   = math.sqrt(dp^2 + dy^2)
    local spd = math.max(1 / math.max(AB.smoothness * 0.3, 0.02), 1)
    local f   = math.clamp(spd * dt * (1 + d*2), 0, 1)
    return Vector2.new(
        cur.X + (tRot.X - cur.X) * f,
        cur.Y + yawDiff(cur.Y, tRot.Y) * f
    )
end

local function curveLock(tRot, cur, dt)
    local dp = math.abs(tRot.X - cur.X)
    local dy = math.abs(yawDiff(cur.Y, tRot.Y))
    if abCurveStart == nil or math.sqrt(dp^2+dy^2) > 0.5 then
        abCurveStart    = cur
        abCurveProgress = 0
    end
    abCurveEnd = tRot
    local spd = (AB.curvePct / 100) * 3
    abCurveProgress = math.clamp(abCurveProgress + spd * dt, 0, 1)
    local t = abCurveProgress
    local s = t * t * (3 - 2*t)  -- smoothstep
    local nP = abCurveStart.X + (abCurveEnd.X - abCurveStart.X) * s
    local nY = abCurveStart.Y + yawDiff(abCurveStart.Y, abCurveEnd.Y) * s
    if abCurveProgress >= 1 then
        abCurveStart    = nil
        abCurveProgress = 0
    end
    return Vector2.new(nP, nY)
end

-- ══════════════════════════════════════════════════
-- AI LEGIT SYSTEM
-- Simulates human mouse behaviour to avoid pattern detection
-- ══════════════════════════════════════════════════
local function applyAILegit(newRot, cur, dt)
    if not AI.on then return newRot end

    -- Random break (release lock briefly)
    if aiInBreak then
        aiBreakTimer = aiBreakTimer - dt
        if aiBreakTimer <= 0 then aiInBreak = false end
        return cur  -- hold camera still during break
    end

    if math.random() < AI.breakChance * dt * 60 then
        aiInBreak    = true
        aiBreakTimer = AI.breakDur
        return cur
    end

    -- Micro jitter (small random offset, simulates hand tremor)
    local jx = (math.random() - 0.5) * 2 * AI.jitter
    local jy = (math.random() - 0.5) * 2 * AI.jitter
    aiJitterOffset = Vector2.new(
        aiJitterOffset.X * 0.8 + jx * 0.2,
        aiJitterOffset.Y * 0.8 + jy * 0.2
    )

    -- Vary smoothness ±20%
    local smoothMult = AI.varySmooth and (0.8 + math.random() * 0.4) or 1

    local result = Vector2.new(
        newRot.X * smoothMult + aiJitterOffset.X,
        newRot.Y * smoothMult + aiJitterOffset.Y
    )

    -- Occasional overshoot: slightly pass the target then correct
    if math.random() < AI.overshoot * 0.02 then
        local ovX = (math.random() - 0.5) * 0.05
        local ovY = (math.random() - 0.5) * 0.05
        result = Vector2.new(result.X + ovX, result.Y + ovY)
    end

    return result
end

-- ══════════════════════════════════════════════════
-- SILENT AIM
-- Hooks Utility.Raycast (correct method — not ws:Raycast)
-- ══════════════════════════════════════════════════
local saApplied = false
local saTgt     = nil

local function saFindTarget(origin)
    if not SA.on then return nil end
    local center = Cam.ViewportSize / 2
    local best   = nil
    local bd     = math.huge

    for _, p in ipairs(sPlayers:GetPlayers()) do
        if not isValidTarget(p) then continue end
        if SA.team and sameTeam(p) then continue end
        local chr = p.Character
        -- Environment check (Rivals specific)
        local me = LP:GetAttribute("EnvironmentID")
        local th = p:GetAttribute("EnvironmentID")
        if me ~= nil and th ~= nil and me ~= th then continue end
        local pt = getPart(chr, SA.part)
        if not pt then continue end
        if (origin - pt.Position).Magnitude > SA.maxDist then continue end
        local sp, on = Cam:WorldToViewportPoint(pt.Position)
        if not on then continue end
        local d = (Vector2.new(sp.X,sp.Y) - center).Magnitude
        if d > SA.fov then continue end
        if SA.vis and not canSee(origin, pt) then continue end
        if SA.mode == "Closest"  and d < bd  then bd=d; best=pt
        elseif SA.mode == "Furthest" and d > bd then bd=d; best=pt
        elseif SA.mode == "Random" and (not best or math.random()<0.3) then best=pt
        end
    end
    saTgt = best
    return best
end

local function hookSA()
    if saApplied then return end
    if not mUtil  then Lib:Notify("SA: Utility not loaded yet",3); return end

    -- Direct table replacement — NOT hookfunction
    -- This avoids the CameraSecurity hookfunction check
    local orig = mUtil.Raycast
    mUtil.Raycast = function(self, origin, direction, distance, ...)
        if SA.on then
            local tgt = saFindTarget(origin)
            if tgt then
                return orig(self, origin, tgt.Position, distance, ...)
            end
        end
        return orig(self, origin, direction, distance, ...)
    end

    saApplied = true
    Lib:Notify("SA hooked (Utility.Raycast)", 3)
end

-- ══════════════════════════════════════════════════
-- FIRE SHOT HELPER
-- ══════════════════════════════════════════════════
local function fireShot(item, hitPart, origin)
    if not item or not hitPart then return end
    if not mUtil or not mEnum or not rUseItem then return end
    local oid = nil
    pcall(function() oid = item:Get("ObjectID") end)
    if not oid then return end
    local org   = origin or Cam.CFrame.Position
    local aimCF = CFrame.lookAt(org, hitPart.Position)
    local sd    = {}
    pcall(function()
        sd[utf8.char(1)] = {
            [utf8.char(0)] = mUtil:EncodeCFrame(aimCF),
            [utf8.char(1)] = mUtil:EncodeCFrame(hitPart.CFrame),
            [utf8.char(2)] = hitPart,
            [utf8.char(3)] = mUtil:EncodeCFrame(
                hitPart.CFrame:ToObjectSpace(CFrame.new(hitPart.Position))
            ),
        }
    end)
    pcall(function() rUseItem:FireServer(oid, mEnum:ToEnum("StartShooting"), sd, nil) end)
    task.delay(0.07, function()
        pcall(function() rUseItem:FireServer(oid, mEnum:ToEnum("StopShooting"), {}, nil) end)
    end)
end

-- ══════════════════════════════════════════════════
-- TRIGGERBOT
-- ══════════════════════════════════════════════════
local tbConn     = nil
local tbLastSeen = 0
local tbLastFire = 0

local function tbGetDelay()
    if TB.rand then
        return math.random(math.min(TB.minD,TB.maxD), math.max(TB.minD,TB.maxD))
    end
    return TB.delay
end

local function startTriggerbot()
    if tbConn then tbConn:Disconnect() end
    tbLastSeen = 0; tbLastFire = 0
    tbConn = sRun.Heartbeat:Connect(function()
        if not TB.on or not LP.Character then return end
        local lf = nil
        pcall(function() if mFig then lf = mFig.LocalFighter end end)
        if not lf then return end
        local item = lf.EquippedItem
        if not item then return end
        local ammo = nil
        pcall(function() ammo = item:Get("CurrentAmmo") end)
        if ammo ~= nil and ammo <= 0 then return end

        local now    = tick()
        local center = viewportCenter()
        local found  = false
        local fp     = nil

        for _, p in ipairs(sPlayers:GetPlayers()) do
            if not isValidTarget(p) then continue end
            if TB.team and sameTeam(p) then continue end
            local chr = p.Character
            for _, n in ipairs({"Head","UpperTorso","LowerTorso","HumanoidRootPart"}) do
                local pt = chr:FindFirstChild(n)
                if not pt then continue end
                if (Cam.CFrame.Position - pt.Position).Magnitude > TB.dist then continue end
                if TB.vis and not canSee(Cam.CFrame.Position, pt) then continue end
                local sp, on = Cam:WorldToViewportPoint(pt.Position)
                if not on or sp.Z <= 0 then continue end
                if (Vector2.new(sp.X,sp.Y) - center).Magnitude <= TB.fov then
                    found = true; fp = pt; tbLastSeen = now; break
                end
            end
            if found then break end
        end

        local grace = (now - tbLastSeen)*1000 <= TB.grace
        if not found and not grace then return end
        if (now - tbLastFire)*1000 < tbGetDelay() then return end
        tbLastFire = now
        if fp then fireShot(item, fp) end
    end)
end

-- ══════════════════════════════════════════════════
-- RAGEBOT — with Priority Targeting + FFA mode
-- ══════════════════════════════════════════════════
local rgConn    = nil
local rgCD      = 0
local rgRunning = false
local rgOrbitC  = nil
local rgEnemy   = nil
local rgOrbitA  = 0

local rgRp = RaycastParams.new()
rgRp.FilterType = Enum.RaycastFilterType.Exclude

local function rgIsValid(p)
    if p == LP then return false end
    -- FFA mode: ignore team check entirely
    if not RG.ffaMode and RG.team and sameTeam(p) then return false end
    return isValidTarget(p)
end

--[[
    Priority system:
    LowHP   — target with least health (easiest to finish)
    Closest — nearest to our HRP (default)
    HighHP  — target with most health (biggest threat)
    Random  — random valid target
]]
local function rgFindTarget()
    local myHRP = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not myHRP then return nil, nil, nil end

    local candidates = {}

    for _, p in ipairs(sPlayers:GetPlayers()) do
        if not rgIsValid(p) then continue end
        local chr = p.Character
        local pt  = getPart(chr, RG.part)
        if not pt then continue end
        local dist = (myHRP.Position - pt.Position).Magnitude
        if dist > RG.dist then continue end
        if RG.vis then
            rgRp.FilterDescendantsInstances = {LP.Character, chr}
            local dir = pt.Position - Cam.CFrame.Position
            local h   = sWorkspace:Raycast(Cam.CFrame.Position, dir, rgRp)
            if h and not h.Instance:IsDescendantOf(chr) then continue end
        end
        local hm  = chr:FindFirstChildOfClass("Humanoid")
        local hp  = hm and hm.Health or 0
        table.insert(candidates, {
            player = p,
            char   = chr,
            part   = pt,
            dist   = dist,
            hp     = hp,
        })
    end

    if #candidates == 0 then return nil, nil, nil end

    local chosen = nil

    if RG.priority == "LowHP" then
        table.sort(candidates, function(a, b) return a.hp < b.hp end)
        chosen = candidates[1]
    elseif RG.priority == "HighHP" then
        table.sort(candidates, function(a, b) return a.hp > b.hp end)
        chosen = candidates[1]
    elseif RG.priority == "Closest" then
        table.sort(candidates, function(a, b) return a.dist < b.dist end)
        chosen = candidates[1]
    elseif RG.priority == "Random" then
        chosen = candidates[math.random(1, #candidates)]
    else
        chosen = candidates[1]
    end

    return chosen.player, chosen.char, chosen.part
end

local function rgStopOrbit()
    if rgOrbitC then rgOrbitC:Disconnect(); rgOrbitC = nil end
    rgEnemy = nil; rgOrbitA = 0
end

local function rgStartOrbit(eChar)
    rgStopOrbit()
    rgEnemy  = eChar
    rgOrbitA = 0
    rgOrbitC = sRun.Heartbeat:Connect(function(dt)
        if not rgEnemy or not rgEnemy.Parent then rgStopOrbit(); return end
        local myH = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        if not myH then rgStopOrbit(); return end
        rgOrbitA = rgOrbitA + dt * 6
        local pos = myH.Position + Vector3.new(math.cos(rgOrbitA), 0, math.sin(rgOrbitA))
        pcall(function() rgEnemy:SetPrimaryPartCFrame(CFrame.lookAt(pos, myH.Position)) end)
    end)
end

local function rgFire(oid, bp)
    if not mUtil or not mEnum or not rUseItem then return end
    local myH = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not myH then return end
    local org   = myH.Position + Vector3.new(0, 1.5, 0)
    local aimCF = CFrame.lookAt(org, bp.Position)
    local sd    = {}
    pcall(function()
        sd[utf8.char(1)] = {
            [utf8.char(0)] = mUtil:EncodeCFrame(aimCF),
            [utf8.char(1)] = mUtil:EncodeCFrame(bp.CFrame),
            [utf8.char(2)] = bp,
            [utf8.char(3)] = mUtil:EncodeCFrame(
                bp.CFrame:ToObjectSpace(CFrame.new(bp.Position))
            ),
        }
    end)
    pcall(function() rUseItem:FireServer(oid, mEnum:ToEnum("StartShooting"), sd, nil) end)
    task.delay(0.07, function()
        pcall(function() rUseItem:FireServer(oid, mEnum:ToEnum("StopShooting"), {}, nil) end)
    end)
end

local function startRagebot()
    if rgConn then rgConn:Disconnect() end
    rgRunning = false
    rgConn = sRun.Heartbeat:Connect(function(dt)
        if not RG.on or not LP.Character then return end
        if not mUtil or not mEnum or not rUseItem then return end
        if rgRunning then return end
        local lf = nil
        pcall(function() if mFig then lf = mFig.LocalFighter end end)
        if not lf then return end
        local item = lf.EquippedItem
        if not item then return end
        local oid = nil
        pcall(function() oid = item:Get("ObjectID") end)
        if not oid then return end
        rgCD = rgCD - dt
        local ammo = nil
        pcall(function() ammo = item:Get("CurrentAmmo") end)
        if ammo ~= nil and ammo <= 0 and rgCD <= 0 then
            rgStopOrbit()
            pcall(function() rUseItem:FireServer(oid, mEnum:ToEnum("Reload"), {}, nil) end)
            rgCD = 2.0; return
        end
        local _, bc, bp = rgFindTarget()
        if not bc or not bp then rgStopOrbit(); return end
        if RG.voidSpam then
            rgRunning = true
            rgStartOrbit(bc)
            task.delay(RG.hideTime, function()
                if not RG.on then rgStopOrbit(); rgRunning = false; return end
                for i = 1, RG.attempts do
                    task.delay((i-1)*RG.atkTime, function()
                        if RG.on and bp and bp.Parent then rgFire(oid, bp) end
                    end)
                end
                task.delay(RG.attempts*RG.atkTime + 0.15, function()
                    rgStopOrbit(); rgRunning = false
                end)
            end)
        else
            rgFire(oid, bp)
        end
    end)
end


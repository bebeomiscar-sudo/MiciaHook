local function saHookByte(a) return string.byte(a or "\0") end
local function saGetEffectiveFOV()
    if SAHookCFG.IgnoreFOV then return math.huge end
    local f=SAHookCFG.FOVSize; if SAHookCFG.DynamicFOV then f=f*(camera.FieldOfView/70) end; return f
end
local SA_PART_MAP={["Head"]={"Head"},["Body"]={"UpperTorso","LowerTorso","HumanoidRootPart"},["Head, Body"]={"Head","UpperTorso","LowerTorso","HumanoidRootPart"},["Body, Head"]={"UpperTorso","LowerTorso","Head"}}
local function saGetTargetPart(char)

local vmRoot = LP.PlayerScripts:FindFirstChild("Assets") and LP.PlayerScripts.Assets:FindFirstChild("ViewModels")

local function resolveVMPath(pathStr)
    if not vmRoot then return nil end
    local parts = string.split(pathStr, ".")
    local cur = vmRoot
    for _,p in ipairs(parts) do
        cur = cur:FindFirstChild(p)
        if not cur then return nil end
    end
    return cur
end

local function findSkinInVMs(skinName)
    if not vmRoot then return nil end
    for _,v in ipairs(vmRoot:GetDescendants()) do
        if v.Name == skinName then return v end
    end
    return nil
end

local function SC_ApplySkin(weaponPath, skinPath, animTable)
    -- Remove old connection
    if SC.Connection then SC.Connection:Disconnect(); SC.Connection=nil end
    for _,t in pairs(SC.LoadedTracks) do pcall(function() t:Destroy() end) end
    SC.LoadedTracks={}

    if not weaponPath or not skinPath then return end

    -- Clone skin into weapon viewmodel
    weaponPath:ClearAllChildren()
    for _,child in ipairs(skinPath:GetChildren()) do
        child:Clone().Parent = weaponPath
    end

    SC.WeaponPath = weaponPath
    SC.SkinPath   = skinPath
    SC.AnimTable  = animTable or {}
    SC.Active     = #animTable > 0 or true

    -- If we have animation overrides, hook the animator
    if next(animTable) then
        -- Wait for a viewmodel belonging to our player in workspace
        task.spawn(function()
            local FirstPerson = workspace:FindFirstChild("ViewModels") and workspace.ViewModels:FindFirstChild("FirstPerson")
            if not FirstPerson then return end

            local vm = nil
            for _ = 1, 100 do
                for _,v in ipairs(FirstPerson:GetChildren()) do
                    if v.Name:match("^"..LP.Name.."%s%-") then vm=v; break end
                end
                if vm then break end
                task.wait(0.1)
            end
            if not vm then return end

            local ac = vm:FindFirstChild("AnimationController")
            if not ac then return end
            local anim = ac:FindFirstChild("Animator")
            if not anim then return end

            SC.Connection = anim.AnimationPlayed:Connect(function(track)
                local currentId = track.Animation.AnimationId
                local newId = animTable[currentId]
                if not newId then return end

                track:Stop(); track:Destroy()

                if SC.LoadedTracks[newId] then
                    if SC.LoadedTracks[newId].IsPlaying then return end
                    pcall(function() SC.LoadedTracks[newId]:Stop(); SC.LoadedTracks[newId]:Destroy() end)
                    SC.LoadedTracks[newId]=nil
                end

                local newAnim = Instance.new("Animation")
                newAnim.AnimationId = newId
                local newTrack = anim:LoadAnimation(newAnim)
                SC.LoadedTracks[newId] = newTrack
                newTrack:Play()
                newTrack.Stopped:Connect(function()
                    if SC.LoadedTracks[newId] == newTrack then SC.LoadedTracks[newId]=nil end
                end)
            end)
        end)
    end

    Library:Notify('Skin applied: '..skinPath.Name, 3)
end

local function SC_Reset(weaponPath)
    if SC.Connection then SC.Connection:Disconnect(); SC.Connection=nil end
    for _,t in pairs(SC.LoadedTracks) do pcall(function() t:Destroy() end) end
    SC.LoadedTracks={}; SC.Active=false
    Library:Notify('Skin reset', 2)
end


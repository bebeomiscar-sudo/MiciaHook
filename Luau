-- SKIN CHANGER
-- Remap: allows equipping skins on locked weapons
-- ══════════════════════════════════════════════════
local skinEquipped    = {}   -- weapon → cosmetic type → data
local skinFavorites   = {}   -- weapon → name → bool
local skinConstructW  = nil  -- current constructing weapon
local skinViewProfile = nil  -- viewed player
local skinHooked      = false
local skinEnabled     = false
local skinLastWeapon  = nil

-- Remap table: locked weapon → skin name to use
-- Players can map e.g. "AssaultRifle" → "GoldenAssaultRifle"
local skinRemap = {}

local SKIN_SAVE = "unlockall/config.json"

local function cloneCosmetic(name, cosType, options)
    if not mCosm then return nil end
    local base = mCosm.Cosmetics[name]
    if not base then return nil end
    local data = {}
    for k, v in pairs(base) do data[k] = v end
    data.Name = name
    data.Type = data.Type or cosType
    data.Seed = data.Seed or math.random(1, 1000000)
    if mEnumL then
        local ok, eid = pcall(mEnumL.ToEnum, mEnumL, name)
        if ok and eid then data.Enum = eid; data.ObjectID = data.ObjectID or eid end
    end
    if options then
        if options.inverted      ~= nil then data.Inverted         = options.inverted      end
        if options.favoritesOnly ~= nil then data.OnlyUseFavorites = options.favoritesOnly end
    end
    return data
end

local function skinSave()
    if not writefile then return end
    pcall(function()
        local cfg = {equipped={}, favorites=skinFavorites, remap=skinRemap}
        for w, cs in pairs(skinEquipped) do
            cfg.equipped[w] = {}
            for ct, cd in pairs(cs) do
                if cd and cd.Name then
                    cfg.equipped[w][ct] = {name=cd.Name, seed=cd.Seed, inverted=cd.Inverted}
                end
            end
        end
        makefolder("unlockall")
        writefile(SKIN_SAVE, sHttp:JSONEncode(cfg))
    end)
end

local function skinLoad()
    if not readfile or not isfile or not isfile(SKIN_SAVE) then return end
    pcall(function()
        local cfg = sHttp:JSONDecode(readfile(SKIN_SAVE))
        if cfg.equipped then
            for w, cs in pairs(cfg.equipped) do
                skinEquipped[w] = {}
                for ct, cd in pairs(cs) do
                    local cl = cloneCosmetic(cd.name, ct, {inverted=cd.inverted})
                    if cl then cl.Seed = cd.seed; skinEquipped[w][ct] = cl end
                end
            end
        end
        skinFavorites = cfg.favorites or {}
        skinRemap     = cfg.remap     or {}
    end)
end

local function cosmeticAllowed(name, cosmetic)
    if not cosmetic then return false end
    local t = cosmetic.Type or ""
    if t == "Finisher" or name:lower():find("finisher") then return false end
    return t=="Skin" or t=="Charm" or t=="Dance" or t=="Emote"
        or t=="Wrap" or t=="Wrapping"
        or name:lower():find("charm") or name:lower():find("dance")
        or name:lower():find("emote") or name:lower():find("wrap")
end

local function enableSkinChanger()
    if not mCosm or not mData then
        Lib:Notify("Enter a match first, then enable skins", 4)
        return
    end

    -- Ownership patches (all types, no Finishers)
    local function ownsFn(self, inv, name, weapon)
        if name:find("MISSING_") then return false end
        local c = mCosm.Cosmetics[name]
        if c and cosmeticAllowed(name, c) then return true end
        return false
    end
    mCosm.OwnsCosmetic            = ownsFn
    mCosm.OwnsCosmeticNormally    = ownsFn
    mCosm.OwnsCosmeticUniversally = ownsFn
    mCosm.OwnsCosmeticForWeapon   = ownsFn

    local origGet = mData.Get
    mData.Get = function(self, key)
        local data = origGet(self, key)
        if key == "CosmeticInventory" then
            local proxy = {}
            if data then
                for k, v in pairs(data) do
                    local c = mCosm.Cosmetics[k]
                    if c and cosmeticAllowed(k, c) then proxy[k] = v end
                end
            end
            return setmetatable(proxy, {__index=function(t,k)
                local c = mCosm.Cosmetics[k]
                if c and cosmeticAllowed(k,c) then return true end
                return nil
            end})
        end
        if key == "FavoritedCosmetics" then
            local result = data and table.clone(data) or {}
            for w, favs in pairs(skinFavorites) do
                result[w] = result[w] or {}
                for name, isFav in pairs(favs) do
                    local c = mCosm.Cosmetics[name]
                    if c and cosmeticAllowed(name,c) then result[w][name] = isFav end
                end
            end
            return result
        end
        return data
    end

    local origGWD = mData.GetWeaponData
    mData.GetWeaponData = function(self, weaponName)
        local data = origGWD(self, weaponName)
        if not data then return nil end
        local merged = {}
        for k, v in pairs(data) do merged[k] = v end
        merged.Name = weaponName

        -- Remap: if this weapon has a remap, apply that skin
        local remapWeapon = skinRemap[weaponName]
        if remapWeapon and skinEquipped[remapWeapon] then
            for ct, cd in pairs(skinEquipped[remapWeapon]) do
                merged[ct] = cd
            end
        elseif skinEquipped[weaponName] then
            for ct, cd in pairs(skinEquipped[weaponName]) do
                merged[ct] = cd
            end
        end
        return merged
    end

    -- Remote hooks (newcclosure = AC safe)
    if not skinHooked and hookmetamethod then
        local rems    = sRep:FindFirstChild("Remotes")
        local dataR   = rems and rems:FindFirstChild("Data")
        local equipR  = dataR and dataR:FindFirstChild("EquipCosmetic")
        local favR    = dataR and dataR:FindFirstChild("FavoriteCosmetic")
        local repR    = rems  and rems:FindFirstChild("Replication")
        local figR    = repR  and repR:FindFirstChild("Fighter")
        local useIR   = figR  and figR:FindFirstChild("UseItem")

        if equipR then
            local oldNC
            oldNC = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
                local m = getnamecallmethod()
                if m ~= "FireServer" then return oldNC(self, ...) end
                local args = {...}

                -- Track last weapon
                if useIR and self == useIR then
                    pcall(function()
                        if mFig then
                            local fighter = mFig:GetFighter(LP)
                            if fighter and fighter.Items then
                                for _, itm in pairs(fighter.Items) do
                                    if itm:Get("ObjectID") == args[1] then
                                        skinLastWeapon = itm.Name; break
                                    end
                                end
                            end
                        end
                    end)
                end

                if self == equipR then
                    local wn   = args[1]
                    local ct   = args[2]
                    local cn   = args[3]
                    local opts = args[4] or {}

                    if ct == "Finisher" then return oldNC(self, ...) end

                    -- Player owns it normally → let through
                    if cn and cn ~= "None" and cn ~= "" then
                        local inv = mData:Get("CosmeticInventory")
                        if inv and rawget(inv, cn) then return oldNC(self, ...) end
                    end

                    -- Dances/Emotes
                    if ct == "Dance" or ct == "Emote" then
                        skinEquipped.Dances = skinEquipped.Dances or {}
                        if not cn or cn == "None" or cn == "" then
                            skinEquipped.Dances[ct] = nil
                        else
                            local cl = cloneCosmetic(cn, ct, {
                                inverted=opts.IsInverted, favoritesOnly=opts.OnlyUseFavorites
                            })
                            if cl then skinEquipped.Dances[ct] = cl end
                        end
                        task.defer(function()
                            pcall(function() mData.CurrentData:Replicate("CosmeticInventory") end)
                            task.wait(0.2); skinSave()
                        end)
                        return
                    end

                    -- Skin/Charm/Wrap
                    -- Check remap: if this weapon is a remap target
                    local targetWeapon = wn
                    for remapFrom, remapTo in pairs(skinRemap) do
                        if remapTo == wn then targetWeapon = remapFrom; break end
                    end

                    skinEquipped[targetWeapon] = skinEquipped[targetWeapon] or {}
                    if not cn or cn == "None" or cn == "" then
                        skinEquipped[targetWeapon][ct] = nil
                        if not next(skinEquipped[targetWeapon]) then
                            skinEquipped[targetWeapon] = nil
                        end
                    else
                        local cl = cloneCosmetic(cn, ct, {
                            inverted=opts.IsInverted, favoritesOnly=opts.OnlyUseFavorites
                        })
                        if cl then skinEquipped[targetWeapon][ct] = cl end
                    end
                    task.defer(function()
                        pcall(function() mData.CurrentData:Replicate("WeaponInventory") end)
                        task.wait(0.2); skinSave()
                    end)
                    return
                end

                if self == favR then
                    local c = mCosm.Cosmetics[args[2]]
                    if c and cosmeticAllowed(args[2], c) then
                        skinFavorites[args[1]]        = skinFavorites[args[1]] or {}
                        skinFavorites[args[1]][args[2]] = args[3] or nil
                        skinSave()
                        task.spawn(function()
                            pcall(function() mData.CurrentData:Replicate("FavoritedCosmetics") end)
                        end)
                        return
                    end
                end

                return oldNC(self, ...)
            end))
            skinHooked = true
        end
    end

    -- ClientItem / ViewModel patches
    local CI = nil
    pcall(function()
        CI = require(PSc.Modules.ClientReplicatedClasses.ClientFighter.ClientItem)
    end)

    if CI and CI._CreateViewModel then
        local origCVM = CI._CreateViewModel
        CI._CreateViewModel = function(self, vmRef)
            local wn = self.Name
            local wp = self.ClientFighter and self.ClientFighter.Player
            skinConstructW = (wp == LP) and wn or nil
            -- Apply remap
            local sourceWeapon = skinRemap[wn] and wn or wn
            if wp == LP and skinEquipped[sourceWeapon] and vmRef then
                for _, ct in ipairs({"Skin","Charm","Wrap"}) do
                    if skinEquipped[sourceWeapon][ct] then
                        local ok1,dk = pcall(function() return self:ToEnum("Data") end)
                        local ok2,ck = pcall(function() return self:ToEnum(ct) end)
                        local ok3,nk = pcall(function() return self:ToEnum("Name") end)
                        if ok1 and ok2 and ok3 and vmRef[dk] then
                            vmRef[dk][ck] = skinEquipped[sourceWeapon][ct]
                            vmRef[dk][nk] = skinEquipped[sourceWeapon][ct].Name
                        elseif vmRef.Data then
                            vmRef.Data[ct]   = skinEquipped[sourceWeapon][ct]
                            vmRef.Data.Name  = skinEquipped[sourceWeapon][ct].Name
                        end
                    end
                end
            end
            local r = origCVM(self, vmRef)
            skinConstructW = nil
            return r
        end
    end

    local vmMod = PSc.Modules.ClientReplicatedClasses.ClientFighter.ClientItem
        :FindFirstChild("ClientViewModel")
    if vmMod then
        local CVM     = require(vmMod)
        local origNew = CVM.new
        CVM.new = function(repData, ci)
            local wp = ci.ClientFighter and ci.ClientFighter.Player
            local wn = skinConstructW or ci.Name
            local sourceW = skinRemap[wn] and wn or wn
            if wp == LP and skinEquipped[sourceW] then
                local ok, RC = pcall(function() return require(sRep.Modules.ReplicatedClass) end)
                if ok and RC then
                    local dk = RC:ToEnum("Data")
                    repData[dk] = repData[dk] or {}
                    for _, ct in ipairs({"Skin","Charm","Wrap"}) do
                        if skinEquipped[sourceW][ct] then
                            local ok2, ce = pcall(function() return RC:ToEnum(ct) end)
                            if ok2 then repData[dk][ce] = skinEquipped[sourceW][ct] end
                        end
                    end
                end
            end
            local r = origNew(repData, ci)
            if wp == LP and skinEquipped[sourceW] and skinEquipped[sourceW].Wrap
                and r and r._UpdateWrap then
                r:_UpdateWrap()
                task.delay(0.1, function()
                    if not r._destroyed then r:_UpdateWrap() end
                end)
            end
            return r
        end

        if CVM.GetCharm then
            local oc = CVM.GetCharm
            CVM.GetCharm = function(self)
                local wn = self.ClientItem and self.ClientItem.Name
                local wp = self.ClientItem and self.ClientItem.ClientFighter
                    and self.ClientItem.ClientFighter.Player
                local sw = skinRemap[wn] and wn or wn
                if wn and wp==LP and skinEquipped[sw] and skinEquipped[sw].Charm then
                    return skinEquipped[sw].Charm
                end
                return oc(self)
            end
        end

        if CVM.GetWrap then
            local ow = CVM.GetWrap
            CVM.GetWrap = function(self)
                local wn = self.ClientItem and self.ClientItem.Name
                local wp = self.ClientItem and self.ClientItem.ClientFighter
                    and self.ClientItem.ClientFighter.Player
                local sw = skinRemap[wn] and wn or wn
                if wn and wp==LP and skinEquipped[sw] and skinEquipped[sw].Wrap then
                    return skinEquipped[sw].Wrap
                end
                return ow(self)
            end
        end
    end

    if mItem and mItem.GetViewModelImageFromWeaponData then
        local origImg = mItem.GetViewModelImageFromWeaponData
        mItem.GetViewModelImageFromWeaponData = function(self, weaponData, highRes)
            if not weaponData then return origImg(self, weaponData, highRes) end
            local wn = weaponData.Name
            local sw = skinRemap[wn] and wn or wn
            if skinEquipped[sw] and skinEquipped[sw].Skin then
                local si = self.ViewModels and self.ViewModels[skinEquipped[sw].Skin.Name]
                if si then
                    return si[highRes and "ImageHighResolution" or "Image"] or si.Image
                end
            end
            return origImg(self, weaponData, highRes)
        end
    end

    -- Emote controller
    pcall(function()
        if not Ctl then return end
        local EC = require(Ctl:WaitForChild("EmoteController",5))
        if EC and EC.GetEmotes then
            local origGE = EC.GetEmotes
            EC.GetEmotes = function(self)
                local emotes = origGE(self)
                for name, cosmetic in pairs(mCosm.Cosmetics) do
                    if cosmeticAllowed(name, cosmetic)
                        and (cosmetic.Type=="Dance" or cosmetic.Type=="Emote") then
                        if not emotes[name] then
                            emotes[name] = {
                                Name=name, Type=cosmetic.Type,
                                ObjectID=cosmetic.ObjectID, Enum=cosmetic.Enum,
                            }
                        end
                    end
                end
                return emotes
            end
        end
    end)

    pcall(function()
        local VP = require(PSc.Modules.Pages.ViewProfile)
        if VP and VP.Fetch then
            local origF = VP.Fetch
            VP.Fetch = function(self, tp)
                skinViewProfile = tp; return origF(self, tp)
            end
        end
    end)

    skinLoad()
    skinEnabled = true
    Lib:Notify("Skin Changer ON — open cosmetic menu to equip", 4)
end


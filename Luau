local orbitAngle,monClock=0,0
table.insert(ActiveConnections,RunService.Heartbeat:Connect(function(dt)
    if CFG.Orbit.On and not Desync.active and CFG.OrbitTarget then local mc=LP.Character;if mc then local mr=mc:FindFirstChild("HumanoidRootPart");local tc=CFG.OrbitTarget.Character;if mr and tc then local tr=tc:FindFirstChild("HumanoidRootPart");local mh=mc:FindFirstChildOfClass("Humanoid");if tr and mh and mh.Health>0 then orbitAngle=orbitAngle+(CFG.Orbit.Speed*dt);if orbitAngle>math.pi*2 then orbitAngle=orbitAngle-math.pi*2 end;local tp=tr.Position;mr.CFrame=CFrame.new(tp+Vector3.new(math.cos(orbitAngle)*CFG.Orbit.Radius,CFG.Orbit.Height,math.sin(orbitAngle)*CFG.Orbit.Radius),tp) end end end end

    if not Desync.active then return end;if not humanoidRootPart or not humanoidRootPart.Parent then Desync.active=false;return end
    local hum=character:FindFirstChildOfClass("Humanoid");if not hum or hum.Health<=0 then if Desync.realCFrame then humanoidRootPart.CFrame=Desync.realCFrame end;Desync.active=false;Desync.phase="idle";Desync.currentDepth=0;return end
    Desync.realCFrame=humanoidRootPart.CFrame;Desync.phaseTimer=Desync.phaseTimer+dt
    if Desync.phase=="hide" then Desync.currentDepth=math.min(Desync.currentDepth+CFG.Void.StepSpeed,CFG.Void.VoidDepth);if Desync.phaseTimer>=CFG.Void.HideTime then Desync.phase="attack";Desync.phaseTimer=0;Desync.shotsFired=0;Desync.shotCooldown=0 end
    elseif Desync.phase=="attack" then Desync.currentDepth=math.max(Desync.currentDepth-CFG.Void.StepSpeed*3,0);if Desync.phase=="attack" and Desync.currentDepth<=2 and CFG.Void.AutoFire then Desync.shotCooldown=Desync.shotCooldown-dt;if Desync.shotsFired<CFG.Void.ShootAttempt and Desync.shotCooldown<=0 then simClick();Desync.shotsFired=Desync.shotsFired+1;Desync.shotCooldown=0.05 end end;if Desync.phaseTimer>=CFG.Void.AttackTime then Desync.phase="hide";Desync.phaseTimer=0;Desync.totalCycles=Desync.totalCycles+1 end end
    if Desync.currentDepth>0 then local rp=Desync.realCFrame.Position;local rot=Desync.realCFrame-rp;humanoidRootPart.CFrame=CFrame.new(Vector3.new(rp.X,rp.Y-Desync.currentDepth,rp.Z))*rot end
    monClock=monClock+dt;if monClock>=0.15 then monClock=0;monPhaseV.Text="PHASE: "..(Desync.phase=="hide" and "HIDING" or Desync.phase=="attack" and "ATTACKING" or "IDLE");monPhaseV.TextColor3=Desync.phase=="hide" and C.cyan or Desync.phase=="attack" and C.orange or C.dim;monDepthV.Text=string.format("DEPTH: %.0f/%d",Desync.currentDepth,CFG.Void.VoidDepth);monCycleV.Text="CYCLES: "..Desync.totalCycles end
end))


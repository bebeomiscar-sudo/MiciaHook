    local bH=s(8);local tB=make("Frame",{Size=UDim2.new(1,-s(24),0,bH),Position=UDim2.new(0,s(12),0,SLIDER_H-bH-s(10)),BackgroundColor3=C.border,BorderSizePixel=0,Parent=f});make("UICorner",{CornerRadius=UDim.new(0,s(3)),Parent=tB})
    local pc=math.clamp((df-mn)/(mx-mn),0,1);local fl=make("Frame",{Size=UDim2.new(pc,0,1,0),BackgroundColor3=C.accent,BorderSizePixel=0,Parent=tB});make("UICorner",{CornerRadius=UDim.new(0,s(3)),Parent=fl})
    local hSz=s(18);local hd=make("Frame",{Size=UDim2.new(0,hSz,0,hSz),Position=UDim2.new(pc,-hSz/2,0.5,-hSz/2),BackgroundColor3=C.text,BorderSizePixel=0,ZIndex=3,Parent=tB});make("UICorner",{CornerRadius=UDim.new(1,0),Parent=hd})
    local tz=make("TextButton",{Size=UDim2.new(1,s(20),0,s(30)),Position=UDim2.new(0,-s(10),0.5,-s(15)),BackgroundTransparency=1,Text="",ZIndex=4,Parent=tB});local sl=false
    local function upd(ix) local r=math.clamp((ix-tB.AbsolutePosition.X)/tB.AbsoluteSize.X,0,1);val=math.clamp(math.floor((mn+(mx-mn)*r)/inc+0.5)*inc,mn,mx);local fp=(val-mn)/(mx-mn);fl.Size=UDim2.new(fp,0,1,0);hd.Position=UDim2.new(fp,-hSz/2,0.5,-hSz/2);vL.Text=fmtN(val,inc);if cb then cb(val) end end
    tz.InputBegan:Connect(function(i) if isTM(i) then sl=true;upd(i.Position.X) end end);hd.InputBegan:Connect(function(i) if isTM(i) then sl=true end end)

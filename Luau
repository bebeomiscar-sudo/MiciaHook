            local inst = Make("TextLabel", {
                BackgroundTransparency=1, Size=UDim2.new(1,0,0,16), Font=T.FontReg,
                Text=text, TextColor3=T.TextDim, TextSize=12,
                TextXAlignment=Enum.TextXAlignment.Left, TextWrapped=true, ZIndex=15, Parent=cont,
            })
            function obj:SetText(t) inst.Text=t; resize() end
            resize(); return obj
        end

        function GB:AddDivider()
            Make("Frame", {BackgroundColor3=T.Border, Size=UDim2.new(1,0,0,1), ZIndex=15, Parent=cont})
            resize()
        end

        function GB:AddToggle(text, default, callback)
            local Tog={Value=default==true}
            local row = Make("Frame", {BackgroundTransparency=1, Size=UDim2.new(1,0,0,26), ZIndex=15, Parent=cont})
            Make("TextLabel", {
                BackgroundTransparency=1, Size=UDim2.new(1,-44,1,0), Font=T.FontReg,
                Text=text, TextColor3=T.Text, TextSize=13, TextXAlignment=Enum.TextXAlignment.Left,
                TextTruncate=Enum.TextTruncate.AtEnd, ZIndex=16, Parent=row,
            })
            local track = Make("Frame", {BackgroundColor3=Tog.Value and T.ToggleOn or T.ToggleOff, Size=UDim2.new(0,34,0,18), Position=UDim2.new(1,-34,0.5,-9), ZIndex=16, Parent=row})
            Corner(track,9)
            local knob = Make("Frame", {BackgroundColor3=Color3.new(1,1,1), Size=UDim2.new(0,12,0,12), Position=Tog.Value and UDim2.new(0,19,0.5,-6) or UDim2.new(0,3,0.5,-6), ZIndex=17, Parent=track})
            Corner(knob,6)
            local function apply(val, skipCb)
                Tog.Value=val
                Tween(track,{BackgroundColor3=val and T.ToggleOn or T.ToggleOff},0.14)
                Tween(knob,{Position=val and UDim2.new(0,19,0.5,-6) or UDim2.new(0,3,0.5,-6)},0.14)
                if not skipCb and callback then pcall(callback,val) end
            end
            local hb = Make("TextButton", {BackgroundTransparency=1, Size=UDim2.new(1,0,1,0), Text="", ZIndex=18, Parent=row})
            hb.MouseButton1Click:Connect(function() apply(not Tog.Value) end)
            function Tog:SetValue(v) apply(v==true,false) end
            function Tog:GetValue() return self.Value end
            apply(Tog.Value,true); resize(); return Tog
        end

        function GB:AddSlider(text, min, max, default, suffix, rounding, callback)
            if type(suffix)=="function" then callback=suffix; suffix=""; rounding=0
            elseif type(rounding)=="function" then callback=rounding; rounding=0 end
            suffix=suffix or ""; rounding=rounding or 0
            local Sli={Value=math.clamp(default or min,min,max)}
            local wrap = Make("Frame", {BackgroundTransparency=1, Size=UDim2.new(1,0,0,42), ZIndex=15, Parent=cont})
            Make("TextLabel", {BackgroundTransparency=1, Size=UDim2.new(0.65,0,0,16), Font=T.FontReg, Text=text, TextColor3=T.Text, TextSize=13, TextXAlignment=Enum.TextXAlignment.Left, ZIndex=16, Parent=wrap})
            local valLbl = Make("TextLabel", {BackgroundTransparency=1, Position=UDim2.new(0.65,0,0,0), Size=UDim2.new(0.35,0,0,16), Font=T.Font, Text=tostring(Sli.Value)..suffix, TextColor3=T.TextAcc, TextSize=13, TextXAlignment=Enum.TextXAlignment.Right, ZIndex=16, Parent=wrap})
            local track = Make("Frame", {BackgroundColor3=T.Border, Position=UDim2.new(0,0,0,24), Size=UDim2.new(1,0,0,8), ZIndex=16, Parent=wrap})
            Corner(track,4)
            local fill = Make("Frame", {BackgroundColor3=T.Accent, Size=UDim2.new(0,0,1,0), ZIndex=17, Parent=track})
            Corner(fill,4)
            local handle = Make("Frame", {BackgroundColor3=Color3.new(1,1,1), AnchorPoint=Vector2.new(0.5,0.5), Size=UDim2.new(0,14,0,14), Position=UDim2.new(0,0,0.5,0), ZIndex=18, Parent=track})
            Corner(handle,7); Stroke(handle,T.Accent,2)
            local function fmt(v)
                if rounding==0 then return tostring(math.floor(v)) end
                return string.format("%."..rounding.."f",v)
            end
            local function setVal(v)
                v=math.clamp(v,min,max); if rounding==0 then v=math.floor(v+0.5) end
                Sli.Value=v; local pct=(v-min)/(max-min)
                fill.Size=UDim2.new(pct,0,1,0); handle.Position=UDim2.new(pct,0,0.5,0)
                valLbl.Text=fmt(v)..suffix; if callback then pcall(callback,v) end
            end
            local dragging=false
            local function fromInput(inp)
                local ix=select(1,InputPos(inp)); local ap=track.AbsolutePosition.X; local as=track.AbsoluteSize.X
                if as<=0 then return end
                setVal(min+(max-min)*math.clamp((ix-ap)/as,0,1))
            end
            track.InputBegan:Connect(function(inp)
                if inp.UserInputType==Enum.UserInputType.MouseButton1 or inp.UserInputType==Enum.UserInputType.Touch then
                    dragging=true; fromInput(inp)
                end
            end)
            UIS.InputChanged:Connect(function(inp)
                if not dragging then return end
                if inp.UserInputType==Enum.UserInputType.MouseMovement or inp.UserInputType==Enum.UserInputType.Touch then fromInput(inp) end
            end)
            UIS.InputEnded:Connect(function(inp)
                if inp.UserInputType==Enum.UserInputType.MouseButton1 or inp.UserInputType==Enum.UserInputType.Touch then dragging=false end
            end)
            setVal(Sli.Value)
            function Sli:SetValue(v) setVal(v) end
            function Sli:GetValue() return self.Value end
            resize(); return Sli
        end


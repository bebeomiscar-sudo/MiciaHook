local function getScreenCenter()
    return Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
end

local function angleDiff(f, t)
    local d = t - f
    return ((d + math.pi) % (math.pi * 2)) - math.pi
end

local function isSameTeamRivals(p)
    local same = false
    pcall(function()
        local mi = LP:GetAttribute("TeamID")
        local ti = p:GetAttribute("TeamID")
        if mi ~= nil and ti ~= nil then same = (mi == ti) end
    end)
    if not same then
        pcall(function() 
            same = p.Team ~= nil and LP.Team ~= nil and p.Team == LP.Team 
        end)
    end
    return same
end

local function isVisible(origin, targetPart)
    if not targetPart then return false end
    local ok, r = pcall(function()
        local dest   = targetPart.Position
        local dir    = dest - origin
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = {
            LP.Character, targetPart.Parent, workspace:FindFirstChild("Debris")
        }
        local hit = workspace:Raycast(origin, dir, params)
        return hit == nil or hit.Instance:IsDescendantOf(targetPart.Parent)
    end)
    return ok and r or false
end

local function getBestPart(char, setting)
    local names = {
        ["Head"]       = {"Head"},
        ["Body"]       = {"UpperTorso", "LowerTorso", "HumanoidRootPart"},
        ["Head, Body"] = {"Head", "UpperTorso", "LowerTorso", "HumanoidRootPart"},
        ["Body, Head"] = {"UpperTorso", "LowerTorso", "Head"},
    }
    local parts = names[setting] or {"Head"}
    for _, n in ipairs(parts) do 
        local p = char:FindFirstChild(n)
        if p then return p end
    end
    return nil
end

local function getEffectiveFOV()
    local f = AimbotCFG.MaxFOV
    if AimbotCFG.DynamicFOV then 
        f = f * (camera.FieldOfView / 70) 
    end
    return f
end

-- ═══════════════════════════════════════════
-- AIMBOT DELAYED POSITION SYSTEM
-- ═══════════════════════════════════════════
local delayedTargetPos = nil
local lockTimer        = 0
local lockedTarget     = nil
local reactionTimer    = 0
local isInReaction     = false

local function resetDelayedPos()
    delayedTargetPos = nil
end

local function getDelayedPos(targetPart, dt)
    if not targetPart or not targetPart.Parent then
        delayedTargetPos = nil
        return nil
    end

    local realPos = targetPart.Position

    if not delayedTargetPos then
        delayedTargetPos = realPos
        return realPos
    end

    local isJumping = false
    pcall(function()
        local hrp = targetPart.Parent:FindFirstChild("HumanoidRootPart")
        if hrp then 
            isJumping = hrp.AssemblyLinearVelocity.Y > 2 
        end
    end)

    local baseFrames = 60 * dt
    local xAlpha = math.clamp((1 - AimbotCFG.XSmooth) * (1 + baseFrames), 0.01, 1)
    local yAlpha
    if isJumping and AimbotCFG.JumpSmooth > 0 then
        yAlpha = math.clamp((1 - AimbotCFG.JumpSmooth) * (1 + baseFrames), 0.01, 1)
    else
        yAlpha = math.clamp((1 - AimbotCFG.YSmooth) * (1 + baseFrames), 0.01, 1)
    end

    delayedTargetPos = Vector3.new(
        delayedTargetPos.X + (realPos.X - delayedTargetPos.X) * xAlpha,
        delayedTargetPos.Y + (realPos.Y - delayedTargetPos.Y) * yAlpha,
        delayedTargetPos.Z + (realPos.Z - delayedTargetPos.Z) * xAlpha
    )

    return delayedTargetPos
end

local function isTargetStillValid(part)
    if not part or not part.Parent then return false end
    local hum = part.Parent:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    if AimbotCFG.VisibleCheck and not isVisible(camera.CFrame.Position, part) then return false end
    if AimbotCFG.TeamCheck then
        local p = Players:GetPlayerFromCharacter(part.Parent)
        if p and isSameTeamRivals(p) then return false end
    end
    return true
end

local function findNewAimbotTarget()
    local c = getScreenCenter()
    local bp, bd = nil, getEffectiveFOV()
    
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LP then continue end
        if AimbotCFG.TeamCheck and isSameTeamRivals(p) then continue end
        
        local ch = p.Character
        if not ch then continue end
        
        local h = ch:FindFirstChildOfClass("Humanoid")
        if not h or h.Health <= 0 then continue end
        
        local part = getBestPart(ch, AimbotCFG.TargetPart)
        if not part then continue end
        
        if AimbotCFG.VisibleCheck and not isVisible(camera.CFrame.Position, part) then continue end
        
        local sp, on = camera:WorldToScreenPoint(part.Position)
        if not on then continue end
        
        local d = (Vector2.new(sp.X, sp.Y) - c).Magnitude
        if d < bd then 
            bd = d
            bp = part 
        end
    end
    
    return bp
end


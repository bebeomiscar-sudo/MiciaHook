MS_OOB:AddToggle("AntiOOBPatch",  {Text="Patch Module", Default=true, Callback=function(v) AntiOOBCFG.PatchModule=v; if v and AntiOOBCFG.Enabled then antiOOB_PatchModule() end end})
MS_OOB:AddToggle("AntiOOBHide",   {Text="Hide OOB Parts",Default=false,Callback=function(v) AntiOOBCFG.HideParts=v; if v and AntiOOBCFG.Enabled then antiOOB_HideOOBParts(true) end end})

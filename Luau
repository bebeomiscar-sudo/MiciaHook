-- UI — SETTINGS TAB
-- ═══════════════════════════════════════════
local ST_L = Tabs.Settings:AddLeftGroupbox("Safety")
local ST_R = Tabs.Settings:AddRightGroupbox("Stop All")

ST_L:AddToggle("AutoDisable",{Text="Auto Disable on Death",Default=true,Callback=function(v) SafetyCFG.AutoDisableOnDeath=v end})
ST_L:AddLabel("Emergency Stop: DELETE key")
ST_L:AddLabel("Disables all features instantly")

ST_R:AddButton({Text="Disable All Features",Func=function() disableAll() end})
ST_R:AddButton({
    Text="Unload Script", DoubleClick=true, Tooltip="Double-click to unload",
    Func=function()
        for _, conn in pairs(Connections) do
            if typeof(conn) == "RBXScriptConnection" then conn:Disconnect() end
        end
        for _, conn in ipairs(antiOOBConns)        do pcall(function() conn:Disconnect() end) end
        for _, conn in ipairs(tracerConns)          do pcall(function() conn:Disconnect() end) end
        for _, conn in ipairs(explosionDeathConns)  do pcall(function() conn:Disconnect() end) end
        for _, conn in ipairs(tripmineConns)        do pcall(function() conn:Disconnect() end) end
        if backstabConn       then backstabConn:Disconnect()       end
        if ragebotPersistConn then ragebotPersistConn:Disconnect() end
        stopRakNetHook(); stopAntiOOB(); stopLoopExplosions()
        stopTracers(); stopAnimation(); stopSoundSpam()
        stopRagebotOrbit(); stopAutoBackstab(); stopAntiTripmine()
        WeaponsCFG.ReloadSpeedEnabled=false; applyReloadPatch()
        if fovCircle   then fovCircle:Remove()   end
        if saFovCircle then saFovCircle:Remove() end
        Library:Unload()
    end,
})


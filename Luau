RunService.Heartbeat:Connect(function(dt)
    -- Auto Collect
    local char = LP.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChild("Humanoid")
        if hrp then
            local nh = hum and hum.Health < hum.MaxHealth
            for _, obj in workspace:GetChildren() do
                if obj.Name == "_drop" and obj:IsA("BasePart") then
                    if (CFG.Collect.Health and obj:FindFirstChild("Health") and nh)
                    or (CFG.Collect.Ammo   and obj:FindFirstChild("Ammo")) then
                        pcall(function()
                            firetouchinterest(hrp, obj, 0)
                            firetouchinterest(hrp, obj, 1)
                        end)
                    end
                end
            end
        end
    end

    -- Orbit
    if CFG.Orbit.On and CFG.OrbitTarget then
        local mc = LP.Character
        if mc then
            local mr = mc:FindFirstChild("HumanoidRootPart")
            local tc = CFG.OrbitTarget.Character
            if mr and tc then
                local tr = tc:FindFirstChild("HumanoidRootPart")
                local mh = mc:FindFirstChildOfClass("Humanoid")
                if tr and mh and mh.Health > 0 then
                    orbitAngle = orbitAngle + (CFG.Orbit.Speed * dt)
                    if orbitAngle > math.pi * 2 then orbitAngle = orbitAngle - math.pi * 2 end
                    local tp = tr.Position
                    mr.CFrame = CFrame.new(
                        tp + Vector3.new(
                            math.cos(orbitAngle) * CFG.Orbit.Radius,
                            CFG.Orbit.Height,
                            math.sin(orbitAngle) * CFG.Orbit.Radius
                        ),
                        tp
                    )
                end
            end
        end
    end

    -- Void Spam
    if VoidDesync.active and RagebotCFG.VoidSpam then
        if not humanoidRootPart or not humanoidRootPart.Parent then
            VoidDesync.active = false; return
        end
        local hum2 = character and character:FindFirstChildOfClass("Humanoid")
        if not hum2 or hum2.Health <= 0 then stopVoidSpam(); return end
        VoidDesync.realCFrame  = humanoidRootPart.CFrame
        VoidDesync.phaseTimer  = VoidDesync.phaseTimer + dt
        if VoidDesync.phase == "hide" then
            VoidDesync.depth = math.min(VoidDesync.depth + 30, 200)
            if VoidDesync.phaseTimer >= RagebotCFG.HideTime then
                VoidDesync.phase      = "attack"
                VoidDesync.phaseTimer = 0
                VoidDesync.shotsFired = 0
                VoidDesync.shotCooldown = 0
            end
        elseif VoidDesync.phase == "attack" then
            VoidDesync.depth = math.max(VoidDesync.depth - 90, 0)
            if VoidDesync.depth <= 2 and RagebotCFG.On then
                VoidDesync.shotCooldown = VoidDesync.shotCooldown - dt
                if VoidDesync.shotsFired < RagebotCFG.ShootAttempts
                and VoidDesync.shotCooldown <= 0 then
                    simClick()
                    VoidDesync.shotsFired   = VoidDesync.shotsFired + 1
                    VoidDesync.shotCooldown = 0.05
                end
            end
            if VoidDesync.phaseTimer >= RagebotCFG.AttackTime then
                VoidDesync.phase      = "hide"
                VoidDesync.phaseTimer = 0
            end
        end
        if VoidDesync.depth > 0 then
            local rp  = VoidDesync.realCFrame.Position
            local rot = VoidDesync.realCFrame - rp
            humanoidRootPart.CFrame = CFrame.new(
                Vector3.new(rp.X, rp.Y - VoidDesync.depth, rp.Z)
            ) * rot
        end
    end
end)


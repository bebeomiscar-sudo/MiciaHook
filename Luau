local function makeToggle(parent,label,default,order,callback)
    local state=default or false
    local frame=make("Frame",{Size=UDim2.new(1,0,0,TOGGLE_H),BackgroundColor3=C.elem,BorderSizePixel=0,LayoutOrder=order,Parent=parent})
    make("UICorner",{CornerRadius=UDim.new(0,s(3)),Parent=frame})
    make("TextLabel",{
        Size=UDim2.new(1,-s(60),1,0),Position=UDim2.new(0,s(12),0,0),
        BackgroundTransparency=1,Text=label,TextColor3=C.text,Font=Enum.Font.Gotham,
        TextSize=FONT_MAIN,TextXAlignment=Enum.TextXAlignment.Left,
        TextTruncate=Enum.TextTruncate.AtEnd,Parent=frame,
    })
    local tW,tH,kS=s(40),s(20),s(16)
    local track=make("Frame",{
        Size=UDim2.new(0,tW,0,tH),Position=UDim2.new(1,-tW-s(10),0.5,-tH/2),
        BackgroundColor3=state and C.accent or C.off,BorderSizePixel=0,Parent=frame,
    })
    make("UICorner",{CornerRadius=UDim.new(0,tH/2),Parent=track})
    local knob=make("Frame",{
        Size=UDim2.new(0,kS,0,kS),
        Position=state and UDim2.new(1,-kS-s(2),0.5,-kS/2) or UDim2.new(0,s(2),0.5,-kS/2),
        BackgroundColor3=C.text,BorderSizePixel=0,Parent=track,
    })
    make("UICorner",{CornerRadius=UDim.new(1,0),Parent=knob})
    local btn=make("TextButton",{Size=UDim2.new(1,0,1,0),BackgroundTransparency=1,Text="",Parent=frame})
    btn.MouseButton1Click:Connect(function()
        state=not state
        tw(track,0.18,{BackgroundColor3=state and C.accent or C.off})
        tw(knob,0.18,{Position=state and UDim2.new(1,-kS-s(2),0.5,-kS/2) or UDim2.new(0,s(2),0.5,-kS/2)})
        if callback then callback(state) end
    end)
    return {
        getState=function() return state end,
        setState=function(v) state=v
            track.BackgroundColor3=v and C.accent or C.off
            knob.Position=v and UDim2.new(1,-kS-s(2),0.5,-kS/2) or UDim2.new(0,s(2),0.5,-kS/2)
        end,
    }
end


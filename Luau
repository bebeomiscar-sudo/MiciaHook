-- CORE: ORBIT LOGIC
--━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

local orbitAngle = 0

table.insert(ActiveConnections, RunService.Heartbeat:Connect(function(dt)
    if not CFG.Orbit.On then return end
    if not CFG.Target then return end

    local myChar = LP.Character
    if not myChar then return end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end

    local targetChar = CFG.Target.Character
    if not targetChar then return end
    local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
    if not targetRoot then return end

    local myHum = myChar:FindFirstChildOfClass("Humanoid")
    if myHum and myHum.Health <= 0 then return end

    orbitAngle = orbitAngle + (CFG.Orbit.Speed * dt)
    if orbitAngle > math.pi * 2 then
        orbitAngle = orbitAngle - math.pi * 2
    end

    local tPos = targetRoot.Position
    local oPos = tPos + Vector3.new(
        math.cos(orbitAngle) * CFG.Orbit.Radius,
        CFG.Orbit.Height,
        math.sin(orbitAngle) * CFG.Orbit.Radius
    )

    myRoot.CFrame = CFrame.new(oPos, tPos)
end))


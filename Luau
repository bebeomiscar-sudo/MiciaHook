-- Waits for Controllers folder before loading
-- so it works in lobby AND in match
-- ═══════════════════════════════════════════
local ctl = nil  -- may be nil in lobby

-- Try to get Controllers, wait up to 10s
task.spawn(function()
    local ok, result = pcall(function()
        return psc:WaitForChild("Controllers", 10)
    end)
    if ok and result then
        ctl = result
    end
end)

local mCam, mFig, mUtil, mEnum, mData, mCosmetic, mItemLib
local rUseItem, rReload

-- Safe require that retries when Controllers loads
local function safeRequire(getPath)
    local mod = nil
    task.spawn(function()
        while not mod do
            pcall(function()
                mod = require(getPath())
            end)
            if not mod then task.wait(2) end
        end
    end)
    -- Return getter so features check at runtime
    return function() return mod end
end

-- These load immediately (ReplicatedStorage is always available)
pcall(function() mUtil  = require(rep.Modules.Utility) end)
pcall(function() mEnum  = require(rep.Modules.EnumLibrary) end)
pcall(function() mItemLib = require(rep.Modules:WaitForChild("ItemLibrary", 10)) end)
pcall(function() mCosmetic = require(rep.Modules:WaitForChild("CosmeticLibrary", 10)) end)

-- Controllers modules — wait for Controllers folder
local function tryLoadControllers()
    if not ctl then return end
    if not mCam then
        pcall(function()
            mCam = require(ctl:WaitForChild("CameraController", 5))
        end)
    end
    if not mFig then
        pcall(function()
            mFig = require(ctl:WaitForChild("FighterController", 5))
        end)
    end
    if not mData then
        pcall(function()
            mData = require(ctl:WaitForChild("PlayerDataController", 5))
        end)
    end
end

-- Remotes (also safe)
local function tryLoadRemotes()
    pcall(function()
        local rf    = rep.Remotes.Replication.Fighter
        rUseItem    = rf.UseItem
        rReload     = rf:FindFirstChild("ReloadItem")
    end)
end

pcall(tryLoadRemotes)

-- Keep trying controllers every 3s until loaded
task.spawn(function()
    while not (mCam and mFig) do
        task.wait(3)
        if not ctl then
            pcall(function() ctl = psc:FindFirstChild("Controllers") end)
        end
        tryLoadControllers()
        tryLoadRemotes()
    end
end)


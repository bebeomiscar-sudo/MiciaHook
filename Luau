--// Aimbot Logic
local aimbotActive = false

local function UpdateAimbot()
    if not Toggles.aimbot_enabled or not Toggles.aimbot_enabled.Value then
        State.drawings.aimbot.circle.Visible = false
        State.manipulation.targetPosition = nil
        return
    end
    
    local screenCenter = Camera.ViewportSize / 2
    State.drawings.aimbot.circle.Position = screenCenter
    State.drawings.aimbot.circle.Radius = Options.silent_radius and Options.silent_radius.Value or 100
    State.drawings.aimbot.circle.Color = Options.aimbot_outline_color1 and Options.aimbot_outline_color1.Value or Color3.new(1, 1, 1)
    State.drawings.aimbot.circle.Visible = Toggles.aimbot_fov_outline and Toggles.aimbot_fov_outline.Value or false
    
    -- Check keybind or mobile button
    local isActive = false
    if Options.aimbot_keybind then
        isActive = Options.aimbot_keybind:GetState()
    end
    
    -- Mobile button override
    if IsMobile and State.mobileButtons["Aimbot"] then
        isActive = isActive or State.mobileButtons["Aimbot"].active()
    end
    
    if isActive then
        local target = GetClosestPlayer(
            Options.silent_radius and Options.silent_radius.Value or 100,
            Toggles.targeting_visibleonly and Toggles.targeting_visibleonly.Value,
            not (Toggles.esp_show_team and Toggles.esp_show_team.Value)
        )
        
        if target then
            -- Hit chance check
            local hitchance = Options.silent_hitchance and Options.silent_hitchance.Value or 100
            if math.random(1, 100) <= hitchance then
                State.manipulation.targetPosition = target.RootPart.Position
                State.manipulation.targetPlayer = target.Player
                
                -- Smooth aim if enabled
                if Toggles.aimbot_smooth and Toggles.aimbot_smooth.Value then
                    local smoothness = Options.aimbot_smoothness and Options.aimbot_smoothness.Value or 0.1
                    local targetScreen = target.ScreenPosition
                    local mousePos = UserInputService:GetMouseLocation()
                    local moveVec = (targetScreen - mousePos) * smoothness
                    
                    if not IsMobile then
                        mousemoverel(moveVec.X, moveVec.Y)
                    end
                end
                
                -- Target highlight
                if Toggles.target_highlight_fill and Toggles.target_highlight_fill.Value then
                    -- Highlight logic here
                end
            else
                State.manipulation.targetPosition = nil
            end
        else
            State.manipulation.targetPosition = nil
        end
    else
        State.manipulation.targetPosition = nil
    end
end


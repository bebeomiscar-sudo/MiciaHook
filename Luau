local function showHit(amount)
    if not hitEnabled then return end
    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.AutomaticSize = Enum.AutomaticSize.XY
    label.Text = tostring(math.floor(amount + 0.5))
    label.Font = Enum.Font.Jura
    label.TextColor3 = hitColor
    label.TextSize = 50
    label.TextStrokeTransparency = 0
    label.TextStrokeColor3 = Color3.new(0, 0, 0)
    label.TextTransparency = 1
    label.Position = UDim2.new(0.5, math.random(-180, 180), 0.45, math.random(-120, 120))
    label.AnchorPoint = Vector2.new(0.5, 0.5)
    label.Parent = hitNumberGui
    
    TweenService:Create(label, TweenInfo.new(0.3), {TextTransparency = 0}):Play()
    
    task.delay(hitStayTime, function()
        TweenService:Create(label, TweenInfo.new(1), {TextTransparency = 1}):Play()
        task.wait(1)
        label:Destroy()
    end)
end

local function setupHumanoid(hum2)
    local lastHealth = hum2.Health
    hum2.HealthChanged:Connect(function(newHealth)
        local dmg = lastHealth - newHealth
        if dmg > 0.1 then showHit(dmg) end
        lastHealth = newHealth
    end)
end


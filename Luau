local ESPObjects={}

local function createESP(player)
    if player==LP then return end
    if ESPObjects[player] then return end
    local esp={}
    pcall(function()
        esp.box=Drawing.new("Square");esp.box.Thickness=1;esp.box.Filled=false;esp.box.Color=Color3.fromRGB(255,50,50);esp.box.Visible=false;esp.box.ZIndex=500
        esp.name=Drawing.new("Text");esp.name.Size=13;esp.name.Center=true;esp.name.Outline=true;esp.name.Color=Color3.fromRGB(255,255,255);esp.name.Visible=false;esp.name.ZIndex=501
        esp.health=Drawing.new("Line");esp.health.Thickness=2;esp.health.Color=Color3.fromRGB(0,255,0);esp.health.Visible=false;esp.health.ZIndex=502
        esp.healthBg=Drawing.new("Line");esp.healthBg.Thickness=2;esp.healthBg.Color=Color3.fromRGB(60,60,60);esp.healthBg.Visible=false;esp.healthBg.ZIndex=499
        esp.dist=Drawing.new("Text");esp.dist.Size=11;esp.dist.Center=true;esp.dist.Outline=true;esp.dist.Color=Color3.fromRGB(200,200,200);esp.dist.Visible=false;esp.dist.ZIndex=501
    end)
    ESPObjects[player]=esp
end

local function removeESP(player)
    local esp=ESPObjects[player]
    if not esp then return end
    pcall(function() if esp.box then esp.box:Remove() end end)
    pcall(function() if esp.name then esp.name:Remove() end end)
    pcall(function() if esp.health then esp.health:Remove() end end)
    pcall(function() if esp.healthBg then esp.healthBg:Remove() end end)
    pcall(function() if esp.dist then esp.dist:Remove() end end)
    ESPObjects[player]=nil
end

local function updateESP()
    if not CFG.ESP.On then
        for player,_ in pairs(ESPObjects) do
            local e=ESPObjects[player]
            if e then
                pcall(function() if e.box then e.box.Visible=false end end)
                pcall(function() if e.name then e.name.Visible=false end end)
                pcall(function() if e.health then e.health.Visible=false end end)
                pcall(function() if e.healthBg then e.healthBg.Visible=false end end)
                pcall(function() if e.dist then e.dist.Visible=false end end)
            end
        end
        return
    end

    for _,player in ipairs(Players:GetPlayers()) do
        if player==LP then continue end
        if CFG.ESP.TeamCheck and isSameTeam(player) then
            local e=ESPObjects[player]
            if e then pcall(function() e.box.Visible=false;e.name.Visible=false;e.health.Visible=false;e.healthBg.Visible=false;e.dist.Visible=false end) end
            continue
        end

        if not ESPObjects[player] then createESP(player) end
        local esp=ESPObjects[player]
        if not esp then continue end

        local char=player.Character
        if not char then pcall(function() esp.box.Visible=false;esp.name.Visible=false;esp.health.Visible=false;esp.healthBg.Visible=false;esp.dist.Visible=false end);continue end

        local hrp=char:FindFirstChild("HumanoidRootPart")
        local head=char:FindFirstChild("Head")
        local hum=char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum or hum.Health<=0 then pcall(function() esp.box.Visible=false;esp.name.Visible=false;esp.health.Visible=false;esp.healthBg.Visible=false;esp.dist.Visible=false end);continue end

        local myHRP=LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        local distance=myHRP and (myHRP.Position-hrp.Position).Magnitude or 0
        if distance>CFG.ESP.MaxDist then pcall(function() esp.box.Visible=false;esp.name.Visible=false;esp.health.Visible=false;esp.healthBg.Visible=false;esp.dist.Visible=false end);continue end

        local pos,onScreen=camera:WorldToViewportPoint(hrp.Position)
        if not onScreen then pcall(function() esp.box.Visible=false;esp.name.Visible=false;esp.health.Visible=false;esp.healthBg.Visible=false;esp.dist.Visible=false end);continue end

        local scaleFactor=1/(pos.Z*math.tan(math.rad(camera.FieldOfView/2))*2)*1000
        local boxW=math.clamp(scaleFactor*3.5,8,80)
        local boxH=math.clamp(scaleFactor*5.5,12,120)
        local bx=pos.X-boxW/2
        local by=pos.Y-boxH/2

        pcall(function()
            if CFG.ESP.Boxes then
                esp.box.Size=Vector2.new(boxW,boxH);esp.box.Position=Vector2.new(bx,by);esp.box.Visible=true
                esp.box.Color=isSameTeam(player) and Color3.fromRGB(50,255,50) or Color3.fromRGB(255,50,50)
            else esp.box.Visible=false end

            if CFG.ESP.Names then
                esp.name.Text=player.DisplayName;esp.name.Position=Vector2.new(pos.X,by-15);esp.name.Visible=true
            else esp.name.Visible=false end

            if CFG.ESP.Health then
                local hp=math.clamp(hum.Health/hum.MaxHealth,0,1)
                local barH=boxH;local barX=bx-4
                esp.healthBg.From=Vector2.new(barX,by);esp.healthBg.To=Vector2.new(barX,by+barH);esp.healthBg.Visible=true
                esp.health.From=Vector2.new(barX,by+barH*(1-hp));esp.health.To=Vector2.new(barX,by+barH);esp.health.Visible=true
                esp.health.Color=Color3.fromRGB(255*(1-hp),255*hp,0)
            else esp.health.Visible=false;esp.healthBg.Visible=false end

            if CFG.ESP.Distance then
                esp.dist.Text=math.floor(distance).."m";esp.dist.Position=Vector2.new(pos.X,by+boxH+2);esp.dist.Visible=true
            else esp.dist.Visible=false end
        end)
    end
end


            ScrollingDirection=Enum.ScrollingDirection.Y, ZIndex=12, Parent=tabFrame,
        })
        local lay = List(col, Enum.FillDirection.Vertical, 6)
        Pad(col,4,4,4,4)
        lay:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            col.CanvasSize = UDim2.new(0,0,0,lay.AbsoluteContentSize.Y+8)
        end)
        return col
    end

    local leftCol  = makeCol(0,0,   0.5,-4)
    local rightCol = makeCol(0.5,4, 0.5,-8)

    function Tab:Show()
        for _, t in ipairs(AllTabs) do t:Hide() end
        tabFrame.Visible=true; indicator.Visible=true
        btn.TextColor3=T.TextAcc; Tween(btn,{BackgroundColor3=T.SurfaceHov},0.12)

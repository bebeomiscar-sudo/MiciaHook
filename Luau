local function isKeyHeld(keyName)
    if IsMobile then return true end
    if keyName == "None" or keyName == "" then return true end
    if keyName == "MouseButton2" then
        return UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
    end
    if keyName == "MouseButton3" then
        return UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton3)
    end
    local ok, result = pcall(function()
        return UIS:IsKeyDown(Enum.KeyCode[keyName])
    end)
    return ok and result or false
end


MS_BS:AddLabel("Detects when you are BEHIND an enemy")
MS_BS:AddLabel("Fires knife hitbox via firetouchinterest")
MS_BS:AddLabel("dot(enemyLook, dirToUs) < 0 = behind ✓")
MS_BS:AddToggle("BackstabEnabled",{
    Text="Enable Auto Backstab", Default=false,
    Callback=function(v)
        AutoBackstabCFG.Enabled=v
        if v then startAutoBackstab(); Library:Notify("Auto Backstab enabled",2)
        else stopAutoBackstab() end
    end,
})
MS_BS:AddToggle("BackstabOnlyKnife",{Text="Knife Only",Default=true,Tooltip="Only when holding a knife",Callback=function(v) AutoBackstabCFG.OnlyKnife=v end})
MS_BS:AddSlider("BackstabMaxDist",  {Text="Max Distance",Default=8,Min=1,Max=20,Rounding=0,Callback=function(v) AutoBackstabCFG.MaxDistance=v end})
MS_BS:AddSlider("BackstabFireRate", {Text="Fire Rate (ms)",Default=50,Min=10,Max=500,Rounding=0,Callback=function(v) AutoBackstabCFG.FireRate=v/1000 end})
MS_BS:AddToggle("BackstabTeamCheck",{Text="Team Check",Default=true,Callback=function(v) AutoBackstabCFG.TeamCheck=v end})

MS_TM:AddLabel("Reveals enemy mines that normally fade in")
MS_TM:AddLabel("Uses SubspaceTripmine CollectionService tag")
MS_TM:AddToggle("AntiTripmineEnabled",{
    Text="Enable Anti Tripmine", Default=false,
    Callback=function(v)
        AntiTripmineCFG.Enabled=v
        if v then startAntiTripmine(); Library:Notify("Anti Tripmine enabled",2)
        else stopAntiTripmine() end
    end,
})
MS_TM:AddToggle("AntiTripmineVisible",{Text="Make Enemy Mines Visible",Default=true,Tooltip="Forces LocalTransparencyModifier=0",Callback=function(v) AntiTripmineCFG.MakeVisible=v end})
MS_TM:AddToggle("AntiTripmineDestroy",{Text="Auto Detonate Mine",Default=false,Tooltip="firetouchinterest on mine Hitbox",Callback=function(v) AntiTripmineCFG.AutoDestroyMine=v end})
MS_TM:AddButton({Text="Reveal All Active Mines",Func=function()
    local count=0
    for _, obj in ipairs(CollectionService:GetTagged("SubspaceTripmine")) do
        if not isTripmineFriendly(obj) then revealTripmine(obj); count=count+1 end
    end
    Library:Notify("Revealed "..count.." mine(s)",2)
end})
MS_TM:AddButton({Text="Restore Mine Visibility",Func=function()
    for part, origVal in pairs(tripmineVisualMap) do
        pcall(function() part.LocalTransparencyModifier=origVal end)
    end
    tripmineVisualMap={}
    Library:Notify("Visibility restored",2)
end})


-- UTILITY FUNCTIONS
-- ═══════════════════════════════════════════
local cachedRayParams = RaycastParams.new()
cachedRayParams.FilterType = Enum.RaycastFilterType.Exclude

local function getScreenCenter()
    return Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
end

local function angleDiff(f, t)
    local d = t - f
    return ((d + math.pi) % (math.pi * 2)) - math.pi
end

local function isSameTeam(p)
    local same = false
    pcall(function()
        local mi = LP:GetAttribute("TeamID")
        local ti = p:GetAttribute("TeamID")
        if mi ~= nil and ti ~= nil then
            same = (mi == ti)
        end
    end)
    if not same then
        pcall(function()
            same = p.Team ~= nil and LP.Team ~= nil and p.Team == LP.Team
        end)
    end
    return same
end

local function isVisible(origin, targetPart)
    if not targetPart then return false end
    local ok, result = pcall(function()
        cachedRayParams.FilterDescendantsInstances = {
            LP.Character,
            targetPart.Parent,
            Workspace:FindFirstChild("Debris")
        }
        local dir = targetPart.Position - origin
        local hit = Workspace:Raycast(origin, dir, cachedRayParams)
        return hit == nil or hit.Instance:IsDescendantOf(targetPart.Parent)
    end)
    return ok and result or false
end

-- ═══════════════════════════════════════════
-- AIMBOT SYSTEM
-- ═══════════════════════════════════════════
local lockedTarget   = nil
local lockTimer      = 0
local reactionTimer  = 0
local isInReaction   = false
local delayedPos     = nil

local fovCircle = Drawing.new("Circle")
fovCircle.NumSides    = 64
fovCircle.Visible     = false
fovCircle.Color       = Color3.fromRGB(255, 255, 255)
fovCircle.Thickness   = 1.5
fovCircle.Transparency = 0.7
fovCircle.Filled      = false

local function getEffectiveAimbotFOV()
    local f = AimbotCFG.MaxFOV
    if AimbotCFG.DynamicFOV then f = f * (camera.FieldOfView / 70) end
    return f
end

local function isInFOV(part)
    if not part then return false end
    local sp, on = camera:WorldToViewportPoint(part.Position)
    if not on then return false end
    return (Vector2.new(sp.X, sp.Y) - getScreenCenter()).Magnitude <= getEffectiveAimbotFOV()
end

local function resetDelayedPos()
    delayedPos = nil
end

local function getDelayedPos(targetPart, dt)
    if not targetPart or not targetPart.Parent then
        delayedPos = nil
        return nil
    end
    local real = targetPart.Position
    if not delayedPos then
        delayedPos = real
        return real
    end

    local isJumping = false
    pcall(function()
        local hrp = targetPart.Parent:FindFirstChild("HumanoidRootPart")
        if hrp then isJumping = hrp.AssemblyLinearVelocity.Y > 2 end
    end)

    local frames = 60 * dt
    local xA = math.clamp((1 - AimbotCFG.XSmooth) * (1 + frames), 0.01, 1)
    local yA = isJumping and AimbotCFG.JumpSmooth > 0
        and math.clamp((1 - AimbotCFG.JumpSmooth) * (1 + frames), 0.01, 1)
        or math.clamp((1 - AimbotCFG.YSmooth) * (1 + frames), 0.01, 1)

    delayedPos = Vector3.new(
        delayedPos.X + (real.X - delayedPos.X) * xA,
        delayedPos.Y + (real.Y - delayedPos.Y) * yA,
        delayedPos.Z + (real.Z - delayedPos.Z) * xA
    )
    return delayedPos
end

local function isTargetValid(part)
    if not part or not part.Parent then return false end
    local hum = part.Parent:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    if not isInFOV(part) then return false end
    if AimbotCFG.VisibleCheck and not isVisible(camera.CFrame.Position, part) then return false end
    if AimbotCFG.TeamCheck then
        local p = Players:GetPlayerFromCharacter(part.Parent)
        if p and isSameTeam(p) then return false end
    end
    return true
end

local function findAimbotTarget()
    local center = getScreenCenter()
    local fov    = getEffectiveAimbotFOV()
    local best, bd = nil, fov

    for _, p in ipairs(Players:GetPlayers()) do
        if p == LP then continue end
        if AimbotCFG.TeamCheck and isSameTeam(p) then continue end
        local ch = p.Character
        if not ch then continue end
        local hum = ch:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end
        local part = getBestPart(ch, AimbotCFG.TargetPart)
        if not part then continue end
        local sp, on = camera:WorldToViewportPoint(part.Position)
        if not on then continue end
        local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
        if d > fov then continue end
        if AimbotCFG.VisibleCheck and not isVisible(camera.CFrame.Position, part) then continue end
        if d < bd then bd = d; best = part end
    end
    return best
end

-- ═══════════════════════════════════════════
-- SILENT AIM — util_raycast based
-- Replaces old ViewportSize spoof with proper
-- server-side shot data manipulation via util_mod
-- Works for both PC and Mobile
-- ═══════════════════════════════════════════
local saFovCircle = Drawing.new("Circle")
saFovCircle.NumSides     = 64
saFovCircle.Visible      = false
saFovCircle.Color        = Color3.fromRGB(0, 200, 255)
saFovCircle.Thickness    = 1.5
saFovCircle.Transparency = 0.7
saFovCircle.Filled       = false

local SA_PEEK_OFFSETS = {
    Vector3.new(0,   0, 0),
    Vector3.new(0,  12, 0),
    Vector3.new(0,  20, 0),
    Vector3.new(0,  30, 0),
    Vector3.new(3,   0, 0),
    Vector3.new(-3,  0, 0),
    Vector3.new(0,  -5, 0),
}

local saConn        = nil
local saTarget      = nil
local saTargetChar  = nil
local saRayParams   = RaycastParams.new()
saRayParams.FilterType = Enum.RaycastFilterType.Exclude

-- util_raycast: finds best peek point so shot data is valid server-side
local function sa_findPeekPoint(origin, targetPos, targetChar)
    saRayParams.FilterDescendantsInstances = {LP.Character, targetChar}

    -- Direct line of sight
    if not Workspace:Raycast(origin, targetPos - origin, saRayParams) then
        return origin, 0
    end

    -- Try offsets (horizontal + vertical peeking)
    for _, offset in ipairs(SA_PEEK_OFFSETS) do
        local sp = origin + offset
        if not Workspace:Raycast(sp, targetPos - sp, saRayParams) then
            return sp, offset.Y
        end
    end

    -- No clear LoS found, still send (server will validate)
    return origin, 0
end

local function getEffectiveSAFOV()
    if SACFG.IgnoreFOV then return math.huge end
    local f = SACFG.FOVSize
    if SACFG.DynamicFOV then f = f * (camera.FieldOfView / 70) end
    return f
end

local function saIsValid(plr, camPos, center)
    local ch = plr.Character
    if not ch then return false end
    local hum = ch:FindFirstChildOfClass("Humanoid")
    if not (hum and hum.Health > 0) then return false end

    -- Environment check (Rivals specific)
    local myEnv    = LP:GetAttribute("EnvironmentID")
    local theirEnv = plr:GetAttribute("EnvironmentID")
    if myEnv ~= nil and theirEnv ~= nil and myEnv ~= theirEnv then return false end

    if SACFG.TeamCheck and isSameTeam(plr) then return false end

    local tp = getBestPart(ch, SACFG.TargetParts)
    if not tp then return false end

    if not SACFG.IgnoreFOV then
        local sp, on = camera:WorldToViewportPoint(tp.Position)
        if not on then return false end
        if (Vector2.new(sp.X, sp.Y) - center).Magnitude > getEffectiveSAFOV() then return false end
    end

    if SACFG.VisCheck and not isVisible(camPos, tp) then return false end
    return true
end

local function saUpdateTarget()
    if not SACFG.On then
        saTarget     = nil
        saTargetChar = nil
        return
    end

    local camPos = camera.CFrame.Position
    local center = camera.ViewportSize / 2
    local best, bd, bestChar = nil, math.huge, nil

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LP then continue end
        if not saIsValid(plr, camPos, center) then continue end

        local ch = plr.Character
        local tp = getBestPart(ch, SACFG.TargetParts)
        if not tp then continue end

        local sp, on = camera:WorldToViewportPoint(tp.Position)
        if not on then continue end
        local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude

        if SACFG.Targeting == "Closest" and d < bd then
            bd = d; best = tp; bestChar = ch
        elseif SACFG.Targeting == "Furthest" and d > bd then
            bd = d; best = tp; bestChar = ch
        elseif SACFG.Targeting == "Random" then
            if not best or math.random() < 0.3 then
                best = tp; bestChar = ch
            end
        end
    end

    saTarget     = best
    saTargetChar = bestChar
end

-- Core util_raycast SA fire:
-- Builds shot CFrame data using util_mod:EncodeCFrame (same as Ragebot)
-- and fires via the game's own UseItem remote — no ViewportSize spoofing
local function saBuildAndFire(item)
    if not saTarget or not saTargetChar then return end
    if not util_mod or not enums_mod then return end
    if math.random(1, 100) > SACFG.HitChance then return end

    local cam    = camera.CFrame
    local origin = cam.Position
    local tp     = saTarget
    local tc     = saTargetChar

    local peekOrigin, peekHeight = sa_findPeekPoint(origin, tp.Position, tc)

    -- Build shot data identical to how the game sends it
    local shotOrigin = Vector3.new(
        peekOrigin.X,
        peekOrigin.Y + peekHeight,
        peekOrigin.Z
    )

    local lookDir    = CFrame.lookAt(shotOrigin, tp.Position)
    local pitch, yaw = lookDir:ToOrientation()

    local cd = {}
    cd[utf8.char(1)] = {
        -- Shooter CFrame (where shot originates)
        [utf8.char(0)] = util_mod:EncodeCFrame(
            CFrame.new(shotOrigin) * CFrame.Angles(pitch, yaw, 0)
        ),
        -- Shot direction CFrame
        [utf8.char(1)] = util_mod:EncodeCFrame(
            CFrame.new(tp.Position) * CFrame.Angles(pitch, yaw, 0)
        ),
        -- Hit part reference
        [utf8.char(2)] = tp,
        -- Relative CFrame on hit part
        [utf8.char(3)] = util_mod:EncodeCFrame(
            tp.CFrame:ToObjectSpace(CFrame.new(tp.Position))
        ),
    }

    local objectId = nil
    pcall(function() objectId = item:Get("ObjectID") end)
    if not objectId then return end

    -- Fire using game remote (same as Ragebot)
    pcall(function()
        rs.Remotes.Replication.Fighter.UseItem:FireServer(
            objectId,
            enums_mod:ToEnum("StartShooting"),
            cd,
            nil
        )
    end)
end

local saReloadCD = 0

local function startSA()
    if saConn then saConn:Disconnect() end

    saConn = RunService.Heartbeat:Connect(function(dt)
        saUpdateTarget()

        if not SACFG.On then return end
        if not LP.Character or not LP.Character:FindFirstChild("HumanoidRootPart") then return end
        if not fighter_mod or not fighter_mod.LocalFighter then return end

        local item = fighter_mod.LocalFighter.EquippedItem
        if not item then return end

        -- Auto reload
        saReloadCD = saReloadCD - dt
        local ammo = nil
        pcall(function() ammo = item:Get("CurrentAmmo") end)
        if ammo ~= nil and ammo <= 0 and saReloadCD <= 0 then
            pcall(function()
                rs.Remotes.Replication.Fighter.UseItem:FireServer(
                    item:Get("ObjectID"),
                    enums_mod:ToEnum("Reload"),
                    {},
                    nil
                )
            end)
            saReloadCD = 2.0
            return
        end

        saBuildAndFire(item)
    end)
end

local function stopSA()
    SACFG.On     = false
    saTarget     = nil
    saTargetChar = nil
    if saConn then
        saConn:Disconnect()
        saConn = nil
    end
end

-- ═══════════════════════════════════════════
-- TRIGGERBOT — Fixed version
-- - One clean Heartbeat connection
-- - Proper weapon validity checks
-- - Configurable FOV threshold
-- - No dangling loops
-- ═══════════════════════════════════════════
local triggerConn     = nil
local triggerLastFire = 0
local triggerFiring   = false
local triggerItem     = nil -- tracked item reference

local triggerRayParams = RaycastParams.new()
triggerRayParams.FilterType = Enum.RaycastFilterType.Exclude
triggerRayParams.IgnoreWater = true

local function triggerIsValidTarget(plr)
    if not plr or plr == LP then return false, nil end
    local ch = plr.Character
    if not ch then return false, nil end
    local hum = ch:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false, nil end
    if TriggerCFG.TeamCheck and isSameTeam(plr) then return false, nil end
    local part = getBestPart(ch, TriggerCFG.TargetPart)
    if not part then return false, nil end
    if TriggerCFG.VisCheck and not isVisible(camera.CFrame.Position, part) then return false, nil end
    local dist = (camera.CFrame.Position - part.Position).Magnitude
    if dist > TriggerCFG.MaxDist then return false, nil end
    return true, part
end

local function triggerDoFire(item)
    if not item then return end
    local objectId = nil
    pcall(function() objectId = item:Get("ObjectID") end)

    -- Method 1: Direct shoot call
    pcall(function()
        if item.Shoot then item:Shoot() end
    end)

    -- Method 2: Remote fire (if available)
    if objectId and enums_mod then
        pcall(function()
            rs.Remotes.Replication.Fighter.UseItem:FireServer(
                objectId,
                enums_mod:ToEnum("StartShooting"),
                {},
                nil
            )
        end)
        -- Brief delay then stop signal
        task.delay(0.06, function()
            pcall(function()
                rs.Remotes.Replication.Fighter.UseItem:FireServer(
                    objectId,
                    enums_mod:ToEnum("StopShooting"),
                    {},
                    nil
                )
            end)
        end)
    end
end

local function startTriggerbot()
    if triggerConn then triggerConn:Disconnect() end
    triggerFiring = false

    triggerConn = RunService.Heartbeat:Connect(function()
        -- Guard: feature off
        if not TriggerCFG.On then
            triggerFiring = false
            return
        end

        -- Guard: character
        local myChar = LP.Character
        if not myChar then triggerFiring = false; return end
        local myHum = myChar:FindFirstChildOfClass("Humanoid")
        if not myHum or myHum.Health <= 0 then triggerFiring = false; return end

        -- Guard: scoped only mode
        if TriggerCFG.Mode == "Scoped Only" then
            local aiming = false
            pcall(function()
                if fighter_mod and fighter_mod.LocalFighter then
                    aiming = fighter_mod.LocalFighter.IsAiming or false
                end
            end)
            if not aiming then triggerFiring = false; return end
        end

        -- Guard: on aimbot target mode
        if TriggerCFG.Mode == "On Aimbot Target" then
            if not lockedTarget then triggerFiring = false; return end
        end

        -- Get equipped item once per frame (safe)
        local item = nil
        pcall(function()
            if fighter_mod and fighter_mod.LocalFighter then
                item = fighter_mod.LocalFighter.EquippedItem
            end
        end)
        if not item then triggerFiring = false; return end

        -- Raycast from camera
        local origin   = camera.CFrame.Position
        local forward  = camera.CFrame.LookVector
        triggerRayParams.FilterDescendantsInstances = {myChar}

        local result = Workspace:Raycast(origin, forward * TriggerCFG.MaxDist, triggerRayParams)
        if not result then triggerFiring = false; return end

        -- Check hit model
        local hitModel = result.Instance:FindFirstAncestorOfClass("Model")
        if not hitModel then triggerFiring = false; return end

        local hitPlayer = Players:GetPlayerFromCharacter(hitModel)
        if not hitPlayer then triggerFiring = false; return end

        local valid, hitPart = triggerIsValidTarget(hitPlayer)
        if not valid then triggerFiring = false; return end

        -- Screen distance check (configurable FOV threshold)
        local sp, onScreen = camera:WorldToViewportPoint(hitPart.Position)
        if not onScreen then triggerFiring = false; return end
        local distFromCenter = (Vector2.new(sp.X, sp.Y) - getScreenCenter()).Magnitude
        if distFromCenter > TriggerCFG.TriggerFOV then triggerFiring = false; return end

        -- Delay check
        local now = tick()
        if (now - triggerLastFire) * 1000 < TriggerCFG.Delay then return end

        -- FIRE (burst support)
        triggerLastFire = now
        for i = 1, TriggerCFG.BurstCount do
            triggerDoFire(item)
            if TriggerCFG.BurstCount > 1 then
                task.wait(0.07)
            end
        end
        triggerFiring = true
    end)
end

local function stopTriggerbot()
    triggerFiring = false
    if triggerConn then
        triggerConn:Disconnect()
        triggerConn = nil
    end
end

-- ═══════════════════════════════════════════
-- RAGEBOT
-- ═══════════════════════════════════════════
local rageConn    = nil
local rageReloadCD = 0
local rageRayParams = RaycastParams.new()
rageRayParams.FilterType = Enum.RaycastFilterType.Exclude

local RAGE_PEEK_OFFSETS = {
    Vector3.new(0, 0, 0), Vector3.new(0, 12, 0), Vector3.new(0, 20, 0),
    Vector3.new(0, 30, 0), Vector3.new(3, 0, 0), Vector3.new(-3, 0, 0),
}

local function rageGetClosest()
    local myPos = character and character:FindFirstChild("HumanoidRootPart")
    if not myPos then return nil, nil end

    local best, bchar, bd = nil, nil, RageCFG.MaxDist

    for _, v in ipairs(Players:GetPlayers()) do
        if v == LP then continue end
        if RageCFG.TeamCheck and isSameTeam(v) then continue end
        local ch = v.Character
        if not ch then continue end
        local head = ch:FindFirstChild("Head")
        local hum  = ch:FindFirstChildOfClass("Humanoid")
        if not head or not hum or hum.Health <= 0 then continue end
        local mag = (myPos.Position - head.Position).Magnitude
        if mag < bd then bd = mag; best = head; bchar = ch end
    end

    return best, bchar
end

local function ragePeek(origin, targetPos, targetChar)
    rageRayParams.FilterDescendantsInstances = {LP.Character, targetChar}

    if not RageCFG.VisibleCheck then return origin, 0 end
    if not Workspace:Raycast(origin, targetPos - origin, rageRayParams) then return origin, 0 end

    for _, offset in ipairs(RAGE_PEEK_OFFSETS) do
        local sp = origin + offset
        if not Workspace:Raycast(sp, targetPos - sp, rageRayParams) then
            return sp, offset.Y
        end
    end
    return nil, nil
end

local function startRagebot()
    if rageConn then rageConn:Disconnect() end

    rageConn = RunService.Heartbeat:Connect(function(dt)
        if not RageCFG.On or not LP.Character then return end
        if not LP.Character:FindFirstChild("HumanoidRootPart") then return end
        if not fighter_mod or not fighter_mod.LocalFighter then return end
        if not util_mod or not enums_mod then return end

        local item = fighter_mod.LocalFighter.EquippedItem
        if not item then return end

        rageReloadCD = rageReloadCD - dt
        local ammo = nil
        pcall(function() ammo = item:Get("CurrentAmmo") end)
        if ammo ~= nil and ammo <= 0 and rageReloadCD <= 0 then
            pcall(function()
                rs.Remotes.Replication.Fighter.UseItem:FireServer(
                    item:Get("ObjectID"), enums_mod:ToEnum("Reload"), {}, nil
                )
            end)
            rageReloadCD = 2.0
            return
        end

        local tp, tc = rageGetClosest()
        if not tp or not tc then return end

        local cam    = camera.CFrame
        local manip, height = ragePeek(cam.Position, tp.Position, tc)
        if not manip then return end

        local sp    = Vector3.new(manip.X, manip.Y + (height or 0), manip.Z)
        local look  = CFrame.lookAt(sp, tp.Position)
        local p, y  = look:ToOrientation()

        local cd = {}
        cd[utf8.char(1)] = {
            [utf8.char(0)] = util_mod:EncodeCFrame(CFrame.new(sp) * CFrame.Angles(p, y, 0)),
            [utf8.char(1)] = util_mod:EncodeCFrame(CFrame.new(tp.Position) * CFrame.Angles(p, y, 0)),
            [utf8.char(2)] = tp,
            [utf8.char(3)] = util_mod:EncodeCFrame(tp.CFrame:ToObjectSpace(CFrame.new(tp.Position))),
        }

        pcall(function()
            rs.Remotes.Replication.Fighter.UseItem:FireServer(
                item:Get("ObjectID"), enums_mod:ToEnum("StartShooting"), cd, nil
            )
        end)
    end)
end

local function stopRagebot()
    RageCFG.On = false
    if rageConn then rageConn:Disconnect(); rageConn = nil end
end

-- ═══════════════════════════════════════════
-- GUN MODS
-- ═══════════════════════════════════════════
local gunOriginals  = {}
local gunPatchBusy  = false
local EXCLUDED_GUNS = {Sniper = true, Crossbow = true, Bow = true, RPG = true}

local function patchGun()
    if gunPatchBusy then return end
    gunPatchBusy = true
    task.defer(function()
        local ok, Items = pcall(function()
            return require(ReplicatedStorage.Modules.ItemLibrary).Items
        end)
        if ok and Items then
            for name, data in pairs(Items) do
                if typeof(data) ~= "table" or EXCLUDED_GUNS[name] then continue end
                if not gunOriginals[name] then
                    gunOriginals[name] = {
                        ShootSpread        = data.ShootSpread,
                        ShootAccuracy      = data.ShootAccuracy,
                        ShootRecoil        = data.ShootRecoil,
                        ShootCooldown      = data.ShootCooldown,
                        ShootBurstCooldown = data.ShootBurstCooldown,
                    }
                end
                local orig = gunOriginals[name]
                if data.ShootSpread   then data.ShootSpread   = GunCFG.NoSpread  and 0    or orig.ShootSpread   end
                if data.ShootAccuracy then data.ShootAccuracy = GunCFG.NoSpread  and 0    or orig.ShootAccuracy end
                if data.ShootRecoil   then data.ShootRecoil   = GunCFG.NoRecoil and 0    or orig.ShootRecoil   end
                if data.ShootCooldown then data.ShootCooldown = GunCFG.FastShoot and 0.05 or orig.ShootCooldown end
                if data.ShootBurstCooldown then
                    data.ShootBurstCooldown = GunCFG.FastShoot and 0.05 or orig.ShootBurstCooldown
                end
            end
        end
        gunPatchBusy = false
    end)
end


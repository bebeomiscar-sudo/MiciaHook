-- AIMBOT
-- ═══════════════════════════════════════════
local lockedTarget  = nil
local lockTimer     = 0
local reactionTimer = 0
local isInReaction  = false
local delayedPos    = nil

local fovCircle = Drawing.new("Circle")
fovCircle.NumSides     = 64
fovCircle.Visible      = false
fovCircle.Color        = Color3.fromRGB(255, 255, 255)
fovCircle.Thickness    = 1.5
fovCircle.Transparency = 0.7
fovCircle.Filled       = false

local function getEffectiveAimbotFOV()
    local f = AimbotCFG.MaxFOV
    if AimbotCFG.DynamicFOV then f = f * (camera.FieldOfView / 70) end
    return f
end

local function isInFOV(part)
    if not part then return false end
    local sp, on = camera:WorldToViewportPoint(part.Position)
    if not on then return false end
    return (Vector2.new(sp.X, sp.Y) - getScreenCenter()).Magnitude <= getEffectiveAimbotFOV()
end

local function resetDelayedPos()
    delayedPos = nil
end

local function getDelayedPos(targetPart, dt)
    if not targetPart or not targetPart.Parent then delayedPos = nil; return nil end
    local real = targetPart.Position
    if not delayedPos then delayedPos = real; return real end

    local isJumping = false
    pcall(function()
        local hrp = targetPart.Parent:FindFirstChild("HumanoidRootPart")
        if hrp then isJumping = hrp.AssemblyLinearVelocity.Y > 2 end
    end)

    local frames = 60 * dt
    local xA     = math.clamp((1 - AimbotCFG.XSmooth) * (1 + frames), 0.01, 1)
    local yA     = (isJumping and AimbotCFG.JumpSmooth > 0)
        and math.clamp((1 - AimbotCFG.JumpSmooth) * (1 + frames), 0.01, 1)
        or  math.clamp((1 - AimbotCFG.YSmooth) * (1 + frames), 0.01, 1)

    delayedPos = Vector3.new(
        delayedPos.X + (real.X - delayedPos.X) * xA,
        delayedPos.Y + (real.Y - delayedPos.Y) * yA,
        delayedPos.Z + (real.Z - delayedPos.Z) * xA
    )
    return delayedPos
end

local function isTargetValid(part)
    if not part or not part.Parent then return false end
    local hum = part.Parent:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    if not isInFOV(part) then return false end
    if AimbotCFG.VisibleCheck and not isVisible(camera.CFrame.Position, part) then return false end
    if AimbotCFG.TeamCheck then
        local p = Players:GetPlayerFromCharacter(part.Parent)
        if p and isSameTeam(p) then return false end
    end
    return true
end

local function findAimbotTarget()
    local center = getScreenCenter()
    local fov    = getEffectiveAimbotFOV()
    local best, bd = nil, fov
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LP then continue end
        if AimbotCFG.TeamCheck and isSameTeam(p) then continue end
        local ch = p.Character
        if not ch then continue end
        local hum = ch:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end
        local part = getBestPart(ch, AimbotCFG.TargetPart)
        if not part then continue end
        local sp, on = camera:WorldToViewportPoint(part.Position)
        if not on then continue end
        local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
        if d > fov then continue end
        if AimbotCFG.VisibleCheck and not isVisible(camera.CFrame.Position, part) then continue end
        if d < bd then bd = d; best = part end
    end
    return best
end

-- ═══════════════════════════════════════════
-- SILENT AIM — util_raycast hook
-- Intercepts Workspace:Raycast calls the game
-- uses for bullet detection and redirects them
-- to the target. NOT ragebot. NOT remote firing.
-- ═══════════════════════════════════════════
local saFovCircle = Drawing.new("Circle")
saFovCircle.NumSides     = 64
saFovCircle.Visible      = false
saFovCircle.Color        = Color3.fromRGB(0, 200, 255)
saFovCircle.Thickness    = 1.5
saFovCircle.Transparency = 0.7
saFovCircle.Filled       = false

local saTarget      = nil
local saTargetChar  = nil
local saTargetConn  = nil
local saHookApplied = false
local saRayHook     = nil

local saRayParams = RaycastParams.new()
saRayParams.FilterType = Enum.RaycastFilterType.Exclude

local function getEffectiveSAFOV()
    if SACFG.IgnoreFOV then return math.huge end
    local f = SACFG.FOVSize
    if SACFG.DynamicFOV then f = f * (camera.FieldOfView / 70) end
    return f
end

local function saIsValid(plr, camPos, center)
    local ch = plr.Character
    if not ch then return false end
    local hum = ch:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    local myEnv    = LP:GetAttribute("EnvironmentID")
    local theirEnv = plr:GetAttribute("EnvironmentID")
    if myEnv ~= nil and theirEnv ~= nil and myEnv ~= theirEnv then return false end
    if SACFG.TeamCheck and isSameTeam(plr) then return false end
    local tp = getBestPart(ch, SACFG.TargetParts)
    if not tp then return false end
    if not SACFG.IgnoreFOV then
        local sp, on = camera:WorldToViewportPoint(tp.Position)
        if not on then return false end
        if (Vector2.new(sp.X, sp.Y) - center).Magnitude > getEffectiveSAFOV() then return false end
    end
    if SACFG.VisCheck then
        saRayParams.FilterDescendantsInstances = {LP.Character, ch}
        local dir = tp.Position - camPos
        local hit = Workspace:Raycast(camPos, dir, saRayParams)
        if hit and not hit.Instance:IsDescendantOf(ch) then return false end
    end
    return true
end

local function saUpdateTarget()
    if not SACFG.On then saTarget = nil; saTargetChar = nil; return end
    local camPos = camera.CFrame.Position
    local center = camera.ViewportSize / 2
    local best, bd, bestChar = nil, math.huge, nil
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LP then continue end
        if not saIsValid(plr, camPos, center) then continue end
        local ch = plr.Character
        local tp = getBestPart(ch, SACFG.TargetParts)
        if not tp then continue end
        local sp, on = camera:WorldToViewportPoint(tp.Position)
        if not on then continue end
        local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
        if SACFG.Targeting == "Closest" and d < bd then
            bd = d; best = tp; bestChar = ch
        elseif SACFG.Targeting == "Furthest" and d > bd then
            bd = d; best = tp; bestChar = ch
        elseif SACFG.Targeting == "Random" then
            if not best or math.random() < 0.3 then best = tp; bestChar = ch end
        end
    end
    saTarget     = best
    saTargetChar = bestChar
end

-- The raycast hook: intercepts Workspace:Raycast,
-- checks if it looks like a bullet ray, redirects to target
local function applySARayHook()
    if saHookApplied then return end
    if not hookmetamethod then
        Library:Notify("SA: hookmetamethod not available", 4)
        return
    end

    local originalNamecall
    originalNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        local method = getnamecallmethod()

        if method == "Raycast" and (self == Workspace or self == ws) then
            if SACFG.On and saTarget and saTargetChar then
                if math.random(1, 100) <= SACFG.HitChance then
                    if not checkcaller() then
                        local args   = {...}
                        local origin = args[1]
                        local dir    = args[2]

                        if origin and dir
                            and typeof(origin) == "Vector3"
                            and typeof(dir)    == "Vector3" then

                            local rayLength = dir.Magnitude

                            -- Bullet rays are long (> 50 studs)
                            if rayLength > 50 then
                                local camPos    = camera.CFrame.Position
                                local distFromCam = (origin - camPos).Magnitude

                                local distFromHRP = math.huge
                                pcall(function()
                                    if LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
                                        distFromHRP = (origin - LP.Character.HumanoidRootPart.Position).Magnitude
                                    end
                                end)

                                -- Only redirect rays starting near camera or HRP
                                if distFromCam < 20 or distFromHRP < 10 then
                                    local targetPos = saTarget.Position
                                    local newDir    = (targetPos - origin).Unit * rayLength
                                    return originalNamecall(self, origin, newDir, args[3])
                                end
                            end
                        end
                    end
                end
            end
        end

        return originalNamecall(self, ...)
    end))

    saHookApplied = true
    saRayHook     = originalNamecall
end

local function startSA()
    applySARayHook()
    if saTargetConn then saTargetConn:Disconnect() end
    saTargetConn = RunService.Heartbeat:Connect(function()
        saUpdateTarget()
    end)
end

local function stopSA()
    SACFG.On     = false
    saTarget     = nil
    saTargetChar = nil
    if saTargetConn then saTargetConn:Disconnect(); saTargetConn = nil end
end


    local center         = getScreenCenter()
    local bChar, bDist   = nil, MobileTrigCFG.FOV
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LP then continue end
        if MobileTrigCFG.TeamCheck and isSameTeamRivals(p) then continue end
        local ch = p.Character; if not ch then continue end
        local hum = ch:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end
        for _, pn in ipairs({ "Head", "UpperTorso", "LowerTorso", "HumanoidRootPart" }) do
            local part = ch:FindFirstChild(pn); if not part then continue end
            if MobileTrigCFG.VisCheck and not isAimbotVisible(part) then continue end
            local sp, on = camera:WorldToScreenPoint(part.Position)
            if not on then continue end
            local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
            if d < bDist then bDist = d; bChar = ch end
        end
    end
    return bChar
end


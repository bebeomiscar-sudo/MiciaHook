                        for _,item in pairs(fighter.Items) do
                            if item:Get("ObjectID")==args[1] then
                                SC2.lastUsedWeapon=item.Name; break
                            end
                        end
                    end
                end)
            end)
        end
        if self==equipRemote then
            local weaponName,cosType,cosName=args[1],args[2],args[3]; local options=args[4] or {}
            SC2.equipped[weaponName]=SC2.equipped[weaponName] or {}
            if not cosName or cosName=="None" or cosName=="" then
                SC2.equipped[weaponName][cosType]=nil
                if not next(SC2.equipped[weaponName]) then SC2.equipped[weaponName]=nil end
            else
                local inv=SC2.DataController:Get("CosmeticInventory")
                if inv and rawget(inv,cosName) then return oldNC(self,...) end
                local cloned=SC2_cloneCosmetic(cosName,cosType,{inverted=options.IsInverted,favoritesOnly=options.OnlyUseFavorites})
                if cloned then SC2.equipped[weaponName][cosType]=cloned end
            end
            task.spawn(function()
                task.wait(0.1)
                pcall(function() SC2.DataController.CurrentData:Replicate("WeaponInventory") end)
                SC2_saveConfig()
            end)
            return
        end
        if favoriteRemote and self==favoriteRemote then
            SC2.favorites[args[1]]=SC2.favorites[args[1]] or {}
            SC2.favorites[args[1]][args[2]]=args[3] or nil
            SC2_saveConfig()
            task.spawn(function()
                pcall(function() SC2.DataController.CurrentData:Replicate("FavoritedCosmetics") end)
            end)
            return
        end
        return oldNC(self,...)
    end)
    SC2.hookApplied=true
end

local function SC2_applyViewModelHooks()
    local psModules=LP.PlayerScripts:FindFirstChild("Modules"); if not psModules then return end
    pcall(function()
        local clientItemPath=psModules.ClientReplicatedClasses.ClientFighter.ClientItem
        local ClientItem=require(clientItemPath)
        if ClientItem._CreateViewModel then
            local orig=ClientItem._CreateViewModel
            ClientItem._CreateViewModel=function(self,viewmodelRef)
                local wn=self.Name; local wp=self.ClientFighter and self.ClientFighter.Player
                SC2.constructing=(wp==LP) and wn or nil
                if wp==LP and SC2.equipped[wn] and SC2.equipped[wn].Skin and viewmodelRef then
                    pcall(function()
                        local dk=self:ToEnum("Data"); local sk=self:ToEnum("Skin"); local nk=self:ToEnum("Name")
                        if viewmodelRef[dk] then
                            viewmodelRef[dk][sk]=SC2.equipped[wn].Skin
                            viewmodelRef[dk][nk]=SC2.equipped[wn].Skin.Name
                        elseif viewmodelRef.Data then
                            viewmodelRef.Data.Skin=SC2.equipped[wn].Skin
                            viewmodelRef.Data.Name=SC2.equipped[wn].Skin.Name
                        end
                    end)
                end
                local result=orig(self,viewmodelRef); SC2.constructing=nil; return result
            end
        end
    end)
    pcall(function()
        local vmMod=psModules.ClientReplicatedClasses.ClientFighter.ClientItem:FindFirstChild("ClientViewModel")
        if not vmMod then return end
        local CVM=require(vmMod)
        if CVM.GetWrap then
            local orig=CVM.GetWrap
            CVM.GetWrap=function(self)
                local wn=self.ClientItem and self.ClientItem.Name
                local wp=self.ClientItem and self.ClientItem.ClientFighter and self.ClientItem.ClientFighter.Player
                if wn and wp==LP and SC2.equipped[wn] and SC2.equipped[wn].Wrap then return SC2.equipped[wn].Wrap end
                return orig(self)
            end
        end
        local origNew=CVM.new
        CVM.new=function(replicatedData,clientItem)
            local wp=clientItem.ClientFighter and clientItem.ClientFighter.Player
            local wn=SC2.constructing or clientItem.Name
            if wp==LP and SC2.equipped[wn] then
                pcall(function()
                    local RC=require(ReplicatedStorage.Modules.ReplicatedClass); local dk=RC:ToEnum("Data")
                    replicatedData[dk]=replicatedData[dk] or {}
                    local cos=SC2.equipped[wn]
                    if cos.Skin then replicatedData[dk][RC:ToEnum("Skin")]=cos.Skin end
                    if cos.Wrap then replicatedData[dk][RC:ToEnum("Wrap")]=cos.Wrap end
                    if cos.Charm then replicatedData[dk][RC:ToEnum("Charm")]=cos.Charm end
                end)
            end
            local result=origNew(replicatedData,clientItem)
            if wp==LP and SC2.equipped[wn] and SC2.equipped[wn].Wrap and result._UpdateWrap then
                task.spawn(function()
                    result:_UpdateWrap(); task.wait(0.1)
                    if not result._destroyed then result:_UpdateWrap() end
                end)
            end
            return result
        end
    end)
    pcall(function()
        local VP=require(psModules.Pages.ViewProfile)
        if VP and VP.Fetch then
            local orig=VP.Fetch
            VP.Fetch=function(self,targetPlayer) SC2.viewingProfile=targetPlayer; return orig(self,targetPlayer) end
        end
    end)
    pcall(function()
        local CE=require(psModules.ClientReplicatedClasses.ClientEntity)
        if CE and CE.ReplicateFromServer then
            local orig=CE.ReplicateFromServer
            CE.ReplicateFromServer=function(self,action,...)
                if action=="FinisherEffect" then
                    local args={...}; local killerName=args[3]; local decoded=killerName
                    if type(killerName)=="userdata" and SC2.EnumLibrary then
                        pcall(function() decoded=SC2.EnumLibrary:FromEnum(killerName) end)
                    end
                    local isOurs=tostring(decoded)==LP.Name or tostring(decoded):lower()==LP.Name:lower()
                    if isOurs and SC2.lastUsedWeapon and SC2.equipped[SC2.lastUsedWeapon] and SC2.equipped[SC2.lastUsedWeapon].Finisher then
                        local fd=SC2.equipped[SC2.lastUsedWeapon].Finisher; local fe=fd.Enum
                        if not fe and SC2.EnumLibrary then pcall(function() fe=SC2.EnumLibrary:ToEnum(fd.Name) end) end
                        if fe then args[1]=fe; return orig(self,action,table.unpack(args)) end
                    end
                end
                return orig(self,action,...)
            end
        end
    end)
end

local sc2ApplyBusy=false

local function SC2_Apply()
    if SC2.applied or sc2ApplyBusy then Library:Notify("Skin Changer v2 already applied",3); return end
    sc2ApplyBusy=true
    task.spawn(function()
        local ok,err=pcall(function()
            local psControllers=LP.PlayerScripts:WaitForChild("Controllers",15)
            local rsModules=ReplicatedStorage:WaitForChild("Modules",15)
            local cosmeticLib=SC2_waitModule(rsModules,"CosmeticLibrary",10)
            local itemLib=SC2_waitModule(rsModules,"ItemLibrary",10)
            local dataCtrl=SC2_waitModule(psControllers,"PlayerDataController",10)
            local enumLib=rsModules:FindFirstChild("EnumLibrary")
            if not cosmeticLib or not itemLib or not dataCtrl then error("Core modules not found") end
            SC2.CosmeticLibrary=require(cosmeticLib); SC2.ItemLibrary=require(itemLib)
            SC2.DataController=require(dataCtrl)
            if enumLib then
                SC2.EnumLibrary=require(enumLib)
                if SC2.EnumLibrary and SC2.EnumLibrary.WaitForEnumBuilder then
                    task.spawn(function() pcall(function() SC2.EnumLibrary:WaitForEnumBuilder() end) end)
                end
            end
            task.spawn(function()
                local fc=psControllers:FindFirstChild("FighterController")
                if fc then pcall(function() SC2.FighterController=require(fc) end) end
            end)
            SC2_applyOwnershipOverrides(); SC2_loadConfig()
            task.wait(1); SC2_applyRemoteHooks(); task.wait(2); SC2_applyViewModelHooks()
        end)
        sc2ApplyBusy=false
        if ok then
            SC2.applied=true
            Library:Notify("Skin Changer v2 applied — all cosmetics + weapons unlocked",5)
        else
            Library:Notify("Skin Changer v2 failed: "..tostring(err),5)
        end
    end)
end

local function SC2_equipCosmetic(weaponName,cosType,cosName,options)
    if not SC2.applied then Library:Notify("Apply Skin Changer v2 first",3); return false end
    SC2.equipped[weaponName]=SC2.equipped[weaponName] or {}
    if not cosName or cosName=="None" then
        SC2.equipped[weaponName][cosType]=nil
        if not next(SC2.equipped[weaponName]) then SC2.equipped[weaponName]=nil end
    else
        local cloned=SC2_cloneCosmetic(cosName,cosType,options or {})
        if cloned then SC2.equipped[weaponName][cosType]=cloned
        else Library:Notify("Cosmetic not found: "..cosName,3); return false end
    end
    task.spawn(function()
        task.wait(0.1)
        pcall(function() SC2.DataController.CurrentData:Replicate("WeaponInventory") end)
        SC2_saveConfig()
    end)
    Library:Notify("Equipped "..(cosName or "None").." on "..weaponName,3)
    return true
end

local function SC2_clearAll()
    SC2.equipped={}; SC2_saveConfig()
    pcall(function() SC2.DataController.CurrentData:Replicate("WeaponInventory") end)
    Library:Notify("All cosmetics cleared",3)
end


local weaponStatusApplied=false; local oldWeaponFunc=nil
local function applyWeaponStatus()
    if weaponStatusApplied then return end
    local hp = LP:FindFirstChild("PlayerScripts") and LP.PlayerScripts:FindFirstChild("Modules")
        and LP.PlayerScripts.Modules:FindFirstChild("WeaponStatusHandler")
    if not hp then return end
    local ok, WSH = pcall(require, hp); if not ok or not WSH then return end
    oldWeaponFunc = WSH.ApplyItemStatusToBackground
    WSH.ApplyItemStatusToBackground = function(self, background, stroke, status)
        background.BackgroundColor3=Color3.fromRGB(100,0,200)
        if stroke then stroke.Color=Color3.fromRGB(170,0,255); stroke.Thickness=2 end
        return oldWeaponFunc(self, background, stroke, "Banned")
    end
    weaponStatusApplied = true
end
local function removeWeaponStatus()
    if not weaponStatusApplied or not oldWeaponFunc then return end
    local hp = LP:FindFirstChild("PlayerScripts") and LP.PlayerScripts:FindFirstChild("Modules")
        and LP.PlayerScripts.Modules:FindFirstChild("WeaponStatusHandler")
    if not hp then return end
    local ok, WSH = pcall(require, hp)
    if ok and WSH then WSH.ApplyItemStatusToBackground=oldWeaponFunc end
    weaponStatusApplied = false
end


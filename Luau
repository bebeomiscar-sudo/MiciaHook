local MS_AC  = Tabs.Misc:AddLeftGroupbox("Auto Collect")
local MS_OOB = Tabs.Misc:AddLeftGroupbox("Anti Out Of Bounds")
local MS_RN  = Tabs.Misc:AddLeftGroupbox("RakNet Ping Spoof")

-- ESP SYSTEM
-- ═══════════════════════════════════════════
local function newDrawing(type, props)
    local d = Drawing.new(type)
    for k, v in pairs(props) do
        pcall(function() d[k] = v end)
    end
    return d
end

local function getOrCreateESP(p)
    if ESPObjects[p] then return ESPObjects[p] end
    local obj = {
        -- Box (4 lines: top, bottom, left, right)
        BoxTop    = newDrawing("Line",  { Thickness = 1.5, Visible = false, ZIndex = 5 }),
        BoxBottom = newDrawing("Line",  { Thickness = 1.5, Visible = false, ZIndex = 5 }),
        BoxLeft   = newDrawing("Line",  { Thickness = 1.5, Visible = false, ZIndex = 5 }),
        BoxRight  = newDrawing("Line",  { Thickness = 1.5, Visible = false, ZIndex = 5 }),
        -- Name
        NameLabel = newDrawing("Text",  { Size = 13, Center = true, Outline = true, OutlineColor = Color3.new(0,0,0), Visible = false, ZIndex = 6 }),
        -- Distance
        DistLabel = newDrawing("Text",  { Size = 11, Center = true, Outline = true, OutlineColor = Color3.new(0,0,0), Visible = false, ZIndex = 6 }),
        -- Health bar (background + fill)
        HealthBG  = newDrawing("Line",  { Thickness = 4, Visible = false, ZIndex = 4, Color = Color3.fromRGB(30, 30, 30) }),
        HealthFill= newDrawing("Line",  { Thickness = 3, Visible = false, ZIndex = 5 }),
    }
    ESPObjects[p] = obj
    return obj
end

local function removeESP(p)
    local obj = ESPObjects[p]
    if not obj then return end
    for _, d in pairs(obj) do
        pcall(function() d:Remove() end)
    end
    ESPObjects[p] = nil
end

local function hideESPObj(obj)
    for _, d in pairs(obj) do
        pcall(function() d.Visible = false end)
    end
end

local function getCharBounds(char)
    -- Returns screen-space bounding box: x, y, w, h
    local parts = { "Head", "UpperTorso", "LowerTorso",
                    "LeftUpperArm","RightUpperArm","LeftUpperLeg","RightUpperLeg",
                    "LeftLowerLeg","RightLowerLeg","HumanoidRootPart" }
    local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
    local anyOn = false
    for _, pn in ipairs(parts) do
        local part = char:FindFirstChild(pn)
        if part then
            local sp, on = camera:WorldToScreenPoint(part.Position)
            if on and sp.Z > 0 then
                anyOn = true
                minX = math.min(minX, sp.X)
                minY = math.min(minY, sp.Y)
                maxX = math.max(maxX, sp.X)
                maxY = math.max(maxY, sp.Y)
            end
        end
    end
    if not anyOn then return nil end
    -- Expand box a bit
    local pad = 6
    return minX - pad, minY - pad, maxX + pad, maxY + pad
end

local function updateESP(dt)
    if not ESPCFG.On then
        for p, _ in pairs(ESPObjects) do
            hideESPObj(ESPObjects[p])
        end
        return
    end

    if ESPCFG.Rainbow then
        espHue = (espHue + dt * 0.15) % 1
    end

    local camPos = camera.CFrame.Position

    for _, p in ipairs(Players:GetPlayers()) do
        if p == LP then continue end
        local obj  = getOrCreateESP(p)
        local char = p.Character
        local hum  = char and char:FindFirstChildOfClass("Humanoid")

        -- Basic validity checks
        if not char or not hum or hum.Health <= 0 then
            hideESPObj(obj); continue
        end
        if ESPCFG.TeamCheck and isSameTeam(p) then
            hideESPObj(obj); continue
        end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then hideESPObj(obj); continue end

        local dist = (camPos - hrp.Position).Magnitude
        if dist > ESPCFG.MaxDistance then hideESPObj(obj); continue end

        if ESPCFG.VisibleOnly and not isVisible(hrp) then
            hideESPObj(obj); continue
        end

        -- Get screen bounds
        local x1, y1, x2, y2 = getCharBounds(char)
        if not x1 then hideESPObj(obj); continue end

        local boxColor = ESPCFG.Rainbow
            and Color3.fromHSV(espHue, 1, 1)
            or ESPCFG.BoxColor
        local thick    = ESPCFG.BoxThickness

        -- Box
        local showBox = ESPCFG.Box
        obj.BoxTop.From    = Vector2.new(x1, y1); obj.BoxTop.To    = Vector2.new(x2, y1)
        obj.BoxBottom.From = Vector2.new(x1, y2); obj.BoxBottom.To = Vector2.new(x2, y2)
        obj.BoxLeft.From   = Vector2.new(x1, y1); obj.BoxLeft.To   = Vector2.new(x1, y2)
        obj.BoxRight.From  = Vector2.new(x2, y1); obj.BoxRight.To  = Vector2.new(x2, y2)
        for _, line in ipairs({ obj.BoxTop, obj.BoxBottom, obj.BoxLeft, obj.BoxRight }) do
            line.Color     = boxColor
            line.Thickness = thick
            line.Visible   = showBox
        end

        -- Name
        obj.NameLabel.Text     = p.Name
        obj.NameLabel.Color    = ESPCFG.NameColor
        obj.NameLabel.Size     = ESPCFG.TextSize
        obj.NameLabel.Position = Vector2.new((x1 + x2) / 2, y1 - ESPCFG.TextSize - 2)
        obj.NameLabel.Visible  = ESPCFG.Name

        -- Distance
        local distStr = string.format("[%d]", math.floor(dist))
        obj.DistLabel.Text     = distStr
        obj.DistLabel.Color    = ESPCFG.DistColor
        obj.DistLabel.Size     = ESPCFG.TextSize - 1
        obj.DistLabel.Position = Vector2.new((x1 + x2) / 2, y2 + 2)
        obj.DistLabel.Visible  = ESPCFG.Distance

        -- Health bar
        if ESPCFG.Health then
            local hp     = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
            local barH   = (y2 - y1) * hp
            local barX   = ESPCFG.HealthBarSide == "Left" and (x1 - 6) or (x2 + 6)
            local barBotY = y2
            local barTopY = y2 - (y2 - y1)
            local barFillTopY = y2 - barH

            -- Health color: green → yellow → red
            local hpColor = Color3.fromHSV(hp * 0.33, 1, 1)

            obj.HealthBG.From    = Vector2.new(barX, barBotY)
            obj.HealthBG.To      = Vector2.new(barX, barTopY)
            obj.HealthBG.Thickness = 4
            obj.HealthBG.Visible = true

            obj.HealthFill.From    = Vector2.new(barX, barBotY)
            obj.HealthFill.To      = Vector2.new(barX, barFillTopY)
            obj.HealthFill.Color   = hpColor
            obj.HealthFill.Thickness = 3
            obj.HealthFill.Visible = true
        else
            obj.HealthBG.Visible   = false
            obj.HealthFill.Visible = false
        end
    end

    -- Clean up objects for players who left
    for p, _ in pairs(ESPObjects) do
        if not p.Parent then
            removeESP(p)
        end
    end
end

Players.PlayerRemoving:Connect(function(p)
    removeESP(p)
    playerImmunity[p] = nil
end)


-- ═══════════════════════════════════════════
-- CORE RENDER STEP
-- ═══════════════════════════════════════════
RunService.RenderStepped:Connect(function(dt)
    camera = workspace.CurrentCamera
    local center = getScreenCenter()

    -- Crosshair
    if CFG.Crosshair.On then
        crosshairImg.Position = UDim2.new(0.5, 0, 0.5, 0)
    end

    -- Stretched resolution
    if StretchCFG.On then
        camera.CFrame = camera.CFrame
            * CFrame.new(0, 0, 0, 1, 0, 0, 0, StretchCFG.Scale, 0, 0, 0, 1)
    end

    -- ══ KICIA AIMBOT UPDATE ══
    kiciaUpdate(dt)

    -- ══ FOV CIRCLES ══
    if kiciaFovCircle then
        kiciaFovCircle.Position = center
        kiciaFovCircle.Radius   = KiciaCFG.MaxFOV
        kiciaFovCircle.Visible  = KiciaCFG.DrawFOV and KiciaCFG.On
    end
    if legacyFovCircle then
        legacyFovCircle.Position = center
        legacyFovCircle.Radius   = AimbotCFG.MaxFOV
        legacyFovCircle.Visible  = AimbotCFG.DrawFOV and AimbotCFG.On
    end
    if saFovCircle then
        saFovCircle.Position = center
        saFovCircle.Radius   = SAHookCFG.IgnoreFOV and 0 or saGetEffectiveFOV()
        saFovCircle.Visible  = SAHookCFG.DrawFOV and SAHookCFG.On and not SAHookCFG.IgnoreFOV
    end
    if trigFovCircle then
        trigFovCircle.Position = center
        trigFovCircle.Radius   = TrigCFG.FOVSize
        trigFovCircle.Visible  = TrigCFG.DrawFOV and TrigCFG.On
    end

    -- ══ LEGACY AIMBOT (PC ADS only) ══
    local shouldLegacyAim = AimbotCFG.On and (isADS or AimbotCFG.ToggleActive)
    if shouldLegacyAim and CameraController then
        if legacyInReaction then
            legacyReactionTimer = legacyReactionTimer - dt
            if legacyReactionTimer <= 0 then legacyInReaction = false end
        end
        if not legacyInReaction then
            if legacyLockedTarget and not legacyIsTargetValid(legacyLockedTarget) then
                legacyLockedTarget = nil; legacyLockTimer = 0
            end
            if not legacyLockedTarget then
                local newT = legacyFindTarget()
                if newT then
                    legacyLockedTarget  = newT
                    legacyLockTimer     = 0
                    legacyInReaction    = false
                end
            end
            if legacyLockedTarget then
                legacyLockTimer = legacyLockTimer + dt
                if legacyLockTimer > AimbotCFG.MaxLockTime then
                    legacyLockedTarget = nil; legacyLockTimer = 0
                else
                    legacyApplyMove(dt, legacyLockedTarget)
                end
            end
        end
    else
        if not shouldLegacyAim then
            legacyLockedTarget = nil; legacyLockTimer = 0; legacyInReaction = false
        end
    end

    -- ══ PC TRIGGERBOT ══
    if TrigCFG.On then
        local tgt = getTriggerTarget()
        if tgt then
            if not TrigState.waiting then
                TrigState.waiting = true
                TrigState.timer   = getTrigDelay()
                TrigState.grace   = TrigCFG.Grace / 1000
            end
            TrigState.timer = TrigState.timer - dt
            if TrigState.timer <= 0 then
                simClick()
                TrigState.waiting = false
                TrigState.timer   = 0
            end
        else
            if TrigState.waiting then
                TrigState.grace = TrigState.grace - dt
                if TrigState.grace <= 0 then
                    TrigState.waiting = false; TrigState.timer = 0; TrigState.grace = 0
                end
            end
        end
    else
        TrigState.waiting = false; TrigState.timer = 0; TrigState.grace = 0
    end

    -- ══ MOBILE TRIGGERBOT ══
    if IsMobile and MobileTrigCFG.On then
        local sf = MobileTrigCFG.AutoFire
            or (MobileTrigCFG.HoldToShoot and MobileTrigState.touching)
        if sf then
            local tgt = getMobileTrigTarget()
            if tgt then
                if not MobileTrigState.waiting then
                    MobileTrigState.waiting  = true
                    MobileTrigState.timer    = MobileTrigCFG.Delay / 1000
                    MobileTrigState.cooldown = 0
                end
                MobileTrigState.timer = MobileTrigState.timer - dt
                if MobileTrigState.timer <= 0 then
                    MobileTrigState.cooldown = MobileTrigState.cooldown - dt
                    if MobileTrigState.cooldown <= 0 then
                        simClick()
                        MobileTrigState.cooldown = MobileTrigCFG.BurstMs / 1000
                    end
                end
            else
                if not MobileTrigState.touching then
                    MobileTrigState.waiting = false; MobileTrigState.timer = 0; MobileTrigState.cooldown = 0
                end
            end
        else
            MobileTrigState.waiting = false; MobileTrigState.timer = 0; MobileTrigState.cooldown = 0
        end
    end

    -- ══ TRACER UPDATE ══
    local now  = tick()
    local life = TracerCFG.Duration
    local keep = {}
    for _, t in ipairs(activeTracers) do
        local age = now - t.Born
        if age < life and t.Line and t.Line.Parent then
            local hsp, hon = camera:WorldToViewportPoint(t.HitPos)
            if hon and hsp.Z > 0 then
                local sFrom = getTracerOrigin()
                local sTo   = Vector2.new(hsp.X, hsp.Y)
                local delta = sTo - sFrom
                local len   = delta.Magnitude
                if len >= 2 then
                    t.Line.Size      = UDim2.new(0, len, 0, TracerCFG.Thickness)
                    t.Line.Position  = UDim2.new(0, sFrom.X, 0, sFrom.Y)
                    t.Line.Rotation  = math.deg(math.atan2(delta.Y, delta.X))
                end
                t.Line.BackgroundTransparency = TracerCFG.Fade
                    and math.clamp(age / life, 0, 0.95) or 0
                t.Line.Visible = true
            else
                t.Line.Visible = false
            end
            table.insert(keep, t)
        else
            pcall(function() if t.Line then t.Line:Destroy() end end)
        end
    end
    activeTracers = keep

    -- ══ ESP UPDATE ══
    updateESP(dt)
end)


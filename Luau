local PART_PRESETS = {
    ["Head"]             = {"Head"},
    ["HumanoidRootPart"] = {"HumanoidRootPart"},
    ["Torso"]            = {"Torso","UpperTorso","LowerTorso","HumanoidRootPart"},
    ["UpperTorso"]       = {"UpperTorso","Torso","LowerTorso","HumanoidRootPart"},
    ["LowerTorso"]       = {"LowerTorso","Torso","UpperTorso","HumanoidRootPart"},
    ["Body"]             = {"UpperTorso","LowerTorso","Torso","HumanoidRootPart"},
    ["Head, Body"]       = {"Head","UpperTorso","LowerTorso","Torso","HumanoidRootPart"},
    ["Body, Head"]       = {"UpperTorso","LowerTorso","Torso","HumanoidRootPart","Head"},
    ["Random"]           = {"Random"},
}

local ALL_TARGET_OPTIONS = {
    "Head","HumanoidRootPart","Torso","UpperTorso","LowerTorso",
    "Body","Head, Body","Body, Head","Random"
}

local function getBestPart(char, setting)
    local preset = PART_PRESETS[setting] or {"Head"}
    if preset[1] == "Random" then
        local avail = {}
        for _, n in ipairs(ALL_PARTS) do
            local p = char:FindFirstChild(n)
            if p then table.insert(avail, p) end
        end
        return #avail > 0 and avail[math.random(1, #avail)] or nil
    end
    for _, n in ipairs(preset) do
        local p = char:FindFirstChild(n)
        if p then return p end
    end
    for _, n in ipairs(ALL_PARTS) do
        local p = char:FindFirstChild(n)
        if p then return p end
    end
    return nil
end


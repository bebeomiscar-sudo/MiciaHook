-- GUN PATCH
local gunOriginals = {}
local function patchGun()
    local ok, Items = pcall(function()
        return require(ReplicatedStorage.Modules.ItemLibrary).Items
    end)
    if not ok or not Items then return end
    local ex = { Sniper = true, Crossbow = true, Bow = true, RPG = true }
    for name, data in pairs(Items) do
        if typeof(data) ~= "table" or ex[name] then continue end
        if not gunOriginals[name] then
            gunOriginals[name] = {
                ShootSpread        = data.ShootSpread,
                ShootAccuracy      = data.ShootAccuracy,
                ShootRecoil        = data.ShootRecoil,
                ShootCooldown      = data.ShootCooldown,
                ShootBurstCooldown = data.ShootBurstCooldown,
            }
        end
        if GunCFG.NoSpread then
            if data.ShootSpread   then data.ShootSpread   = 0 end
            if data.ShootAccuracy then data.ShootAccuracy = 0 end
        else
            if data.ShootSpread   then data.ShootSpread   = gunOriginals[name].ShootSpread   end
            if data.ShootAccuracy then data.ShootAccuracy = gunOriginals[name].ShootAccuracy end
        end
        if GunCFG.NoRecoil then
            if data.ShootRecoil then data.ShootRecoil = 0 end
        else
            if data.ShootRecoil then data.ShootRecoil = gunOriginals[name].ShootRecoil end
        end
        if GunCFG.FastShoot then
            if data.ShootCooldown      then data.ShootCooldown      = 0.05 end
            if data.ShootBurstCooldown then data.ShootBurstCooldown = 0.05 end
        else
            if data.ShootCooldown      then data.ShootCooldown      = gunOriginals[name].ShootCooldown      end
            if data.ShootBurstCooldown then data.ShootBurstCooldown = gunOriginals[name].ShootBurstCooldown end
        end
    end
end

-- IMMUNITY DETECTION
local function isPlayerImmune(p)
    if not ImmunityCFG.Enabled then return false end
    local data = playerImmunity[p]
    if data and data.forceShield then return true end
    local char = p.Character
    if char then
        if char:FindFirstChildOfClass("ForceField") then return true end
        for _, obj in ipairs(char:GetDescendants()) do
            local n = obj.Name:lower()
            if n == "shield" or n:find("immune") or n:find("protect") then
                if obj:IsA("BasePart") or obj:IsA("SelectionBox") or obj:IsA("ParticleEmitter") then
                    return true
                end
            end
        end
    end
    if data then
        local elapsed = tick() - data.spawnTime
        if elapsed < ImmunityCFG.SpawnProtectionTime then return true end
    end
    return false
end

local function hookPlayerImmunity(p)
    if p == LP then return end
    local function onCharAdded(char)
        playerImmunity[p] = { spawnTime = tick(), forceShield = false, lastMaxHealth = 0 }
        if char:FindFirstChildOfClass("ForceField") then
            playerImmunity[p].forceShield = true
        end
        char.ChildAdded:Connect(function(child)
            if child:IsA("ForceField") and playerImmunity[p] then
                playerImmunity[p].forceShield = true
            end
        end)
        char.ChildRemoved:Connect(function(child)
            if child:IsA("ForceField") and playerImmunity[p] then
                playerImmunity[p].forceShield = false
            end
        end)
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            playerImmunity[p].lastMaxHealth = hum.MaxHealth
            hum:GetPropertyChangedSignal("MaxHealth"):Connect(function()
                if not playerImmunity[p] then return end
                local prev = playerImmunity[p].lastMaxHealth
                local curr = hum.MaxHealth
                if curr > 10000 and prev > 0 and curr > prev * 5 then
                    playerImmunity[p].forceShield = true
                end
                playerImmunity[p].lastMaxHealth = curr
            end)
        end
    end
    if p.Character then
        task.spawn(function() task.wait(0.1); onCharAdded(p.Character) end)
    end
    p.CharacterAdded:Connect(function(char) task.wait(0.1); onCharAdded(char) end)
end


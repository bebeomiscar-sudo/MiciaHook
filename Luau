-- Toggle (checkbox style like KiciaHook)
local function mkToggle(col, txt, default, cb)
    local row = Instance.new("Frame", col)
    row.Size             = UDim2.new(1, -8, 0, 20)
    row.BackgroundTransparency = 1

    local box = Instance.new("Frame", row)
    box.Size             = UDim2.fromOffset(14, 14)
    box.Position         = UDim2.fromOffset(0, 3)
    box.BackgroundColor3 = default and UI_CLR.check_on or UI_CLR.check_off
    box.BorderSizePixel  = 0
    local bc = Instance.new("UICorner", box)
    bc.CornerRadius = UDim.new(0, 2)

    local lbl = Instance.new("TextLabel", row)
    lbl.Size             = UDim2.new(1, -20, 1, 0)
    lbl.Position         = UDim2.fromOffset(20, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text             = txt
    lbl.TextColor3       = default and UI_CLR.text or UI_CLR.text_dim
    lbl.TextSize         = 12
    lbl.Font             = Enum.Font.Gotham
    lbl.TextXAlignment   = Enum.TextXAlignment.Left

    local val = default or false
    local btn = Instance.new("TextButton", row)
    btn.Size             = UDim2.new(1, 0, 1, 0)
    btn.BackgroundTransparency = 1
    btn.Text             = ""

    local function set(v)
        val = v
        box.BackgroundColor3 = v and UI_CLR.check_on or UI_CLR.check_off
        lbl.TextColor3       = v and UI_CLR.text or UI_CLR.text_dim
        pcall(cb, v)
    end

    btn.MouseButton1Click:Connect(function() set(not val) end)
    set(default or false)

    return row, function(v) set(v) end, function() return val end
end

-- Slider (KiciaHook style: shows current/max on right)
local function mkSlider(col, txt, min, max, default, rnd, cb)
    local wrap = Instance.new("Frame", col)
    wrap.Size             = UDim2.new(1, -8, 0, 36)
    wrap.BackgroundTransparency = 1

    local header = Instance.new("Frame", wrap)
    header.Size             = UDim2.new(1, 0, 0, 16)
    header.BackgroundTransparency = 1

    local lbl = Instance.new("TextLabel", header)
    lbl.Size             = UDim2.new(0.7, 0, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text             = txt
    lbl.TextColor3       = UI_CLR.text
    lbl.TextSize         = 12
    lbl.Font             = Enum.Font.Gotham
    lbl.TextXAlignment   = Enum.TextXAlignment.Left

    local valLbl = Instance.new("TextLabel", header)
    valLbl.Size            = UDim2.new(0.3, 0, 1, 0)
    valLbl.Position        = UDim2.new(0.7, 0, 0, 0)
    valLbl.BackgroundTransparency = 1
    valLbl.TextColor3      = UI_CLR.text_dim
    valLbl.TextSize        = 11
    valLbl.Font            = Enum.Font.Gotham
    valLbl.TextXAlignment  = Enum.TextXAlignment.Right

    local track = Instance.new("Frame", wrap)
    track.Size             = UDim2.new(1, 0, 0, 6)
    track.Position         = UDim2.fromOffset(0, 18)
    track.BackgroundColor3 = UI_CLR.slider_bg
    track.BorderSizePixel  = 0
    local tc2 = Instance.new("UICorner", track)
    tc2.CornerRadius = UDim.new(0, 3)

    local fill = Instance.new("Frame", track)
    fill.Size             = UDim2.new(0, 0, 1, 0)
    fill.BackgroundColor3 = UI_CLR.accent
    fill.BorderSizePixel  = 0
    local fc = Instance.new("UICorner", fill)
    fc.CornerRadius = UDim.new(0, 3)

    local val = default
    local dragging = false

    local function updateVal(v)
        v = math.clamp(v, min, max)
        if rnd then
            v = math.floor(v / rnd + 0.5) * rnd
        else
            v = math.floor(v + 0.5)
        end
        val = v
        local pct = (v - min) / (max - min)
        fill.Size = UDim2.new(pct, 0, 1, 0)
        valLbl.Text = tostring(v) .. "/" .. tostring(max)
        pcall(cb, v)
    end

    local btn = Instance.new("TextButton", track)
    btn.Size             = UDim2.new(1, 0, 1, 20)
    btn.Position         = UDim2.fromOffset(0, -7)
    btn.BackgroundTransparency = 1
    btn.Text             = ""

    btn.MouseButton1Down:Connect(function()
        dragging = true
    end)
    uis.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    rs.RenderStepped:Connect(function()
        if dragging then
            local mx    = uis:GetMouseLocation().X
            local tx    = track.AbsolutePosition.X
            local tw    = track.AbsoluteSize.X
            local pct   = math.clamp((mx - tx) / tw, 0, 1)
            updateVal(min + (max - min) * pct)
        end
    end)

    updateVal(default)

    return wrap, function(v) updateVal(v) end, function() return val end
end

-- Dropdown
local function mkDropdown(col, txt, vals, default, cb)
    local wrap = Instance.new("Frame", col)
    wrap.Size             = UDim2.new(1, -8, 0, 38)
    wrap.BackgroundTransparency = 1

    local lbl = Instance.new("TextLabel", wrap)
    lbl.Size             = UDim2.new(1, 0, 0, 16)
    lbl.BackgroundTransparency = 1
    lbl.Text             = txt
    lbl.TextColor3       = UI_CLR.text
    lbl.TextSize         = 12
    lbl.Font             = Enum.Font.Gotham
    lbl.TextXAlignment   = Enum.TextXAlignment.Left

    local btn = Instance.new("TextButton", wrap)
    btn.Size             = UDim2.new(1, 0, 0, 20)
    btn.Position         = UDim2.fromOffset(0, 18)
    btn.BackgroundColor3 = UI_CLR.tab_bg
    btn.BorderSizePixel  = 0
    btn.Text             = default or vals[1]
    btn.TextColor3       = UI_CLR.text
    btn.TextSize         = 12
    btn.Font             = Enum.Font.Gotham
    local bc2 = Instance.new("UICorner", btn)
    bc2.CornerRadius = UDim.new(0, 3)

    -- Dropdown list (simple version)
    local listFrame = Instance.new("Frame", GUI) -- parented to GUI so it overlays
    listFrame.Size             = UDim2.fromOffset(200, #vals * 22 + 4)
    listFrame.BackgroundColor3 = UI_CLR.tab_bg
    listFrame.BorderSizePixel  = 0
    listFrame.Visible          = false
    listFrame.ZIndex           = 10
    local lfc = Instance.new("UICorner", listFrame)
    lfc.CornerRadius = UDim.new(0, 4)
    local lfs = Instance.new("UIStroke", listFrame)
    lfs.Color     = UI_CLR.border
    lfs.Thickness = 1
    local lfl = Instance.new("UIListLayout", listFrame)
    lfl.SortOrder = Enum.SortOrder.LayoutOrder
    local lp3 = Instance.new("UIPadding", listFrame)
    lp3.PaddingTop  = UDim.new(0, 2)
    lp3.PaddingLeft = UDim.new(0, 2)

    local open = false
    local cur  = default or vals[1]

    local function closeList()
        open = false
        listFrame.Visible = false
    end

    for _, v in ipairs(vals) do
        local item = Instance.new("TextButton", listFrame)
        item.Size             = UDim2.new(1, -4, 0, 20)
        item.BackgroundColor3 = UI_CLR.tab_bg
        item.BorderSizePixel  = 0
        item.Text             = v
        item.TextColor3       = v == cur and UI_CLR.accent or UI_CLR.text
        item.TextSize         = 12
        item.Font             = Enum.Font.Gotham
        item.ZIndex           = 11
        item.MouseButton1Click:Connect(function()
            cur      = v
            btn.Text = v
            for _, c in ipairs(listFrame:GetChildren()) do
                if c:IsA("TextButton") then
                    c.TextColor3 = c.Text == v and UI_CLR.accent or UI_CLR.text
                end
            end
            closeList()
            pcall(cb, v)
        end)
    end

    btn.MouseButton1Click:Connect(function()
        open = not open
        if open then
            local ap = btn.AbsolutePosition
            listFrame.Position = UDim2.fromOffset(ap.X, ap.Y + 22)
            listFrame.Size     = UDim2.fromOffset(btn.AbsoluteSize.X, #vals * 22 + 4)
            listFrame.Visible  = true
        else
            closeList()
        end
    end)

    -- Close when clicking elsewhere
    GUI.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            if open then
                task.defer(function()
                    if not listFrame:IsDescendantOf(GUI) then return end
                    closeList()
                end)
            end
        end
    end)

    pcall(cb, cur)
    return wrap, function(v)
        cur = v; btn.Text = v; pcall(cb, v)
    end, function() return cur end
end


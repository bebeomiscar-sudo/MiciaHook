-- ═══════════════════════════════════════════
-- CORE RENDER STEP (Aimbot + Triggerbot + Crosshair + FOV)
-- ═══════════════════════════════════════════
table.insert(ActiveConnections, RunService.RenderStepped:Connect(function(dt)
    camera = workspace.CurrentCamera
    local center = getScreenCenter()

    -- Crosshair
    if CFG.Crosshair.On then crosshairImg.Position = UDim2.new(0.5,0,0.5,0) end

    -- FOV circle
    if fovCircle then
        fovCircle.Position = center
        fovCircle.Radius   = AimbotCFG.MaxFOV
        fovCircle.Visible  = AimbotCFG.DrawFOV and AimbotCFG.On
    end

    -- ═══ AIMBOT ═══
    if AimbotCFG.On and CameraController then
        -- Reaction time gate
        if isInReaction then
            reactionTimer = reactionTimer - dt
            if reactionTimer <= 0 then isInReaction = false end
        end

        if not isInReaction then
            local tp = getAimbotTarget()

            -- Reset on target change
            if tp ~= lockedTarget then
                lockedTarget = tp; lockTimer = 0
                if tp then isInReaction = true; reactionTimer = AimbotCFG.ReactionTime / 1000 end
            end

            if tp and lockedTarget then
                lockTimer = lockTimer + dt
                if lockTimer > AimbotCFG.MaxLockTime then
                    lockedTarget = nil; lockTimer = 0
                else
                    -- Speed: normal vs in-attack
                    local isAttacking = false
                    pcall(function()
                        if fighter_mod and fighter_mod.LocalFighter then
                            isAttacking = fighter_mod.LocalFighter:Get("IsShooting") == true
                        end
                    end)
                    local speed = isAttacking and AimbotCFG.SpeedInAttack or AimbotCFG.Speed

                    -- Scale speed by FOV distance
                    local sp2, on2 = camera:WorldToScreenPoint(tp.Position)
                    if on2 then
                        local screenDist = (Vector2.new(sp2.X, sp2.Y) - center).Magnitude
                        local fovR       = getEffectiveFOV()
                        if fovR > 0 then
                            local scaleFactor = 1 - ((screenDist / fovR) * (AimbotCFG.SpeedScaleFOV / 100))
                            speed = speed * math.max(0.1, scaleFactor)
                        end
                    end

                    pcall(function()
                        local cp  = camera.CFrame.Position
                        local du  = (tp.Position - cp).Unit
                        local tP  = math.asin(du.Y)
                        local tY  = math.atan2(-du.X, -du.Z)
                        local sm  = math.clamp(speed / 5, 0, 1)
                        local cur = CameraController.Rotation
                        CameraController:SetRotation(Vector2.new(
                            cur.X + (tP - cur.X) * sm,
                            cur.Y + angleDiff(cur.Y, tY) * sm
                        ))
                    end)
                end
            end
        end
    end

    -- ═══ TRIGGERBOT ═══
    if TrigCFG.On then
        local tgt = getTriggerTarget()
        if tgt then
            if not TrigState.waiting then
                TrigState.waiting = true
                TrigState.timer   = getTrigDelay()
                TrigState.grace   = TrigCFG.Grace / 1000
            end
            TrigState.timer = TrigState.timer - dt
            if TrigState.timer <= 0 then
                simClick(); TrigState.waiting = false; TrigState.timer = 0
            end
        else
            -- Grace period
            if TrigState.waiting then
                TrigState.grace = TrigState.grace - dt
                if TrigState.grace <= 0 then
                    TrigState.waiting=false; TrigState.timer=0; TrigState.grace=0
                end
            end
        end
    else
        TrigState.waiting=false; TrigState.timer=0; TrigState.grace=0
    end

    -- Watermark
    watermark:SetText("Rivals Tool v9.3 | "..(AimbotCFG.On and "AIM " or "")..(silentActive and "RAGE " or "")..(TrigCFG.On and "TRIG" or ""))
end))

-- ═══════════════════════════════════════════
-- CORE HEARTBEAT (Orbit + Voidspam + AutoCollect)
-- ═══════════════════════════════════════════
local orbitAngle = 0

table.insert(ActiveConnections, RunService.Heartbeat:Connect(function(dt)

    -- Auto Collect
    local char = LP.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChild("Humanoid")
        if hrp then
            local needsHealth = hum and hum.Health < hum.MaxHealth
            for _, obj in workspace:GetChildren() do
                if obj.Name == "_drop" and obj:IsA("BasePart") then
                    if (CFG.Collect.Health and obj:FindFirstChild("Health") and needsHealth)
                    or (CFG.Collect.Ammo and obj:FindFirstChild("Ammo")) then
                        pcall(function() firetouchinterest(hrp,obj,0); firetouchinterest(hrp,obj,1) end)
                    end
                end
            end
        end
    end

    -- Orbit
    if CFG.Orbit.On and not Desync.active and CFG.OrbitTarget then
        local mc = LP.Character
        if mc then
            local mr = mc:FindFirstChild("HumanoidRootPart")
            local tc = CFG.OrbitTarget.Character
            if mr and tc then
                local tr = tc:FindFirstChild("HumanoidRootPart")
                local mh = mc:FindFirstChildOfClass("Humanoid")
                if tr and mh and mh.Health > 0 then
                    orbitAngle = orbitAngle + (CFG.Orbit.Speed * dt)
                    if orbitAngle > math.pi*2 then orbitAngle = orbitAngle - math.pi*2 end
                    local tp = tr.Position
                    mr.CFrame = CFrame.new(
                        tp + Vector3.new(math.cos(orbitAngle)*CFG.Orbit.Radius, CFG.Orbit.Height, math.sin(orbitAngle)*CFG.Orbit.Radius),
                        tp
                    )
                end
            end
        end
    end

    -- Voidspam
    if not Desync.active then return end
    if not humanoidRootPart or not humanoidRootPart.Parent then Desync.active=false; return end
    local hum2 = character:FindFirstChildOfClass("Humanoid")
    if not hum2 or hum2.Health <= 0 then
        if Desync.realCFrame then humanoidRootPart.CFrame = Desync.realCFrame end
        Desync.active=false; Desync.phase="idle"; Desync.currentDepth=0; return
    end

    Desync.realCFrame  = humanoidRootPart.CFrame
    Desync.phaseTimer  = Desync.phaseTimer + dt

    if Desync.phase == "hide" then
        Desync.currentDepth = math.min(Desync.currentDepth + CFG.Void.StepSpeed, CFG.Void.VoidDepth)
        if Desync.phaseTimer >= CFG.Void.HideTime then
            Desync.phase="attack"; Desync.phaseTimer=0; Desync.shotsFired=0; Desync.shotCooldown=0
        end
    elseif Desync.phase == "attack" then
        Desync.currentDepth = math.max(Desync.currentDepth - CFG.Void.StepSpeed*3, 0)
        Desync.projCheckCD = Desync.projCheckCD + 1
        if Desync.projCheckCD >= 3 then
            Desync.projCheckCD = 0
            if checkProjectiles() then Desync.phase="hide"; Desync.phaseTimer=0; Desync.totalCycles=Desync.totalCycles+1 end
        end
        if Desync.phase=="attack" and Desync.currentDepth<=2 and CFG.Void.AutoFire then
            Desync.shotCooldown = Desync.shotCooldown - dt
            if Desync.shotsFired < CFG.Void.ShootAttempt and Desync.shotCooldown <= 0 then
                simClick(); Desync.shotsFired=Desync.shotsFired+1; Desync.shotCooldown=0.05
            end
        end
        if Desync.phase=="attack" and Desync.phaseTimer >= CFG.Void.AttackTime then
            Desync.phase="hide"; Desync.phaseTimer=0; Desync.totalCycles=Desync.totalCycles+1
        end
    end

    if Desync.currentDepth > 0 then
        local rp  = Desync.realCFrame.Position
        local rot = Desync.realCFrame - rp
        humanoidRootPart.CFrame = CFrame.new(Vector3.new(rp.X, rp.Y - Desync.currentDepth, rp.Z)) * rot
    end
end))


-- ═══════════════════════════════════════════
local function getWeaponType(item)
    if not item then return "unknown" end
    local itemData = nil
    pcall(function() itemData = item:Get("ItemData") or item.ItemData end)
    if not itemData then
        local name = ""; pcall(function() name = item:Get("Name") or item.Name or "" end)
        local autoW = {["Assault Rifle"]=true,["SMG"]=true,["Minigun"]=true,["Flamethrower"]=true,["Freeze Ray"]=true}
        local semiW = {["Pistol"]=true,["Revolver"]=true,["Shotgun"]=true,["Sniper"]=true,["Crossbow"]=true,["Bow"]=true,["RPG"]=true}
        if autoW[name] then return "automatic" end
        if semiW[name] then return "semi" end
        return "unknown"
    end
    if itemData.ShootCooldown then
        return itemData.ShootCooldown < 0.1 and "automatic" or "semi"
    end
    return "unknown"
end

local function isPlayerValidForTrigger(target)
    if not target then return false end
    local char = target.Character; if not char then return false end
    local hum  = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    if TriggerbotCFG.TeamCheck and isSameTeamRivals(target) then return false end
    local part = getBestPart(char, TriggerbotCFG.TargetPart); if not part then return false end
    if TriggerbotCFG.VisibleCheck and not isVisible(camera.CFrame.Position, part) then return false end
    if (camera.CFrame.Position - part.Position).Magnitude > TriggerbotCFG.MaxDistance then return false end
    return true, part
end

local function fireWeapon(item, weaponType)
    if not item then return end
    pcall(function()
        if item.StartShooting then item:StartShooting() end
        if item.Shoot then
            if weaponType == "automatic" then
                if not isFiring then
                    isFiring = true
                    task.spawn(function()
                        while isFiring and TriggerbotCFG.On do
                            pcall(function()
                                item:Shoot()
                                rs.Remotes.Replication.Fighter.UseItem:FireServer(
                                    item:Get("ObjectID"), enums_mod and enums_mod:ToEnum("StartShooting") or 1, {}, nil)
                            end)
                            task.wait(0.05)
                        end
                    end)
                end
            else
                for _ = 1, TriggerbotCFG.BurstCount do item:Shoot(); task.wait(0.05) end
            end
        elseif item.Fire then item:Fire() end
        local objectId = nil; pcall(function() objectId = item:Get("ObjectID") end)
        if objectId and enums_mod then
            rs.Remotes.Replication.Fighter.UseItem:FireServer(objectId, enums_mod:ToEnum("StartShooting"), {}, nil)
            if weaponType == "automatic" and TriggerbotCFG.AutoFire then
                task.spawn(function()
                    local st = tick()
                    while tick()-st < 0.3 and TriggerbotCFG.On do
                        rs.Remotes.Replication.Fighter.UseItem:FireServer(objectId, enums_mod:ToEnum("Shooting"), {}, nil)
                        task.wait(0.05)
                    end
                    rs.Remotes.Replication.Fighter.UseItem:FireServer(objectId, enums_mod:ToEnum("StopShooting"), {}, nil)
                end)
            else
                task.wait(0.05)
                rs.Remotes.Replication.Fighter.UseItem:FireServer(objectId, enums_mod:ToEnum("StopShooting"), {}, nil)
            end
        end
    end)
end

local function stopFiring(item)
    isFiring = false
    pcall(function()
        if item and item.StopShooting then item:StopShooting() end
        local objectId = nil; pcall(function() objectId = item:Get("ObjectID") end)
        if objectId and enums_mod then
            rs.Remotes.Replication.Fighter.UseItem:FireServer(objectId, enums_mod:ToEnum("StopShooting"), {}, nil)
        end
    end)
end

local function startTriggerbot()
    if triggerbotConn then triggerbotConn:Disconnect() end
    triggerbotConn = RunService.Heartbeat:Connect(function()
        if not TriggerbotCFG.On then
            if isFiring then
                pcall(function()
                    if fighter_mod and fighter_mod.LocalFighter and fighter_mod.LocalFighter.EquippedItem then
                        stopFiring(fighter_mod.LocalFighter.EquippedItem)
                    end
                end)
            end; return
        end
        if not LP.Character or not LP.Character:FindFirstChild("HumanoidRootPart") then return end
        local myHum = LP.Character:FindFirstChildOfClass("Humanoid")
        if not myHum or myHum.Health <= 0 then return end
        local equippedItem = nil; local weaponType = "unknown"
        pcall(function()
            if fighter_mod and fighter_mod.LocalFighter then
                equippedItem = fighter_mod.LocalFighter.EquippedItem
                weaponType   = getWeaponType(equippedItem)
            end
        end)
        local rp = RaycastParams.new()
        rp.FilterType = Enum.RaycastFilterType.Exclude
        rp.FilterDescendantsInstances = {LP.Character}; rp.IgnoreWater = true
        local result  = Workspace:Raycast(camera.CFrame.Position, camera.CFrame.LookVector * TriggerbotCFG.MaxDistance, rp)
        local shouldFire = false
        if result then
            local hm = result.Instance:FindFirstAncestorOfClass("Model")
            if hm then
                local hp = Players:GetPlayerFromCharacter(hm)
                if hp and hp ~= LP then
                    local valid, tp = isPlayerValidForTrigger(hp)
                    if valid then
                        local sp, on = camera:WorldToViewportPoint(tp.Position)
                        if on and (Vector2.new(sp.X,sp.Y)-getScreenCenter()).Magnitude < 50 then
                            shouldFire = true
                        end
                    end
                end
            end
        end
        if shouldFire then
            local ct = tick()
            if (ct - lastTriggerTime) * 1000 >= TriggerbotCFG.Delay then
                lastTriggerTime = ct
                if equippedItem then fireWeapon(equippedItem, weaponType) end
            end
        else
            if isFiring and equippedItem then stopFiring(equippedItem) end
        end
    end)
end

local function stopTriggerbot()
    if triggerbotConn then triggerbotConn:Disconnect(); triggerbotConn = nil end
    if isFiring then
        pcall(function()
            if fighter_mod and fighter_mod.LocalFighter and fighter_mod.LocalFighter.EquippedItem then
                stopFiring(fighter_mod.LocalFighter.EquippedItem)
            end
        end)
    end
    isFiring = false
end


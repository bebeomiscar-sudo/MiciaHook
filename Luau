local function IsAlive(player)
    if not player or not player.Character then return false end
    local h = player.Character:FindFirstChildOfClass("Humanoid")
    return h and h.Health > 0
end

local function isSameTeamRivals(p)
    local same = false
    pcall(function()
        local mi = LP:GetAttribute("TeamID")
        local ti = p:GetAttribute("TeamID")
        if mi ~= nil and ti ~= nil then same = (mi == ti) end
    end)
    if not same then
        pcall(function()
            same = p.Team ~= nil and LP.Team ~= nil and p.Team == LP.Team
        end)
    end
    return same
end

local function isVisible(origin, targetPart)
    if not targetPart then return false end
    local ok, r = pcall(function()
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = {LP.Character, targetPart.Parent}
        local hit = Workspace:Raycast(origin, targetPart.Position - origin, params)
        return hit == nil or hit.Instance:IsDescendantOf(targetPart.Parent)
    end)
    return ok and r or false
end

local function getScreenCenter()
    return Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
end

local function angleDiff(f, t)
    local d = t - f
    return ((d + math.pi) % (math.pi * 2)) - math.pi
end

local function isInShootingRange(player)
    if not player then return false end
    local ok, v = pcall(function()
        if FighterCtrl and FighterCtrl.LocalFighter then
            if player == LP then
                return FighterCtrl.LocalFighter:Get("IsInShootingRange")
            end
            local f = FighterCtrl:GetFighter(player)
            if f then return f:Get("IsInShootingRange") end
        end
        return false
    end)
    return ok and v or false
end


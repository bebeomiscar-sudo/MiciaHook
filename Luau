local function makeKeybind(parent, label, defaultKeyName, order, onChanged)
    local currentKey = defaultKeyName or "None"
    local listening = false
    local f=make("Frame",{Size=UDim2.new(1,0,0,TOGGLE_H),BackgroundColor3=C.elem,BorderSizePixel=0,LayoutOrder=order,Visible=not IsMobile,Parent=parent})
    make("UICorner",{CornerRadius=UDim.new(0,s(3)),Parent=f})
    make("TextLabel",{Size=UDim2.new(1,-s(90),1,0),Position=UDim2.new(0,s(12),0,0),BackgroundTransparency=1,Text=label,TextColor3=C.text,Font=Enum.Font.Gotham,TextSize=FONT_MAIN,TextXAlignment=Enum.TextXAlignment.Left,TextTruncate=Enum.TextTruncate.AtEnd,Parent=f})
    local keyBtn=make("TextButton",{Size=UDim2.new(0,s(70),0,s(24)),Position=UDim2.new(1,-s(78),0.5,-s(12)),BackgroundColor3=C.border,BorderSizePixel=0,Text=formatKeyName(currentKey),TextColor3=C.text,Font=Enum.Font.GothamBold,TextSize=FONT_SMALL,Parent=f})
    make("UICorner",{CornerRadius=UDim.new(0,s(4)),Parent=keyBtn})
    local listenConn = nil
    keyBtn.MouseButton1Click:Connect(function()
        if listening then return end
        listening = true; keyBtn.Text = "..."; keyBtn.BackgroundColor3 = C.accent
        listenConn = UIS.InputBegan:Connect(function(input, gp)
            if input.UserInputType == Enum.UserInputType.Keyboard then
                currentKey = input.KeyCode == Enum.KeyCode.Escape and "None" or input.KeyCode.Name
            elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
                currentKey = "MouseButton2"
            elseif input.UserInputType == Enum.UserInputType.MouseButton3 then
                currentKey = "MouseButton3"
            else return end
            keyBtn.Text = formatKeyName(currentKey); keyBtn.BackgroundColor3 = C.border
            listening = false; if listenConn then listenConn:Disconnect(); listenConn=nil end
            if onChanged then onChanged(currentKey) end
        end)
    end)
    return {getKey=function() return currentKey end, setKey=function(k) currentKey=k; keyBtn.Text=formatKeyName(k) end}
end


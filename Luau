local function startSilentAim()
    if silentConn then silentConn:Disconnect() end
    silentConn=RunService.Heartbeat:Connect(function(dt)
        if not silentActive or not LP.Character then return end
        if not LP.Character:FindFirstChild("HumanoidRootPart") then return end
        if not fighter_mod or not fighter_mod.LocalFighter then return end
        local item=fighter_mod.LocalFighter.EquippedItem; if not item then return end
        reloadCooldown=reloadCooldown-dt
        local ammo=nil; pcall(function() ammo=item:Get("CurrentAmmo") end)
        if ammo~=nil and ammo<=0 and reloadCooldown<=0 then
            tryRagebotReload(item); reloadCooldown=2.0; return
        end
        local tp,tc=sa_getClosest(); if not tp or not tc then return end
        local cam=ws_sa.CurrentCamera.CFrame
        local manip,height=sa_calcPoint(cam.Position,tp.Position,tc)
        if not manip then return end
        local sp=(height==nil and manip) or cam.Position; local cd={}
        cd[utf8.char(1)]={
            [utf8.char(0)]=util_mod:EncodeCFrame(
                CFrame.new(sp.X,sp.Y+(height or 0),sp.Z)
                *CFrame.Angles(CFrame.lookAt(sp,tp.Position):ToOrientation())),
            [utf8.char(1)]=height and
                util_mod:EncodeCFrame(CFrame.new(tp.Position)*CFrame.Angles(CFrame.lookAt(sp,tp.Position):ToOrientation())) or
                util_mod:EncodeCFrame(CFrame.new(sp.X,sp.Y+(height or 0),sp.Z)*CFrame.Angles(CFrame.lookAt(sp,tp.Position):ToOrientation())),
            [utf8.char(2)]=tp,
            [utf8.char(3)]=util_mod:EncodeCFrame(tp.CFrame:ToObjectSpace(CFrame.new(tp.Position))),
        }
        pcall(function()
            rs_sa.Remotes.Replication.Fighter.UseItem:FireServer(
                item:Get("ObjectID"),enums_mod:ToEnum("StartShooting"),cd,nil)
        end)
    end)
end


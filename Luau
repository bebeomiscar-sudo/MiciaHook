--[[
    FRAME CYCLE — HOW THE DESYNC WORKS:
    
    ┌─────────────────────────────────────────────────┐
    │ WITHIN EACH FRAME:                               │
    │                                                   │
    │ 1. [RenderStep priority 199]                     │
    │    Set HRP → realCFrame                          │
    │    Camera follows HRP at real position            │
    │    YOU SEE: yourself standing normally            │
    │                                                   │
    │ 2. [Rendering happens]                           │
    │    Character model draws at real position         │
    │    Your screen shows normal gameplay              │
    │                                                   │
    │ 3. [Physics simulation]                          │
    │    HRP is at realCFrame                          │
    │    Movement controller works normally             │
    │    WASD/joystick movement applies                 │
    │                                                   │
    │ 4. [Heartbeat - after physics]                   │
    │    Read HRP position (has movement applied)      │
    │    Save as new realCFrame                        │
    │    Set HRP → underground position                │
    │    SERVER RECEIVES: underground position         │
    │    ENEMIES SEE: character underground            │
    │    THEIR ESP: dot/model shows underground        │
    │    THEIR AIMBOT: locks onto underground pos      │
    │                                                   │
    │ 5. [Replication to server]                       │
    │    Server has underground CFrame                  │
    │    All other clients render you underground       │
    │                                                   │
    │ NEXT FRAME: Step 1 snaps HRP back for camera     │
    └─────────────────────────────────────────────────┘
    
    HIDE/ATTACK CYCLE:
    
    HIDE PHASE (HideTime seconds):
      ├─ currentDepth steps toward VoidDepth
      ├─ Each frame: depth += StepSpeed (incremental, not instant)
      ├─ Server sees character sinking underground gradually
      ├─ Enemy ESP follows the sinking position
      ├─ Anti-cheat sees gradual CFrame change (not teleport)
      └─ After HideTime expires → switch to ATTACK
    
    ATTACK PHASE (AttackTime seconds):
      ├─ currentDepth steps toward 0 (3x faster going UP)
      ├─ When depth < 2 studs → character is at real position
      ├─ Auto Fire: clicks mouse 1-2 times
      ├─ Manual: player can aim and shoot normally
      ├─ Projectile Mimic: if incoming projectile detected,
      │  immediately abort attack → dive back underground
      └─ After AttackTime expires → switch to HIDE
    
    RESULT:
      You play normally. They can't hit you.
      During your attack window, you can hit them.
      Their ragebot shoots underground, missing every time.
]]

-- ══════════════════════════════════════════
-- RENDERSTEP: Set HRP to real position
-- Runs BEFORE camera (priority 199)
-- Player sees character at real position
-- ══════════════════════════════════════════

RunService:BindToRenderStep("RivalsDesync", Enum.RenderPriority.Camera.Value - 1, function()
    if not Desync.active then return end
    if not Desync.realCFrame then return end
    if not humanoidRootPart or not humanoidRootPart.Parent then return end

    -- Set HRP to real position → camera follows this
    -- Player sees themselves at the real position, completely normal
    humanoidRootPart.CFrame = Desync.realCFrame
end)

-- ══════════════════════════════════════════
-- HEARTBEAT: Save real position, apply underground, manage phases
-- Runs AFTER physics (movement has been applied)
-- Server receives the underground position
-- ══════════════════════════════════════════

local monitorClock = 0

table.insert(ActiveConnections, RunService.Heartbeat:Connect(function(dt)
    if not Desync.active then return end
    if not humanoidRootPart or not humanoidRootPart.Parent then
        Desync.active = false
        return
    end

    -- Check if alive
    local hum = character:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then
        -- Died while desynced — restore position and stop
        if Desync.realCFrame then
            humanoidRootPart.CFrame = Desync.realCFrame
        end
        Desync.active      = false
        Desync.phase        = "idle"
        Desync.currentDepth = 0
        return
    end

    -- ── SAVE REAL POSITION ──
    -- After physics/movement, HRP has been moved by the character controller
    -- This is the player's ACTUAL intended position (where they moved to)
    Desync.realCFrame = humanoidRootPart.CFrame

    -- ── UPDATE PHASE TIMER ──
    Desync.phaseTimer = Desync.phaseTimer + dt

    -- ── PHASE STATE MACHINE ──

    if Desync.phase == "hide" then
        -- ─── HIDE: Step underground gradually ───
        -- Incremental stepping: move down by StepSpeed studs per frame
        -- NOT instant teleport — anti-cheat sees gradual CFrame change
        Desync.currentDepth = math.min(
            Desync.currentDepth + CFG.Void.StepSpeed,
            CFG.Void.VoidDepth
        )

        -- Check if hide time expired → switch to attack
        if Desync.phaseTimer >= CFG.Void.HideTime then
            Desync.phase      = "attack"
            Desync.phaseTimer  = 0
            Desync.shotsFired  = 0
            Desync.shotCooldown = 0
        end

    elseif Desync.phase == "attack" then
        -- ─── ATTACK: Step back up to real position ───
        -- Come up 3x faster than going down (minimize exposure)
        Desync.currentDepth = math.max(
            Desync.currentDepth - CFG.Void.StepSpeed * 3,
            0
        )

        -- ─── PROJECTILE MIMIC ───
        -- Check for incoming projectiles every 3 frames (performance)
        Desync.projCheckCD = Desync.projCheckCD + 1
        if Desync.projCheckCD >= 3 then
            Desync.projCheckCD = 0
            Desync.projDetected = checkProjectiles()

            if Desync.projDetected then
                -- Incoming projectile! Abort attack immediately
                -- Dive back underground before it hits
                Desync.phase      = "hide"
                Desync.phaseTimer = 0
                Desync.totalCycles = Desync.totalCycles + 1
                -- Skip the rest of this frame's attack logic
                -- currentDepth will start increasing next frame
            end
        end

        -- ─── AUTO FIRE ───
        -- Only fire when character is near surface (depth < 2 studs)
        if Desync.phase == "attack" and Desync.currentDepth <= 2 then
            if CFG.Void.AutoFire then
                Desync.shotCooldown = Desync.shotCooldown - dt
                if Desync.shotsFired < CFG.Void.ShootAttempt and Desync.shotCooldown <= 0 then
                    autoFire()
                    Desync.shotsFired   = Desync.shotsFired + 1
                    Desync.shotCooldown = 0.05 -- 50ms between shots
                end
            end
            -- If auto fire is OFF, player shoots manually during this window
            -- Their shots fire from real position because HRP is at realCFrame
            -- during RenderStep (which is when input/raycasts use HRP position)
        end

        -- Check if attack time expired → switch to hide
        if Desync.phase == "attack" and Desync.phaseTimer >= CFG.Void.AttackTime then
            Desync.phase       = "hide"
            Desync.phaseTimer  = 0
            Desync.totalCycles = Desync.totalCycles + 1
        end
    end

    -- ── APPLY UNDERGROUND POSITION ──
    -- This is what the SERVER sees. This is what ENEMIES see.
    -- Their ESP dot, their character model of us, their aimbot target
    -- is ALL at this underground position.
    if Desync.currentDepth > 0 then
        -- Keep same XZ and rotation, only shift Y downward
        local realPos  = Desync.realCFrame.Position
        local rotation = Desync.realCFrame - realPos -- Extract rotation component

        local undergroundPos = Vector3.new(
            realPos.X,
            realPos.Y - Desync.currentDepth,
            realPos.Z
        )

        humanoidRootPart.CFrame = CFrame.new(undergroundPos) * rotation

        -- This CFrame gets replicated to the server
        -- All other players see our character model at undergroundPos
        -- Their ESP overlay renders at undergroundPos
        -- Their aimbot locks onto undergroundPos
        -- Their bullets fire toward undergroundPos
        -- But WE are actually at realPos (shown in next RenderStep)
    end
    -- If currentDepth is 0 (during attack at surface), HRP stays at realCFrame
    -- This is the brief window where our hitbox is actually hittable
    -- But it's so brief (AttackTime) that their ragebot barely has time to react

    -- ── UPDATE MONITOR ──
    monitorClock = monitorClock + dt
    if monitorClock >= 0.15 then
        monitorClock = 0

        -- Phase display
        local phaseText = Desync.phase == "hide" and "HIDING (underground)" or
                         Desync.phase == "attack" and "ATTACKING (surface)" or "IDLE"
        local phaseColor = Desync.phase == "hide" and C.cyan or
                          Desync.phase == "attack" and C.orange or C.dim
        monPhaseV.Text = "PHASE: " .. phaseText
        monPhaseV.TextColor3 = phaseColor

        -- Depth
        monDepthV.Text = string.format("DEPTH: %.0f / %d studs", Desync.currentDepth, CFG.Void.VoidDepth)
        monDepthV.TextColor3 = Desync.currentDepth > 0 and C.green or C.orange

        -- Shots
        monShotsV.Text = string.format("SHOTS: %d / %d%s",
            Desync.shotsFired, CFG.Void.ShootAttempt,
            CFG.Void.AutoFire and " (auto)" or " (manual)")
        monShotsV.TextColor3 = Desync.shotsFired > 0 and C.yellow or C.dim

        -- Cycles
        monCycleV.Text = "CYCLES: " .. Desync.totalCycles
        monCycleV.TextColor3 = Desync.totalCycles > 0 and C.text or C.dim

        -- Projectile
        if CFG.Void.ProjectileMimic then
            monProjV.Text = "PROJ MIMIC: " .. (Desync.projDetected and "!! INCOMING !!" or "scanning...")
            monProjV.TextColor3 = Desync.projDetected and C.red or C.green
        else
            monProjV.Text = "PROJ MIMIC: OFF"
            monProjV.TextColor3 = C.dim
        end
    end
end))


local function makeModeSelect(parent,modes,default,order,callback)
    local container=make("Frame",{
        Size=UDim2.new(1,0,0,s(36)),BackgroundTransparency=1,LayoutOrder=order,Parent=parent,
    })
    make("UIListLayout",{
        FillDirection=Enum.FillDirection.Horizontal,
        SortOrder=Enum.SortOrder.LayoutOrder,
        Padding=UDim.new(0,s(3)),Parent=container,
    })
    local selected=default
    local buttons={}
    for i,mode in ipairs(modes) do
        local isSel=(mode==default)
        local btn=make("TextButton",{
            Size=UDim2.new(1/#modes,-s(3),1,0),
            BackgroundColor3=isSel and C.accent or C.off,BorderSizePixel=0,
            Text=mode,TextColor3=isSel and C.text or C.dim,
            Font=Enum.Font.GothamBold,TextSize=FONT_TINY,
            LayoutOrder=i,Parent=container,
        })
        make("UICorner",{CornerRadius=UDim.new(0,s(3)),Parent=btn})
        buttons[mode]=btn
        btn.MouseButton1Click:Connect(function()
            for m,b in pairs(buttons) do tw(b,0.12,{BackgroundColor3=C.off});b.TextColor3=C.dim end
            tw(btn,0.12,{BackgroundColor3=C.accent});btn.TextColor3=C.text
            selected=mode
            if callback then callback(mode) end
        end)
    end
    return {getMode=function() return selected end}
end


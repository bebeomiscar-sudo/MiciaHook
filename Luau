local POSE_SPIDER = {
    RootJoint    = function(t) return CFrame.Angles(math.rad(88),t*30,0)*CFrame.new(0,-5,4) end,
    Neck         = function(t) return CFrame.Angles(math.rad(-80)+math.sin(t*8)*0.1,0,0) end,

local function playEmote(animId, speed)
    stopEmote(); if not animId or animId == "" then return end
    local char = LP.Character; if not char then return end
    local hum  = char:FindFirstChildWhichIsA("Humanoid"); if not hum then return end
    local cleanId = tostring(animId):gsub("%s+", "")
    if not cleanId:find("rbxassetid://") then cleanId = "rbxassetid://" .. cleanId end
    local anim = Instance.new("Animation")
    anim.AnimationId = cleanId; EmoteState.animObject = anim
    local animator = hum:FindFirstChildOfClass("Animator") or Instance.new("Animator", hum)
    for _, t in next, animator:GetPlayingAnimationTracks() do t:Stop() end
    local ok, track = pcall(function() return animator:LoadAnimation(anim) end)
    if ok and track then
        track.Priority = Enum.AnimationPriority.Action4
        track:Play(); track:AdjustSpeed(speed or 1)
        EmoteState.currentTrack = track; EmoteState.playing = true
        track.Stopped:Connect(function()
            if CFG.Emote.On and CFG.Emote.Loop and EmoteState.playing then
                task.wait(0.05)
                if CFG.Emote.On then playEmote(CFG.Emote.AnimID, CFG.Emote.Speed) end
            end
        end)
    end
end


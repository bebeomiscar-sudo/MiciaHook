            phaseName = phaseNames2KTP[(VoidState.phase - 1) % 6] or "—"
        else
            phaseName = phaseNamesScatter[(VoidState.phase - 1) % 8] or "—"
        end
        monPhaseLabel.Text = "PHASE: " .. phaseName
        local isHome = phaseName:find("HOME") ~= nil
        monPhaseLabel.TextColor3 = isHome and C.green or C.red

        local tps = #VoidState.tpsTracker
        monTPSLabel.Text = "TPS: " .. tostring(tps) .. " teleports/sec"
        monTPSLabel.TextColor3 = tps > 20 and C.green or tps > 10 and C.orange or C.red

        monStateLabel.Text = "STATE: DESYNC ACTIVE ▸ " .. CFG.Void.Mode
        monStateLabel.TextColor3 = C.accentL
    end
end))


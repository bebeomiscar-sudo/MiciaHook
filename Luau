local ray_params_sa = RaycastParams.new()
local sa_offsets = {
    Vector3.new(0,12,0), Vector3.new(0,16,0), Vector3.new(0,20,0),
    Vector3.new(0,24,0), Vector3.new(0,28,0), Vector3.new(0,32,0),
    Vector3.new(0,36,0), Vector3.new(0,40,0),
}

local function sa_getClosest()
    if not LP.Character or not LP.Character:FindFirstChild("HumanoidRootPart") then
        return nil, nil
    end
    local target, tchar, dist = nil, nil, silentFOV
    for _, v in next, players_sa:GetPlayers() do
        if v == LP then continue end
        if silentTeamCheck and isSameTeamRivals(v) then continue end
        if not v.Character or not v.Character:FindFirstChild("Head") then continue end
        local hum = v.Character:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end
        if isPlayerImmune(v) then continue end
        local mag = (LP.Character.HumanoidRootPart.Position - v.Character.Head.Position).Magnitude
        if mag < dist then dist = mag; target = v.Character.Head; tchar = v.Character end
    end
    return target, tchar
end

local function sa_calcPoint(origin, target_pos, target_char)
    ray_params_sa.FilterDescendantsInstances = {LP.Character, target_char}
    ray_params_sa.FilterType = Enum.RaycastFilterType.Exclude
    if not silentVisibleCheck then return origin, nil end
    if not ws_sa:Raycast(origin, target_pos - origin, ray_params_sa) then return origin, nil end
    for _, offset in next, sa_offsets do
        local scan_pos = origin + offset
        if not ws_sa:Raycast(scan_pos, target_pos - scan_pos, ray_params_sa) then
            return scan_pos, offset.Y
        end
    end
    return nil, nil
end

local function tryRagebotReload(item)
    if not item then return end
    if not CFG.Void.AutoReload then return end
    local reloadOk = false
    pcall(function()
        rs_sa.Remotes.Replication.Fighter.UseItem:FireServer(
            item:Get("ObjectID"), enums_mod:ToEnum("Reload"), {}, nil
        )
        reloadOk = true
    end)
    if not reloadOk then
        pcall(function()
            rs_sa.Remotes.Replication.Fighter.UseItem:FireServer(
                item:Get("ObjectID"), enums_mod:ToEnum("StartReloading"), {}, nil
            )
        end)
    end
end

local function startSilentAim()
    if silentConn then silentConn:Disconnect() end
    silentConn = RunService.Heartbeat:Connect(function(dt)
        if not silentActive then return end
        if not LP.Character then return end
        if not LP.Character:FindFirstChild("HumanoidRootPart") then return end
        if not fighter_mod or not fighter_mod.LocalFighter then return end
        local item = fighter_mod.LocalFighter.EquippedItem
        if not item then return end
        if CFG.Void.AutoReload then
            reloadCooldown = reloadCooldown - dt
            local currentAmmo = nil
            pcall(function() currentAmmo = item:Get("CurrentAmmo") end)
            if currentAmmo ~= nil and currentAmmo <= 0 and reloadCooldown <= 0 then
                tryRagebotReload(item)
                reloadCooldown = 2.0
                return
            end
        end
        local target_part, target_char = sa_getClosest()
        if not target_part or not target_char then return end
        local cam    = ws_sa.CurrentCamera.CFrame
        local manip, height = sa_calcPoint(cam.Position, target_part.Position, target_char)
        if not manip then return end
        local shoot_pos = (height == nil and manip) or cam.Position
        local cameradata = {}
        cameradata[utf8.char(1)] = {
            [utf8.char(0)] = util_mod:EncodeCFrame(
                CFrame.new(shoot_pos.X, shoot_pos.Y+(height or 0), shoot_pos.Z)
                * CFrame.Angles(CFrame.lookAt(shoot_pos, target_part.Position):ToOrientation())
            ),
            [utf8.char(1)] = height and
                util_mod:EncodeCFrame(CFrame.new(target_part.Position)*CFrame.Angles(CFrame.lookAt(shoot_pos,target_part.Position):ToOrientation()))
                or util_mod:EncodeCFrame(CFrame.new(shoot_pos.X,shoot_pos.Y+(height or 0),shoot_pos.Z)*CFrame.Angles(CFrame.lookAt(shoot_pos,target_part.Position):ToOrientation())),
            [utf8.char(2)] = target_part,
            [utf8.char(3)] = util_mod:EncodeCFrame(target_part.CFrame:ToObjectSpace(CFrame.new(target_part.Position))),
        }
        pcall(function()
            rs_sa.Remotes.Replication.Fighter.UseItem:FireServer(
                item:Get("ObjectID"), enums_mod:ToEnum("StartShooting"), cameradata, nil
            )
        end)
    end)
end

local function stopSilentAim()
    if silentConn then silentConn:Disconnect(); silentConn = nil end
end

-- ═══════════════════════════════════════════
-- KICIAHOOK SILENT AIM (ViewportSize Hook)
-- ═══════════════════════════════════════════
local saHookTarget  = nil
local saHookConn    = nil
local saHookApplied = false
local saHookIdx     = nil

local function saHookByte(attr) return string.byte(attr or "\0") end

local function saGetEffectiveFOV()
    if SAHookCFG.IgnoreFOV then return math.huge end
    local fov = SAHookCFG.FOVSize
    if SAHookCFG.DynamicFOV then fov = fov * (camera.FieldOfView / 70) end
    return fov
end

local SA_PART_MAP = {
    ["Head"]       = {"Head"},
    ["Body"]       = {"UpperTorso","LowerTorso","HumanoidRootPart"},
    ["Head, Body"] = {"Head","UpperTorso","LowerTorso","HumanoidRootPart"},
    ["Body, Head"] = {"UpperTorso","LowerTorso","Head"},
}

local function saGetTargetPart(char)
    local names = SA_PART_MAP[SAHookCFG.TargetParts] or {"Head"}
    if SAHookCFG.PreferRandom then
        local valid = {}
        for _, n in ipairs(names) do
            local p = char:FindFirstChild(n)
            if p then table.insert(valid, p) end
        end
        if #valid > 0 then return valid[math.random(1, #valid)] end
        return nil
    end
    for _, n in ipairs(names) do
        local p = char:FindFirstChild(n)
        if p then return p end
    end
    return nil
end

local function saHookVisible(part, camPos)
    if not SAHookCFG.VisCheck then return true end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {
        LP.Character, part.Parent, workspace:FindFirstChild("Debris"),
    }
    local dir    = part.Position - camPos
    local result = workspace:Raycast(camPos, dir.Unit * SAHookCFG.Distance, params)
    return result == nil or result.Instance:IsDescendantOf(part.Parent)
end

local function saHookValid(plr, camPos, center)
    local char = plr.Character; if not char then return false end
    local hum  = char:FindFirstChildOfClass("Humanoid")
    if not (hum and hum.Health > 0) then return false end
    local myEnv    = LP:GetAttribute("EnvironmentID")
    local theirEnv = plr:GetAttribute("EnvironmentID")
    if myEnv and theirEnv and saHookByte(myEnv) ~= saHookByte(theirEnv) then return false end
    if SAHookCFG.TeamCheck then
        local myTeam    = LP:GetAttribute("TeamID")
        local theirTeam = plr:GetAttribute("TeamID")
        if myTeam and theirTeam and saHookByte(myTeam) == saHookByte(theirTeam) then return false end
    end
    local head = char:FindFirstChild("Head")
    if not head then return false end
    if (head.Position - camPos).Magnitude > SAHookCFG.Distance then return false end
    if not SAHookCFG.IgnoreFOV then
        local sp, on = workspace.CurrentCamera:WorldToViewportPoint(head.Position)
        if not on then return false end
        local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
        if d > saGetEffectiveFOV() then return false end
    end
    local targetPart = saGetTargetPart(char)
    if not targetPart then return false end
    if not saHookVisible(targetPart, camPos) then return false end
    return true
end

local function startSAHook()
    if not saHookApplied then
        local ok = pcall(function()
            saHookIdx = hookmetamethod(game, "__index", newcclosure(function(self, idx, ...)
                if saHookTarget
                    and not checkcaller()
                    and idx == "ViewportSize"
                    and self == workspace.CurrentCamera
                then
                    if math.random(1, 100) <= SAHookCFG.HitChance then
                        local pos, on = workspace.CurrentCamera:WorldToViewportPoint(saHookTarget)
                        if on then return Vector2.new(pos.X, pos.Y) end
                    end
                end
                return saHookIdx(self, idx, ...)
            end))
        end)
        if ok then saHookApplied = true end
    end
    if saHookConn then saHookConn:Disconnect() end
    saHookConn = RunService.Heartbeat:Connect(function()
        if not SAHookCFG.On then saHookTarget = nil; return end
        local cam    = workspace.CurrentCamera
        local camPos = cam.CFrame.Position
        local center = cam.ViewportSize / 2
        local best, bd = nil, math.huge
        for _, plr in Players:GetPlayers() do
            if plr == LP then continue end
            if saHookValid(plr, camPos, center) then
                local char = plr.Character
                if not char then continue end
                local targetPart = saGetTargetPart(char)
                if not targetPart then continue end
                local sp, on = cam:WorldToViewportPoint(targetPart.Position)
                if on then
                    local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                    if SAHookCFG.Targeting == "Closest" then
                        if d < bd then bd = d; best = targetPart end
                    elseif SAHookCFG.Targeting == "Furthest" then
                        if d > bd or bd == math.huge then bd = d; best = targetPart end
                    elseif SAHookCFG.Targeting == "Random" then
                        if best == nil or math.random() < 0.5 then best = targetPart end
                    else
                        if d < bd then bd = d; best = targetPart end
                    end
                end
            end
        end
        saHookTarget = best and best.Position or nil
    end)
end

local function stopSAHook()
    SAHookCFG.On  = false
    saHookTarget  = nil
    if saHookConn then saHookConn:Disconnect(); saHookConn = nil end
end

-- ═══════════════════════════════════════════
-- ANTI-AIM SYSTEM (shared — used by both tabs)
-- ═══════════════════════════════════════════
local function restoreRootJoint()
    pcall(function()
        local char = LP.Character; if not char then return end
        local hrp  = char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
        local rj   = hrp:FindFirstChild("RootJoint")
        if rj and aaOrigC0 then rj.C0 = aaOrigC0 end
    end)
end

local function startAntiAim()
    if aaConn then aaConn:Disconnect(); aaConn = nil end
    aaSpinAccum = 0

    aaConn = RunService.RenderStepped:Connect(function(dt)
        if not AntiAimCFG.On then
            aaConn:Disconnect(); aaConn = nil
            restoreRootJoint()
            aaOrigC0 = nil
            return
        end

        aaSpinAccum = aaSpinAccum + dt

        local char = LP.Character; if not char then return end
        local hrp  = char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
        local rj   = hrp:FindFirstChild("RootJoint"); if not rj then return end

        if not aaOrigC0 then aaOrigC0 = rj.C0 end

        local yaw, pitch = 0, 0
        local typ = AntiAimCFG.Type

        if     typ == "Backwards"  then yaw   = math.rad(180)
        elseif typ == "Spin"       then yaw   = aaSpinAccum * 8
        elseif typ == "HideHead"   then pitch = math.rad(89)
        elseif typ == "BelowFloor" then pitch = math.rad(180)
        elseif typ == "Custom"     then
            yaw   = math.rad(AntiAimCFG.YawAngle)
            pitch = math.rad(AntiAimCFG.PitchAngle)
        end

        pcall(function() rj.C0 = aaOrigC0 * CFrame.Angles(pitch, yaw, 0) end)
    end)
end

local function stopAntiAim()
    AntiAimCFG.On = false
    if aaConn then aaConn:Disconnect(); aaConn = nil end
    restoreRootJoint()
    aaOrigC0 = nil
end

-- ═══════════════════════════════════════════
-- WALL BANG SYSTEM
-- ═══════════════════════════════════════════
local function wbGetClosest()
    local lr = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not lr then return nil end

    local closest, closestDist = nil, WallBangCFG.MaxDistance

    for _, p in ipairs(Players:GetPlayers()) do
        if p == LP then continue end
        if WallBangCFG.TeamCheck and isSameTeamRivals(p) then continue end
        if isPlayerImmune(p) then continue end

        local hrp = getHRP(p)
        if not hrp then continue end

        local hum = p.Character:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end

        local d = (hrp.Position - lr.Position).Magnitude
        if d < closestDist then
            closestDist = d
            closest     = p
        end
    end

    return closest
end

local function startWallBang()
    local char = LP.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then
        window:Notify("Wall Bang", "No HumanoidRootPart found", 3)
        return
    end

    WB.origPos    = hrp.Position
    WB.targetCF   = nil
    WB.lastTarget = nil
    WallBangCFG.Enabled = true

    if WB.conn then WB.conn:Disconnect() end

    WB.conn = RunService.Heartbeat:Connect(function()
        if not WallBangCFG.Enabled then
            WB.conn:Disconnect()
            WB.conn = nil
            return
        end

        local target = wbGetClosest()
        if target then
            local eHRP = getHRP(target)
            if eHRP then
                -- Slight offset so we sit inside the hitbox
                WB.targetCF   = eHRP.CFrame * CFrame.new(0, 0, 0.5)
                WB.lastTarget = target
            end
        end

        local myChar = LP.Character
        local myHRP  = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not myHRP then return end

        if WB.targetCF then
            local ok = pcall(function()
                myHRP.CFrame                   = WB.targetCF
                myHRP.AssemblyLinearVelocity   = Vector3.zero
                myHRP.AssemblyAngularVelocity  = Vector3.zero
            end)
            if not ok then
                WallBangCFG.Enabled = false
                WB.conn:Disconnect()
                WB.conn = nil
                window:Notify("Wall Bang", "Stopped — HRP became unwritable", 3)
            end
        end
    end)

    window:Notify("Wall Bang", "Active — teleporting to closest enemy", 3)
end

local function stopWallBang()
    WallBangCFG.Enabled = false

    if WB.conn then
        WB.conn:Disconnect()
        WB.conn = nil
    end

    if WallBangCFG.RestoreOnStop and WB.origPos then
        local char = LP.Character
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")
        pcall(function()
            if hrp then
                hrp.CFrame                   = CFrame.new(WB.origPos)
                hrp.AssemblyLinearVelocity   = Vector3.zero
                hrp.AssemblyAngularVelocity  = Vector3.zero
            end
        end)
        window:Notify("Wall Bang", "Stopped — position restored", 3)
    else
        window:Notify("Wall Bang", "Stopped", 2)
    end

    WB.origPos    = nil
    WB.targetCF   = nil
    WB.lastTarget = nil
end


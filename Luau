-- ═══════════════════════════════════════════
-- CORE: RENDER STEPPED
-- ═══════════════════════════════════════════
local watermark = library:Hud()
local orbitAngle = 0

RunService.RenderStepped:Connect(function(dt)
    camera = workspace.CurrentCamera
    local center = getScreenCenter()

    -- FOV Circles
    if fovCircle then
        fovCircle.Position = center
        fovCircle.Radius   = AimbotCFG.MaxFOV
        fovCircle.Visible  = AimbotCFG.DrawFOV and AimbotCFG.On
    end
    if saFovCircle then
        saFovCircle.Position = center
        saFovCircle.Radius   = SAHookCFG.IgnoreFOV and 0 or saGetEffectiveFOV()
        saFovCircle.Visible  = SAHookCFG.DrawFOV and SAHookCFG.On and not SAHookCFG.IgnoreFOV
    end

    -- ═══ AIMBOT (STICKY LOCK) ═══
    if AimbotCFG.On and CameraController then
        if isInReaction then
            reactionTimer = reactionTimer - dt
            if reactionTimer <= 0 then isInReaction = false end
        end
        if not isInReaction then
            if lockedTarget and not isTargetStillValid(lockedTarget) then
                lockedTarget=nil; lockTimer=0
            end
            if not lockedTarget then
                local newTarget = findNewAimbotTarget()
                if newTarget then
                    lockedTarget=newTarget; lockTimer=0
                    isInReaction=true; reactionTimer=AimbotCFG.ReactionTime/1000
                end
            end
            if lockedTarget then
                lockTimer = lockTimer + dt
                if lockTimer > AimbotCFG.MaxLockTime then
                    lockedTarget=nil; lockTimer=0
                else
                    local isAttacking = false
                    xpcall(function()
                        if fighter_mod and fighter_mod.LocalFighter then
                            isAttacking = fighter_mod.LocalFighter:Get("IsShooting") == true
                        end
                    end, function(err) end)
                    local speed = isAttacking and AimbotCFG.SpeedInAttack or AimbotCFG.Speed
                    xpcall(function()
                        local cp   = camera.CFrame.Position
                        local du   = (lockedTarget.Position - cp).Unit
                        local tP   = math.asin(du.Y)
                        local tY   = math.atan2(-du.X, -du.Z)
                        local sm   = math.clamp(speed/5, 0, 1)
                        local cur  = CameraController.Rotation
                        CameraController:SetRotation(Vector2.new(
                            cur.X + (tP - cur.X) * sm,
                            cur.Y + angleDiff(cur.Y, tY) * sm
                        ))
                    end, function(err) end)
                end
            end
        end
    end

    -- ═══ TRIGGERBOT ═══
    if TrigCFG.On then
        local tgt = getTriggerTarget()
        if tgt then
            if not TrigState.waiting then
                TrigState.waiting=true; TrigState.timer=getTrigDelay(); TrigState.grace=TrigCFG.Grace/1000
            end
            TrigState.timer = TrigState.timer - dt
            if TrigState.timer <= 0 then simClick(); TrigState.waiting=false; TrigState.timer=0 end
        else
            if TrigState.waiting then
                TrigState.grace = TrigState.grace - dt
                if TrigState.grace <= 0 then
                    TrigState.waiting=false; TrigState.timer=0; TrigState.grace=0
                end
            end
        end
    else
        TrigState.waiting=false; TrigState.timer=0; TrigState.grace=0
    end

    -- ═══ ESP RENDER ═══
    if S.ESP.Rainbow then espHue = (espHue + 0.005) % 1 end
    local localRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    for _, p in pairs(Players:GetPlayers()) do
        if p == LP then continue end
        local hl   = Highlights[p]
        local obj  = ESPObjects[p]
        local char = p.Character
        local rainCol = S.ESP.Rainbow and Color3.fromHSV(espHue,1,1) or nil
        -- Charms
        if hl then
            local showHL = S.ESP.Enabled and S.ESP.Charms and not(S.ESP.TeamCheck and isSameTeamRivals(p))
            hl.Enabled=showHL
            hl.OutlineColor=rainCol or S.ESP.Colors.Charms
            hl.FillTransparency=S.ESP.CharmsFill and 0.5 or 1
            hl.FillColor=rainCol or S.ESP.Colors.Charms
        end
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local show = S.ESP.Enabled and char and hum and hrp and hum.Health > 0
            and not(S.ESP.TeamCheck and isSameTeamRivals(p))
        -- Skeleton
        local skel = SkeletonFrames[p]
        if skel then
            if show and S.ESP.Skeleton then
                for i, joint in ipairs(SKEL) do
                    local f = skel[i]; if not f then continue end
                    local pA = char:FindFirstChild(joint[1])
                    local pB = char:FindFirstChild(joint[2])
                    if not pA or not pB then f.Visible=false; continue end
                    local posA, onA = camera:WorldToViewportPoint(pA.Position)
                    local posB, onB = camera:WorldToViewportPoint(pB.Position)
                    if not onA or not onB or posA.Z<0 or posB.Z<0 then f.Visible=false; continue end
                    local sA = Vector2.new(posA.X,posA.Y)
                    local sB = Vector2.new(posB.X,posB.Y)
                    f.Visible=true
                    f.BackgroundColor3 = rainCol or S.ESP.SkeletonColor
                    f.Size = UDim2.new(0,(sB-sA).Magnitude,0,2)
                    f.Position = UDim2.new(0,sA.X,0,sA.Y)
                    f.Rotation = math.deg(math.atan2(sB.Y-sA.Y,sB.X-sA.X))
                end
            else
                for _, f in pairs(skel) do f.Visible=false end
            end
        end
        if not obj then if show then createESP(p) end; continue end
        if not show then
            obj.NL.Visible=false; obj.IL.Visible=false; obj.HPBg.Visible=false
            if obj.Box then obj.Box.Visible=false end
            continue
        end
        local sp, os = camera:WorldToViewportPoint(hrp.Position)
        if not os or sp.Z < 0 then
            obj.NL.Visible=false; obj.IL.Visible=false; obj.HPBg.Visible=false
            if obj.Box then obj.Box.Visible=false end
            continue
        end
        local headPart = char:FindFirstChild("Head") or hrp
        local headPos, headOn = camera:WorldToViewportPoint(headPart.Position+Vector3.new(0,0.75,0))
        local feetPos, feetOn = camera:WorldToViewportPoint(hrp.Position-Vector3.new(0,3,0))
        local sx    = sp.X
        local topY  = headOn and headPos.Y or (sp.Y - 40)
        local pH    = (feetOn and feetPos.Y or sp.Y) - topY
        local distM = localRoot and math.floor((hrp.Position-localRoot.Position).Magnitude) or 0
        local col   = rainCol or S.ESP.Colors.Name
        -- Name
        if S.ESP.Name then
            obj.NL.Text=p.DisplayName; obj.NL.TextColor3=col
            obj.NL.Position=UDim2.new(0,sx,0,topY-16); obj.NL.Visible=true
        else obj.NL.Visible=false end
        -- HP bar
        if S.ESP.Health then
            local ratio  = math.clamp(hum.Health/hum.MaxHealth,0,1)
            local pxH    = math.max(10, pH)
            local hpCol  = Color3.fromRGB(math.floor(255*(1-ratio)), math.floor(220*ratio), 60)
            obj.HPBg.Size=UDim2.new(0,3,0,pxH); obj.HPBg.Position=UDim2.new(0,sx-50,0,topY)
            obj.HPBar.Size=UDim2.new(1,0,ratio,0); obj.HPBar.BackgroundColor3=hpCol
            obj.HPBg.Visible=true
        else obj.HPBg.Visible=false end
        -- Box
        local boxW = math.max(30, pH * 0.5)
        if obj.Box and S.ESP.Box then
            obj.Box.Size=UDim2.new(0,boxW,0,pH)
            obj.Box.Position=UDim2.new(0,sx-boxW/2,0,topY)
            obj.Box.Visible=true
            obj.BoxStroke.Color=rainCol or S.ESP.Colors.Outline
        elseif obj.Box then obj.Box.Visible=false end
        -- Info label
        local tool  = char:FindFirstChildOfClass("Tool")
        local parts = {}
        if S.ESP.Distance then table.insert(parts, distM.."m") end
        if S.ESP.Weapon and tool then
            local wn = tool.Name:gsub("^Rivals_",""):gsub("_"," ")
            if S.ESP.Ammo then
                for _, v in pairs(tool:GetDescendants()) do
                    if (v:IsA("IntValue") or v:IsA("NumberValue")) and v.Name:lower():find("ammo") then
                        wn = wn.." | "..math.floor(v.Value); break
                    end
                end
            end
            table.insert(parts, wn)
        end
        if #parts > 0 then
            obj.IL.Text=table.concat(parts,"  |  ")
            obj.IL.TextColor3=rainCol or S.ESP.Colors.Distance
            obj.IL.Position=UDim2.new(0,sx,0,topY+pH+2)
            obj.IL.Visible=true
        else obj.IL.Visible=false end
    end

    -- ═══ CROSSHAIR ═══
    if S.Crosshair.Rainbow then chHue = (chHue + dt*0.4) % 1 end
    local chCol = S.Crosshair.Rainbow and Color3.fromHSV(chHue,1,1) or S.Crosshair.Color
    local s_ch  = S.Crosshair
    local vp    = camera.ViewportSize
    local cx, cy = vp.X/2, vp.Y/2
    local G, th, L = s_ch.Gap, s_ch.Thickness, s_ch.Length
    for _, p in pairs(chParts) do
        if not p.f or not p.f.Parent then continue end
        p.f.Visible = S.Crosshair.Enabled
        if p.f.BackgroundTransparency ~= 1 then p.f.BackgroundColor3 = chCol end
        for _, c in pairs(p.f:GetChildren()) do if c:IsA("UIStroke") then c.Color=chCol end end
        local r = p.r
        if r=="top"   then p.f.Size=UDim2.new(0,th,0,L)  p.f.Position=UDim2.new(0,cx,0,cy-G-L/2)
        elseif r=="bot"   then p.f.Size=UDim2.new(0,th,0,L)  p.f.Position=UDim2.new(0,cx,0,cy+G+L/2)
        elseif r=="left"  then p.f.Size=UDim2.new(0,L,0,th)  p.f.Position=UDim2.new(0,cx-G-L/2,0,cy)
        elseif r=="right" then p.f.Size=UDim2.new(0,L,0,th)  p.f.Position=UDim2.new(0,cx+G+L/2,0,cy)
        elseif r=="dot"   then p.f.Size=UDim2.new(0,s_ch.Size,0,s_ch.Size) p.f.Position=UDim2.new(0,cx,0,cy)
        elseif r=="circle" then
            p.f.Size=UDim2.new(0,s_ch.Size*4+G*2,0,s_ch.Size*4+G*2)
            p.f.Position=UDim2.new(0,cx,0,cy)
            for _, c in pairs(p.f:GetChildren()) do
                if c:IsA("UIStroke") then c.Color=chCol; c.Thickness=th end
            end
        elseif r=="circle2" then
            p.f.Size=UDim2.new(0,(s_ch.Size*4+G*2)*1.5,0,(s_ch.Size*4+G*2)*1.5)
            p.f.Position=UDim2.new(0,cx,0,cy)
        end
    end

    -- ═══ HIT MARKER ═══
    local now = tick()
    local hm  = S.Misc.HitMarker
    local keep = {}
    for _, m in ipairs(activeMarkers) do
        local age = now - m.born
        if age >= hm.Duration or not m.label.Parent then
            xpcall(function() m.label:Destroy() end, function(err) end)
        else
            m.oY = m.oY + hm.Float * (1/60)
            local ok, sp, on = pcall(function() return camera:WorldToViewportPoint(m.head.Position) end)
            if ok and on and sp.Z > 0 then
                local a = 1 - (age/hm.Duration)
                m.label.Position = UDim2.new(0, sp.X+m.jX, 0, sp.Y-30-m.oY)
                m.label.TextTransparency = 1-a
                m.label.TextStrokeTransparency = 1-a*0.9
                m.label.Visible = true
            else m.label.Visible=false end
            table.insert(keep, m)
        end
    end
    activeMarkers = keep

    -- ═══ BULLET TRACERS ═══
    local life = S.Misc.BulletTracer.Duration
    local keepT = {}
    for _, t in ipairs(activeTracers) do
        local age = now - t.Born
        if age < life and t.Line and t.Line.Parent then
            local sp2, on2 = camera:WorldToViewportPoint(t.HitPos)
            if on2 and sp2.Z > 0 then
                local sFrom = getTracerOrigin()
                local sTo2  = Vector2.new(sp2.X, sp2.Y)
                local delta = sTo2 - sFrom
                local len   = delta.Magnitude
                t.Line.Size = UDim2.new(0,len,0,S.Misc.BulletTracer.Thickness)
                t.Line.Position = UDim2.new(0,sFrom.X,0,sFrom.Y)
                t.Line.Rotation = math.deg(math.atan2(delta.Y,delta.X))
                t.Line.BackgroundColor3 = S.Misc.BulletTracer.Rainbow
                    and Color3.fromHSV((tracerHue+age*0.3)%1,1,1)
                    or S.Misc.BulletTracer.Color
                t.Line.BackgroundTransparency = S.Misc.BulletTracer.Fade
                    and math.clamp(age/life, 0, 0.95)
                    or 0
                t.Line.Visible=true
            else t.Line.Visible=false end
            table.insert(keepT, t)
        else
            xpcall(function() if t.Line then t.Line:Destroy() end end, function(err) end)
        end
    end
    activeTracers = keepT

    -- ═══ WATERMARK ═══
    local wParts = {"Rivals Tool v9.8"}
    table.insert(wParts, os.date("%H:%M:%S"))
    local active = {}
    if AimbotCFG.On     then table.insert(active,"AIM")   end
    if SAHookCFG.On     then table.insert(active,"HOOK")  end
    if silentActive     then table.insert(active,"RAGE")  end
    if TrigCFG.On       then table.insert(active,"TRIG")  end
    if CFG.Void.On      then table.insert(active,"VOID")  end
    if CFG.Orbit.On     then table.insert(active,"ORBIT") end
    if S.AntiAim.Enabled  then table.insert(active,"AA")  end
    if S.FakeLag.Enabled  then table.insert(active,"FL")  end
    if S.Player.Fly.Enabled then table.insert(active,"FLY") end
    if S.ESP.Enabled    then table.insert(active,"ESP")   end
    if GunCFG.NoRecoil or GunCFG.NoSpread or GunCFG.FastShoot then table.insert(active,"GUN") end
    if #active > 0 then table.insert(wParts, "["..table.concat(active," ").."]") end
    watermark:SetText(table.concat(wParts, " | "))
end)


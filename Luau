local SA_PEEK_OFFSETS_RB = {
    Vector3.new(0,12,0),Vector3.new(0,16,0),Vector3.new(0,20,0),Vector3.new(0,24,0),
    Vector3.new(0,28,0),Vector3.new(0,32,0),Vector3.new(0,36,0),Vector3.new(0,40,0),
}
local ray_params_sa = RaycastParams.new()

local function sa_getClosest()
    if not LP.Character or not LP.Character:FindFirstChild("HumanoidRootPart") then return nil,nil end
    local target, tchar, dist = nil, nil, RageCFG.MaxDist
    for _, v in next, players:GetPlayers() do
        if v == LP then continue end
        if RageCFG.TeamCheck and isSameTeamRivals(v) then continue end
        if not v.Character or not v.Character:FindFirstChild("Head") then continue end
        local hum = v.Character:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end
        local mag = (LP.Character.HumanoidRootPart.Position - v.Character.Head.Position).Magnitude
        if mag < dist then dist = mag; target = v.Character.Head; tchar = v.Character end
    end
    return target, tchar
end

local function sa_calcPoint(origin, target_pos, target_char)
    ray_params_sa.FilterDescendantsInstances = {LP.Character, target_char}
    ray_params_sa.FilterType = Enum.RaycastFilterType.Exclude
    if not RageCFG.VisibleCheck then return origin, nil end
    if not ws:Raycast(origin, target_pos - origin, ray_params_sa) then return origin, nil end
    for _, offset in next, SA_PEEK_OFFSETS_RB do
        local sp = origin + offset
        if not ws:Raycast(sp, target_pos - sp, ray_params_sa) then return sp, offset.Y end
    end
    return nil, nil
end

local function tryRagebotReload(item)
    if not item then return end
    pcall(function() rs.Remotes.Replication.Fighter.UseItem:FireServer(item:Get("ObjectID"), enums_mod:ToEnum("Reload"), {}, nil) end)
    pcall(function() rs.Remotes.Replication.Fighter.UseItem:FireServer(item:Get("ObjectID"), enums_mod:ToEnum("StartReloading"), {}, nil) end)
end

local function startRagebot()
    if silentConn then silentConn:Disconnect() end
    silentConn = RunService.Heartbeat:Connect(function(dt)
        if not RageCFG.On or not LP.Character then return end
        if not LP.Character:FindFirstChild("HumanoidRootPart") then return end
        if not fighter_mod or not fighter_mod.LocalFighter then return end
        local item = fighter_mod.LocalFighter.EquippedItem; if not item then return end
        reloadCooldown = reloadCooldown - dt
        local ammo = nil; pcall(function() ammo = item:Get("CurrentAmmo") end)
        if ammo ~= nil and ammo <= 0 and reloadCooldown <= 0 then
            tryRagebotReload(item); reloadCooldown = 2.0; return
        end
        local tp, tc = sa_getClosest(); if not tp or not tc then return end
        local cam           = ws.CurrentCamera.CFrame
        local manip, height = sa_calcPoint(cam.Position, tp.Position, tc)
        if not manip then return end
        local sp = (height == nil and manip) or cam.Position
        local cd = {}
        cd[utf8.char(1)] = {
            [utf8.char(0)] = util_mod:EncodeCFrame(CFrame.new(sp.X,sp.Y+(height or 0),sp.Z)*CFrame.Angles(CFrame.lookAt(sp,tp.Position):ToOrientation())),
            [utf8.char(1)] = height and util_mod:EncodeCFrame(CFrame.new(tp.Position)*CFrame.Angles(CFrame.lookAt(sp,tp.Position):ToOrientation()))
                or util_mod:EncodeCFrame(CFrame.new(sp.X,sp.Y+(height or 0),sp.Z)*CFrame.Angles(CFrame.lookAt(sp,tp.Position):ToOrientation())),
            [utf8.char(2)] = tp,
            [utf8.char(3)] = util_mod:EncodeCFrame(tp.CFrame:ToObjectSpace(CFrame.new(tp.Position))),
        }
        pcall(function() rs.Remotes.Replication.Fighter.UseItem:FireServer(item:Get("ObjectID"), enums_mod:ToEnum("StartShooting"), cd, nil) end)
    end)
end

local function stopRagebot()
    if silentConn then silentConn:Disconnect(); silentConn = nil end
end

local function startRagebotOrbit()
    if ragebotLoopTask then task.cancel(ragebotLoopTask); ragebotLoopTask = nil end
    ragebotLoopTask = task.spawn(function()
        while RagebotCFG.Enabled do
            local enemies = GetEnemiesSorted()
            local enemy   = enemies[1]
            local myRoot  = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            if enemy and enemy.Character and myRoot then
                local enemyRoot = enemy.Character:FindFirstChild("HumanoidRootPart")
                if enemyRoot then
                    local t = tick() * RagebotCFG.OrbitSpeed
                    local r = RagebotCFG.OrbitRadius
                    pcall(function()
                        enemyRoot.CFrame = CFrame.new(
                            myRoot.Position + Vector3.new(math.sin(t)*r, 0, math.cos(t)*r)
                        )
                    end)
                end
            end
            task.wait(0.05)
            if not RagebotCFG.Enabled then break end
        end
        ragebotLoopTask = nil
    end)
end

local function stopRagebotOrbit()
    if ragebotLoopTask then task.cancel(ragebotLoopTask); ragebotLoopTask = nil end
end

local function setupRagebotPersistence()
    if ragebotPersistConn then ragebotPersistConn:Disconnect() end
    ragebotPersistConn = LP.CharacterAdded:Connect(function(char)
        if not RagebotCFG.PersistAcrossRounds or not ragebotWasEnabled then return end
        char:WaitForChild("HumanoidRootPart", 10); task.wait(1.5)
        if not RagebotCFG.Enabled then
            RagebotCFG.Enabled = true
            startRagebot(); startRagebotOrbit()
            Library:Notify("Ragebot auto-resumed", 3)
        end
    end)
end


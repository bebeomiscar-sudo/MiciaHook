local function SC_ApplySkin(weaponName, skinName, enable)
    if not weaponName or not viewModels then return end
    local weaponFolder = nil
    for _, v in ipairs(viewModels:GetDescendants()) do
        if v.Name == weaponName then weaponFolder = v; break end
    end
    if not weaponFolder then return end
    if enable then
        if not skinName then return end
        local skinFolder = nil
        for _, v in ipairs(viewModels:GetDescendants()) do
            if v.Name == skinName then skinFolder = v; break end
        end
        if not skinFolder then return end
        weaponFolder:ClearAllChildren()
        for _, child in ipairs(skinFolder:GetChildren()) do
            child:Clone().Parent = weaponFolder
        end
        activeSkinMap[weaponName]          = skinName
        skinConfig.ActiveSkins[weaponName] = skinName
    else
        activeSkinMap[weaponName]          = nil
        skinConfig.ActiveSkins[weaponName] = nil
    end
end

local function SC_ApplyMaterial(materialName)
    if not skinConfig.MaterialEnabled then return end
    skinConfig.CurrentMaterial = materialName
    local tempVMs = nil
    pcall(function() tempVMs = ReplicatedStorage.Assets.Temp.ViewModels end)
    if not tempVMs then return end
    for _, child in ipairs(tempVMs:GetChildren()) do
        if string.find(child.Name, localPlayerName .. " -", 1, true) == 1 then
            local itemVisual = child:FindFirstChild("ItemVisual")
            if itemVisual then
                for _, part in ipairs(itemVisual:GetDescendants()) do
                    if (part:IsA("MeshPart") or part:IsA("BasePart") or part:IsA("Part"))
                        and not string.find(string.lower(part.Name), "primary") then
                        pcall(function() part.Material = Enum.Material[materialName] end)
                    end
                end
            end
        end
    end
end

local function SC_ApplyTransparency(pct)
    if not skinConfig.MaterialEnabled then return end
    skinConfig.Transparency = pct
    local tempVMs = nil
    pcall(function() tempVMs = ReplicatedStorage.Assets.Temp.ViewModels end)
    if not tempVMs then return end
    for _, child in ipairs(tempVMs:GetChildren()) do
        if string.find(child.Name, localPlayerName .. " -", 1, true) == 1 then
            local itemVisual = child:FindFirstChild("ItemVisual")
            if itemVisual then
                for _, part in ipairs(itemVisual:GetDescendants()) do
                    if (part:IsA("MeshPart") or part:IsA("BasePart") or part:IsA("Part"))
                        and not string.find(string.lower(part.Name), "primary") then
                        pcall(function() part.Transparency = pct / 100 end)
                    end
                end
            end
        end
    end
end

local function SC_WatchViewModels()
    local tempVMs = nil
    pcall(function() tempVMs = ReplicatedStorage.Assets.Temp.ViewModels end)
    if not tempVMs then return end
    tempVMs.ChildAdded:Connect(function(child)
        if not skinConfig.MaterialEnabled then return end
        task.wait(0.1)
        if string.find(child.Name, localPlayerName .. " -", 1, true) == 1 then
            SC_ApplyMaterial(skinConfig.CurrentMaterial)
            SC_ApplyTransparency(skinConfig.Transparency)
        end
    end)
    tempVMs.ChildRemoved:Connect(function(child)
        if not skinConfig.MaterialEnabled then return end
        task.wait(0.1)
        if string.find(child.Name, localPlayerName .. " -", 1, true) == 1 then
            SC_ApplyMaterial(skinConfig.CurrentMaterial)
            SC_ApplyTransparency(skinConfig.Transparency)
        end
    end)
end

local function SC_GetConfigList()
    if not isfolder(SC_FOLDER) then return {} end
    local list = {}
    local ok, files = pcall(listfiles, SC_FOLDER)
    if ok and files then
        for _, path in pairs(files) do
            local name = path:match("([^/\\]+)%.json$")
            if name then table.insert(list, name) end
        end
    end
    return list
end

local function SC_SaveConfig(configName)
    if not configName or configName == "" then configName = "default" end
    if not isfolder(SC_FOLDER) then makefolder(SC_FOLDER) end
    local path = SC_FOLDER .. "/" .. configName .. ".json"
    local data = {
        AutoLoadConfig   = skinConfig.AutoLoadConfig,
        LastLoadedConfig = configName,
        ActiveSkins      = skinConfig.ActiveSkins,
        CurrentMaterial  = skinConfig.CurrentMaterial,
        MaterialEnabled  = skinConfig.MaterialEnabled,
        Transparency     = skinConfig.Transparency,
    }
    local ok, err = pcall(writefile, path, HttpService:JSONEncode(data))
    if ok then
        Library:Notify("Config '" .. configName .. "' saved!", 2)
    else
        Library:Notify("Failed to save: " .. tostring(err), 3)
    end
end

local function SC_LoadConfig(configName)
    if not configName or configName == "" then configName = "default" end
    local path = SC_FOLDER .. "/" .. configName .. ".json"
    if not isfile(path) then Library:Notify("Config not found!", 2); return end
    local readOk, raw = pcall(readfile, path)
    if not readOk then Library:Notify("Failed to read config", 3); return end
    local decodeOk, data = pcall(function() return HttpService:JSONDecode(raw) end)
    if not decodeOk or not data then Library:Notify("Failed to decode config", 3); return end
    skinConfig.AutoLoadConfig   = data.AutoLoadConfig or true
    skinConfig.ActiveSkins      = data.ActiveSkins or {}
    skinConfig.CurrentMaterial  = data.CurrentMaterial or "SmoothPlastic"
    skinConfig.MaterialEnabled  = data.MaterialEnabled or false
    skinConfig.Transparency     = data.Transparency or 0
    skinConfig.LastLoadedConfig = configName
    for weaponName, skinName in pairs(skinConfig.ActiveSkins) do
        SC_ApplySkin(weaponName, skinName, true)
    end
    if skinConfig.MaterialEnabled then
        SC_ApplyMaterial(skinConfig.CurrentMaterial)
        SC_ApplyTransparency(skinConfig.Transparency)
    end
    if materialToggle     then materialToggle:SetValue(skinConfig.MaterialEnabled)     end
    if materialDropdown   then materialDropdown:SetValue(skinConfig.CurrentMaterial)   end
    if transparencySlider then transparencySlider:SetValue(skinConfig.Transparency)    end
    if autoLoadToggle     then autoLoadToggle:SetValue(skinConfig.AutoLoadConfig)      end
    local firstWeapon, firstSkin = next(skinConfig.ActiveSkins)
    if firstWeapon and firstSkin then
        if weaponDropdown then weaponDropdown:SetValue(firstWeapon) end
        if skinDropdown and WEAPON_SKINS[firstWeapon] then
            skinDropdown:SetValues(WEAPON_SKINS[firstWeapon])
            skinDropdown:SetValue(firstSkin)
        end
        currentWeaponSel = firstWeapon
    end
    Library:Notify("Config '" .. configName .. "' loaded!", 2)
end

local function SC_DeleteConfig(configName)
    if not configName or configName == "" or configName == "default" then
        Library:Notify("Cannot delete default!", 2); return
    end
    local path = SC_FOLDER .. "/" .. configName .. ".json"
    if not isfile(path) then Library:Notify("Config not found!", 2); return end
    local ok, err = pcall(delfile, path)
    if ok then
        Library:Notify("Deleted '" .. configName .. "'", 2)
    else
        Library:Notify("Failed: " .. tostring(err), 3)
    end
end

local function SC_AutoLoad()
    if not isfolder(SC_FOLDER) then makefolder(SC_FOLDER) end
    if skinConfig.AutoLoadConfig then
        local target = skinConfig.LastLoadedConfig or "default"
        if isfile(SC_FOLDER .. "/" .. target .. ".json") then
            SC_LoadConfig(target)
        end
    end
end

-- ═══════════════════════════════════════════
-- AIMBOT
-- ═══════════════════════════════════════════
local function getAimbotEffectiveFOV()
    local f = AimbotCFG.MaxFOV
    if AimbotCFG.DynamicFOV then f = f * (camera.FieldOfView / 70) end
    return f
end

local function isInAimbotFOV(targetPart)
    if not targetPart then return false end
    local sp, onScreen = camera:WorldToViewportPoint(targetPart.Position)
    if not onScreen then return false end
    return (Vector2.new(sp.X, sp.Y) - getScreenCenter()).Magnitude <= getAimbotEffectiveFOV()
end

local function resetDelayedPos() delayedTargetPos = nil end

local function getDelayedPos(targetPart, dt)
    if not targetPart or not targetPart.Parent then delayedTargetPos = nil; return nil end
    local realPos = targetPart.Position
    if not delayedTargetPos then delayedTargetPos = realPos; return realPos end
    local isJumping = false
    pcall(function()
        local hrpT = targetPart.Parent:FindFirstChild("HumanoidRootPart")
        if hrpT then isJumping = hrpT.AssemblyLinearVelocity.Y > 2 end
    end)
    local bf = 60 * dt
    local xA = math.clamp((1 - AimbotCFG.XSmooth) * (1 + bf), 0.01, 1)
    local yA = (isJumping and AimbotCFG.JumpSmooth > 0)
        and math.clamp((1 - AimbotCFG.JumpSmooth) * (1 + bf), 0.01, 1)
        or  math.clamp((1 - AimbotCFG.YSmooth)    * (1 + bf), 0.01, 1)
    delayedTargetPos = Vector3.new(
        delayedTargetPos.X + (realPos.X - delayedTargetPos.X) * xA,
        delayedTargetPos.Y + (realPos.Y - delayedTargetPos.Y) * yA,
        delayedTargetPos.Z + (realPos.Z - delayedTargetPos.Z) * xA
    )
    return delayedTargetPos
end

local function isTargetStillValid(part)
    if not part or not part.Parent then return false end
    local hum = part.Parent:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    if not isInAimbotFOV(part) then return false end
    if AimbotCFG.VisibleCheck and not isVisible(camera.CFrame.Position, part) then return false end
    if AimbotCFG.TeamCheck then
        local p = Players:GetPlayerFromCharacter(part.Parent)
        if p and isSameTeamRivals(p) then return false end
    end
    return true
end

local function findNewAimbotTarget()
    local c    = getScreenCenter()
    local eFOV = getAimbotEffectiveFOV()
    local bp, bd = nil, eFOV
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LP then continue end
        if AimbotCFG.TeamCheck and isSameTeamRivals(p) then continue end
        if isInShootingRange(p) then continue end
        local ch = p.Character; if not ch then continue end
        local h = ch:FindFirstChildOfClass("Humanoid")
        if not h or h.Health <= 0 then continue end
        local part = getBestPart(ch, AimbotCFG.TargetPart)
        if not part then continue end
        local sp, on = camera:WorldToScreenPoint(part.Position)
        if not on then continue end
        local d = (Vector2.new(sp.X, sp.Y) - c).Magnitude
        if d > eFOV then continue end
        if AimbotCFG.VisibleCheck and not isVisible(camera.CFrame.Position, part) then continue end
        if d < bd then bd = d; bp = part end
    end
    return bp
end

-- ═══════════════════════════════════════════
-- TRACK DUMMY
-- ═══════════════════════════════════════════
local function getDummyTarget()
    local entities = Workspace:FindFirstChild("ShootingRangeEntities")
    if not entities then return nil end
    local children = entities:GetChildren()
    if #children == 0 then return nil end
    local idx   = math.clamp(TrackDummyCFG.DummyIndex, 1, #children)
    local dummy = children[idx]
    if not dummy then return nil end
    return getBestPart(dummy, AimbotCFG.TargetPart)
        or dummy:FindFirstChild("Head")
        or dummy:FindFirstChild("HumanoidRootPart")
        or dummy:FindFirstChildOfClass("BasePart")
end

local function runAimbot(dt)
    if fovCircle then
        fovCircle.Position = getScreenCenter()
        fovCircle.Radius   = getAimbotEffectiveFOV()
        fovCircle.Visible  = AimbotCFG.FOVStyle ~= "Invisible"
            and AimbotCFG.DrawFOV
            and (AimbotCFG.On or TrackDummyCFG.Enabled)
    end

    if not CameraController then return end

    if TrackDummyCFG.Enabled then
        local dummyPart = getDummyTarget()
        if dummyPart and dummyPart.Parent then
            local sm = math.clamp(1 / math.max(AimbotCFG.Smoothness, 0.1), 0.01, 1)
            pcall(function()
                local cp  = camera.CFrame.Position
                local du  = (dummyPart.Position - cp).Unit
                local tP  = math.asin(math.clamp(du.Y,-1,1))
                local tY  = math.atan2(-du.X,-du.Z)
                local cur = CameraController.Rotation
                CameraController:SetRotation(Vector2.new(
                    cur.X + (tP - cur.X) * sm,
                    cur.Y + angleDiff(cur.Y, tY) * sm
                ))
            end)
        end
        return
    end

    if not AimbotCFG.On then return end

    if isInReaction then
        reactionTimer = reactionTimer - dt
        if reactionTimer <= 0 then isInReaction = false end
    end

    if not isInReaction then
        if lockedTarget and not isTargetStillValid(lockedTarget) then
            lockedTarget = nil; lockTimer = 0; resetDelayedPos()
        end
        if not lockedTarget then
            local newT = findNewAimbotTarget()
            if newT then
                lockedTarget  = newT; lockTimer = 0
                isInReaction  = true; reactionTimer = AimbotCFG.ReactionTime / 1000
                resetDelayedPos()
            end
        end
        if lockedTarget then
            lockTimer = lockTimer + dt
            if lockTimer > AimbotCFG.ForgotTime then
                lockedTarget = nil; lockTimer = 0; resetDelayedPos()
            else
                if isInAimbotFOV(lockedTarget) then
                    local aimPos = getDelayedPos(lockedTarget, dt)
                    if aimPos then
                        local sm = math.clamp(1 / math.max(AimbotCFG.Smoothness, 0.1), 0.01, 1)
                        pcall(function()
                            local cp  = camera.CFrame.Position
                            local du  = (aimPos - cp).Unit
                            local tP  = math.asin(math.clamp(du.Y,-1,1))
                            local tY  = math.atan2(-du.X,-du.Z)
                            local cur = CameraController.Rotation
                            CameraController:SetRotation(Vector2.new(
                                cur.X + (tP - cur.X) * sm,
                                cur.Y + angleDiff(cur.Y, tY) * sm
                            ))
                        end)
                    end
                else
                    lockedTarget = nil; lockTimer = 0; resetDelayedPos()
                end
            end
        end
    end
end

-- ═══════════════════════════════════════════
-- AUTO BACKSTAB
-- ═══════════════════════════════════════════
local function getBackstabHitboxPart()
    local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end
    for _, part in ipairs(CollectionService:GetTagged("FireHitbox")) do
        if (part.Position - myRoot.Position).Magnitude < 15 then
            return part
        end
    end
    return nil
end

local function isEquippingKnife()
    if not AutoBackstabCFG.OnlyKnife then return true end
    local char = LP.Character; if not char then return false end
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Tool") then
            local name = child.Name:lower()
            if string.find(name,"knife") or string.find(name,"karambit")
               or string.find(name,"balisong") or string.find(name,"chancla")
               or string.find(name,"machete") or string.find(name,"key") then
                return true
            end
        end
    end
    return false
end

local function isBehindTarget(targetChar)
    local myRoot    = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    local theirRoot = targetChar:FindFirstChild("HumanoidRootPart")
    if not myRoot or not theirRoot then return false end
    local dirToUs   = (myRoot.Position - theirRoot.Position).Unit
    local theirLook = theirRoot.CFrame.LookVector
    return theirLook:Dot(dirToUs) < 0
end

local function startAutoBackstab()
    if backstabConn then backstabConn:Disconnect() end
    backstabConn = RunService.Heartbeat:Connect(function()
        if not AutoBackstabCFG.Enabled then return end
        if not isEquippingKnife() then return end
        local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        if not myRoot then return end
        local bestEnemy, bestDist = nil, AutoBackstabCFG.MaxDistance
        for _, p in ipairs(Players:GetPlayers()) do
            if p == LP then continue end
            if AutoBackstabCFG.TeamCheck and isSameTeamRivals(p) then continue end
            if not IsAlive(p) then continue end
            local theirRoot = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
            if not theirRoot then continue end
            local dist = (myRoot.Position - theirRoot.Position).Magnitude
            if dist < bestDist then bestDist = dist; bestEnemy = p end
        end
        if not bestEnemy or not bestEnemy.Character then return end
        if not isBehindTarget(bestEnemy.Character) then return end
        local hitboxPart = getBackstabHitboxPart()
        if not hitboxPart then return end
        local enemyRoot = bestEnemy.Character:FindFirstChild("HumanoidRootPart")
        if not enemyRoot then return end
        pcall(function()
            firetouchinterest(hitboxPart, enemyRoot, 0)
            task.wait(AutoBackstabCFG.FireRate)
            firetouchinterest(hitboxPart, enemyRoot, 1)
        end)
    end)
end

local function stopAutoBackstab()
    AutoBackstabCFG.Enabled = false
    if backstabConn then backstabConn:Disconnect(); backstabConn = nil end
end

-- ═══════════════════════════════════════════
-- ANTI SUBSPACE TRIPMINE
-- ═══════════════════════════════════════════
local function isTripmineFriendly(mineObj)
    local placedByUID = mineObj:GetAttribute("PlacedByUserID")
    if not placedByUID then return false end
    if placedByUID == LP.UserId then return true end
    local mineTeam = mineObj:GetAttribute("TeamID")
    local myTeam   = nil
    pcall(function()
        if FighterCtrl and FighterCtrl.LocalFighter then
            myTeam = FighterCtrl.LocalFighter:Get("TeamID")
        end
    end)
    if myTeam and mineTeam and myTeam == mineTeam then return true end
    return false
end

local function revealTripmine(mineObj)
    for _, desc in ipairs(mineObj:GetDescendants()) do
        if desc:IsA("BasePart") or desc:IsA("Decal")
           or desc:IsA("Texture") or desc:IsA("ParticleEmitter")
           or desc:IsA("Trail") or desc:IsA("Beam") then
            pcall(function()
                tripmineVisualMap[desc] = desc.LocalTransparencyModifier
                desc.LocalTransparencyModifier = 0
            end)
        end
    end
end

local function detonateTripmine(mineObj)
    local hitbox = mineObj:FindFirstChild("Hitbox")
    local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if hitbox and myRoot then
        pcall(function()
            firetouchinterest(myRoot, hitbox, 0)
            task.wait(0.05)
            firetouchinterest(myRoot, hitbox, 1)
        end)
    end
end

local function onTripmineAdded(mineObj)
    if not AntiTripmineCFG.Enabled then return end
    if isTripmineFriendly(mineObj) then return end
    if AntiTripmineCFG.MakeVisible then
        revealTripmine(mineObj)
        local conn = mineObj.DescendantAdded:Connect(function(desc)
            if not AntiTripmineCFG.Enabled or not AntiTripmineCFG.MakeVisible then return end
            pcall(function()
                if desc:IsA("BasePart") or desc:IsA("Decal")
                   or desc:IsA("Texture") or desc:IsA("ParticleEmitter") then
                    tripmineVisualMap[desc] = desc.LocalTransparencyModifier
                    desc.LocalTransparencyModifier = 0
                end
            end)
        end)
        table.insert(tripmineConns, conn)
    end
    if AntiTripmineCFG.AutoDestroyMine then
        task.spawn(function()
            task.wait(0.2)
            if mineObj and mineObj.Parent then detonateTripmine(mineObj) end
        end)
    end
end

local function startAntiTripmine()
    for _, c in ipairs(tripmineConns) do pcall(function() c:Disconnect() end) end
    tripmineConns = {}
    local c1 = CollectionService:GetInstanceAddedSignal("SubspaceTripmine"):Connect(function(obj)
        if AntiTripmineCFG.Enabled then task.spawn(onTripmineAdded, obj) end
    end)
    table.insert(tripmineConns, c1)
    for _, obj in ipairs(CollectionService:GetTagged("SubspaceTripmine")) do
        task.spawn(onTripmineAdded, obj)
    end
end

local function stopAntiTripmine()
    AntiTripmineCFG.Enabled = false
    for _, c in ipairs(tripmineConns) do pcall(function() c:Disconnect() end) end
    tripmineConns = {}
    for part, origVal in pairs(tripmineVisualMap) do
        pcall(function() part.LocalTransparencyModifier = origVal end)
    end
    tripmineVisualMap = {}
end


local function playSoundOnce(soundId, volume)
    pcall(function()
        local part = Instance.new("Part")
        part.Anchored=true; part.CanCollide=false; part.Transparency=1; part.Size=Vector3.new(1,1,1)
        local myChar = LP.Character
        if myChar then
            local root = myChar:FindFirstChild("HumanoidRootPart")
            part.Position = root and root.Position or Vector3.new(0,0,0)
        end
        part.Parent = Workspace
        local snd = Instance.new("Sound")
        snd.SoundId=soundId; snd.Volume=volume or 1
        snd.RollOffMaxDistance=10000; snd.Parent=part; snd:Play()
        task.delay(5, function() pcall(function() part:Destroy() end) end)
    end)
end

local function startSoundSpam()
    if soundSpamTask then task.cancel(soundSpamTask); soundSpamTask = nil end
    soundSpamTask = task.spawn(function()
        while SoundSpamCFG.Enabled do
            local id = (SoundSpamCFG.CustomId ~= "" and SoundSpamCFG.CustomId) or SoundSpamCFG.SoundId
            playSoundOnce(id, SoundSpamCFG.Volume)
            task.wait(math.max(0.01, SoundSpamCFG.Interval))
        end
        soundSpamTask = nil
    end)
end

local function stopSoundSpam()
    SoundSpamCFG.Enabled = false
    if soundSpamTask then task.cancel(soundSpamTask); soundSpamTask = nil end
end


-- Make float button draggable on mobile
do
    local fbDragging = false
    local fbDragStart, fbStartPos

    floatBtn.InputBegan:Connect(function(input)
        if isTouchOrMouse(input) then
            fbDragging = true
            fbDragStart = getInputPos(input)
            fbStartPos = floatBtn.Position
        end
    end)

    floatBtn.InputEnded:Connect(function(input)
        if isTouchOrMouse(input) then
            fbDragging = false
        end
    end)

    table.insert(ActiveConnections, UIS.InputChanged:Connect(function(input)
        if fbDragging and isTouchOrMouseMove(input) then
            local delta = getInputPos(input) - fbDragStart
            local moved = delta.Magnitude > 8
            if moved then
                floatBtn.Position = UDim2.new(
                    fbStartPos.X.Scale, fbStartPos.X.Offset + delta.X,
                    fbStartPos.Y.Scale, fbStartPos.Y.Offset + delta.Y
                )
            end
        end
    end))
end


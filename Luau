local SA_PEEK_OFFSETS = {
    Vector3.new(0,12,0),Vector3.new(0,16,0),Vector3.new(0,20,0),Vector3.new(0,24,0),
    Vector3.new(0,28,0),Vector3.new(0,32,0),Vector3.new(0,36,0),Vector3.new(0,40,0),
}
local sa_ray_params = RaycastParams.new()

local function saGetEffectiveFOV()
    if SAHookCFG.IgnoreFOV then return math.huge end
    local f = SAHookCFG.FOVSize
    if SAHookCFG.DynamicFOV then f = f * (camera.FieldOfView / 70) end
    return f
end

local function saHookVisible(part, camPos)
    if not SAHookCFG.VisCheck then return true end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {LP.Character, part.Parent}
    local result = Workspace:Raycast(camPos, part.Position - camPos, params)
    return result == nil or result.Instance:IsDescendantOf(part.Parent)
end

local function saHookValid(plr, camPos, center)
    local char = plr.Character; if not char then return false end
    local hum  = char:FindFirstChildOfClass("Humanoid")
    if not (hum and hum.Health > 0) then return false end
    local myEnv    = LP:GetAttribute("EnvironmentID")
    local theirEnv = plr:GetAttribute("EnvironmentID")
    if myEnv ~= nil and theirEnv ~= nil and myEnv ~= theirEnv then return false end
    if SAHookCFG.TeamCheck and isSameTeamRivals(plr) then return false end
    local tp = getBestPart(char, SAHookCFG.TargetParts); if not tp then return false end
    if not SAHookCFG.IgnoreFOV then
        local sp, on = Workspace.CurrentCamera:WorldToViewportPoint(tp.Position)
        if not on then return false end
        if (Vector2.new(sp.X, sp.Y) - center).Magnitude > saGetEffectiveFOV() then return false end
    end
    if not saHookVisible(tp, camPos) then return false end
    return true
end

local function updateSATarget()
    if not SAHookCFG.On then
        saHookTarget = nil; saCurrentTarget = nil; saCurrentTargetChar = nil; return
    end
    local cam    = Workspace.CurrentCamera
    local camPos = cam.CFrame.Position
    local center = cam.ViewportSize / 2
    local best, bd, bestChar = nil, math.huge, nil
    for _, plr in Players:GetPlayers() do
        if plr == LP then continue end
        if saHookValid(plr, camPos, center) then
            local char = plr.Character; if not char then continue end
            local tp = getBestPart(char, SAHookCFG.TargetParts); if not tp then continue end
            local sp, on = cam:WorldToViewportPoint(tp.Position)
            if on then
                local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                if SAHookCFG.Targeting == "Closest" and d < bd then
                    bd = d; best = tp; bestChar = char
                elseif SAHookCFG.Targeting == "Furthest" and (d > bd or bd == math.huge) then
                    bd = d; best = tp; bestChar = char
                elseif SAHookCFG.Targeting == "Random" and (best == nil or math.random() < 0.5) then
                    best = tp; bestChar = char
                end
            end
        end
    end
    saHookTarget = best and best.Position or nil
    saCurrentTarget = best; saCurrentTargetChar = bestChar
end

local function startSAHook()
    if not saHookApplied then
        local ok = pcall(function()
            saHookIdx = hookmetamethod(game, "__index", newcclosure(function(self, idx, ...)
                if not SAHookCFG.On then return saHookIdx(self, idx, ...) end
                if saHookTarget and not checkcaller() and idx == "ViewportSize" and self == Workspace.CurrentCamera then
                    if math.random(1,100) <= SAHookCFG.HitChance then
                        local pos, on = Workspace.CurrentCamera:WorldToViewportPoint(saHookTarget)
                        if on then return Vector2.new(pos.X*2, pos.Y*2) end
                    end
                end
                return saHookIdx(self, idx, ...)
            end))
        end)
        if ok then saHookApplied = true end
    end
end

local function startSAManipulation()
    if saManipConn then saManipConn:Disconnect() end
    saManipConn = RunService.Heartbeat:Connect(function(dt)
        if not SAHookCFG.On or not SAHookCFG.Manipulation then return end
        if not LP.Character or not LP.Character:FindFirstChild("HumanoidRootPart") then return end
        if not sa_fighter_mod or not sa_fighter_mod.LocalFighter then return end
        local item = sa_fighter_mod.LocalFighter.EquippedItem; if not item then return end
        if not saCurrentTarget or not saCurrentTargetChar then return end
        if math.random(1,100) > SAHookCFG.HitChance then return end
        sa_reloadCooldown = sa_reloadCooldown - dt
        local ammo = nil; pcall(function() ammo = item:Get("CurrentAmmo") end)
        if ammo ~= nil and ammo <= 0 and sa_reloadCooldown <= 0 then
            pcall(function() rs.Remotes.Replication.Fighter.UseItem:FireServer(item:Get("ObjectID"), sa_enums_mod:ToEnum("Reload"), {}, nil) end)
            sa_reloadCooldown = 2.0; return
        end
        local cam    = ws.CurrentCamera.CFrame
        local tp     = saCurrentTarget
        local tc     = saCurrentTargetChar
        local origin = cam.Position
        sa_ray_params.FilterDescendantsInstances = {LP.Character, tc}
        sa_ray_params.FilterType = Enum.RaycastFilterType.Exclude
        local manip, height
        if not ws:Raycast(origin, tp.Position - origin, sa_ray_params) then
            manip = origin; height = nil
        else
            for _, offset in next, SA_PEEK_OFFSETS do
                local sp = origin + offset
                if not ws:Raycast(sp, tp.Position - sp, sa_ray_params) then
                    manip = sp; height = offset.Y; break
                end
            end
        end
        if not manip then return end
        local sp = (height == nil and manip) or cam.Position
        local cd = {}
        cd[utf8.char(1)] = {
            [utf8.char(0)] = sa_util_mod:EncodeCFrame(CFrame.new(sp.X,sp.Y+(height or 0),sp.Z)*CFrame.Angles(CFrame.lookAt(sp,tp.Position):ToOrientation())),
            [utf8.char(1)] = height and sa_util_mod:EncodeCFrame(CFrame.new(tp.Position)*CFrame.Angles(CFrame.lookAt(sp,tp.Position):ToOrientation()))
                or sa_util_mod:EncodeCFrame(CFrame.new(sp.X,sp.Y+(height or 0),sp.Z)*CFrame.Angles(CFrame.lookAt(sp,tp.Position):ToOrientation())),
            [utf8.char(2)] = tp,
            [utf8.char(3)] = sa_util_mod:EncodeCFrame(tp.CFrame:ToObjectSpace(CFrame.new(tp.Position))),
        }
        pcall(function() rs.Remotes.Replication.Fighter.UseItem:FireServer(item:Get("ObjectID"), sa_enums_mod:ToEnum("StartShooting"), cd, nil) end)
    end)
end

local function startSA()
    startSAHook()
    if saTargetUpdateConn then saTargetUpdateConn:Disconnect() end
    saTargetUpdateConn = RunService.Heartbeat:Connect(function() updateSATarget() end)
    if SAHookCFG.Manipulation then startSAManipulation() end
end

local function stopSAHook()
    SAHookCFG.On = false; saHookTarget = nil; saCurrentTarget = nil; saCurrentTargetChar = nil
    if saTargetUpdateConn then saTargetUpdateConn:Disconnect(); saTargetUpdateConn = nil end
    if saManipConn then saManipConn:Disconnect(); saManipConn = nil end
end


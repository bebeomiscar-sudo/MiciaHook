-- MAIN RENDER LOOP
-- ═══════════════════════════════════════════
rs.RenderStepped:Connect(function(dt)
    cam = ws.CurrentCamera
    local center = screenCenter()

    -- FOV circles
    abFovCircle.Position = center
    abFovCircle.Radius   = abGetEffFOV()
    abFovCircle.Visible  = AB.drawFov and AB.on

    saFovCirc.Position = center
    saFovCirc.Radius   = SA.fov
    saFovCirc.Visible  = SA.drawFov and SA.on

    -- Update tracers
    updateTracers()

    -- Update ESP
    updateESP()

    -- Update SA target
    if SA.on then saFindTarget() end

    -- LEGITBOT using CameraController.ApplyRotationDelta
    if AB.on and mCam then
        if abReact then
            abReactT = abReactT - dt
            if abReactT <= 0 then abReact=false end
        end
        if not abReact then
            if abTarget and not abTargetValid(abTarget) then
                abTarget=nil; abLockT=0
            end
            if not abTarget then
                abTarget = abFindTarget()
                if abTarget then
                    abLockT  = 0
                    abReact  = true
                    abReactT = AB.react/1000
                end
            end
            if abTarget then
                abLockT = abLockT + dt
                if abLockT > AB.lockTime then
                    abTarget=nil; abLockT=0
                elseif inFOV(abTarget, abGetEffFOV()) then
                    pcall(function()
                        local camPos = cam.CFrame.Position
                        local du     = (abTarget.Position - camPos).Unit
                        local tPitch = math.asin(math.clamp(du.Y,-1,1))
                        local tYaw   = math.atan2(-du.X, -du.Z)
                        local cur    = mCam.Rotation
                        local sm     = 1/math.max(AB.speed, 0.1)
                        -- Use the game's own ApplyRotationDelta method
                        local dp = (tPitch - cur.X) * sm
                        local dy = angleDiff(cur.Y, tYaw) * sm
                        mCam:ApplyRotationDelta(Vector2.new(dp, dy))
                    end)
                else
                    abTarget=nil; abLockT=0
                end
            end
        end
    end
end)


    LeftHip   = function(t) return CFrame.Angles(math.rad(90),0,0) end,
    RightKnee = function(t) return CFrame.Angles(math.rad(90),0,0) end,
    LeftKnee  = function(t) return CFrame.Angles(math.rad(-90),0,0) end,

        TextTruncate=Enum.TextTruncate.AtEnd,Parent=btn,
    })
    local tab={btn=btn,indicator=ind,lbl=lbl,page=page}
    table.insert(tabData,tab)
    btn.MouseButton1Click:Connect(function()
        if activeTab then
            activeTab.indicator.Visible=false;activeTab.lbl.TextColor3=C.dim
            activeTab.btn.BackgroundTransparency=1;activeTab.page.Visible=false

local function makeToggle(parent,label,default,order,callback)
    local state = default or false
    local frame = make("Frame",{Size=UDim2.new(1,0,0,TOGGLE_H),BackgroundColor3=C.elem,BorderSizePixel=0,LayoutOrder=order,Parent=parent})
    make("UICorner",{CornerRadius=UDim.new(0,s(3)),Parent=frame})
    make("TextLabel",{
        Size=UDim2.new(1,-s(60),1,0),Position=UDim2.new(0,s(12),0,0),
        BackgroundTransparency=1,Text=label,TextColor3=C.text,Font=Enum.Font.Gotham,
        TextSize=FONT_MAIN,TextXAlignment=Enum.TextXAlignment.Left,
        TextTruncate=Enum.TextTruncate.AtEnd,Parent=frame,
    })
    local tW,tH,kS = s(40),s(20),s(16)
    local track = make("Frame",{
        Size=UDim2.new(0,tW,0,tH),Position=UDim2.new(1,-tW-s(10),0.5,-tH/2),
        BackgroundColor3=state and C.accent or C.off,BorderSizePixel=0,Parent=frame,
    })
    make("UICorner",{CornerRadius=UDim.new(0,tH/2),Parent=track})
    local knob = make("Frame",{
        Size=UDim2.new(0,kS,0,kS),
        Position=state and UDim2.new(1,-kS-s(2),0.5,-kS/2) or UDim2.new(0,s(2),0.5,-kS/2),
        BackgroundColor3=C.text,BorderSizePixel=0,Parent=track,
    })
    make("UICorner",{CornerRadius=UDim.new(1,0),Parent=knob})
    local btn = make("TextButton",{Size=UDim2.new(1,0,1,0),BackgroundTransparency=1,Text="",Parent=frame})
    btn.MouseButton1Click:Connect(function()
        state = not state
        tw(track,0.18,{BackgroundColor3=state and C.accent or C.off})
        tw(knob,0.18,{Position=state and UDim2.new(1,-kS-s(2),0.5,-kS/2) or UDim2.new(0,s(2),0.5,-kS/2)})
        if callback then callback(state) end
    end)
    return {
        getState=function() return state end,
        setState=function(v) state=v
            track.BackgroundColor3=v and C.accent or C.off
            knob.Position=v and UDim2.new(1,-kS-s(2),0.5,-kS/2) or UDim2.new(0,s(2),0.5,-kS/2)
        end,
    }
end

local function makeSlider(parent,label,min,max,default,increment,order,callback)
    local value = default
    local frame = make("Frame",{Size=UDim2.new(1,0,0,SLIDER_H),BackgroundColor3=C.elem,BorderSizePixel=0,LayoutOrder=order,Parent=parent})
    make("UICorner",{CornerRadius=UDim.new(0,s(3)),Parent=frame})
    make("TextLabel",{
        Size=UDim2.new(0.55,0,0,s(22)),Position=UDim2.new(0,s(12),0,s(2)),
        BackgroundTransparency=1,Text=label,TextColor3=C.text,Font=Enum.Font.Gotham,
        TextSize=s(12),TextXAlignment=Enum.TextXAlignment.Left,
        TextTruncate=Enum.TextTruncate.AtEnd,Parent=frame,
    })
    local valLabel = make("TextLabel",{
        Size=UDim2.new(0.4,0,0,s(22)),Position=UDim2.new(0.57,0,0,s(2)),
        BackgroundTransparency=1,Text=fmtN(value,increment),TextColor3=C.dim,
        Font=Enum.Font.GothamSemibold,TextSize=s(12),TextXAlignment=Enum.TextXAlignment.Right,Parent=frame,
    })
    local bH=s(8)
    local trackBG = make("Frame",{
        Size=UDim2.new(1,-s(24),0,bH),Position=UDim2.new(0,s(12),0,SLIDER_H-bH-s(10)),
        BackgroundColor3=C.border,BorderSizePixel=0,Parent=frame,
    })
    make("UICorner",{CornerRadius=UDim.new(0,s(3)),Parent=trackBG})
    local pct=math.clamp((default-min)/(max-min),0,1)
    local fill = make("Frame",{Size=UDim2.new(pct,0,1,0),BackgroundColor3=C.accent,BorderSizePixel=0,Parent=trackBG})
    make("UICorner",{CornerRadius=UDim.new(0,s(3)),Parent=fill})
    local hS=s(18)
    local handle = make("Frame",{
        Size=UDim2.new(0,hS,0,hS),Position=UDim2.new(pct,-hS/2,0.5,-hS/2),
        BackgroundColor3=C.text,BorderSizePixel=0,ZIndex=3,Parent=trackBG,
    })
    make("UICorner",{CornerRadius=UDim.new(1,0),Parent=handle})
    local touchZone = make("TextButton",{
        Size=UDim2.new(1,s(20),0,s(30)),Position=UDim2.new(0,-s(10),0.5,-s(15)),
        BackgroundTransparency=1,Text="",ZIndex=4,Parent=trackBG,
    })
    local sliding=false
    local function upd(ix)
        local r=math.clamp((ix-trackBG.AbsolutePosition.X)/trackBG.AbsoluteSize.X,0,1)
        value=math.clamp(math.floor((min+(max-min)*r)/increment+0.5)*increment,min,max)
        local fp=(value-min)/(max-min)
        fill.Size=UDim2.new(fp,0,1,0)
        handle.Position=UDim2.new(fp,-hS/2,0.5,-hS/2)
        valLabel.Text=fmtN(value,increment)
        if callback then callback(value) end
    end
    touchZone.InputBegan:Connect(function(i) if isTM(i) then sliding=true;upd(i.Position.X) end end)
    handle.InputBegan:Connect(function(i) if isTM(i) then sliding=true end end)
    table.insert(ActiveConnections,UIS.InputChanged:Connect(function(i) if sliding and isTMMove(i) then upd(i.Position.X) end end))
    table.insert(ActiveConnections,UIS.InputEnded:Connect(function(i) if isTM(i) then sliding=false end end))
    return {
        getValue=function() return value end,
        setValue=function(v)
            value=v;local p=(v-min)/(max-min)
            fill.Size=UDim2.new(p,0,1,0);handle.Position=UDim2.new(p,-hS/2,0.5,-hS/2)
            valLabel.Text=fmtN(v,increment)
        end,
    }
end


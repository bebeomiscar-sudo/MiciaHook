    pcall(function()
        local mi = LP:GetAttribute("TeamID"); local ti = p:GetAttribute("TeamID")
        if mi ~= nil and ti ~= nil then same = (mi == ti) end
    end)
    if not same then
        pcall(function() same = p.Team ~= nil and LP.Team ~= nil and p.Team == LP.Team end)
    end
    return same
end

local function isVisible(origin, targetPart)
    if not targetPart then return false end
    local ok, r = pcall(function()
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = {LP.Character, targetPart.Parent, Workspace:FindFirstChild("Debris")}
        local hit = Workspace:Raycast(origin, targetPart.Position - origin, params)
        return hit == nil or hit.Instance:IsDescendantOf(targetPart.Parent)
    end)
    return ok and r or false
end


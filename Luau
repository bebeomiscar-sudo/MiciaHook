-- DELAYED POSITION
local delayedTargetPos=nil
local function resetDelayedPos() delayedTargetPos=nil end
local function getDelayedPos(targetPart,dt)
    if not targetPart or not targetPart.Parent then delayedTargetPos=nil; return nil end
    local realPos=targetPart.Position
    if not delayedTargetPos then delayedTargetPos=realPos; return realPos end
    local isJumping=false
    pcall(function()
        local hrp=targetPart.Parent:FindFirstChild("HumanoidRootPart")
        if hrp then isJumping=hrp.AssemblyLinearVelocity.Y>2 end
    end)
    local baseFrames=60*dt
    local xAlpha=math.clamp((1-AimbotCFG.XSmooth)*(1+baseFrames),0.01,1)
    local yAlpha
    if isJumping and AimbotCFG.JumpSmooth>0 then
        yAlpha=math.clamp((1-AimbotCFG.JumpSmooth)*(1+baseFrames),0.01,1)
    else
        yAlpha=math.clamp((1-AimbotCFG.YSmooth)*(1+baseFrames),0.01,1)
    end
    delayedTargetPos=Vector3.new(
        delayedTargetPos.X+(realPos.X-delayedTargetPos.X)*xAlpha,
        delayedTargetPos.Y+(realPos.Y-delayedTargetPos.Y)*yAlpha,
        delayedTargetPos.Z+(realPos.Z-delayedTargetPos.Z)*xAlpha
    )
    return delayedTargetPos
end


local function makeModeSelect(parent,label,options,defaultMode,order,callback)
    local idx=1
    for i,o in ipairs(options) do if o==defaultMode then idx=i;break end end
    local f=make("Frame",{Size=UDim2.new(1,0,0,TOGGLE_H),BackgroundColor3=C.elem,BorderSizePixel=0,LayoutOrder=order,Parent=parent});make("UICorner",{CornerRadius=UDim.new(0,s(3)),Parent=f})
    make("TextLabel",{Size=UDim2.new(1,-s(120),1,0),Position=UDim2.new(0,s(12),0,0),BackgroundTransparency=1,Text=label,TextColor3=C.text,Font=Enum.Font.Gotham,TextSize=FONT_MAIN,TextXAlignment=Enum.TextXAlignment.Left,TextTruncate=Enum.TextTruncate.AtEnd,Parent=f})
    local mb=make("TextButton",{Size=UDim2.new(0,s(100),0,s(26)),Position=UDim2.new(1,-s(108),0.5,-s(13)),BackgroundColor3=C.border,BorderSizePixel=0,Text=options[idx],TextColor3=C.gold,Font=Enum.Font.GothamBold,TextSize=FONT_SMALL,Parent=f});make("UICorner",{CornerRadius=UDim.new(0,s(4)),Parent=mb})
    mb.MouseButton1Click:Connect(function()
        idx=idx%#options+1;mb.Text=options[idx]
        tw(mb,0.1,{BackgroundColor3=C.accent})
        task.delay(0.15,function() tw(mb,0.15,{BackgroundColor3=C.border}) end)
        if callback then callback(options[idx]) end
    end)
    return {getMode=function() return options[idx] end,setMode=function(mode) for i,o in ipairs(options) do if o==mode then idx=i;mb.Text=options[idx];break end end end}
end


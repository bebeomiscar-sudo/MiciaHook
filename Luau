local function findNewAimbotTarget()
    local c=getScreenCenter(); local bp,bd=nil,getEffectiveFOV()
    for _,p in ipairs(Players:GetPlayers()) do
        if p==LP then continue end
        if AimbotCFG.TeamCheck and isSameTeamRivals(p) then continue end
        local ch=p.Character; if not ch then continue end
        local h=ch:FindFirstChildOfClass("Humanoid")

-- WALLBANG SYSTEM
-- Method: patches Utility.Raycast to ignore
-- non-character BaseParts (walls etc.)
-- ═══════════════════════════════════════════
local WB = {
    enabled     = false,
    maxPen      = 3,        -- max wall penetrations
    dmgFalloff  = 0.2,      -- damage multiplier reduction per wall (0=none, 1=full)
    showMarker  = true,     -- show hit marker through walls
    method      = "Filter", -- "Filter" | "Penetration"
}

local wbApplied      = false
local wbHitGui       = Instance.new("ScreenGui", pg)
wbHitGui.Name        = "WBMarkers"
wbHitGui.ResetOnSpawn = false
wbHitGui.IgnoreGuiInset = true

-- Hit marker
local function showWBMarker(pos3)
    if not WB.showMarker then return end
    local s2=w2s(pos3); if not s2 then return end
    local lbl=Instance.new("TextLabel", wbHitGui)
    lbl.BackgroundTransparency=1; lbl.Size=UDim2.fromOffset(40,40)
    lbl.Position=UDim2.fromOffset(s2.X-20, s2.Y-20)
    lbl.Text="✕"; lbl.TextColor3=Color3.fromRGB(255,50,50)
    lbl.TextSize=32; lbl.Font=Enum.Font.GothamBold
    lbl.TextTransparency=0
    tws:Create(lbl,TweenInfo.new(0.5),{TextTransparency=1}):Play()
    task.delay(0.5,function() lbl:Destroy() end)
end

-- Helper: is this part a "wall" (not a player body part)
local function isWall(inst)
    if not inst or not inst:IsA("BasePart") then return false end
    -- if it has a humanoid ancestor → it's a player part, not a wall
    if inst.Parent and inst.Parent:FindFirstChildOfClass("Humanoid") then return false end
    if inst.Parent and inst.Parent.Parent and
        inst.Parent.Parent:FindFirstChildOfClass("Humanoid") then return false end
    return true
end

-- Build a filter list of all non-player parts in workspace
local function buildWallIgnore()
    local list={}
    for _, d in ipairs(ws:GetDescendants()) do
        if d:IsA("BasePart") then
            local isChar=false
            for _, p in ipairs(plr:GetPlayers()) do
                if p.Character and d:IsDescendantOf(p.Character) then
                    isChar=true; break
                end
            end
            if not isChar then table.insert(list,d) end
        end
    end
    return list
end

-- Penetration raycast: shoots through walls up to WB.maxPen layers
local function penetrationRaycast(origin, direction, distance, params)
    local rp=RaycastParams.new()
    rp.FilterType=Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances={}
    local pen=0; local orig=origin; local result=nil
    for _=1, WB.maxPen+1 do
        local r=ws:Raycast(orig, direction*(distance or 1000), rp)
        if not r then break end
        if r.Instance then
            if isWall(r.Instance) then
                -- pass through: add to ignore list and advance origin
                table.insert(rp.FilterDescendantsInstances, r.Instance)
                orig=r.Position + direction.Unit*0.1
                pen=pen+1
                if pen>WB.maxPen then break end
                showWBMarker(r.Position)
            else
                -- hit a player
                result=r; break
            end
        end
    end
    return result
end

local function applyWallbang()
    if wbApplied then return end
    if not mUtil then Lib:Notify("WB: Utility not loaded",3); return end

    local origRC=mUtil.Raycast
    mUtil.Raycast = function(self, origin, direction, distance, ...)
        if WB.enabled then
            if WB.method=="Penetration" then
                local r=penetrationRaycast(origin, direction, distance)
                if r then return r end
            elseif WB.method=="Filter" then
                -- build ignore list excluding players
                local rp=RaycastParams.new()
                rp.FilterType=Enum.RaycastFilterType.Exclude
                rp.FilterDescendantsInstances=buildWallIgnore()
                local r=ws:Raycast(origin, direction*(distance or 1000), rp)
                if r then showWBMarker(r.Position); return r end
            end
        end
        if SA.on then
            local target=saGetTarget(origin)
            if target then return origRC(self,origin,target.Position,distance,...) end
        end
        return origRC(self,origin,direction,distance,...)
    end
    wbApplied=true; Lib:Notify("Wallbang hooked (Utility.Raycast)",3)
end


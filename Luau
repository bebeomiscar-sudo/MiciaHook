closeBtn.MouseButton1Click:Connect(function()
    CFG.Orbit.On = false
    CFG.Void.On = false
    for _, conn in pairs(ActiveConnections) do
        pcall(function() conn:Disconnect() end)
    end
    gui:Destroy()
end)

local minimized = false
minBtn.MouseButton1Click:Connect(function()
    minimized = not minimized
    tw(mainFrame, 0.25, {
        Size = minimized
            and UDim2.new(0, WIN_W, 0, TOP_H)
            or  UDim2.new(0, WIN_W, 0, WIN_H)
    })
    contentArea.Visible = not minimized
    sidebar.Visible = not minimized
    statusBar.Visible = not minimized
end)

-- Float button toggles UI visibility
local floatDebounce = false
floatBtn.MouseButton1Click:Connect(function()
    if floatDebounce then return end
    floatDebounce = true
    mainFrame.Visible = not mainFrame.Visible
    floatBtn.BackgroundColor3 = mainFrame.Visible and C.accent or C.off
    task.wait(0.2)
    floatDebounce = false
end)

-- PC keyboard toggle
table.insert(ActiveConnections, UIS.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == CFG.UIKey then
        mainFrame.Visible = not mainFrame.Visible
        floatBtn.BackgroundColor3 = mainFrame.Visible and C.accent or C.off
    end
end))


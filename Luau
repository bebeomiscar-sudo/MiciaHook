                local dist=(myHRP.Position-hitbox.Position).Magnitude
                if dist<=CFG.Ragebot.SubspaceRange then
                    pcall(function() firetouchinterest(myHRP,hitbox,1);firetouchinterest(myHRP,hitbox,0) end)
                end
            end
        end
    end
end


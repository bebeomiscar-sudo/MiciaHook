local function applyFOVStyle(circle)
    if not circle then return end
    local style = AimbotCFG.FOVStyle
    if style == "Invisible" then
        circle.Visible = false
    elseif style == "Filled" then
        circle.Filled    = true
        circle.Thickness = 1
        circle.Transparency = 0.85
        circle.Visible = AimbotCFG.DrawFOV and AimbotCFG.On
    else -- Half (default)

-- Snow (3D)
local snowEnabled  = false
local snowParts    = {}
local snowConn     = nil
local SNOW_COUNT   = 120

local function createSnowflake()
    local p = Instance.new("Part")
    p.Size           = Vector3.new(0.2, 0.2, 0.2)
    p.Shape          = Enum.PartType.Ball
    p.Anchored       = true
    p.CanCollide     = false
    p.CastShadow     = false
    p.Material       = Enum.Material.SmoothPlastic
    p.Color          = Color3.fromRGB(240, 240, 255)
    p.Transparency   = 0.3
    p.Parent         = Workspace
    return p
end

local function randomSnowPos()
    local cam = Workspace.CurrentCamera
    local cp  = cam and cam.CFrame.Position or Vector3.new(0, 50, 0)
    return Vector3.new(
        cp.X + math.random(-50, 50),
        cp.Y + math.random(5, 30),
        cp.Z + math.random(-50, 50)
    )
end

local function startSnow()
    if snowConn then return end
    for i = 1, SNOW_COUNT do
        local p = createSnowflake()
        p.Position = randomSnowPos()
        table.insert(snowParts, p)
    end
    snowConn = RunService.Heartbeat:Connect(function(dt)
        local cam = Workspace.CurrentCamera
        local cp  = cam and cam.CFrame.Position or Vector3.new(0, 50, 0)
        for _, p in ipairs(snowParts) do
            if not p or not p.Parent then continue end
            local pos = p.Position
            p.Position = pos + Vector3.new(
                math.sin(tick() * 0.5 + pos.X) * 0.02,
                -0.15 * dt * 60,
                math.cos(tick() * 0.3 + pos.Z) * 0.02
            )
            -- Respawn if too far or too low
            if (p.Position - cp).Magnitude > 60 or p.Position.Y < cp.Y - 20 then
                p.Position = randomSnowPos()
            end
        end
    end)
end

local function stopSnow()
    if snowConn then snowConn:Disconnect(); snowConn = nil end
    for _, p in ipairs(snowParts) do pcall(function() p:Destroy() end) end
    snowParts = {}
end


-- FIX 2: AIMBOT WITH PROPER TEAM CHECK
-- ═══════════════════════════════════════════
local function getAimbotTarget()
    local c = getScreenCenter()
    local bp, bd = nil, CFG.Aimbot.FOV
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LP then continue end

        -- Team check with Rivals fallback
        if CFG.Aimbot.TeamCheck then
            local sameTeam = false
            pcall(function()
                sameTeam = p.Team ~= nil and LP.Team ~= nil and p.Team == LP.Team
            end)
            -- Rivals fallback: check TeamTag value objects
            if not sameTeam then
                pcall(function()
                    local tag = p.Character and p.Character:FindFirstChild("TeamTag")
                    local myTag = LP.Character and LP.Character:FindFirstChild("TeamTag")
                    if tag and myTag then
                        sameTeam = tag.Value == myTag.Value
                    end
                end)
            end
            if sameTeam then continue end
        end

        local ch = p.Character
        if not ch then continue end
        local h = ch:FindFirstChildOfClass("Humanoid")
        if not h or h.Health <= 0 then continue end
        local part = ch:FindFirstChild(CFG.Aimbot.AimHead and "Head" or "HumanoidRootPart")
        if not part then continue end
        if CFG.Aimbot.VisibleCheck and not isVisible(part) then continue end
        local sp, on = camera:WorldToScreenPoint(part.Position)
        if not on then continue end
        local d = (Vector2.new(sp.X, sp.Y) - c).Magnitude
        if d < bd then bd = d; bp = part end
    end
    return bp
end


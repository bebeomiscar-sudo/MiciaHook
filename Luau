-- PROJECTILE CHECK
-- ═══════════════════════════════════════════
local function checkProjectiles()
    if not CFG.Void.ProjectileMimic or not Desync.realCFrame then return false end
    local myPos=Desync.realCFrame.Position; local range=CFG.Void.DetectionRange
    local params=OverlapParams.new(); params.FilterType=Enum.RaycastFilterType.Exclude; params.FilterDescendantsInstances={character}
    local ok,parts=pcall(function() return workspace:GetPartBoundsInRadius(myPos,range,params) end)
    if not ok or not parts then return false end
    for _,part in ipairs(parts) do if not part:IsDescendantOf(character) then local vel=part.AssemblyLinearVelocity; if vel.Magnitude>80 then local toUs=(myPos-part.Position); if toUs.Magnitude>1 and toUs.Unit:Dot(vel.Unit)>0.4 then return true end end end end
    return false
end


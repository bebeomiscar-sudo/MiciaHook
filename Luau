-- AIMBOT (Sticky Lock + Multi-Mode)
-- ═══════════════════════════════════════════
local lockTimer     = 0
local lockedTarget  = nil
local reactionTimer = 0
local isInReaction  = false
local aimbotConn    = nil

local function isTargetStillValid(part)
    if not part or not part.Parent then return false end
    local hum = part.Parent:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    if AimbotCFG.VisibleCheck and not isAimbotVisible(part) then return false end
    if AimbotCFG.TeamCheck then
        local p = Players:GetPlayerFromCharacter(part.Parent)
        if p and isSameTeam(p) then return false end
    end
    return true
end

local function findNewAimbotTarget()
    local c = getScreenCenter()
    local bp, bd = nil, getEffectiveFOV()
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LP then continue end
        if AimbotCFG.TeamCheck and isSameTeam(p) then continue end
        local ch = p.Character; if not ch then continue end
        local h  = ch:FindFirstChildOfClass("Humanoid")
        if not h or h.Health <= 0 then continue end
        local part = getBestPart(ch, AimbotCFG.TargetPart); if not part then continue end
        if AimbotCFG.VisibleCheck and not isAimbotVisible(part) then continue end
        local sp, on = camera:WorldToScreenPoint(part.Position)
        if not on then continue end
        local d = (Vector2.new(sp.X, sp.Y) - c).Magnitude
        if d < bd then bd = d; bp = part end
    end
    return bp
end

local function startAimbot()
    if aimbotConn then aimbotConn:Disconnect() end
    aimbotConn = RunService.RenderStepped:Connect(function(dt)
        if not AimbotCFG.On then
            if aimbotConn then aimbotConn:Disconnect(); aimbotConn = nil end
            return
        end
        -- Keybind check
        if AimbotCFG.UseKeybind and not UIS:IsKeyDown(AimbotCFG.Keybind) then return end
        local mode = AimbotCFG.Mode
        if mode == "Memory" or mode == "Camera" then
            -- Sticky lock logic
            if isInReaction then
                reactionTimer = reactionTimer - dt
                if reactionTimer <= 0 then isInReaction = false end
                return
            end
            if lockedTarget and not isTargetStillValid(lockedTarget) then
                lockedTarget = nil; lockTimer = 0
            end
            if not lockedTarget then
                local newTarget = findNewAimbotTarget()
                if newTarget then
                    lockedTarget = newTarget; lockTimer = 0
                    isInReaction = true; reactionTimer = AimbotCFG.ReactionTime / 1000
                end
            end
            if lockedTarget and CameraController then
                lockTimer = lockTimer + dt
                if lockTimer > AimbotCFG.MaxLockTime then
                    lockedTarget = nil; lockTimer = 0
                else
                    local isAttacking = false
                    pcall(function()
                        if fighter_mod and fighter_mod.LocalFighter then
                            isAttacking = fighter_mod.LocalFighter:Get("IsShooting") == true
                        end
                    end)
                    local speed = isAttacking and AimbotCFG.SpeedInAttack or AimbotCFG.Speed
                    local sp2, on2 = camera:WorldToScreenPoint(lockedTarget.Position)
                    if on2 then
                        local screenDist = (Vector2.new(sp2.X, sp2.Y) - getScreenCenter()).Magnitude
                        local fovR = getEffectiveFOV()
                        if fovR > 0 then
                            local scale = 1 - ((screenDist / fovR) * (AimbotCFG.SpeedScaleFOV / 100))
                            speed = speed * math.max(0.1, scale)
                        end
                    end
                    pcall(function()
                        local cp  = camera.CFrame.Position
                        local du  = (lockedTarget.Position - cp).Unit
                        local tP  = math.asin(du.Y)
                        local tY  = math.atan2(-du.X, -du.Z)
                        local sm  = math.clamp(speed / 5, 0, 1)
                        local cur = CameraController.Rotation
                        CameraController:SetRotation(Vector2.new(
                            cur.X + (tP - cur.X) * sm,
                            cur.Y + angleDiff(cur.Y, tY) * sm
                        ))
                    end)
                end
            end
        elseif mode == "Mouse" then
            local t = getClosest({teamCheck=AimbotCFG.TeamCheck, visCheck=AimbotCFG.VisibleCheck})
            if not t or not t.Character then return end
            local part = getBestPart(t.Character, AimbotCFG.TargetPart)
            if not part then return end
            local sp, on = camera:WorldToViewportPoint(part.Position)
            if on and sp.Z > 0 then
                local vp = camera.ViewportSize
                local cx, cy = vp.X/2, vp.Y/2
                local nx = cx + (sp.X - cx) * AimbotCFG.Smoothness
                local ny = cy + (sp.Y - cy) * AimbotCFG.Smoothness
                pcall(function() mousemoveabs(nx, ny) end)
            end
        end
    end)
end
local function stopAimbot()
    AimbotCFG.On = false; lockedTarget = nil; lockTimer = 0
    if aimbotConn then aimbotConn:Disconnect(); aimbotConn = nil end
end

-- ═══════════════════════════════════════════
-- TRIGGERBOT
-- ═══════════════════════════════════════════
local TrigState = {waiting=false, timer=0, grace=0}
local trigConn  = nil
local lastTrigFire = 0

local function getTrigDelay()
    if TrigCFG.RandomDelay then
        return math.random(TrigCFG.MinDelay, TrigCFG.MaxDelay) / 1000
    end
    return TrigCFG.Delay / 1000
end

local function getTriggerTarget()
    local origin    = camera.CFrame.Position
    local direction = camera.CFrame.LookVector * 2000
    local params    = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local fl = {}
    if LP.Character then table.insert(fl, LP.Character) end
    params.FilterDescendantsInstances = fl
    local hit = workspace:Raycast(origin, direction, params)
    if not hit or not hit.Instance then return nil end
    local hitChar, inst = nil, hit.Instance
    while inst do
        if inst:FindFirstChildOfClass("Humanoid") then hitChar = inst; break end
        inst = inst.Parent
    end
    if not hitChar then return nil end
    local hum = hitChar:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return nil end
    local tp = Players:GetPlayerFromCharacter(hitChar)
    if not tp or tp == LP then return nil end
    if TrigCFG.TeamCheck and isSameTeam(tp) then return nil end
    local validNames = TARGET_PARTS[TrigCFG.TargetPart] or {"Head","UpperTorso","LowerTorso"}
    local partMatch  = false
    for _, pn in ipairs(validNames) do
        if hit.Instance.Name == pn then partMatch = true; break end
    end
    if not partMatch then return nil end
    if TrigCFG.VisibleCheck then
        local checkPart = hitChar:FindFirstChild("Head") or hit.Instance
        if not isAimbotVisible(checkPart) then return nil end
    end
    return hitChar
end

local function startTriggerbot()
    if trigConn then trigConn:Disconnect() end
    trigConn = RunService.Heartbeat:Connect(function()
        if not TrigCFG.On then
            if trigConn then trigConn:Disconnect(); trigConn = nil end; return
        end
        local tgt = getTriggerTarget()
        local now = tick()
        if tgt and (now - lastTrigFire) >= getTrigDelay() then
            lastTrigFire = now
            simClick()
        end
    end)
end
local function stopTriggerbot()
    TrigCFG.On = false
    if trigConn then trigConn:Disconnect(); trigConn = nil end
    TrigState.waiting = false; TrigState.timer = 0; TrigState.grace = 0
end

-- ═══════════════════════════════════════════
-- ANTI-AIM
-- ═══════════════════════════════════════════
local aaConn   = nil
local aaOrigC0 = nil

local function startAntiAim()
    if aaConn then aaConn:Disconnect() end
    local t = 0
    aaConn = RunService.RenderStepped:Connect(function(dt)
        if not AntiAimCFG.Enabled then
            aaConn:Disconnect(); aaConn = nil
            pcall(function()
                local char = LP.Character
                local hrp  = char and char:FindFirstChild("HumanoidRootPart")
                local rj   = hrp and hrp:FindFirstChild("RootJoint")
                if rj and aaOrigC0 then rj.C0 = aaOrigC0 end
            end)
            return
        end
        t = t + dt
        local char = LP.Character; if not char then return end
        local hrp  = char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
        local rj   = hrp:FindFirstChild("RootJoint"); if not rj then return end
        if not aaOrigC0 then aaOrigC0 = rj.C0 end
        local yaw, pitch = 0, 0
        local typ = AntiAimCFG.Type
        if     typ == "Backwards"  then yaw = math.rad(180)
        elseif typ == "Spin"       then yaw = t * 5
        elseif typ == "HideHead"   then pitch = math.rad(89)
        elseif typ == "BelowFloor" then pitch = math.rad(180)
        elseif typ == "Custom"     then
            yaw   = math.rad(AntiAimCFG.YawAngle)
            pitch = math.rad(AntiAimCFG.PitchAngle)
        end
        pcall(function() rj.C0 = aaOrigC0 * CFrame.Angles(pitch, yaw, 0) end)
    end)
end
local function stopAntiAim()
    AntiAimCFG.Enabled = false
    if aaConn then aaConn:Disconnect(); aaConn = nil end
    pcall(function()
        local char = LP.Character
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")
        local rj   = hrp and hrp:FindFirstChild("RootJoint")
        if rj and aaOrigC0 then rj.C0 = aaOrigC0 end
    end)
    aaOrigC0 = nil
end

-- ═══════════════════════════════════════════
-- FAKE LAG
-- ═══════════════════════════════════════════
local flConn = nil
local function startFakeLag()
    if flConn then flConn:Disconnect() end
    local lastFlip = tick(); local frozen = false
    flConn = RunService.Heartbeat:Connect(function()
        if not FakeLagCFG.Enabled then
            flConn:Disconnect(); flConn = nil
            pcall(function()
                local char = LP.Character
                local hrp  = char and char:FindFirstChild("HumanoidRootPart")
                if hrp then hrp.Anchored = false end
            end)
            return
        end
        local char = LP.Character
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local now = tick()
        if now - lastFlip >= FakeLagCFG.Interval then
            lastFlip = now; frozen = not frozen
            pcall(function() hrp.Anchored = frozen end)
            if frozen and FakeLagCFG.Desync then
                local orig = hrp.CFrame
                task.delay(0.016, function()
                    pcall(function()
                        hrp.CFrame = orig * CFrame.new(
                            (math.random()-0.5)*FakeLagCFG.DesyncStr, 0,
                            (math.random()-0.5)*FakeLagCFG.DesyncStr
                        )
                    end)
                    task.delay(0.016, function() pcall(function() hrp.CFrame = orig end) end)
                end)
            end
        end
    end)
end
local function stopFakeLag()
    FakeLagCFG.Enabled = false
    if flConn then flConn:Disconnect(); flConn = nil end
    pcall(function()
        local char = LP.Character
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then hrp.Anchored = false end
    end)
end

-- ═══════════════════════════════════════════
-- RAGEBOT (Remote Silent Aim)
-- ═══════════════════════════════════════════
local silentActive       = false
local silentVisibleCheck = false
local silentTeamCheck    = false
local silentFOV          = 999
local silentConn         = nil
local reloadCooldown     = 0

local ray_params_sa = RaycastParams.new()
local sa_offsets = {
    Vector3.new(0,12,0), Vector3.new(0,16,0), Vector3.new(0,20,0),
    Vector3.new(0,24,0), Vector3.new(0,28,0), Vector3.new(0,32,0),
}

local function sa_getClosest()
    if not LP.Character or not LP.Character:FindFirstChild("HumanoidRootPart") then return nil, nil end
    local target, tchar, dist = nil, nil, silentFOV
    for _, v in next, Players:GetPlayers() do
        if v == LP then continue end
        if silentTeamCheck and isSameTeam(v) then continue end
        if not v.Character or not v.Character:FindFirstChild("Head") then continue end
        local hum = v.Character:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end
        local mag = (LP.Character.HumanoidRootPart.Position - v.Character.Head.Position).Magnitude
        if mag < dist then dist = mag; target = v.Character.Head; tchar = v.Character end
    end
    return target, tchar
end

local function sa_calcPoint(origin, target_pos, target_char)
    ray_params_sa.FilterDescendantsInstances = {LP.Character, target_char}
    ray_params_sa.FilterType = Enum.RaycastFilterType.Exclude
    if not silentVisibleCheck then return origin, nil end
    if not workspace:Raycast(origin, target_pos - origin, ray_params_sa) then return origin, nil end
    for _, offset in next, sa_offsets do
        local scan_pos = origin + offset
        if not workspace:Raycast(scan_pos, target_pos - scan_pos, ray_params_sa) then
            return scan_pos, offset.Y
        end
    end
    return nil, nil
end

local function tryRagebotReload(item)
    if not item or not CFG.Void.AutoReload then return end
    pcall(function()
        ReplicatedStorage.Remotes.Replication.Fighter.UseItem:FireServer(
            item:Get("ObjectID"), enums_mod:ToEnum("Reload"), {}, nil
        )
    end)
end

local function startRagebotSA()
    if silentConn then silentConn:Disconnect() end
    silentConn = RunService.Heartbeat:Connect(function(dt)
        if not silentActive then return end
        if not LP.Character then return end
        if not LP.Character:FindFirstChild("HumanoidRootPart") then return end
        if not fighter_mod or not fighter_mod.LocalFighter then return end
        local item = fighter_mod.LocalFighter.EquippedItem
        if not item then return end
        if CFG.Void.AutoReload then
            reloadCooldown = reloadCooldown - dt
            local currentAmmo = nil
            pcall(function() currentAmmo = item:Get("CurrentAmmo") end)
            if currentAmmo ~= nil and currentAmmo <= 0 and reloadCooldown <= 0 then
                tryRagebotReload(item); reloadCooldown = 2.0; return
            end
        end
        local target_part, target_char = sa_getClosest()
        if not target_part or not target_char then return end
        local cam    = workspace.CurrentCamera.CFrame
        local manip, height = sa_calcPoint(cam.Position, target_part.Position, target_char)
        if not manip then return end
        local shoot_pos = (height == nil and manip) or cam.Position
        local cameradata = {}
        cameradata[utf8.char(1)] = {
            [utf8.char(0)] = util_mod:EncodeCFrame(
                CFrame.new(shoot_pos.X, shoot_pos.Y+(height or 0), shoot_pos.Z)
                * CFrame.Angles(CFrame.lookAt(shoot_pos, target_part.Position):ToOrientation())
            ),
            [utf8.char(1)] = height and
                util_mod:EncodeCFrame(CFrame.new(target_part.Position)*CFrame.Angles(CFrame.lookAt(shoot_pos,target_part.Position):ToOrientation()))
                or util_mod:EncodeCFrame(CFrame.new(shoot_pos.X,shoot_pos.Y+(height or 0),shoot_pos.Z)*CFrame.Angles(CFrame.lookAt(shoot_pos,target_part.Position):ToOrientation())),
            [utf8.char(2)] = target_part,
            [utf8.char(3)] = util_mod:EncodeCFrame(target_part.CFrame:ToObjectSpace(CFrame.new(target_part.Position))),
        }
        pcall(function()
            ReplicatedStorage.Remotes.Replication.Fighter.UseItem:FireServer(
                item:Get("ObjectID"), enums_mod:ToEnum("StartShooting"), cameradata, nil
            )
        end)
    end)
end
local function stopRagebotSA()
    if silentConn then silentConn:Disconnect(); silentConn = nil end
end

-- ═══════════════════════════════════════════
-- VOIDSPAM / DESYNC
-- ═══════════════════════════════════════════
local function checkProjectiles()
    if not CFG.Void.ProjectileMimic or not Desync.realCFrame then return false end
    local myPos  = Desync.realCFrame.Position
    local params = OverlapParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {character}
    local ok, parts = pcall(function()
        return workspace:GetPartBoundsInRadius(myPos, CFG.Void.DetectionRange, params)
    end)
    if not ok or not parts then return false end
    for _, part in ipairs(parts) do
        if not part:IsDescendantOf(character) then
            local vel = part.AssemblyLinearVelocity
            if vel.Magnitude > 80 then
                local toUs = myPos - part.Position
                if toUs.Magnitude > 1 and toUs.Unit:Dot(vel.Unit) > 0.4 then return true end
            end
        end
    end
    return false
end

RunService:BindToRenderStep("RivalsDesync", Enum.RenderPriority.Camera.Value - 1, function()

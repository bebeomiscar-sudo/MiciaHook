local function applyWeaponStatus()
    if weaponStatusApplied then return end
    local handlerPath = LP:FindFirstChild("PlayerScripts")
        and LP.PlayerScripts:FindFirstChild("Modules")
        and LP.PlayerScripts.Modules:FindFirstChild("WeaponStatusHandler")
    if not handlerPath then return end

    local ok, WeaponStatusHandler = pcall(require, handlerPath)
    if not ok or not WeaponStatusHandler then return end

    oldWeaponFunc = WeaponStatusHandler.ApplyItemStatusToBackground
    WeaponStatusHandler.ApplyItemStatusToBackground = function(self, background, stroke, status)
        background.BackgroundColor3 = Color3.fromRGB(100, 0, 200)
        if stroke then
            stroke.Color = Color3.fromRGB(170, 0, 255)
            stroke.Thickness = 2
        end
        local parent = background.Parent
        if parent and parent:FindFirstChild("Icon") then
            parent.Icon.Picture.ImageTransparency = 0.1
        end
        return oldWeaponFunc(self, background, stroke, "Banned")
    end
    weaponStatusApplied = true
end

local function removeWeaponStatus()
    if not weaponStatusApplied or not oldWeaponFunc then return end
    local handlerPath = LP:FindFirstChild("PlayerScripts")
        and LP.PlayerScripts:FindFirstChild("Modules")
        and LP.PlayerScripts.Modules:FindFirstChild("WeaponStatusHandler")
    if not handlerPath then return end

    local ok, WeaponStatusHandler = pcall(require, handlerPath)
    if ok and WeaponStatusHandler then
        WeaponStatusHandler.ApplyItemStatusToBackground = oldWeaponFunc
    end
    weaponStatusApplied = false
end


local function getMousePosition()
    -- Always use UIS, never Player:GetMouse()
    local pos = UIS:GetMouseLocation()
    local offX, offY = 0, 0

    if InputCFG.Platform == "PC" then
        offX = InputCFG.PC_OffsetX
        offY = InputCFG.PC_OffsetY
    else
        offX = InputCFG.MB_OffsetX
        offY = InputCFG.MB_OffsetY
    end

    return Vector2.new(pos.X + offX, pos.Y + offY)
end

local function getSmoothnessValue()

-- ═══════════════════════════════════════════
local triggerbotConn = nil
local lastTriggerTime = 0
local isFiring = false
local fireStartTime = 0

local function getWeaponType(item)
    if not item then return "unknown" end
    
    local name = ""
    pcall(function() name = item:Get("Name") or item.Name or "" end)
    
    local autoWeapons = {
        ["Assault Rifle"] = true, ["SMG"] = true, ["Minigun"] = true,
        ["Flamethrower"] = true, ["Freeze Ray"] = true
    }
    local semiWeapons = {
        ["Pistol"] = true, ["Revolver"] = true, ["Deagle"] = true,
        ["Shotgun"] = true, ["Sniper"] = true, ["Crossbow"] = true,
        ["Bow"] = true, ["RPG"] = true, ["Grenade Launcher"] = true
    }
    
    if autoWeapons[name] then return "automatic" end
    if semiWeapons[name] then return "semi" end
    return "unknown"
end

local function isPlayerValidForTrigger(target)
    if not target then return false end
    local character = target.Character
    if not character then return false end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return false end
    
    if TriggerbotCFG.TeamCheck and isSameTeamRivals(target) then return false end
    
    local part = getBestPart(character, TriggerbotCFG.TargetPart)
    if not part then return false end
    
    if TriggerbotCFG.VisibleCheck and not isVisible(camera.CFrame.Position, part) then return false end
    
    local distance = (camera.CFrame.Position - part.Position).Magnitude
    if distance > TriggerbotCFG.MaxDistance then return false end
    
    return true, part
end

local function fireWeapon(item, weaponType)
    if not item then return end
    
    pcall(function()
        if item.StartShooting then
            item:StartShooting()
        end
        
        if item.Shoot then
            if weaponType == "automatic" then
                if not isFiring then
                    isFiring = true
                    fireStartTime = tick()
                    
                    task.spawn(function()
                        while isFiring and TriggerbotCFG.On do
                            pcall(function()
                                item:Shoot()
                                rs.Remotes.Replication.Fighter.UseItem:FireServer(
                                    item:Get("ObjectID"),
                                    enums_mod and enums_mod:ToEnum("StartShooting") or 1,
                                    {},
                                    nil
                                )
                            end)
                            task.wait(0.05)
                        end
                    end)
                end
            else
                for i = 1, TriggerbotCFG.BurstCount do
                    item:Shoot()
                    task.wait(0.05)
                end
            end
        elseif item.Fire then
            item:Fire()
        end
        
        local objectId = nil
        pcall(function() objectId = item:Get("ObjectID") end)
        
        if objectId and enums_mod then
            rs.Remotes.Replication.Fighter.UseItem:FireServer(
                objectId,
                enums_mod:ToEnum("StartShooting"),
                {},
                nil
            )
            
            if weaponType == "automatic" and TriggerbotCFG.AutoFire then
                task.spawn(function()
                    local startTime = tick()
                    while tick() - startTime < 0.3 and TriggerbotCFG.On do
                        rs.Remotes.Replication.Fighter.UseItem:FireServer(
                            objectId,
                            enums_mod:ToEnum("Shooting"),
                            {},
                            nil
                        )
                        task.wait(0.05)
                    end
                    
                    rs.Remotes.Replication.Fighter.UseItem:FireServer(
                        objectId,
                        enums_mod:ToEnum("StopShooting"),
                        {},
                        nil
                    )
                end)
            else
                task.wait(0.05)
                rs.Remotes.Replication.Fighter.UseItem:FireServer(
                    objectId,
                    enums_mod:ToEnum("StopShooting"),
                    {},
                    nil
                )
            end
        end
    end)
end

local function stopFiring(item)
    isFiring = false
    
    pcall(function()
        if item and item.StopShooting then
            item:StopShooting()
        end
        
        local objectId = nil
        pcall(function() objectId = item:Get("ObjectID") end)
        
        if objectId and enums_mod then
            rs.Remotes.Replication.Fighter.UseItem:FireServer(
                objectId,
                enums_mod:ToEnum("StopShooting"),
                {},
                nil
            )
        end
    end)
end

local function startTriggerbot()
    if triggerbotConn then triggerbotConn:Disconnect() end
    
    triggerbotConn = RunService.Heartbeat:Connect(function()
        if not TriggerbotCFG.On then 
            if isFiring then
                pcall(function()
                    if fighter_mod and fighter_mod.LocalFighter and fighter_mod.LocalFighter.EquippedItem then
                        stopFiring(fighter_mod.LocalFighter.EquippedItem)
                    end
                end)
            end
            return 
        end
        
        if not LP.Character or not LP.Character:FindFirstChild("HumanoidRootPart") then 
            if isFiring then
                pcall(function()
                    if fighter_mod and fighter_mod.LocalFighter and fighter_mod.LocalFighter.EquippedItem then
                        stopFiring(fighter_mod.LocalFighter.EquippedItem)
                    end
                end)
            end
            return 
        end
        
        local myHum = LP.Character:FindFirstChildOfClass("Humanoid")
        if not myHum or myHum.Health <= 0 then return end
        
        if TriggerbotCFG.Mode == "Scoped Only" then
            local isAiming = false
            pcall(function()
                if fighter_mod and fighter_mod.LocalFighter then
                    isAiming = fighter_mod.LocalFighter.IsAiming or false
                end
            end)
            if not isAiming then 
                if isFiring then
                    pcall(function()
                        if fighter_mod and fighter_mod.LocalFighter and fighter_mod.LocalFighter.EquippedItem then
                            stopFiring(fighter_mod.LocalFighter.EquippedItem)
                        end
                    end)
                end
                return 
            end
        end
        
        if TriggerbotCFG.Mode == "On Aimbot Target" and not lockedTarget then
            if isFiring then
                pcall(function()
                    if fighter_mod and fighter_mod.LocalFighter and fighter_mod.LocalFighter.EquippedItem then
                        stopFiring(fighter_mod.LocalFighter.EquippedItem)
                    end
                end)
            end
            return
        end
        
        local equippedItem = nil
        local weaponType = "unknown"
        pcall(function()
            if fighter_mod and fighter_mod.LocalFighter then
                equippedItem = fighter_mod.LocalFighter.EquippedItem
                weaponType = getWeaponType(equippedItem)
            end
        end)
        
        local rayOrigin = camera.CFrame.Position
        local rayDirection = camera.CFrame.LookVector * TriggerbotCFG.MaxDistance
        
        local raycastParams = RaycastParams.new()
        raycastParams.FilterType = Enum.RaycastFilterType.Exclude
        raycastParams.FilterDescendantsInstances = {LP.Character}
        raycastParams.IgnoreWater = true
        
        local result = Workspace:Raycast(rayOrigin, rayDirection, raycastParams)
        
        local shouldFire = false
        
        if result then
            local hitModel = result.Instance:FindFirstAncestorOfClass("Model")
            if hitModel then
                local hitPlayer = Players:GetPlayerFromCharacter(hitModel)
                if hitPlayer and hitPlayer ~= LP then
                    local valid, targetPart = isPlayerValidForTrigger(hitPlayer)
                    if valid then
                        local partPos = targetPart.Position
                        local screenPos, onScreen = camera:WorldToViewportPoint(partPos)
                        
                        if onScreen then
                            local center = getScreenCenter()
                            local distFromCenter = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                            
                            if distFromCenter < 50 then
                                shouldFire = true
                            end
                        end
                    end
                end
            end
        end
        
        if shouldFire then
            local currentTime = tick()
            if (currentTime - lastTriggerTime) * 1000 >= TriggerbotCFG.Delay then
                lastTriggerTime = currentTime
                
                if equippedItem then
                    fireWeapon(equippedItem, weaponType)
                end
            end
        else
            if isFiring and equippedItem then
                stopFiring(equippedItem)
            end
        end
    end)
end

local function stopTriggerbot()
    if triggerbotConn then
        triggerbotConn:Disconnect()
        triggerbotConn = nil
    end
    
    if isFiring then
        pcall(function()
            if fighter_mod and fighter_mod.LocalFighter and fighter_mod.LocalFighter.EquippedItem then
                stopFiring(fighter_mod.LocalFighter.EquippedItem)
            end
        end)
    end
    
    isFiring = false
end


-- ═══════════════════════════════════════════
-- AC BYPASS
-- The only thing Rivals detects:
-- 1. Player:GetMouse() being referenced (weak table check)
-- 2. game:Kick() returning successfully (hook detection)
-- 3. CameraSecurity __index checking for hookfunction in getfenv
-- Fix: Never use Player:GetMouse(), use cloneref, use newcclosure
-- ═══════════════════════════════════════════
if hookmetamethod then
    if not game:IsLoaded() then game.Loaded:Wait() end
    pcall(function()
        for _, v in getgc() do
            if typeof(v) == "function" then
                local ok, s = pcall(debug.info, v, "s")
                if ok and s and string.find(s, "AnalyticsPipelineController") then
                    -- Neutralize the ban function cleanly
                    hookfunction(v, newcclosure(function(...) return end))
                end
            end
        end
    end)
end


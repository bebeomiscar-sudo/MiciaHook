-- RAGEBOT ENGINE (Glue Kill Method)
--━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
local RagebotState={conn=nil,active=false,actionTime=0,targetName=""}

local function stopRagebot()
    if RagebotState.conn then pcall(function() RagebotState.conn:Disconnect() end);RagebotState.conn=nil end
    RagebotState.active=false
    pcall(function()
        local c=LP.Character;if not c then return end
        local r=c:FindFirstChild("HumanoidRootPart")
        if r then pcall(function() sethiddenproperty(r,"PhysicsRepRootPart",nil) end) end
        local bp=LP:FindFirstChildOfClass("Backpack")
        local combat=c:FindFirstChild("Combat")
        if combat and bp then combat.Parent=bp end
    end)
end

local function startGlueKill(targetName)
    stopRagebot()
    local targetPlr=Players:FindFirstChild(targetName)
    if not targetPlr then return end
    local char=LP.Character;if not char then return end
    local hrp=char:FindFirstChild("HumanoidRootPart");if not hrp then return end
    local tChar=targetPlr.Character;if not tChar then return end
    local tHRP=tChar:FindFirstChild("HumanoidRootPart");if not tHRP then return end
    local bp=LP:FindFirstChildOfClass("Backpack")
    local combat=bp and bp:FindFirstChild("Combat") or char:FindFirstChild("Combat")
    if not combat then return end

    combat.Parent=char
    tHRP.Anchored=true
    pcall(function() sethiddenproperty(hrp,"PhysicsRepRootPart",tHRP) end)
    RagebotState.active=true
    RagebotState.actionTime=tick()
    RagebotState.targetName=targetName

    RagebotState.conn=RunService.Heartbeat:Connect(function()
        if not RagebotState.active or tick()-RagebotState.actionTime>8 then
            stopRagebot()
            if tHRP and tHRP.Parent then tHRP.Anchored=false end
            return
        end
        local tPlr=Players:FindFirstChild(targetName)
        if not tPlr or not tPlr.Character then stopRagebot();return end
        local tH=tPlr.Character:FindFirstChild("HumanoidRootPart")
        local tHum=tPlr.Character:FindFirstChildOfClass("Humanoid")
        if not tH or not tHum then stopRagebot();return end
        if tHum.Health<=0 then
            if tH.Parent then tH.Anchored=false end
            stopRagebot();return
        end
        local myChar=LP.Character;if not myChar then stopRagebot();return end
        local myHRP=myChar:FindFirstChild("HumanoidRootPart");if not myHRP then stopRagebot();return end
        tH.Anchored=true
        pcall(function() sethiddenproperty(myHRP,"PhysicsRepRootPart",tH) end)
        myHRP.CFrame=CFrame.lookAt(tH.Position-tH.CFrame.LookVector*4,tH.Position)
        local c2=myChar:FindFirstChild("Combat")
        if not c2 then local bp2=LP:FindFirstChildOfClass("Backpack");c2=bp2 and bp2:FindFirstChild("Combat") end
        if c2 then if c2.Parent~=myChar then c2.Parent=myChar end;c2:Activate() end
    end)
end


-- Also check existing subspace mines
local function destroyExistingSubspaces()
    if not CFG.Ragebot.AntiSubspace then return end
    local myChar=LP.Character;if not myChar then return end
    local myHRP=myChar:FindFirstChild("HumanoidRootPart");if not myHRP then return end
    for _,child in ipairs(workspace:GetChildren()) do
        if child.Name=="SubspaceTripmineHitbox" then
            local hitbox=child:FindFirstChild("Hitbox")

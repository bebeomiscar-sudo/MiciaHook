-- UI HELPERS
local function Tween(inst, props, t)
    pcall(function()
        TweenService:Create(inst, TweenInfo.new(t or 0.15, Enum.EasingStyle.Quad), props):Play()
    end)
end

local function Make(class, props, parent)
    local inst = Instance.new(class)
    for k, v in pairs(props or {}) do pcall(function() inst[k] = v end) end
    if parent then inst.Parent = parent end
    return inst
end

local function Corner(p, r)  Make("UICorner",  {CornerRadius=UDim.new(0,r or 6)}, p) end
local function Stroke(p, c, t) return Make("UIStroke", {Color=c or T.Border, Thickness=t or 1}, p) end
local function Pad(p, t, b, l, r)
    Make("UIPadding", {PaddingTop=UDim.new(0,t or 0), PaddingBottom=UDim.new(0,b or 0), PaddingLeft=UDim.new(0,l or 0), PaddingRight=UDim.new(0,r or 0)}, p)
end
local function List(p, dir, gap)
    return Make("UIListLayout", {FillDirection=dir or Enum.FillDirection.Vertical, Padding=UDim.new(0,gap or 4), SortOrder=Enum.SortOrder.LayoutOrder}, p)
end

local function InputPos(input)
    if input.UserInputType == Enum.UserInputType.Touch then return input.Position.X, input.Position.Y end
    local m = LP:GetMouse(); return m.X, m.Y
end

local function Draggable(handle, root)
    local drag, startM, startP = false, nil, nil
    handle.InputBegan:Connect(function(inp)
        if inp.UserInputType ~= Enum.UserInputType.MouseButton1 and inp.UserInputType ~= Enum.UserInputType.Touch then return end
        drag=true; startM=Vector2.new(InputPos(inp)); startP=root.Position
    end)
    UIS.InputChanged:Connect(function(inp)
        if not drag then return end
        if inp.UserInputType ~= Enum.UserInputType.MouseMovement and inp.UserInputType ~= Enum.UserInputType.Touch then return end
        local mx,my = InputPos(inp); local delta = Vector2.new(mx,my) - startM
        root.Position = UDim2.new(startP.X.Scale, startP.X.Offset+delta.X, startP.Y.Scale, startP.Y.Offset+delta.Y)
    end)
    UIS.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then drag=false end
    end)
end


local orbitAngle = 0

table.insert(ActiveConnections, RunService.Heartbeat:Connect(function(dt)
    if not CFG.Orbit.On or CFG.Void.On or not CFG.OrbitTarget then return end
    local mc = LP.Character; if not mc then return end
    local mr = mc:FindFirstChild("HumanoidRootPart"); if not mr then return end
    local tc = CFG.OrbitTarget.Character; if not tc then return end
    local tr = tc:FindFirstChild("HumanoidRootPart"); if not tr then return end
    local mh = mc:FindFirstChildOfClass("Humanoid")
    if mh and mh.Health <= 0 then return end
    orbitAngle = orbitAngle + (CFG.Orbit.Speed * dt)
    if orbitAngle > math.pi * 2 then orbitAngle = orbitAngle - math.pi * 2 end
    local tp = tr.Position
    mr.CFrame = CFrame.new(tp + Vector3.new(
        math.cos(orbitAngle) * CFG.Orbit.Radius,
        CFG.Orbit.Height,
        math.sin(orbitAngle) * CFG.Orbit.Radius
    ), tp)
end))


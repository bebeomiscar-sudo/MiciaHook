local function getTriggerTarget()
    local center=getScreenCenter()
    local origin=camera.CFrame.Position
    local dir=(camera.CFrame.LookVector)*1000
    local params=RaycastParams.new()
    params.FilterType=Enum.RaycastFilterType.Exclude
    local fl={camera}
    if LP.Character then table.insert(fl,LP.Character) end
    params.FilterDescendantsInstances=fl
    local hit=workspace:Raycast(origin,dir,params)
    if not hit or not hit.Instance then return nil end
    local hitChar = nil
    local inst = hit.Instance
    while inst do
        if inst:FindFirstChildOfClass("Humanoid") then hitChar=inst; break end
        inst = inst.Parent
    end
    if not hitChar then return nil end
    local hum=hitChar:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health<=0 then return nil end
    local tp=Players:GetPlayerFromCharacter(hitChar)
    if tp==LP then return nil end
    if CFG.Trigger.TeamCheck and tp and isSameTeam(tp) then return nil end
    local root=hitChar:FindFirstChild("HumanoidRootPart") or hitChar:FindFirstChild("Head")
    if root then
        local sp,on=camera:WorldToScreenPoint(root.Position)
        if on then
            local d=(Vector2.new(sp.X,sp.Y)-center).Magnitude
            if d>CFG.Trigger.FOV then return nil end
        end
    end
    return hitChar
end


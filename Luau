-- SKIN CHANGER — CORE
-- ═══════════════════════════════════════════
local activeSkinSelections = {}
local skinChangerConn      = nil
local lastEquippedWeapon   = nil

local function applyActiveSkin(weaponName, skinName)
    if not SkinChangerCFG.On then return end
    if skinName == "Default" or not skinName then
        if currentAnimSkin and currentAnimWeapon == weaponName then unhookAnimations() end
        return
    end
    if currentAnimWeapon == weaponName and currentAnimSkin == skinName then return end
    if animHookActive then unhookAnimations() end
    local hooked = hookAnimations(weaponName, skinName)
    if hooked then
        Library:Notify("Skin: " .. skinName .. " + custom anims ✓", 2)
    else
        Library:Notify("Skin: " .. skinName .. " applied (no custom anims)", 2)
    end
end

local function startSkinChanger()
    if skinChangerConn then skinChangerConn:Disconnect() end
    skinChangerConn = RunService.Heartbeat:Connect(function()
        if not SkinChangerCFG.On then return end
        if not fighter_mod or not fighter_mod.LocalFighter then return end
        local item = fighter_mod.LocalFighter.EquippedItem
        if not item then
            if lastEquippedWeapon then unhookAnimations(); lastEquippedWeapon = nil end
            return
        end
        local weaponName = nil
        pcall(function() weaponName = item:Get("Name") end)
        if not weaponName then return end
        if weaponName ~= lastEquippedWeapon then
            if animHookActive then unhookAnimations() end
            lastEquippedWeapon = weaponName
            local selectedSkin = activeSkinSelections[weaponName]
            if selectedSkin and selectedSkin ~= "Default" then
                applyActiveSkin(weaponName, selectedSkin)
            end
        end
    end)
end

local function stopSkinChanger()
    SkinChangerCFG.On = false
    if skinChangerConn then skinChangerConn:Disconnect(); skinChangerConn = nil end
    unhookAnimations()
    lastEquippedWeapon = nil
end


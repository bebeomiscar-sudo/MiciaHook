local function isSameTeam(player)
    if not player or not LP then return false end
    local ok,r = pcall(function()
        if player.Team and LP.Team then return player.Team==LP.Team end
        return false
    end)
    return ok and r or false
end

local function isVisible(targetPart)
    if not targetPart then return false end
    local ok, result = pcall(function()
        local origin = camera.CFrame.Position
        local direction = (targetPart.Position - origin)
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        local filterList = {camera}
        if LP.Character then table.insert(filterList, LP.Character) end
        params.FilterDescendantsInstances = filterList
        local hit = workspace:Raycast(origin, direction, params)
        if hit then return hit.Instance:IsDescendantOf(targetPart.Parent) end
        return true
    end)
    return ok and result or false
end

local function isAirborne(char)
    if not char then return false end
    local ok,r = pcall(function()
        local hum=char:FindFirstChildOfClass("Humanoid")
        if not hum then return false end
        local st=hum:GetState()
        return st==Enum.HumanoidStateType.Freefall or st==Enum.HumanoidStateType.Jumping or st==Enum.HumanoidStateType.FallingDown
    end)
    return ok and r or false
end

local BODY_PARTS = {
    "Head","HumanoidRootPart","UpperTorso","LowerTorso",
    "LeftUpperArm","RightUpperArm","LeftLowerArm","RightLowerArm",
    "LeftUpperLeg","RightUpperLeg","LeftLowerLeg","RightLowerLeg",
    "Torso","Left Arm","Right Arm","Left Leg","Right Leg",
}

local function getClosestPart(char)
    local center=getScreenCenter(); local bestPart,bestDist=nil,math.huge
    for _,pn in ipairs(BODY_PARTS) do
        local p=char:FindFirstChild(pn)
        if not p or not p:IsA("BasePart") then continue end
        local sp,on=camera:WorldToScreenPoint(p.Position)
        if not on then continue end
        local d=(Vector2.new(sp.X,sp.Y)-center).Magnitude
        if d<bestDist then bestDist=d; bestPart=p end
    end
    return bestPart
end

local function getClosestPointOnPart(part)
    if not part then return nil end
    local ok,r = pcall(function()
        local cp=camera.CFrame.Position; local cf=part.CFrame; local hs=part.Size/2
        local lp=cf:PointToObjectSpace(cp)
        return cf:PointToWorldSpace(Vector3.new(
            math.clamp(lp.X,-hs.X,hs.X),
            math.clamp(lp.Y,-hs.Y,hs.Y),
            math.clamp(lp.Z,-hs.Z,hs.Z)
        ))
    end)
    return ok and r or part.Position
end


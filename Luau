-- SKIN CHANGER
-- ═══════════════════════════════════════════
local equipped           = {}
local favorites          = {}
local skinChangerEnabled = false
local remoteHookApplied  = false
local vmPatchApplied     = false
local saveFile           = "unlockall/config.json"

local function cloneCosmetic(name, cosmeticType, options)
    if not CosmeticLibrary then return nil end
    local base = CosmeticLibrary.Cosmetics[name]
    if not base then return nil end
    local data = {}
    for k, v in pairs(base) do data[k] = v end
    data.Name = name
    data.Type = data.Type or cosmeticType
    data.Seed = data.Seed or math.random(1, 1000000)
    if EnumLibrary then
        local ok, enumId = pcall(EnumLibrary.ToEnum, EnumLibrary, name)
        if ok and enumId then data.Enum = enumId; data.ObjectID = data.ObjectID or enumId end
    end
    if options then
        if options.inverted      ~= nil then data.Inverted         = options.inverted      end
        if options.favoritesOnly ~= nil then data.OnlyUseFavorites = options.favoritesOnly end
    end
    return data
end

local function isCosmeticAllowed(name, cosmetic)
    if not cosmetic or not skinChangerEnabled then return false end
    local t = cosmetic.Type or ""
    if t == "Finisher" or name:lower():find("finisher") then return false end
    return true
end

local function saveConfig()
    if not writefile then return end
    pcall(function()
        local config = {equipped = {}, favorites = favorites}
        for weapon, cosmetics in pairs(equipped) do
            config.equipped[weapon] = {}
            for ct, cd in pairs(cosmetics) do
                if cd and cd.Name then
                    config.equipped[weapon][ct] = {name=cd.Name, seed=cd.Seed, inverted=cd.Inverted}
                end
            end
        end
        makefolder("unlockall")
        writefile(saveFile, HttpService:JSONEncode(config))
    end)
end

local function loadConfig()
    if not readfile or not isfile or not isfile(saveFile) then return end
    pcall(function()
        local config = HttpService:JSONDecode(readfile(saveFile))
        if config.equipped then
            for weapon, cosmetics in pairs(config.equipped) do
                equipped[weapon] = {}
                for ct, cd in pairs(cosmetics) do
                    local cloned = cloneCosmetic(cd.name, ct, {inverted=cd.inverted})
                    if cloned then cloned.Seed = cd.seed; equipped[weapon][ct] = cloned end
                end
            end
        end
        favorites = config.favorites or {}
    end)
end

local function applySkinPatches()
    if not CosmeticLibrary or not DataController then return end
    CosmeticLibrary.OwnsCosmetic = function(self, inv, name)
        if name:find("MISSING_") then return false end
        local cosmetic = CosmeticLibrary.Cosmetics[name]
        return cosmetic and isCosmeticAllowed(name, cosmetic) or false
    end
    CosmeticLibrary.OwnsCosmeticNormally    = CosmeticLibrary.OwnsCosmetic
    CosmeticLibrary.OwnsCosmeticUniversally = CosmeticLibrary.OwnsCosmetic
    CosmeticLibrary.OwnsCosmeticForWeapon   = CosmeticLibrary.OwnsCosmetic

    local origGet = DataController.Get
    DataController.Get = function(self, key)
        local data = origGet(self, key)
        if key == "CosmeticInventory" and skinChangerEnabled then
            return setmetatable({}, {
                __index = function(t, k)
                    local cosmetic = CosmeticLibrary.Cosmetics[k]
                    return cosmetic and isCosmeticAllowed(k, cosmetic) or nil
                end
            })
        end
        if key == "FavoritedCosmetics" and skinChangerEnabled then
            local result = data and table.clone(data) or {}
            for w, favs in pairs(favorites) do
                result[w] = result[w] or {}
                for n, v in pairs(favs) do
                    local cosmetic = CosmeticLibrary.Cosmetics[n]
                    if cosmetic and isCosmeticAllowed(n, cosmetic) then result[w][n] = v end
                end
            end
            return result
        end
        return data
    end

    local origGetWD = DataController.GetWeaponData
    DataController.GetWeaponData = function(self, wn)
        local data = origGetWD(self, wn)
        if not data then return nil end
        local merged = {}
        for k, v in pairs(data) do merged[k] = v end
        merged.Name = wn
        if skinChangerEnabled and equipped[wn] then
            for ct, cd in pairs(equipped[wn]) do merged[ct] = cd end
        end
        return merged
    end
end

local function applyRemoteHook()
    if remoteHookApplied or not hookmetamethod then return end
    local equipRemote    = ReplicatedStorage.Remotes.Data:FindFirstChild("EquipCosmetic")
    local favoriteRemote = ReplicatedStorage.Remotes.Data:FindFirstChild("FavoriteCosmetic")
    if not equipRemote then return end

    local oldNC
    oldNC = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if method ~= "FireServer" then return oldNC(self, ...) end
        local args = {...}

        if self == equipRemote and skinChangerEnabled then
            local weaponName, cosmeticType, cosmeticName, options =
                args[1], args[2], args[3], args[4] or {}
            if cosmeticType == "Finisher" then return oldNC(self, ...) end
            equipped[weaponName] = equipped[weaponName] or {}
            if not cosmeticName or cosmeticName == "None" or cosmeticName == "" then
                equipped[weaponName][cosmeticType] = nil
                if not next(equipped[weaponName]) then equipped[weaponName] = nil end
            else
                local cloned = cloneCosmetic(cosmeticName, cosmeticType,
                    {inverted=options.IsInverted, favoritesOnly=options.OnlyUseFavorites})
                if cloned then equipped[weaponName][cosmeticType] = cloned end
            end
            task.defer(function()
                pcall(function() DataController.CurrentData:Replicate("WeaponInventory") end)
                task.wait(0.2); saveConfig()
            end)
            return
        end

        if self == favoriteRemote and skinChangerEnabled then
            local cosmetic = CosmeticLibrary and CosmeticLibrary.Cosmetics[args[2]]
            if cosmetic and isCosmeticAllowed(args[2], cosmetic) then
                favorites[args[1]] = favorites[args[1]] or {}
                favorites[args[1]][args[2]] = args[3] or nil
                saveConfig()
                task.spawn(function()
                    pcall(function() DataController.CurrentData:Replicate("FavoritedCosmetics") end)
                end)
                return
            end
        end

        return oldNC(self, ...)
    end))
    remoteHookApplied = true
end

local function enableSkinChanger()
    skinChangerEnabled = true
    applySkinPatches()
    applyRemoteHook()
    loadConfig()
    Library:Notify("Skin Changer enabled", 3)
end

local function disableSkinChanger()
    skinChangerEnabled = false
    Library:Notify("Skin Changer disabled (rejoin to fully revert)", 4)
end


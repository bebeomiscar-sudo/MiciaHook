-- Skin Changer
local scWeaponList = {}
for w, _ in pairs(SC_WeaponSkins) do table.insert(scWeaponList, w) end
table.sort(scWeaponList)
local scSelectedWeapon = scWeaponList[1]
local scSelectedSkin   = "Default"
local scInfoLabel      = s_skin_main:CreateLabel("Select weapon then skin")

s_skin_main:CreateDropdown("Weapon", scWeaponList, function(v)
    scSelectedWeapon = v; scSelectedSkin = "Default"
    scInfoLabel:UpdateText("Selected: "..v)
    local skins = {"Default"}
    for _, s in ipairs(SC_WeaponSkins[v] or {}) do table.insert(skins, s) end
    window:Notify("Skins for "..v, table.concat(skins, ", "), 5)
end, scWeaponList[1], false)

s_skin_main:CreateTextBox("Skin Name", "Type exact skin name...", false, function(v)
    local trimmed = v:gsub("^%s+",""):gsub("%s+$","")
    if trimmed == "" or trimmed == "Default" then
        SC_Reset(scSelectedWeapon); scSelectedSkin = "Default"
        scInfoLabel:UpdateText(scSelectedWeapon.." → Default")
    else
        local found = false
        for _, sk in ipairs(SC_WeaponSkins[scSelectedWeapon] or {}) do
            if sk:lower() == trimmed:lower() then
                found = true; scSelectedSkin = sk
                SC_Apply(scSelectedWeapon, sk)
                scInfoLabel:UpdateText(scSelectedWeapon.." → "..sk)
                window:Notify("Applied", sk.." on "..scSelectedWeapon, 3); break
            end
        end
        if not found then window:Notify("Not Found", '"'..trimmed..'" not valid for '..scSelectedWeapon, 4) end
    end
end)
s_skin_main:CreateButton("Reset Skin", function()
    SC_Reset(scSelectedWeapon); scSelectedSkin = "Default"
    scInfoLabel:UpdateText(scSelectedWeapon.." → Default")
end)
s_skin_main:CreateButton("List Skins (Console)", function()
    if not scSelectedWeapon then return end
    print("=== Skins for "..scSelectedWeapon.." ==="); print("Default")
    for _, sk in ipairs(SC_WeaponSkins[scSelectedWeapon] or {}) do print(sk) end
    window:Notify("Console", "All skins printed (F9)", 4)
end)


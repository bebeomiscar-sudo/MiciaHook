local function FindCoreProjectile()
    for _, obj in ipairs(Workspace:GetChildren()) do
        if obj.Name == "CoreProjectile" and obj:FindFirstChild("TouchInterest") then return obj end
    end
    return nil
end

local function GetEnemyHitbox(enemy)
    if not enemy or not enemy.Character then return nil end
    local tp = ProjectileTPCFG.TargetPart
    return enemy.Character:FindFirstChild(tp)
        or enemy.Character:FindFirstChild("HitBoxHead")
        or enemy.Character:FindFirstChild("HitBoxHeadSmall")
        or enemy.Character:FindFirstChild("Head")
end

local function createExpandedHitbox(enemy)
    if not enemy or not enemy.Character then return nil end
    local root = enemy.Character:FindFirstChild("HumanoidRootPart"); if not root then return nil end
    local size = ProjectileTPCFG.HitboxSize
    local hitbox = Instance.new("Part")
    hitbox.Name="._ExpandedHitbox"; hitbox.Size=Vector3.new(size,size,size)
    hitbox.CFrame=root.CFrame; hitbox.Anchored=true; hitbox.CanCollide=false
    hitbox.Transparency=1; hitbox.Parent=Workspace
    task.delay(1, function() pcall(function() hitbox:Destroy() end) end)
    return hitbox
end

Connections.ProjectileTP = RunService.Heartbeat:Connect(function()
    if not ProjectileTPCFG.Enabled then return end
    pcall(function()
        local projectile = FindCoreProjectile(); if not projectile then return end
        if ProjectileTPCFG.Cache and not ProjectileCache[projectile] then
            ProjectileCache[projectile] = true
        end
        CacheEnemies()
        for _, enemy in ipairs(EnemyCache) do
            local hitbox = GetEnemyHitbox(enemy); if not hitbox then continue end
            for _ = 1, math.max(1, ProjectileTPCFG.ShootAttempts) do
                firetouchinterest(projectile, hitbox, 0)
                task.wait(ProjectileTPCFG.LoopDelay)
                firetouchinterest(projectile, hitbox, 1)
                if ProjectileTPCFG.HitboxSize > 5 then
                    local expanded = createExpandedHitbox(enemy)
                    if expanded then
                        firetouchinterest(projectile, expanded, 0)
                        task.wait(0.01)
                        firetouchinterest(projectile, expanded, 1)
                    end
                end
            end
        end
    end)
end)

Connections.ProjAutoShoot = RunService.Heartbeat:Connect(function()
    if not ProjectileTPCFG.AutoShoot then return end
    pcall(function()
        local tool = LP.Character:FindFirstChildOfClass("Tool")
        if tool then tool:Activate() end
    end)
end)

